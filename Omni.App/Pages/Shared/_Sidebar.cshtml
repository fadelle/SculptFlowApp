@inject ICurrentClientContext CurrentClient
@inject IConfigManager Settings
@* The dark sidebar (docs/UI_GUIDE.md §5, §0.4): brand + client name, then the four groups of links in their old order.
   #sidebar-inbox-badge is filled by sidebar.js / inbox.js. *@
@{
    var clientName = (await CurrentClient.GetClientAsync())?.Name;
    var path = Context.Request.Path.Value ?? "";
    bool IsActive(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase)
        || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    var dashboardActive = IsActive("/dashboard") && !IsActive("/dashboard/contacts") && !IsActive("/dashboard/bookings");
}
@functions {
    // One nav row; the label doubles as the tooltip when the sidebar is collapsed to icons.
    private static Microsoft.AspNetCore.Html.IHtmlContent Row(string href, string icon, string label, bool active, string? extra = null)
    {
        var current = active ? " is-active\" aria-current=\"page" : "";
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<div class=\"au-nav-row\"><a class=\"au-nav-item{current}\" href=\"{enc.Encode(href)}\" title=\"{enc.Encode(label)}\">"
            + $"<span class=\"au-icon\" aria-hidden=\"true\">{icon}</span><span class=\"au-nav-item__label\">{enc.Encode(label)}</span>{extra}</a></div>");
    }
}
<nav class="au-sidebar" aria-label="@T["nav.label"]">
    <a class="au-brand" href="/dashboard">
        <span class="au-brand__mark"><img class="au-brand__logo" src="~/logo.svg" alt="" width="38" height="38" /></span>
        <span class="au-brand__text">
            <span class="au-brand__name">Omni</span>
            <span class="au-brand__sub" title="@clientName">@(string.IsNullOrWhiteSpace(clientName) ? T["nav.brandSub"].Value : clientName)</span>
        </span>
    </a>
    <div class="au-side-rule"></div>
    <div class="au-side-scroll">
        <div class="au-side-section">@T["nav.section.daily"]</div>
        @Row("/dashboard", "space_dashboard", T["nav.dashboard"].Value, dashboardActive) @* icon:space_dashboard *@
        @Row("/inbox", "chat", T["nav.inbox"].Value, IsActive("/inbox"),
            "<span class=\"au-nav-count sidebar-badge\" id=\"sidebar-inbox-badge\" hidden></span>") @* icon:chat *@
        @Row("/dashboard/contacts", "group", T["nav.contacts"].Value, IsActive("/dashboard/contacts")) @* icon:group *@
        @Row("/dashboard/bookings", "calendar_month", T["nav.bookings"].Value, IsActive("/dashboard/bookings")) @* icon:calendar_month *@

        <div class="au-side-section">@T["nav.section.marketing"]</div>
        @Row("/Campaigns", "campaign", T["nav.campaigns"].Value, IsActive("/Campaigns")) @* icon:campaign *@
        @Row("/WhatsApp/Templates", "description", T["nav.whatsAppTemplates"].Value, IsActive("/WhatsApp/Templates")) @* icon:description *@
        @Row("/WhatsApp/Health", "monitor_heart", T["nav.whatsAppHealth"].Value, IsActive("/WhatsApp/Health")) @* icon:monitor_heart *@

        <div class="au-side-section">@T["nav.section.setup"]</div>
        @Row("/Services", "medical_services", T["nav.services"].Value, IsActive("/Services")) @* icon:medical_services *@
        @Row("/KnowledgeBase", "menu_book", T["nav.knowledgeBase"].Value, IsActive("/KnowledgeBase")) @* icon:menu_book *@

        <div class="au-side-section">@T["nav.section.settings"]</div>
        @Row("/settings/business-info", "apartment", T["nav.businessInfo"].Value, IsActive("/settings/business-info")) @* icon:apartment *@
        @Row("/Members", "badge", T["nav.members"].Value, IsActive("/Members")) @* icon:badge *@
        @Row("/settings/integrations", "hub", T["nav.integrations"].Value, IsActive("/settings/integrations")) @* icon:hub *@
        @Row("/settings/calendar-integrations", "event_available", T["nav.calendarIntegrations"].Value, IsActive("/settings/calendar-integrations")) @* icon:event_available *@
        @if (Settings.BillingEnabled)
        {
            @Row("/settings/billing", "credit_card", T["nav.billing"].Value, IsActive("/settings/billing")) @* icon:credit_card *@
        }
    </div>
</nav>
