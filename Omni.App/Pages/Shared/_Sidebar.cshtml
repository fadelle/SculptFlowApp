@inject ICurrentClientContext CurrentClient
@inject IConfigManager Settings
@inject Omni.App.Business.Contracts.Services.Billing.IEntitlementService Entitlements
@inject Omni.App.Business.Contracts.Services.Channels.IChannelIntegrationService Channels
@* The dark sidebar (docs/UI_GUIDE.md §5, §0.4): brand + client name, then the four groups of links in their old order.
   #sidebar-inbox-badge is filled by sidebar.js / inbox.js. *@
@{
    var clientName = (await CurrentClient.GetClientAsync())?.Name;
    var path = Context.Request.Path.Value ?? "";
    bool IsActive(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase)
        || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    var dashboardActive = IsActive("/dashboard") && !IsActive("/dashboard/contacts") && !IsActive("/dashboard/bookings");
    // Links follow the client's plan (every feature is on while billing is off): a module the plan doesn't include is hidden,
    // and its pages say so if opened directly (RequirePlanFeature, _BookingsNotIncluded, the Reports page).
    var clientId = await CurrentClient.GetClientIdAsync();
    var plan = clientId is null ? null : await Entitlements.GetAsync(clientId.Value);
    var bookingsIncluded = plan is null || plan.CanUseBookings;
    var aiIncluded = plan is null || plan.CanUseAiAssistant;
    var campaignsIncluded = plan is null || plan.CanUseCampaigns;
    // Services feed bookings and the AI assistant's answers.
    var servicesIncluded = bookingsIncluded || aiIncluded;
    // Reports need the plan's reporting feature; the link says whether they are basic or advanced.
    var reportsIncluded = plan is null || plan.CanUseReporting;
    // No tag while billing is off (no plans then).
    string? reportsLevel = plan is not { BillingEnabled: true } ? null
        : plan.CanUseAdvancedReporting ? T["nav.reportsLevel.advanced"].Value : T["nav.reportsLevel.basic"].Value;
    // Channel pages show once that channel is connected (RequireConnectedChannel guards the pages the same way).
    IReadOnlySet<string> connected = clientId is null ? new HashSet<string>() : await Channels.ListConnectedChannelsAsync(clientId.Value);
    var whatsAppConnected = connected.Contains(ChannelType.WhatsApp);
}
@functions {
    // One nav row; the label doubles as the tooltip when the sidebar is collapsed to icons.
    private static Microsoft.AspNetCore.Html.IHtmlContent Row(string href, string icon, string label, bool active, string? extra = null)
    {
        var current = active ? " is-active\" aria-current=\"page" : "";
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<div class=\"au-nav-row\"><a class=\"au-nav-item{current}\" href=\"{enc.Encode(href)}\" title=\"{enc.Encode(label)}\">"
            + $"<span class=\"au-icon\" aria-hidden=\"true\">{icon}</span><span class=\"au-nav-item__label\">{enc.Encode(label)}</span>{extra}</a></div>");
    }
}
<nav class="au-sidebar" aria-label="@T["nav.label"]">
    <a class="au-brand" href="/dashboard">
        <span class="au-brand__mark"><img class="au-brand__logo" src="~/logo.svg" alt="" width="38" height="38" /></span>
        <span class="au-brand__text">
            <span class="au-brand__name">Omni</span>
            <span class="au-brand__sub" title="@clientName">@(string.IsNullOrWhiteSpace(clientName) ? T["nav.brandSub"].Value : clientName)</span>
        </span>
    </a>
    <div class="au-side-rule"></div>
    <div class="au-side-scroll">
        <div class="au-side-section">@T["nav.section.daily"]</div>
        @Row("/dashboard", "space_dashboard", T["nav.dashboard"].Value, dashboardActive) @* icon:space_dashboard *@
        @Row("/inbox", "chat", T["nav.inbox"].Value, IsActive("/inbox"),
            "<span class=\"au-nav-count sidebar-badge\" id=\"sidebar-inbox-badge\" hidden></span>") @* icon:chat *@
        @Row("/dashboard/contacts", "group", T["nav.contacts"].Value, IsActive("/dashboard/contacts")) @* icon:group *@
        @if (bookingsIncluded)
        {
            @Row("/dashboard/bookings", "calendar_month", T["nav.bookings"].Value, IsActive("/dashboard/bookings")) @* icon:calendar_month *@
        }
        @if (reportsIncluded)
        {
            @Row("/reports", "insights", T["nav.reports"].Value, IsActive("/reports"),
                reportsLevel is null ? null : $"<span class=\"au-nav-tag\">{System.Text.Encodings.Web.HtmlEncoder.Default.Encode(reportsLevel)}</span>") @* icon:insights *@
        }

        @if (campaignsIncluded)
        {
            <div class="au-side-section">@T["nav.section.marketing"]</div>
            @Row("/Campaigns", "campaign", T["nav.campaigns"].Value, IsActive("/Campaigns")) @* icon:campaign *@
        }

        @* One expandable group per connected channel that has pages of its own (WhatsApp today); a new channel page goes in
           its channel's group, a new channel gets a group like this one. Open while one of its pages is showing. *@
        @if (whatsAppConnected)
        {
            var whatsAppOpen = IsActive("/WhatsApp");
            <div class="au-side-section">@T["nav.section.channels"]</div>
            <details class="au-nav-group au-nav-group--nested" open="@whatsAppOpen">
                <summary title="@ChannelNames.Brand(ChannelType.WhatsApp)">
                    <span class="nav-channel-mark" style="background:@ChannelIconHelper.Hex(ChannelType.WhatsApp)" aria-hidden="true">@Html.Raw(ChannelIconHelper.BrandSvg(ChannelType.WhatsApp) ?? ChannelIconHelper.Initials(ChannelType.WhatsApp))</span>
                    <span class="au-nav-item__label">@ChannelNames.Brand(ChannelType.WhatsApp)</span>
                    <span class="au-icon au-nav-chevron" aria-hidden="true">expand_more</span>
                </summary>
                <div class="au-nav-children">
                    @Row("/WhatsApp/Templates", "description", T["nav.channel.templates"].Value, IsActive("/WhatsApp/Templates")) @* icon:description *@
                    @Row("/WhatsApp/Health", "monitor_heart", T["nav.channel.health"].Value, IsActive("/WhatsApp/Health")) @* icon:monitor_heart *@
                </div>
            </details>
        }

        @if (servicesIncluded)
        {
            <div class="au-side-section">@T["nav.section.setup"]</div>
            @Row("/Services", "medical_services", T["nav.services"].Value, IsActive("/Services")) @* icon:medical_services *@
            @if (aiIncluded)
            {
                @Row("/KnowledgeBase", "menu_book", T["nav.knowledgeBase"].Value, IsActive("/KnowledgeBase")) @* icon:menu_book *@
                @Row("/Bots", "smart_toy", T["nav.bots"].Value, IsActive("/Bots")) @* icon:smart_toy *@
            }
        }

        <div class="au-side-section">@T["nav.section.settings"]</div>
        @Row("/settings/business-info", "apartment", T["nav.businessInfo"].Value, IsActive("/settings/business-info")) @* icon:apartment *@
        @Row("/Members", "badge", T["nav.members"].Value, IsActive("/Members")) @* icon:badge *@
        @Row("/settings/integrations", "hub", T["nav.integrations"].Value, IsActive("/settings/integrations")) @* icon:hub *@
        @if (aiIncluded)
        {
            @Row("/settings/inbox", "tune", T["nav.inboxSettings"].Value, IsActive("/settings/inbox")) @* icon:tune *@
        }
        @Row("/settings/auto-respond", "quickreply", T["nav.autoRespond"].Value, IsActive("/settings/auto-respond")) @* icon:quickreply *@
        @if (bookingsIncluded)
        {
            @Row("/settings/calendar-integrations", "event_available", T["nav.calendarIntegrations"].Value, IsActive("/settings/calendar-integrations")) @* icon:event_available *@
            @Row("/settings/reminders", "schedule", T["nav.reminders"].Value, IsActive("/settings/reminders")) @* icon:schedule *@
        }
        @if (Settings.BillingEnabled)
        {
            @Row("/settings/billing", "credit_card", T["nav.billing"].Value, IsActive("/settings/billing")) @* icon:credit_card *@
        }
    </div>
</nav>
