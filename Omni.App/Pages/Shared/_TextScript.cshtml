@* UI strings for page scripts (wwwroot/js/omni-text.js): the request's language, its locale tag and direction, the
   client's business-type words and the review-mode switch inline, the language's strings from /i18n/{lang}.js (cached by its hash). In <head>, because page scripts may call
   window.omniText while loading. *@
@inject ITextContext TextContext
@inject ITextCatalog TextCatalog
<script>window.omniTextConfig = @Json.Serialize(new { lang = TextContext.Language, locale = AppLanguage.BrowserLocale(TextContext.Language), dir = TextContext.Direction, terms = TextContext.Terms, showKeys = TextContext.ShowKeys });</script>
<script src="/i18n/@(TextContext.Language).js?v=@TextCatalog.Version(TextContext.Language)"></script>
<script src="~/js/omni-text.js" asp-append-version="true"></script>
