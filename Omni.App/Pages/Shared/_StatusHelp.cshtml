@model IReadOnlyList<Omni.App.Entities.Dtos.BusinessTypes.PipelineStageOption>
@* Reusable "what do these mean?" reference — included on the Contact edit page and the Campaign creation page (the two
   places members pick stages, qualifications and sources). The stage list is the client's own pipeline (the model), each
   explained by its category; the other sections are static. *@
@{
    var categoryHelp = new Dictionary<string, string>
    {
        [StageCategory.Open] = T["stages.help.open"],
        [StageCategory.Booked] = T["stages.help.booked"],
        [StageCategory.Attended] = T["stages.help.attended"],
        [StageCategory.NoShow] = T["stages.help.noShow"],
        [StageCategory.Converted] = T["stages.help.converted"],
        [StageCategory.ClosedLost] = T["stages.help.closedLost"],
        [StageCategory.NeedsHuman] = T["stages.help.needsHuman"],
    };
}
<div id="status-help-overlay" class="status-help-overlay" hidden>
    <div class="status-help-card card" role="dialog" aria-modal="true" aria-labelledby="status-help-title">
        <div class="status-help-header">
            <h3 id="status-help-title">@T["statusHelp.title"]</h3>
            <button type="button" class="au-icon-btn" id="status-help-close" aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
        </div>

        <section class="status-help-section">
            <h4>@T["stages.help.title"]</h4>
            <p class="text-subtle">@T["stages.help.intro"]</p>
            <dl>
                @foreach (var stage in Model)
                {
                    <dt>@stage.Label</dt><dd>@(categoryHelp.TryGetValue(stage.Category, out var help) ? help : "")</dd>
                }
            </dl>
        </section>

        <section class="status-help-section">
            <h4>@T["statusHelp.qualification.title"]</h4>
            <p class="text-subtle">@T["statusHelp.qualification.intro"]</p>
            <dl>
                <dt>@T["statusHelp.qualification.unknown"]</dt><dd>@T["statusHelp.qualification.unknownHelp"]</dd>
                <dt>@T["statusHelp.qualification.hot"]</dt><dd>@T["statusHelp.qualification.hotHelp"]</dd>
                <dt>@T["statusHelp.qualification.warm"]</dt><dd>@T["statusHelp.qualification.warmHelp"]</dd>
                <dt>@T["statusHelp.qualification.cold"]</dt><dd>@T["statusHelp.qualification.coldHelp"]</dd>
                <dt>@T["statusHelp.qualification.needsHuman"]</dt><dd>@T["statusHelp.qualification.needsHumanHelp"]</dd>
                <dt>@T["statusHelp.qualification.spam"]</dt><dd>@T["statusHelp.qualification.spamHelp"]</dd>
            </dl>
        </section>

        <section class="status-help-section">
            <h4>@T["statusHelp.source.title"]</h4>
            <p class="text-subtle">@T["statusHelp.source.intro", "facebook, instagram, google, website, referral, whatsapp"]</p>
        </section>

        <section class="status-help-section">
            <h4>@T["statusHelp.booking.title"]</h4>
            <p class="text-subtle">@T["statusHelp.booking.intro"]</p>
            <dl>
                <dt>@T["statusHelp.booking.booked"]</dt><dd>@T["statusHelp.booking.bookedHelp"]</dd>
                <dt>@T["statusHelp.booking.confirmed"]</dt><dd>@T["statusHelp.booking.confirmedHelp"]</dd>
                <dt>@T["statusHelp.booking.attended"]</dt><dd>@T["statusHelp.booking.attendedHelp"]</dd>
                <dt>@T["statusHelp.booking.noShow"]</dt><dd>@T["statusHelp.booking.noShowHelp"]</dd>
                <dt>@T["statusHelp.booking.canceled"]</dt><dd>@T["statusHelp.booking.canceledHelp"]</dd>
                <dt>@T["statusHelp.booking.rescheduled"]</dt><dd>@T["statusHelp.booking.rescheduledHelp"]</dd>
            </dl>
            <p class="text-subtle"><strong>@T["statusHelp.booking.reactivationTitle"]</strong> @T["statusHelp.booking.reactivationText"]</p>
        </section>
    </div>
</div>
