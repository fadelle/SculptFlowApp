@model IReadOnlyList<Omni.App.Entities.Dtos.BusinessTypes.PipelineStageOption>
@* Reusable "what do these mean?" reference — included on the Contact edit page and the Campaign creation page (the two
   places staff pick stages, qualifications and sources). The stage list is the client's own pipeline (the model), each
   explained by its category; the other sections are static. *@
@{
    var categoryHelp = new Dictionary<string, string>
    {
        [StageCategory.Open] = T["stages.help.open"],
        [StageCategory.Booked] = T["stages.help.booked"],
        [StageCategory.Attended] = T["stages.help.attended"],
        [StageCategory.NoShow] = T["stages.help.noShow"],
        [StageCategory.Converted] = T["stages.help.converted"],
        [StageCategory.ClosedLost] = T["stages.help.closedLost"],
        [StageCategory.NeedsHuman] = T["stages.help.needsHuman"],
    };
}
<div id="status-help-overlay" class="status-help-overlay" hidden>
    <div class="status-help-card card" role="dialog" aria-modal="true" aria-labelledby="status-help-title">
        <div class="status-help-header">
            <h3 id="status-help-title">What do these mean?</h3>
            <button type="button" class="au-icon-btn" id="status-help-close" aria-label="Close" title="Close"><span class="au-icon" aria-hidden="true">close</span></button>
        </div>

        <section class="status-help-section">
            <h4>@T["stages.help.title"]</h4>
            <p class="text-subtle">@T["stages.help.intro"]</p>
            <dl>
                @foreach (var stage in Model)
                {
                    <dt>@stage.Label</dt><dd>@(categoryHelp.TryGetValue(stage.Category, out var help) ? help : "")</dd>
                }
            </dl>
        </section>

        <section class="status-help-section">
            <h4>Qualification status</h4>
            <p class="text-subtle">How promising this contact looks — set by the AI during conversation, or by staff directly.</p>
            <dl>
                <dt>Unknown</dt><dd>Not yet assessed.</dd>
                <dt>Hot</dt><dd>High intent — likely to book soon.</dd>
                <dt>Warm</dt><dd>Interested, but not urgent.</dd>
                <dt>Cold</dt><dd>Low intent — unlikely to convert soon.</dd>
                <dt>Needs human review</dt><dd>The AI couldn't confidently qualify this contact — flagged for staff.</dd>
                <dt>Spam</dt><dd>Not a genuine contact.</dd>
            </dl>
        </section>

        <section class="status-help-section">
            <h4>Contact source</h4>
            <p class="text-subtle">
                Where the contact came from. There's no fixed list — it's free text, so it grows to match
                however your client actually acquires contacts (e.g. <em>facebook</em>, <em>instagram</em>,
                <em>google</em>, <em>website</em>, <em>referral</em>, <em>whatsapp</em>, or anything else
                via "Other…"). Used to filter campaigns by acquisition channel.
            </p>
        </section>

        <section class="status-help-section">
            <h4>Booking status</h4>
            <p class="text-subtle">The state of one specific booking.</p>
            <dl>
                <dt>Booked</dt><dd>A booking time has been scheduled.</dd>
                <dt>Confirmed</dt><dd>The client or contact has confirmed they'll attend.</dd>
                <dt>Attended</dt><dd>The booking took place.</dd>
                <dt>No-show</dt><dd>They didn't show up.</dd>
                <dt>Canceled</dt><dd>The booking was canceled.</dd>
                <dt>Rescheduled</dt><dd>The booking time was moved to a new date/time.</dd>
            </dl>
            <p class="text-subtle">
                <strong>Matters for "Old contacts who never booked":</strong> Booked, Confirmed, Rescheduled,
                or Attended means the contact has a real booking on record, so they stop matching that
                reactivation audience. Canceled and No-show don't count as a successful booking — those
                contacts stay eligible for reactivation.
            </p>
        </section>
    </div>
</div>
