@page "/WhatsApp/Health"
@model Omni.App.Pages.WhatsApp.Health.IndexModel
@{
    ViewData["Title"] = T["nav.whatsAppHealth"].Value;
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts

    // ---- Presentation only: plain-language wording for Meta's raw values ----
    (string Level, string Label, string Css, string Explain)? Quality(string? rating) => (rating ?? "").ToUpperInvariant() switch
    {
        "GREEN" or "HIGH" => ("high", T["whatsAppHealth.quality.high"].Value, "q-green", T["whatsAppHealth.quality.highHelp"].Value),
        "YELLOW" or "MEDIUM" => ("medium", T["whatsAppHealth.quality.medium"].Value, "q-yellow", T["whatsAppHealth.quality.mediumHelp"].Value),
        "RED" or "LOW" => ("low", T["whatsAppHealth.quality.low"].Value, "q-red", T["whatsAppHealth.quality.lowHelp"].Value),
        _ => null
    };
    string Nice(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : T.ValueLabel(value.ToLowerInvariant());
    // Material Symbols names (docs/tools/icon-font.js reads the icon:… notes).
    (string Icon, string Label) EventKind(string type) => type switch
    {
        WhatsAppHealthEventType.PhoneNumberQualityUpdate => ("star", T["whatsAppHealth.event.quality"].Value), @* icon:star *@
        WhatsAppHealthEventType.PhoneNumberNameUpdate => ("edit", T["whatsAppHealth.event.name"].Value), @* icon:edit *@
        WhatsAppHealthEventType.AccountUpdate => ("account_circle", T["whatsAppHealth.event.account"].Value), @* icon:account_circle *@
        WhatsAppHealthEventType.AccountReviewUpdate => ("verified", T["whatsAppHealth.event.review"].Value), @* icon:verified *@
        WhatsAppHealthEventType.ConnectionUpdate => ("sync_alt", T["whatsAppHealth.event.connection"].Value), @* icon:sync_alt *@
        WhatsAppHealthEventType.TemplateProblem => ("description", T["whatsAppHealth.event.template"].Value), @* icon:description *@
        WhatsAppHealthEventType.WebhookProblem => ("warning", T["whatsAppHealth.event.webhook"].Value), @* icon:warning *@
        _ => ("circle", T["whatsAppHealth.event.other"].Value) @* icon:circle *@
    };
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else if (Model.Health is null)
{
    var notConnected = new EmptyStateModel(Icon: "phone_iphone", Title: T["whatsAppHealth.notConnected.title"].Value,
        Text: T["whatsAppHealth.notConnected.text"].Value,
        ActionLabel: T["whatsAppHealth.notConnected.action"].Value, ActionHref: "/settings/integrations", ActionIcon: "link");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="notConnected" /></div>
}
else
{
    var h = Model.Health;
    var quality = Quality(h.PhoneQualityRating);
    var accountBad = h.AccountStatus is not null && new[] { "disabled", "banned", "restricted" }.Contains(h.AccountStatus.ToLowerInvariant());
    var reviewRejected = string.Equals(h.AccountReviewStatus, "rejected", StringComparison.OrdinalIgnoreCase);

    // Banner: what the health level means for the client, and what to do about it (from the same fields the
    // server used to compute HealthLevel — see WhatsAppHealthService.RecomputeHealth).
    var (heroCss, heroIcon, heroTitle, heroText, heroTodo) = h.HealthLevel switch
    {
        WhatsAppHealthLevel.Healthy => ("ok", "check_circle", T["whatsAppHealth.hero.healthyTitle"].Value, T["whatsAppHealth.hero.healthyText"].Value, (string?)null),
        WhatsAppHealthLevel.Warning => ("warn", "warning", T["whatsAppHealth.hero.warningTitle"].Value,
            quality?.Level == "medium" ? T["whatsAppHealth.hero.mediumText"].Value
                : T["whatsAppHealth.hero.phoneStatusText", Nice(h.PhoneStatus)].Value,
            quality?.Level == "medium" ? T["whatsAppHealth.hero.mediumTodo"].Value
                : T["whatsAppHealth.hero.phoneStatusTodo"].Value),
        WhatsAppHealthLevel.Problem => ("bad", "error", T["whatsAppHealth.hero.problemTitle"].Value,
            accountBad ? T["whatsAppHealth.hero.accountText", Nice(h.AccountStatus)].Value
                : reviewRejected ? T["whatsAppHealth.hero.reviewText"].Value
                : T["whatsAppHealth.hero.lowText"].Value,
            T["whatsAppHealth.hero.problemTodo"].Value),
        WhatsAppHealthLevel.Disconnected => ("off", "link_off", T["dashboard.whatsApp.notConnected"].Value, T["whatsAppHealth.hero.disconnectedText"].Value, T["whatsAppHealth.hero.disconnectedTodo"].Value),
        _ => ("off", "help", T["whatsAppHealth.hero.unknownTitle"].Value, T["whatsAppHealth.hero.unknownText"].Value, (string?)null)
    };
    var lastHeardLong = h.LastWebhookAt is null || DateTimeOffset.UtcNow - h.LastWebhookAt.Value > TimeSpan.FromHours(24);
    var problemEvents = Model.Events.Count(e => e.Severity is not null && e.Severity != WhatsAppHealthEventSeverity.Info);

    @* whatsapp-health.js writes "Updated just now: …" here after a live update. *@
    <div class="alert alert-info mb-2" id="health-live-note" hidden></div>
    @* Icons used by the banner above: *@ @* icon:link_off *@ @* icon:help *@

    <div id="whatsapp-health-card" data-level="@h.HealthLevel" data-quality="@h.PhoneQualityRating" data-account="@h.AccountStatus" data-review="@h.AccountReviewStatus">
        <div class="hero hero-@heroCss">
            <div class="hero-icon" aria-hidden="true"><span class="au-icon">@heroIcon</span></div>
            <div class="flex-1">
                <div class="hero-title" id="health-status-badge">@heroTitle</div>
                <div class="hero-text">@heroText</div>
                @if (heroTodo is not null)
                {
                    <div class="hero-todo"><strong>@T["whatsAppHealth.hero.todo"]</strong> @heroTodo</div>
                }
            </div>
            @if (h.HealthLevel == WhatsAppHealthLevel.Disconnected)
            {
                <a href="/settings/integrations" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">link</span>@T["whatsAppHealth.reconnect"]</a>
            }
        </div>

        <div class="facts">
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">@T["whatsAppHealth.phone.title"]</div>
                <div class="fact-main" id="health-phone"><span dir="ltr">@(h.DisplayPhoneNumber ?? "—")</span></div>
                <div class="cell-sub">
                    @if (!string.IsNullOrWhiteSpace(h.VerifiedName))
                    {
                        @T.Html("whatsAppHealth.phone.shownAs", new Microsoft.AspNetCore.Html.HtmlString($"<strong id=\"health-verified-name\">{System.Net.WebUtility.HtmlEncode(h.VerifiedName)}</strong>"))
                        @if (!string.IsNullOrWhiteSpace(h.NameStatus))
                        {
                            <span class="badge @(string.Equals(h.NameStatus, "approved", StringComparison.OrdinalIgnoreCase) ? "badge-green" : "badge-amber")">@T["whatsAppHealth.phone.nameStatus", Nice(h.NameStatus)]</span>
                        }
                    }
                    else
                    {
                        @T["whatsAppHealth.phone.noName"]
                    }
                </div>
            </div>
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">@T["whatsAppHealth.quality.title"]</div>
                <div class="fact-main" id="health-quality">
                    @if (quality is not null)
                    {
                        <span class="q-dot @quality.Value.Css"></span>@quality.Value.Label
                    }
                    else
                    {
                        @:—
                    }
                </div>
                <div class="cell-sub">@(quality?.Explain ?? T["whatsAppHealth.quality.none"].Value)</div>
            </div>
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">@T["whatsAppHealth.account.title"]</div>
                <div class="fact-main" id="health-account">@Nice(h.AccountStatus)</div>
                <div class="cell-sub" id="health-review">@(h.AccountReviewStatus is null ? "" : T["whatsAppHealth.account.review", Nice(h.AccountReviewStatus)].Value)</div>
            </div>
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">@T["whatsAppHealth.lastHeard.title"]</div>
                <div class="fact-main" id="health-last-webhook" data-timestamp="@(h.LastWebhookAt?.ToString("O"))">
                    @if (h.LastWebhookAt is { } lastWebhook) { @LocalTimeHelper.Ago(T, lastWebhook) } else { @T["members.lastSignIn.never"] }
                </div>
                <div class="cell-sub">
                    @LocalTimeHelper.Time(h.LastWebhookAt, empty: "")
                    @if (lastHeardLong)
                    {
                        <span class="text-warn">· @T["whatsAppHealth.lastHeard.long"]</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="section-head">
        <h2 class="section-title">@T["whatsAppHealth.activity.title"]</h2>
        @if (Model.Events.Count > 0)
        {
            <div class="inbox-filters" id="health-tabs" role="tablist" aria-label="@T["whatsAppHealth.activity.show"]">
                <button type="button" class="inbox-filter active" data-tab="all">@T["campaigns.tabs.all"] <span class="inbox-filter-count">@Model.Events.Count</span></button>
                <button type="button" class="inbox-filter" data-tab="problem">@T["whatsAppHealth.activity.problems"] <span class="inbox-filter-count">@problemEvents</span></button>
            </div>
        }
    </div>

    @if (Model.Events.Count == 0)
    {
        var quiet = new EmptyStateModel(Icon: "notifications_none", Title: T["whatsAppHealth.activity.emptyTitle"].Value,
            Text: T["whatsAppHealth.activity.emptyText"].Value);
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="quiet" /></div>
    }
    else
    {
        <div class="au-panel au-panel--round timeline" id="whatsapp-health-events">
            @foreach (var e in Model.Events)
            {
                var kind = EventKind(e.EventType);
                var sev = e.Severity ?? WhatsAppHealthEventSeverity.Info;
                <div class="tl-row" data-problem="@(sev != WhatsAppHealthEventSeverity.Info ? "1" : "0")">
                    <span class="tl-icon sev-@sev" aria-hidden="true"><span class="au-icon au-icon--sm">@kind.Icon</span></span>
                    <div class="flex-1">
                        <div class="tl-title">@(e.Message ?? T["whatsAppHealth.event.update", kind.Label].Value)</div>
                        <div class="cell-sub">@kind.Label@(e.Status is null ? "" : " · " + Nice(e.Status))</div>
                    </div>
                    <div class="cell-sub" @LocalTimeHelper.Title(e.OccurredAt)>@LocalTimeHelper.Time(e.OccurredAt)</div>
                </div>
            }
            <div class="tl-row tl-empty" id="health-tab-empty" hidden><span class="text-subtle">@T["whatsAppHealth.activity.noProblems"]</span></div>
        </div>
    }

    <details class="au-panel au-panel--round tech mt-3">
        <summary>@T["messages.error.details"]</summary>
        <div class="inbox-contact-info-row"><span>@T["whatsAppHealth.tech.waba"]</span><strong id="health-waba" dir="ltr">@(h.WabaId ?? "—")</strong></div>
        <div class="inbox-contact-info-row"><span>@T["whatsAppHealth.tech.phoneStatus"]</span><strong>@(h.PhoneStatus ?? "—")</strong></div>
        <div class="inbox-contact-info-row"><span>@T["whatsAppHealth.tech.account"]</span><strong>@(h.AccountStatus ?? "—") / @(h.AccountReviewStatus ?? "—")</strong></div>
        <div class="inbox-contact-info-row"><span>@T["whatsAppHealth.tech.quality"]</span><strong>@(h.PhoneQualityRating ?? "—")</strong></div>
        <div class="inbox-contact-info-row"><span>@T["whatsAppHealth.tech.lastProblem"]</span><strong id="health-last-problem">@(h.LastProblemCode is null && h.LastProblemMessage is null ? T["whatsAppHealth.tech.none"].Value : $"{h.LastProblemCode} {h.LastProblemMessage}".Trim())</strong></div>
    </details>

    <script>
        (function () {
            var tabs = document.querySelectorAll('#health-tabs [data-tab]');
            var rows = document.querySelectorAll('#whatsapp-health-events .tl-row[data-problem]');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var problemsOnly = tab.getAttribute('data-tab') === 'problem';
                    var shown = 0;
                    tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
                    rows.forEach(function (r) {
                        var show = !problemsOnly || r.getAttribute('data-problem') === '1';
                        r.hidden = !show;
                        if (show) shown++;
                    });
                    document.getElementById('health-tab-empty').hidden = shown > 0;
                });
            });
        })();
    </script>

    <script>
        window.PS_WHATSAPP_HEALTH_CONFIG = {
            clientId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClientId.ToString())),
            hubUrl: '/hubs/inbox'
        };
    </script>
    <script src="~/js/whatsapp-health.js" asp-append-version="true"></script>
}
