@page "/WhatsApp/Templates"
@model Omni.App.Pages.WhatsApp.Templates.IndexModel
@{
    ViewData["Title"] = T["nav.whatsAppTemplates"].Value;
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts

    // Presentation only.
    static string Group(string status) => status switch
    {
        WhatsAppTemplateStatus.Approved => "approved",
        WhatsAppTemplateStatus.Pending => "review",
        _ => "attention"
    };
    (string Label, string Css) Quality(string? rating) => (rating ?? "").ToUpperInvariant() switch
    {
        "GREEN" or "HIGH" => (T["whatsAppHealth.quality.high"].Value, "q-green"),
        "YELLOW" or "MEDIUM" => (T["whatsAppHealth.quality.medium"].Value, "q-yellow"),
        "RED" or "LOW" => (T["whatsAppHealth.quality.low"].Value, "q-red"),
        _ => ("", "")
    };
    string LanguageName(string code) => code switch
    {
        "en_US" => T["templates.lang.enUs"].Value, "en_GB" => T["templates.lang.enGb"].Value, "en" => T["templates.lang.en"].Value,
        "ar" => T["templates.lang.ar"].Value, "fr" => T["templates.lang.fr"].Value, "es" => T["templates.lang.es"].Value,
        "de" => T["templates.lang.de"].Value, "tr" => T["templates.lang.tr"].Value,
        _ => code
    };
    // Why a template needs attention, in plain words.
    string? Why(WhatsAppTemplateResponse t) =>
        !string.IsNullOrWhiteSpace(t.RejectionReason) ? t.RejectionReason
        : t.Status is WhatsAppTemplateStatus.Paused or WhatsAppTemplateStatus.Disabled ? T["templates.why.stopped"].Value
        : Group(t.Status) == "attention" && t.Status != WhatsAppTemplateStatus.Rejected && t.Status != WhatsAppTemplateStatus.Draft ? T["templates.why.flagged"].Value
        : null;
    var languages = new[] { "en_US", "en_GB", "ar", "fr", "es", "de", "tr" };
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    @* A failed "new template" shows its error inside the reopened popup instead of up here. *@
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ReopenNewTemplate ? null : Model.ErrorMessage)" />

    <div class="au-page-head">
        <p class="au-page-head__sub">
            @T["templates.intro"]
            <span class="info-tip info-inline" tabindex="0" role="button" aria-describedby="templates-tip">
                @T["templates.what.title"]
                <span class="au-icon au-icon--sm" aria-hidden="true">info</span>
                <span class="info-tip-box" role="tooltip" id="templates-tip">
                    @T["templates.what.text"]
                </span>
            </span>
        </p>
        <div class="au-page-head__actions">
            <button type="button" class="au-btn au-btn--primary" id="new-template-btn"><span class="au-icon" aria-hidden="true">add</span>@T["templates.new"]</button>
        </div>
    </div>

    @if (Model.Templates.Count == 0)
    {
        <div class="au-panel au-panel--round">
            <div class="au-empty">
                <span class="au-empty__icon"><span class="au-icon" aria-hidden="true">description</span></span>
                <div class="empty-title">@T["templates.empty.title"]</div>
                <p class="empty-text">@T["templates.empty.text"]</p>
                <button type="button" class="au-btn au-btn--primary" data-open-new-template><span class="au-icon" aria-hidden="true">add</span>@T["templates.new"]</button>
            </div>
        </div>
    }
    else
    {
        var groups = Model.Templates.GroupBy(t => Group(t.Status)).ToDictionary(g => g.Key, g => g.Count());
        @* Read by wwwroot/js/templates-page.js and whatsapp-templates.js: #template-tabs, #tpl-split, #templates-tbody, the
           row's data-* and [data-role] cells, its 2nd cell (category · language) and .row-actions (copied into the side
           panel). Keep the column order. *@
        <div class="inbox-filters mb-2" id="template-tabs" role="tablist" aria-label="@T["templates.tabs.label"]">
            <button type="button" class="inbox-filter active" data-tab="all">@T["campaigns.tabs.all"] <span class="inbox-filter-count">@Model.Templates.Count</span></button>
            <button type="button" class="inbox-filter" data-tab="approved">@T["values.approved"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("approved"))</span></button>
            <button type="button" class="inbox-filter" data-tab="review">@T["templates.tabs.review"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("review"))</span></button>
            <button type="button" class="inbox-filter" data-tab="attention">@T["whatsAppHealth.hero.warningTitle"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("attention"))</span></button>
        </div>

        <div class="tpl-split" id="tpl-split">
            <div class="au-table-card">
                <div class="au-table-scroll">
                    <table class="au-table au-table--stack" id="templates-table">
                        <thead>
                            <tr>
                                <th>@T["templates.table.template"]</th>
                                <th>@T["templates.table.categoryLanguage"]</th>
                                <th>@T["services.table.status"]</th>
                                <th>@T["templates.table.quality"]</th>
                                <th>@T["templates.table.message"]</th>
                                <th>@T["knowledge.table.updated"]</th>
                                <th><span class="au-sr-only">@T["services.table.actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody id="templates-tbody">
                            @foreach (var t in Model.Templates)
                            {
                                var q = Quality(t.QualityRating);
                                var why = Why(t);
                                <tr class="row-link" data-template-id="@t.Id" data-group="@Group(t.Status)"
                                    data-name="@t.Name" data-body="@t.Body" data-header="@(t.HeaderType == WhatsAppTemplateHeaderType.Text ? t.HeaderContent : "")"
                                    data-header-type="@(t.HeaderType ?? "none")" data-footer="@t.Footer" data-lang="@t.Language"
                                    data-meta="@(string.IsNullOrEmpty(t.MetaTemplateId) ? "" : "1")">
                                    <td data-label="@T["templates.table.template"]"><strong dir="ltr">@t.Name</strong></td>
                                    <td data-label="@T["knowledge.table.category"]" class="text-md"><div>@T.ValueLabel(t.Category)<div class="cell-sub">@LanguageName(t.Language)</div></div></td>
                                    <td data-label="@T["services.table.status"]" class="au-wrap">
                                        <div>
                                            <span class="badge @StatusBadgeHelper.TemplateStatusCssClass(t.Status)" data-role="status">@T.TemplateStatusLabel(t.Status)</span>
                                            <div class="cell-err" data-role="reason" hidden="@(why is null)">@why</div>
                                        </div>
                                    </td>
                                    <td data-label="@T["templates.table.quality"]" class="text-md" data-role="quality">
                                        @if (q.Label.Length > 0)
                                        {
                                            <span class="q-dot @q.Css"></span>@q.Label
                                        }
                                        else
                                        {
                                            <span class="text-subtle">—</span>
                                        }
                                    </td>
                                    <td data-label="@T["templates.table.message"]" class="au-wrap"><div class="body-clip" dir="auto">@t.Body</div></td>
                                    <td data-label="@T["knowledge.table.updated"]" class="cell-sub" data-role="updated">@LocalTimeHelper.Time(t.LastMetaEventAt ?? t.UpdatedAt)</td>
                                    <td class="row-actions">
                                        @if (t.Status == WhatsAppTemplateStatus.Approved)
                                        {
                                            <a class="au-btn au-btn--outlined au-btn--sm" href="/Campaigns/Create?WhatsAppTemplateId=@t.Id">@T["templates.useInCampaign"]</a>
                                        }
                                        @if (!string.IsNullOrEmpty(t.MetaTemplateId))
                                        {
                                            <form method="post" asp-page-handler="Sync" class="inline-form">
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <button type="submit" class="au-btn au-btn--text au-btn--sm" title="@T["templates.sync.help"]"><span class="au-icon" aria-hidden="true">sync</span>@T["templates.sync.button"]</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Retry" class="inline-form">
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <button type="submit" class="au-btn au-btn--outlined au-btn--sm" title="@T["templates.retry.help"]">@T["templates.retry.button"]</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr class="empty-row" id="template-tab-empty" hidden><td colspan="7">@T["templates.tabs.empty"]</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @* Side panel: the full message as WhatsApp shows it (filled by templates-page.js from the row's data-* attributes). *@
            <aside class="au-panel au-panel--round tpl-side" id="tpl-side" hidden>
                <div class="modal-head">
                    <div class="min-w-0">
                        <h3 class="card-title" id="tpl-side-name"></h3>
                        <div class="cell-sub" id="tpl-side-meta"></div>
                    </div>
                    <button type="button" class="au-icon-btn" id="tpl-side-close" aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
                </div>
                <div class="wa-preview"><div class="wa-bubble" id="tpl-side-bubble" dir="auto"></div></div>
                <div class="inbox-contact-info-row mt-2"><span>@T["services.table.status"]</span><strong id="tpl-side-status"></strong></div>
                <div class="inbox-contact-info-row"><span>@T["templates.table.quality"]</span><strong id="tpl-side-quality"></strong></div>
                <div class="inbox-contact-info-row"><span>@T["templates.side.blanks"]</span><strong id="tpl-side-blanks"></strong></div>
                <div class="inbox-contact-info-row"><span>@T["campaigns.recipients.lastUpdate"]</span><strong id="tpl-side-updated"></strong></div>
                <div class="flex gap-2 mt-2 flex-wrap" id="tpl-side-actions"></div>
            </aside>
        </div>
    }

    @* ---------- New template (popup; ids read by templates-page.js) ---------- *@
    <div class="bm-overlay" id="new-template-overlay" hidden>
        <div class="card tpl-modal" role="dialog" aria-modal="true" aria-labelledby="new-template-title">
            <div class="modal-head">
                <h3 id="new-template-title" class="card-title">@T["templates.new"]</h3>
                <button type="button" class="au-icon-btn" id="new-template-close" aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            @if (Model.ReopenNewTemplate)
            {
                <partial name="_Messages" model="new PageMessagesModel(null, Model.ErrorMessage)" />
            }
            <form method="post" asp-page-handler="Create" id="new-template-form">
                <div class="tpl-form-grid">
                    <div class="integration-form">
                        <label class="field">
                            <span>@T["services.edit.name"]</span>
                            <input type="text" name="Name" id="tpl-name" value="@Model.Name" placeholder="@T["templates.form.namePlaceholder"]" class="text-input" required maxlength="512" autocomplete="off" />
                            <small class="hint-line">@T["templates.form.nameHelp"]</small>
                        </label>

                        <div class="field">
                            <span>@T["knowledge.table.category"]</span>
                            <div class="cat-grid">
                                @foreach (var (value, title, desc) in new[]
                                {
                                    (WhatsAppTemplateCategory.Utility, T["values.utility"].Value, T["templates.form.utilityHelp"].Value),
                                    (WhatsAppTemplateCategory.Marketing, T["values.marketing"].Value, T["templates.form.marketingHelp"].Value),
                                    (WhatsAppTemplateCategory.Authentication, T["values.authentication"].Value, T["templates.form.authenticationHelp"].Value),
                                })
                                {
                                    <label class="cat-card">
                                        <input type="radio" name="Category" value="@value" checked="@(value == Model.Category)" />
                                        <strong>@title</strong>
                                        <small>@desc</small>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="field">
                            <span>@T["templates.form.language"]</span>
                            <select class="select" id="tpl-lang-select" aria-label="@T["templates.form.language"]">
                                @foreach (var code in languages)
                                {
                                    <option value="@code" selected="@(code == Model.Language)">@LanguageName(code) (@code)</option>
                                }
                                <option value="__other" selected="@(!languages.Contains(Model.Language))">@T["contactDetail.update.otherSource"]</option>
                            </select>
                            <input type="text" name="Language" id="tpl-lang" value="@Model.Language" class="text-input mt-1" placeholder="@T["templates.form.languageCodePlaceholder"]" aria-label="@T["templates.form.languageCode"]" hidden="@(languages.Contains(Model.Language))" />
                        </div>

                        <div class="field">
                            <span>@T["templates.form.header"]</span>
                            <div class="seg" role="radiogroup" aria-label="@T["templates.form.headerType"]">
                                @foreach (var h in new[] { WhatsAppTemplateHeaderType.None, WhatsAppTemplateHeaderType.Text, WhatsAppTemplateHeaderType.Image, WhatsAppTemplateHeaderType.Video, WhatsAppTemplateHeaderType.Document })
                                {
                                    <label class="seg-opt"><input type="radio" name="HeaderType" value="@h" checked="@(h == Model.HeaderType)" /><span>@T.ValueLabel(h)</span></label>
                                }
                            </div>
                            <input type="text" name="HeaderContent" id="tpl-header" value="@Model.HeaderContent" class="text-input mt-1" placeholder="@T["templates.form.headerText"]" aria-label="@T["templates.form.headerText"]" maxlength="60" />
                            <small class="hint-line right" data-counter-for="tpl-header" data-max="60"></small>
                        </div>

                        <div class="field">
                            <span class="flex items-center justify-between">
                                @T["templates.table.message"]
                                <button type="button" class="link-btn" id="tpl-insert-blank">@T["templates.form.insertBlank"]</button>
                            </span>
                            <textarea name="Body" id="tpl-body" rows="4" class="text-input" required maxlength="1024" dir="auto" aria-label="@T["templates.table.message"]" placeholder="@T["templates.form.bodyPlaceholder", "{{1}}", "{{2}}"]">@Model.Body</textarea>
                            <small class="hint-line right" data-counter-for="tpl-body" data-max="1024"></small>
                        </div>

                        <label class="field">
                            <span>@T["templates.form.footer"] <span class="opt">@T["common.optional"]</span></span>
                            <input type="text" name="Footer" id="tpl-footer" value="@Model.Footer" class="text-input" maxlength="60" />
                            <small class="hint-line right" data-counter-for="tpl-footer" data-max="60"></small>
                        </label>
                    </div>
                    <div>
                        <span class="eyebrow">@T["templates.form.livePreview"]</span>
                        <div class="wa-preview"><div class="wa-bubble" id="tpl-preview" dir="auto"></div></div>
                        <div class="text-subtle text-xs mt-1">@T["templates.form.blanksHelp"]</div>
                    </div>
                </div>
                <div class="au-form-actions">
                    <button type="button" class="au-btn au-btn--text" id="new-template-cancel">@T["common.cancel"]</button>
                    <button type="submit" class="au-btn au-btn--primary"><span class="au-icon au-icon--dir" aria-hidden="true">send</span>@T["templates.form.submit"]</button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/templates-page.js" asp-append-version="true"></script>
    @if (Model.ReopenNewTemplate)
    {
        <script>
            // The new template didn't save: open the popup again (with what was typed) through the page's own button.
            (function () {
                var open = document.getElementById('new-template-btn') || document.querySelector('[data-open-new-template]');
                if (open) open.click();
            })();
        </script>
    }
    <script>
        window.PS_WHATSAPP_TEMPLATES_CONFIG = {
            clientId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClientId.ToString())),
            hubUrl: '/hubs/inbox'
        };
    </script>
    <script src="~/js/whatsapp-templates.js" asp-append-version="true"></script>
}
