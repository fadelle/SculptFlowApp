@page "/dashboard/contacts"
@model Omni.App.Pages.Dashboard.ContactsModel
@{
    ViewData["Title"] = "Interested People";
    var now = DateTimeOffset.UtcNow;
    var filtered = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Stage) || !string.IsNullOrWhiteSpace(Model.Source);

    // Presentation only: which channel icon a free-text contacts.source value gets (null = show the text).
    static string? SourceChannel(string? source)
    {
        var s = (source ?? "").ToLowerInvariant();
        if (s.Contains("whatsapp")) return "whatsapp";
        if (s.Contains("instagram")) return "instagram";
        if (s.Contains("facebook") || s.Contains("meta")) return "facebook";
        if (s.Contains("telegram")) return "telegram";
        if (s.Contains("google")) return "google";
        if (s.Contains("website") || s == "web") return "website";
        if (s.Contains("email")) return "email";
        if (s.Contains("sms")) return "sms";
        return null;
    }

    string PageLink(int p) =>
        $"/dashboard/contacts?PageNumber={p}&Stage={Uri.EscapeDataString(Model.Stage ?? "")}&Source={Uri.EscapeDataString(Model.Source ?? "")}&Search={Uri.EscapeDataString(Model.Search ?? "")}";
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <div class="au-page-head">
        <p class="au-page-head__sub">Everyone who has shown interest in your client. Open a person to update their stage.</p>
    </div>

    @* #contacts-filters and #contacts-results are read by wwwroot/js/contacts.js (live search swaps the results in place). *@
    <form method="get" class="au-toolbar" id="contacts-filters">
        <div class="au-toolbar__filters">
            <input type="search" name="Search" value="@Model.Search" placeholder="Search by name or phone…" class="au-input search-input contacts-search" aria-label="Search contacts" autocomplete="off" />
            <select name="Stage" class="au-select" aria-label="Stage" onchange="this.form.requestSubmit()">
                <option value="">All stages</option>
                @foreach (var stage in Model.Stages)
                {
                    <option value="@stage.Key" selected="@(stage.Key == Model.Stage)">@stage.Label</option>
                }
            </select>
            <select name="Source" class="au-select" aria-label="Source" onchange="this.form.requestSubmit()">
                <option value="">All sources</option>
                @foreach (var source in Model.AllSources)
                {
                    <option value="@source" selected="@(string.Equals(source, Model.Source, StringComparison.OrdinalIgnoreCase))">@FilterLabelHelper.Label(source)</option>
                }
            </select>
        </div>
        <div class="au-toolbar__actions">
            @if (filtered)
            {
                <a class="au-btn au-btn--text" href="/dashboard/contacts">Clear</a>
            }
            <button type="submit" class="au-btn au-btn--outlined"><span class="au-icon" aria-hidden="true">search</span>Search</button>
        </div>
    </form>

    <div id="contacts-results">
        <div class="au-table-card">
            @if (Model.Contacts.Count == 0)
            {
                var empty = filtered
                    ? new EmptyStateModel(Icon: "search_off", Title: "No one matches these filters",
                        Text: "Try a different name, phone, stage or source.", ActionLabel: "Clear filters", ActionHref: "/dashboard/contacts", ActionIcon: "filter_alt_off")
                    : new EmptyStateModel(Icon: "group", Title: "No interested people yet",
                        Text: "People who message your client or fill in one of your forms show up here.",
                        ActionLabel: "Connect a messaging channel", ActionHref: "/settings/integrations", ActionIcon: "hub");
                <partial name="_EmptyState" model="empty" />
            }
            else
            {
                <div class="au-table-scroll">
                    <table class="au-table au-table--stack">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Service</th>
                                <th>Source</th>
                                <th>Stage</th>
                                <th>Qualification</th>
                                <th>Last contact</th>
                                <th>Next follow-up</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contact in Model.Contacts)
                            {
                                var channel = SourceChannel(contact.Source);
                                var overdue = contact.NextFollowupAt is not null && contact.NextFollowupAt < now;
                                <tr class="row-link" data-href="/dashboard/contacts/@contact.Id">
                                    <td data-label="Name"><a class="cell-person" href="/dashboard/contacts/@contact.Id"><span class="avatar-sm">@(string.IsNullOrWhiteSpace(contact.FullName) ? "?" : contact.FullName.Trim()[..1])</span>@(contact.FullName ?? "—")</a></td>
                                    <td data-label="Phone">@(contact.Phone ?? "—")</td>
                                    <td data-label="Service">@(contact.ServiceName ?? "—")</td>
                                    <td data-label="Source">
                                        @if (channel is null)
                                        {
                                            @(string.IsNullOrWhiteSpace(contact.Source) ? "—" : FilterLabelHelper.Label(contact.Source))
                                        }
                                        else
                                        {
                                            var svg = ChannelIconHelper.Svg(channel);
                                            <span class="source-icon" style="background:@(channel == "google" ? "#4285F4" : ChannelIconHelper.Hex(channel))" title="@FilterLabelHelper.Label(contact.Source)" aria-label="@FilterLabelHelper.Label(contact.Source)">
                                                @if (svg is not null) { @Html.Raw(svg) } else { @(channel == "google" ? "G" : ChannelIconHelper.Initials(channel)) }
                                            </span>
                                        }
                                    </td>
                                    <td data-label="Stage"><span class="badge @StageDisplay.CssClass(Model.Stages, contact.StageKey)">@StageDisplay.Label(Model.Stages, contact.StageKey)</span></td>
                                    <td data-label="Qualification"><span class="badge @StatusBadgeHelper.CssClass(contact.Qualification)">@FilterLabelHelper.Label(contact.Qualification)</span></td>
                                    <td data-label="Last contact">@LocalTimeHelper.Time(contact.LastContactAt)</td>
                                    <td data-label="Next follow-up">
                                        @if (overdue)
                                        {
                                            <span class="overdue" title="This follow-up date has passed">@LocalTimeHelper.Time(contact.NextFollowupAt) · overdue</span>
                                        }
                                        else
                                        {
                                            @LocalTimeHelper.Time(contact.NextFollowupAt)
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.TotalCount > 0)
            {
                <div class="au-pager">
                    <span class="au-pager__count"><strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "person" : "people")</span>
                    @if (Model.TotalPages > 1)
                    {
                        <ul class="pagination" aria-label="Pages">
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="@(p == Model.PageNumber ? "active" : "")">
                                    <a href="@PageLink(p)" aria-current="@(p == Model.PageNumber ? "page" : null)">@p</a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </div>

    <script src="~/js/contacts.js" asp-append-version="true"></script>
}
