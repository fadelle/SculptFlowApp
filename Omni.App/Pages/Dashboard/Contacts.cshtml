@page "/dashboard/contacts"
@model Omni.App.Pages.Dashboard.ContactsModel
@{
    ViewData["Title"] = T["contacts.title"].Value;
    var now = DateTimeOffset.UtcNow;
    var filtered = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Stage) || !string.IsNullOrWhiteSpace(Model.Source);

    // Presentation only: which channel icon a free-text contacts.source value gets (null = show the text).
    static string? SourceChannel(string? source)
    {
        var s = (source ?? "").ToLowerInvariant();
        if (s.Contains("whatsapp")) return "whatsapp";
        if (s.Contains("instagram")) return "instagram";
        if (s.Contains("facebook") || s.Contains("meta")) return "facebook";
        if (s.Contains("telegram")) return "telegram";
        if (s.Contains("google")) return "google";
        if (s.Contains("website") || s == "web") return "website";
        if (s.Contains("email")) return "email";
        if (s.Contains("sms")) return "sms";
        return null;
    }

    string PageLink(int p) =>
        $"/dashboard/contacts?PageNumber={p}&Stage={Uri.EscapeDataString(Model.Stage ?? "")}&Source={Uri.EscapeDataString(Model.Source ?? "")}&Search={Uri.EscapeDataString(Model.Search ?? "")}";
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, null)" />
    <div class="au-page-head">
        <p class="au-page-head__sub">@T["contacts.intro"]</p>
        <div class="au-page-head__actions">
            <a href="/dashboard/contacts?add=true" class="au-btn au-btn--primary" data-modal-open="contact-add-overlay"><span class="au-icon" aria-hidden="true">add</span>@T["contacts.add.button"]</a>
        </div>
    </div>

    @* #contacts-filters and #contacts-results are read by wwwroot/js/contacts.js (live search swaps the results in place). *@
    <form method="get" class="au-toolbar" id="contacts-filters">
        <div class="au-toolbar__filters">
            <input type="search" name="Search" value="@Model.Search" placeholder="@T["contacts.search.placeholder"]" class="au-input search-input contacts-search" aria-label="@T["contacts.search.label"]" autocomplete="off" />
            <select name="Stage" class="au-select" aria-label="@T["contacts.filter.stage"]" onchange="this.form.requestSubmit()">
                <option value="">@T["contacts.filter.allStages"]</option>
                @foreach (var stage in Model.Stages)
                {
                    <option value="@stage.Key" selected="@(stage.Key == Model.Stage)">@stage.Label</option>
                }
            </select>
            <select name="Source" class="au-select" aria-label="@T["contacts.filter.source"]" onchange="this.form.requestSubmit()">
                <option value="">@T["contacts.filter.allSources"]</option>
                @foreach (var source in Model.AllSources)
                {
                    <option value="@source" selected="@(string.Equals(source, Model.Source, StringComparison.OrdinalIgnoreCase))">@T.ValueLabel(source)</option>
                }
            </select>
        </div>
        <div class="au-toolbar__actions">
            @if (filtered)
            {
                <a class="au-btn au-btn--text" href="/dashboard/contacts">@T["common.clear"]</a>
            }
            <button type="submit" class="au-btn au-btn--outlined"><span class="au-icon" aria-hidden="true">search</span>@T["common.search"]</button>
        </div>
    </form>

    <div id="contacts-results">
        <div class="au-table-card">
            @if (Model.Contacts.Count == 0)
            {
                var empty = filtered
                    ? new EmptyStateModel(Icon: "search_off", Title: T["contacts.empty.filteredTitle"].Value,
                        Text: T["contacts.empty.filteredText"].Value, ActionLabel: T["common.clearFilters"].Value, ActionHref: "/dashboard/contacts", ActionIcon: "filter_alt_off")
                    : new EmptyStateModel(Icon: "group", Title: T["contacts.empty.title"].Value,
                        Text: T["contacts.empty.text"].Value,
                        ActionLabel: T["contacts.empty.action"].Value, ActionHref: "/settings/integrations", ActionIcon: "hub");
                <partial name="_EmptyState" model="empty" />
            }
            else
            {
                <div class="au-table-scroll">
                    <table class="au-table au-table--stack">
                        <thead>
                            <tr>
                                <th>@T["contacts.table.name"]</th>
                                <th>@T["contacts.table.phone"]</th>
                                <th>@T["contacts.table.service"]</th>
                                <th>@T["contacts.table.source"]</th>
                                <th>@T["contacts.table.stage"]</th>
                                <th>@T["contacts.table.qualification"]</th>
                                <th>@T["contacts.table.lastContact"]</th>
                                <th>@T["contacts.table.nextFollowUp"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contact in Model.Contacts)
                            {
                                var channel = SourceChannel(contact.Source);
                                var overdue = contact.NextFollowupAt is not null && contact.NextFollowupAt < now;
                                <tr class="row-link" data-href="/dashboard/contacts/@contact.Id">
                                    <td data-label="@T["contacts.table.name"]"><a class="cell-person" href="/dashboard/contacts/@contact.Id"><span class="avatar-sm">@(string.IsNullOrWhiteSpace(contact.FullName) ? "?" : contact.FullName.Trim()[..1])</span><span dir="auto">@(contact.FullName ?? "—")</span></a></td>
                                    <td data-label="@T["contacts.table.phone"]"><span dir="ltr">@(contact.Phone ?? "—")</span></td>
                                    <td data-label="@T["contacts.table.service"]">@(contact.ServiceName ?? "—")</td>
                                    <td data-label="@T["contacts.table.source"]">
                                        @if (channel is null)
                                        {
                                            @(string.IsNullOrWhiteSpace(contact.Source) ? "—" : T.ValueLabel(contact.Source))
                                        }
                                        else
                                        {
                                            var svg = ChannelIconHelper.Svg(channel);
                                            <span class="source-icon" style="background:@(channel == "google" ? "#4285F4" : ChannelIconHelper.Hex(channel))" title="@T.ValueLabel(contact.Source)" aria-label="@T.ValueLabel(contact.Source)">
                                                @if (svg is not null) { @Html.Raw(svg) } else { @(channel == "google" ? "G" : ChannelIconHelper.Initials(channel)) }
                                            </span>
                                        }
                                    </td>
                                    <td data-label="@T["contacts.table.stage"]"><span class="badge @StageDisplay.CssClass(Model.Stages, contact.StageKey)">@StageDisplay.Label(Model.Stages, contact.StageKey)</span></td>
                                    <td data-label="@T["contacts.table.qualification"]"><span class="badge @StatusBadgeHelper.CssClass(contact.Qualification)">@T.ValueLabel(contact.Qualification)</span></td>
                                    <td data-label="@T["contacts.table.lastContact"]">@LocalTimeHelper.Time(contact.LastContactAt)</td>
                                    <td data-label="@T["contacts.table.nextFollowUp"]">
                                        @if (overdue)
                                        {
                                            <span class="overdue" title="@T["contacts.followUp.overdueHelp"]">@T.Html("contacts.followUp.overdue", LocalTimeHelper.Time(contact.NextFollowupAt))</span>
                                        }
                                        else
                                        {
                                            @LocalTimeHelper.Time(contact.NextFollowupAt)
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.TotalCount > 0)
            {
                <div class="au-pager">
                    <span class="au-pager__count">@{ var countHtml = new Microsoft.AspNetCore.Html.HtmlString($"<strong>{Model.TotalCount}</strong>"); }@T.Html(T.PluralKey("contacts.count", Model.TotalCount), countHtml)</span>
                    @if (Model.TotalPages > 1)
                    {
                        <ul class="pagination" aria-label="@T["common.pages"]">
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="@(p == Model.PageNumber ? "active" : "")">
                                    <a href="@PageLink(p)" aria-current="@(p == Model.PageNumber ? "page" : null)">@p</a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </div>

    @* Add a contact by hand (popup; modal.js). A failed save shows the page again with the popup open and the reason. *@
    <div class="bm-overlay" data-modal id="contact-add-overlay" hidden="@(!Model.AddFormOpen)">
        <div class="card form-modal" role="dialog" aria-modal="true" aria-labelledby="contact-add-title">
            <div class="modal-head">
                <h3 id="contact-add-title" class="card-title">@T["contacts.add.title"]</h3>
                <button type="button" class="au-icon-btn" data-modal-close aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            @if (Model.AddError is not null)
            {
                <partial name="_Messages" model="new PageMessagesModel(null, Model.AddError)" />
            }
            <form method="post" asp-page-handler="Add">
                <p class="au-help">@T["contacts.add.help"]</p>
                <div class="au-form-grid">
                    <div class="au-form-field au-span-2">
                        <label class="au-form-label" for="contact-add-name">@T["contacts.add.name"]</label>
                        <input type="text" name="NewName" id="contact-add-name" value="@Model.NewName" class="au-input" maxlength="200" dir="auto" autocomplete="off" />
                    </div>
                    <div class="au-form-field">
                        <label class="au-form-label" for="contact-add-phone">@T["contacts.table.phone"]</label>
                        <input type="tel" name="NewPhone" id="contact-add-phone" value="@Model.NewPhone" class="au-input" maxlength="30" dir="ltr" autocomplete="off" placeholder="+961 70 123 456" />
                    </div>
                    <div class="au-form-field">
                        <label class="au-form-label" for="contact-add-email">@T["contactDetail.details.email"] <span class="opt">@T["common.optional"]</span></label>
                        <input type="email" name="NewEmail" id="contact-add-email" value="@Model.NewEmail" class="au-input" maxlength="200" dir="ltr" autocomplete="off" />
                    </div>
                    @if (Model.ActiveServices.Count > 0)
                    {
                        <div class="au-form-field au-span-2">
                            <label class="au-form-label" for="contact-add-service">@T["contacts.table.service"] <span class="opt">@T["common.optional"]</span></label>
                            <select name="NewServiceId" id="contact-add-service" class="au-select">
                                <option value="">—</option>
                                @foreach (var s in Model.ActiveServices)
                                {
                                    <option value="@s.Id" selected="@(s.Id == Model.NewServiceId)">@s.Name</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="au-form-field au-span-2">
                        <label class="au-form-label" for="contact-add-notes">@T["contactDetail.details.notes"] <span class="opt">@T["common.optional"]</span></label>
                        <textarea name="NewNotes" id="contact-add-notes" rows="2" class="au-textarea" maxlength="2000" dir="auto">@Model.NewNotes</textarea>
                    </div>
                </div>
                <div class="au-form-actions">
                    <button type="button" class="au-btn au-btn--text" data-modal-close>@T["common.cancel"]</button>
                    <button type="submit" class="au-btn au-btn--primary">@T["contacts.add.submit"]</button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/contacts.js" asp-append-version="true"></script>
}
