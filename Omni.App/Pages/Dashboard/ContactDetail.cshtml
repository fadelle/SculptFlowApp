@page "/dashboard/contacts/{id:guid}"
@model Omni.App.Pages.Dashboard.ContactDetailModel
@{
    ViewData["Title"] = "Contact";
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else if (Model.Contact is null)
{
    var missing = new EmptyStateModel(Icon: "person_off", Title: "This person isn't in your list",
        ActionLabel: "Back to Interested People", ActionHref: "/dashboard/contacts", ActionIcon: "arrow_back");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="missing" /></div>
}
else
{
    var contact = Model.Contact;
    var followupOverdue = contact.NextFollowupAt is not null && contact.NextFollowupAt < DateTimeOffset.UtcNow;
    // Inbox search matches name, phone or service — the phone is the most specific.
    var inboxSearch = !string.IsNullOrWhiteSpace(contact.Phone) ? contact.Phone : contact.FullName;

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/dashboard/contacts" aria-label="Back to Interested People" title="Back to Interested People">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <span class="avatar-md" aria-hidden="true">@(string.IsNullOrWhiteSpace(contact.FullName) ? "?" : contact.FullName.Trim()[..1])</span>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@(contact.FullName ?? "—")</h2>
            <span class="au-back-header__sub">@(contact.Phone ?? "No phone") · @(contact.ServiceName ?? "No service on file")</span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @StageDisplay.CssClass(Model.Stages, contact.StageKey)">@StageDisplay.Label(Model.Stages, contact.StageKey)</span>
        <span class="badge @StatusBadgeHelper.CssClass(contact.Qualification)">@FilterLabelHelper.Label(contact.Qualification)</span>
        @if (!string.IsNullOrWhiteSpace(inboxSearch))
        {
            <a class="au-btn au-btn--outlined au-btn--sm" href="/inbox?search=@Uri.EscapeDataString(inboxSearch)"><span class="au-icon" aria-hidden="true">chat</span>Open in Inbox</a>
        }
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="contact-grid">
        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="contact-details-title">
            <div class="au-panel__head"><h3 class="au-panel__title" id="contact-details-title">Details</h3></div>
            <dl class="au-detail-rows">
                <div class="au-detail-row"><dt>Phone</dt><dd>@(contact.Phone ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Email</dt><dd>@(contact.Email ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Service</dt><dd>@(contact.ServiceName ?? "—")</dd></div>
                <div class="au-detail-row"><dt>City</dt><dd>@(contact.City ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Timeline</dt><dd>@(contact.DesiredTimeline ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Last contact</dt><dd>@LocalTimeHelper.Time(contact.LastContactAt)</dd></div>
                <div class="au-detail-row"><dt>Next follow-up</dt><dd class="@(followupOverdue ? "overdue" : "")">@LocalTimeHelper.Time(contact.NextFollowupAt)@(followupOverdue ? " · overdue" : "")</dd></div>
                <div class="au-detail-row"><dt>Contact since</dt><dd>@LocalTimeHelper.Time(contact.CreatedAt, "date")</dd></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(contact.Notes))
            {
                <div class="contact-notes">
                    <span class="au-eyebrow">Notes</span>
                    <p>@contact.Notes</p>
                </div>
            }
        </section>

        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="contact-update-title">
            <div class="au-panel__head">
                <h3 class="au-panel__title" id="contact-update-title">Update this person</h3>
                <button type="button" class="status-help-trigger" data-status-help-trigger title="What do these mean?" aria-label="What do these statuses mean?">?</button>
            </div>
            <form method="post" class="au-stack">
                <div class="au-form-field">
                    <label class="au-form-label" for="contact-stage">Stage</label>
                    <select name="StageKey" id="contact-stage" class="au-select">
                        @foreach (var stage in Model.Stages)
                        {
                            <option value="@stage.Key" selected="@(stage.Key == Model.StageKey)">@stage.Label</option>
                        }
                        @if (!Model.Stages.Any(s => s.Key == Model.StageKey) && !string.IsNullOrEmpty(Model.StageKey))
                        {
                            <option value="@Model.StageKey" selected>@StageDisplay.Label(Model.Stages, Model.StageKey)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="contact-qualification">Qualification</label>
                    <select name="Qualification" id="contact-qualification" class="au-select">
                        @foreach (var s in Model.QualificationOptions)
                        {
                            <option value="@s" selected="@(s == Model.Qualification)">@FilterLabelHelper.Label(s)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="source-choice">Where they came from</label>
                    <select name="SourceChoice" id="source-choice" class="au-select" onchange="document.getElementById('custom-source-field').style.display = this.value === 'other' ? '' : 'none';">
                        @foreach (var s in Model.SourceOptions)
                        {
                            <option value="@s" selected="@(s == Model.SourceChoice)">@s</option>
                        }
                        <option value="other" selected="@(Model.SourceChoice == "other")">Other…</option>
                    </select>
                </div>

                <div class="au-form-field" id="custom-source-field" style="display:@(Model.SourceChoice == "other" ? "" : "none")">
                    <label class="au-form-label" for="custom-source">Other source</label>
                    <input type="text" name="CustomSource" id="custom-source" value="@Model.CustomSource" class="au-input" placeholder="e.g. trade show" />
                </div>

                <div class="au-form-actions">
                    <button type="submit" class="au-btn au-btn--primary">Save changes</button>
                </div>
            </form>
        </section>
    </div>

    <partial name="_StatusHelp" model="Model.Stages" />
    <script src="~/js/status-help.js" asp-append-version="true"></script>
}
