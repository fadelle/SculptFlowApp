@page "/dashboard/contacts/{id:guid}"
@model Omni.App.Pages.Dashboard.ContactDetailModel
@{
    ViewData["Title"] = T["contactDetail.title"].Value;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else if (Model.Contact is null)
{
    var missing = new EmptyStateModel(Icon: "person_off", Title: T["contactDetail.missing"].Value,
        ActionLabel: T["contactDetail.back"].Value, ActionHref: "/dashboard/contacts", ActionIcon: "arrow_back");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="missing" /></div>
}
else
{
    var contact = Model.Contact;
    var followupOverdue = contact.NextFollowupAt is not null && contact.NextFollowupAt < DateTimeOffset.UtcNow;
    // Inbox search matches name, phone or service — the phone is the most specific.
    var inboxSearch = !string.IsNullOrWhiteSpace(contact.Phone) ? contact.Phone : contact.FullName;

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/dashboard/contacts" aria-label="@T["contactDetail.back"]" title="@T["contactDetail.back"]">
            <span class="au-icon au-icon--dir" aria-hidden="true">arrow_back</span>
        </a>
        <span class="avatar-md" aria-hidden="true">@(string.IsNullOrWhiteSpace(contact.FullName) ? "?" : contact.FullName.Trim()[..1])</span>
        <div class="min-w-0">
            <h2 class="au-back-header__title" dir="auto">@(contact.FullName ?? "—")</h2>
            <span class="au-back-header__sub"><span dir="ltr">@(contact.Phone ?? T["contactDetail.noPhone"].Value)</span> · @(contact.ServiceName ?? T["contactDetail.noService"].Value)</span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @StageDisplay.CssClass(Model.Stages, contact.StageKey)">@StageDisplay.Label(Model.Stages, contact.StageKey)</span>
        <span class="badge @StatusBadgeHelper.CssClass(contact.Qualification)">@T.ValueLabel(contact.Qualification)</span>
        @if (!string.IsNullOrWhiteSpace(inboxSearch))
        {
            <a class="au-btn au-btn--outlined au-btn--sm" href="/inbox?search=@Uri.EscapeDataString(inboxSearch)"><span class="au-icon" aria-hidden="true">chat</span>@T["contactDetail.openInInbox"]</a>
        }
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="contact-grid">
        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="contact-details-title">
            <div class="au-panel__head"><h3 class="au-panel__title" id="contact-details-title">@T["contactDetail.details.title"]</h3></div>
            <dl class="au-detail-rows">
                <div class="au-detail-row"><dt>@T["contacts.table.phone"]</dt><dd><span dir="ltr">@(contact.Phone ?? "—")</span></dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.email"]</dt><dd><span dir="ltr">@(contact.Email ?? "—")</span></dd></div>
                <div class="au-detail-row"><dt>@T["contacts.table.service"]</dt><dd>@(contact.ServiceName ?? "—")</dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.city"]</dt><dd>@(contact.City ?? "—")</dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.timeline"]</dt><dd>@(contact.DesiredTimeline ?? "—")</dd></div>
                <div class="au-detail-row"><dt>@T["contacts.table.lastContact"]</dt><dd>@LocalTimeHelper.Time(contact.LastContactAt)</dd></div>
                <div class="au-detail-row"><dt>@T["contacts.table.nextFollowUp"]</dt><dd class="@(followupOverdue ? "overdue" : "")">@(followupOverdue ? T.Html("contacts.followUp.overdue", LocalTimeHelper.Time(contact.NextFollowupAt)) : LocalTimeHelper.Time(contact.NextFollowupAt))</dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.since"]</dt><dd>@LocalTimeHelper.Time(contact.CreatedAt, "date")</dd></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(contact.Notes))
            {
                <div class="contact-notes">
                    <span class="au-eyebrow">@T["contactDetail.details.notes"]</span>
                    <p dir="auto">@contact.Notes</p>
                </div>
            }
        </section>

        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="contact-update-title">
            <div class="au-panel__head">
                <h3 class="au-panel__title" id="contact-update-title">@T["contactDetail.update.title"]</h3>
                <button type="button" class="status-help-trigger" data-status-help-trigger title="@T["statusHelp.trigger.title"]" aria-label="@T["statusHelp.trigger.label"]">?</button>
            </div>
            <form method="post" class="au-stack">
                <div class="au-form-field">
                    <label class="au-form-label" for="contact-stage">@T["contacts.table.stage"]</label>
                    <select name="StageKey" id="contact-stage" class="au-select">
                        @foreach (var stage in Model.Stages)
                        {
                            <option value="@stage.Key" selected="@(stage.Key == Model.StageKey)">@stage.Label</option>
                        }
                        @if (!Model.Stages.Any(s => s.Key == Model.StageKey) && !string.IsNullOrEmpty(Model.StageKey))
                        {
                            <option value="@Model.StageKey" selected>@StageDisplay.Label(Model.Stages, Model.StageKey)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="contact-qualification">@T["contacts.table.qualification"]</label>
                    <select name="Qualification" id="contact-qualification" class="au-select">
                        @foreach (var s in Model.QualificationOptions)
                        {
                            <option value="@s" selected="@(s == Model.Qualification)">@T.ValueLabel(s)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="source-choice">@T["contactDetail.update.source"]</label>
                    <select name="SourceChoice" id="source-choice" class="au-select" onchange="document.getElementById('custom-source-field').style.display = this.value === 'other' ? '' : 'none';">
                        @foreach (var s in Model.SourceOptions)
                        {
                            <option value="@s" selected="@(s == Model.SourceChoice)">@s</option>
                        }
                        <option value="other" selected="@(Model.SourceChoice == "other")">@T["contactDetail.update.otherSource"]</option>
                    </select>
                </div>

                <div class="au-form-field" id="custom-source-field" style="display:@(Model.SourceChoice == "other" ? "" : "none")">
                    <label class="au-form-label" for="custom-source">@T["contactDetail.update.customSource"]</label>
                    <input type="text" name="CustomSource" id="custom-source" value="@Model.CustomSource" class="au-input" placeholder="@T["contactDetail.update.customSourcePlaceholder"]" />
                </div>

                <div class="au-form-actions">
                    <button type="submit" class="au-btn au-btn--primary">@T["common.saveChanges"]</button>
                </div>
            </form>
        </section>
    </div>

    <partial name="_StatusHelp" model="Model.Stages" />
    <script src="~/js/status-help.js" asp-append-version="true"></script>
}
