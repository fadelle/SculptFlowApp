@page "/dashboard/contacts/{id:guid}"
@model Omni.App.Pages.Dashboard.ContactDetailModel
@{
    ViewData["Title"] = T["contactDetail.title"].Value;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else if (Model.Contact is null)
{
    var missing = new EmptyStateModel(Icon: "person_off", Title: T["contactDetail.missing"].Value,
        ActionLabel: T["contactDetail.back"].Value, ActionHref: "/dashboard/contacts", ActionIcon: "arrow_back");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="missing" /></div>
}
else
{
    var contact = Model.Contact;
    var followupOverdue = contact.NextFollowupAt is not null && contact.NextFollowupAt < DateTimeOffset.UtcNow;
    // Inbox search matches name, phone or service — the phone is the most specific.
    var inboxSearch = !string.IsNullOrWhiteSpace(contact.Phone) ? contact.Phone : contact.FullName;
    var optedOut = contact.OptedOutAt is not null || !contact.MarketingOptIn;
    string LanguageName(string code) => code switch
    {
        ContactLanguage.English => T["contactDetail.language.en"].Value,
        ContactLanguage.Arabic => T["contactDetail.language.ar"].Value,
        ContactLanguage.French => T["contactDetail.language.fr"].Value,
        _ => code
    };

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/dashboard/contacts" aria-label="@T["contactDetail.back"]" title="@T["contactDetail.back"]">
            <span class="au-icon au-icon--dir" aria-hidden="true">arrow_back</span>
        </a>
        <span class="avatar-md" aria-hidden="true">@(string.IsNullOrWhiteSpace(contact.FullName) ? "?" : contact.FullName.Trim()[..1])</span>
        <div class="min-w-0">
            <h2 class="au-back-header__title" dir="auto">@(contact.FullName ?? "—")</h2>
            <span class="au-back-header__sub"><span dir="ltr">@(contact.Phone ?? T["contactDetail.noPhone"].Value)</span> · @(contact.ServiceName ?? T["contactDetail.noService"].Value)</span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @StageDisplay.CssClass(Model.Stages, contact.StageKey)">@StageDisplay.Label(Model.Stages, contact.StageKey)</span>
        <span class="badge @StatusBadgeHelper.CssClass(contact.Qualification)">@T.ValueLabel(contact.Qualification)</span>
        @if (optedOut)
        {
            <span class="badge badge-gray">@T["contactDetail.optOut.badge"]</span>
        }
        @if (!string.IsNullOrWhiteSpace(inboxSearch))
        {
            <a class="au-btn au-btn--outlined au-btn--sm" href="/inbox?search=@Uri.EscapeDataString(inboxSearch)"><span class="au-icon" aria-hidden="true">chat</span>@T["contactDetail.openInInbox"]</a>
        }
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="contact-grid">
        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="contact-details-title">
            <div class="au-panel__head"><h3 class="au-panel__title" id="contact-details-title">@T["contactDetail.details.title"]</h3></div>
            <dl class="au-detail-rows">
                <div class="au-detail-row"><dt>@T["contacts.table.phone"]</dt><dd><span dir="ltr">@(contact.Phone ?? "—")</span></dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.email"]</dt><dd><span dir="ltr">@(contact.Email ?? "—")</span></dd></div>
                <div class="au-detail-row"><dt>@T["contacts.table.service"]</dt><dd>@(contact.ServiceName ?? "—")</dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.language"]</dt><dd>@if (string.IsNullOrEmpty(contact.PreferredLanguage)) { @T["contactDetail.language.none"] } else if (Model.LanguageOptions.Contains(contact.PreferredLanguage)) { @LanguageName(contact.PreferredLanguage) } else { <span dir="ltr">@contact.PreferredLanguage</span> }</dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.city"]</dt><dd dir="auto">@(contact.City ?? "—")</dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.timeline"]</dt><dd dir="auto">@(contact.DesiredTimeline ?? "—")</dd></div>
                <div class="au-detail-row"><dt>@T["contacts.table.lastContact"]</dt><dd>@LocalTimeHelper.Time(contact.LastContactAt)</dd></div>
                <div class="au-detail-row"><dt>@T["contacts.table.nextFollowUp"]</dt><dd class="@(followupOverdue ? "overdue" : "")">@(followupOverdue ? T.Html("contacts.followUp.overdue", LocalTimeHelper.Time(contact.NextFollowupAt)) : LocalTimeHelper.Time(contact.NextFollowupAt))</dd></div>
                <div class="au-detail-row"><dt>@T["contactDetail.details.since"]</dt><dd>@LocalTimeHelper.Time(contact.CreatedAt, "date")</dd></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(contact.Notes))
            {
                <div class="contact-notes">
                    <span class="au-eyebrow">@T["contactDetail.details.notes"]</span>
                    <p dir="auto">@contact.Notes</p>
                </div>
            }

            <div class="contact-notes" id="contact-opt-out">
                <span class="au-eyebrow">@T["contactDetail.optOut.title"]</span>
                <p>@(optedOut ? T.Html("contactDetail.optOut.optedOut", LocalTimeHelper.Time(contact.OptedOutAt ?? contact.UpdatedAt, "date")) : T["contactDetail.optOut.subscribed"])</p>
                <form method="post" asp-page-handler="OptOut" asp-route-id="@contact.Id"
                      data-au-confirm="@(optedOut ? T["contactDetail.optOut.optInConfirm"].Value : null)"
                      data-au-confirm-label="@(optedOut ? T["contactDetail.optOut.optIn"].Value : null)">
                    <input type="hidden" name="optedOut" value="@(optedOut ? "false" : "true")" />
                    <button type="submit" class="au-btn au-btn--outlined au-btn--sm">@(optedOut ? T["contactDetail.optOut.optIn"] : T["contactDetail.optOut.optOut"])</button>
                </form>
            </div>
        </section>

        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="contact-update-title">
            <div class="au-panel__head">
                <h3 class="au-panel__title" id="contact-update-title">@T["contactDetail.update.title"]</h3>
                <button type="button" class="status-help-trigger" data-status-help-trigger title="@T["statusHelp.trigger.title"]" aria-label="@T["statusHelp.trigger.label"]">?</button>
            </div>
            <form method="post" class="au-stack">
                <div class="au-form-field">
                    <label class="au-form-label" for="contact-stage">@T["contacts.table.stage"]</label>
                    <select name="StageKey" id="contact-stage" class="au-select">
                        @foreach (var stage in Model.Stages)
                        {
                            <option value="@stage.Key" selected="@(stage.Key == Model.StageKey)">@stage.Label</option>
                        }
                        @if (!Model.Stages.Any(s => s.Key == Model.StageKey) && !string.IsNullOrEmpty(Model.StageKey))
                        {
                            <option value="@Model.StageKey" selected>@StageDisplay.Label(Model.Stages, Model.StageKey)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="contact-qualification">@T["contacts.table.qualification"]</label>
                    <select name="Qualification" id="contact-qualification" class="au-select">
                        @foreach (var s in Model.QualificationOptions)
                        {
                            <option value="@s" selected="@(s == Model.Qualification)">@T.ValueLabel(s)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="source-choice">@T["contactDetail.update.source"]</label>
                    <select name="SourceChoice" id="source-choice" class="au-select" onchange="document.getElementById('custom-source-field').style.display = this.value === 'other' ? '' : 'none';">
                        @foreach (var s in Model.SourceOptions)
                        {
                            <option value="@s" selected="@(s == Model.SourceChoice)">@s</option>
                        }
                        <option value="other" selected="@(Model.SourceChoice == "other")">@T["contactDetail.update.otherSource"]</option>
                    </select>
                </div>

                <div class="au-form-field" id="custom-source-field" style="display:@(Model.SourceChoice == "other" ? "" : "none")">
                    <label class="au-form-label" for="custom-source">@T["contactDetail.update.customSource"]</label>
                    <input type="text" name="CustomSource" id="custom-source" value="@Model.CustomSource" class="au-input" placeholder="@T["contactDetail.update.customSourcePlaceholder"]" />
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="language-choice">@T["contactDetail.update.language"]</label>
                    <select name="LanguageChoice" id="language-choice" class="au-select" aria-describedby="language-hint" onchange="document.getElementById('custom-language-field').style.display = this.value === 'other' ? '' : 'none';">
                        <option value="" selected="@(Model.LanguageChoice == "")">@T["contactDetail.language.none"]</option>
                        @foreach (var code in Model.LanguageOptions)
                        {
                            <option value="@code" selected="@(code == Model.LanguageChoice)">@LanguageName(code)</option>
                        }
                        <option value="@ContactDetailModel.OtherLanguage" selected="@(Model.LanguageChoice == ContactDetailModel.OtherLanguage)">@T["contactDetail.update.otherLanguage"]</option>
                    </select>
                    <small class="au-help" id="language-hint">@T["contactDetail.update.languageHint"]</small>
                </div>

                <div class="au-form-field" id="custom-language-field" style="display:@(Model.LanguageChoice == ContactDetailModel.OtherLanguage ? "" : "none")">
                    <label class="au-form-label" for="custom-language">@T["contactDetail.update.customLanguage"]</label>
                    <input type="text" name="CustomLanguage" id="custom-language" value="@Model.CustomLanguage" class="au-input" dir="ltr" maxlength="20" autocomplete="off" placeholder="@T["contactDetail.update.customLanguagePlaceholder"]" />
                </div>

                <div class="au-form-actions">
                    <button type="submit" class="au-btn au-btn--primary">@T["common.saveChanges"]</button>
                </div>
            </form>
        </section>
    </div>

    @* ---------- Orders (QA t3-inbox-10): listed here, added and edited in the popup below. ---------- *@
    <section class="au-panel au-panel--round au-panel--pad mt-3" aria-labelledby="contact-orders-title" id="orders">
        <div class="au-panel__head">
            <h3 class="au-panel__title" id="contact-orders-title">@T["contactDetail.orders.title"]</h3>
            <a href="/dashboard/contacts/@contact.Id?order=new" class="au-btn au-btn--outlined au-btn--sm" data-modal-open="order-overlay"><span class="au-icon" aria-hidden="true">add</span>@T["contactDetail.orders.add"]</a>
        </div>
        @if (Model.Orders.Count == 0)
        {
            <p class="au-help">@T["contactDetail.orders.empty"]</p>
        }
        else
        {
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead>
                        <tr>
                            <th>@T["contactDetail.orders.service"]</th>
                            <th>@T["services.table.status"]</th>
                            <th>@T["contactDetail.orders.amount"]</th>
                            <th>@T["contactDetail.orders.created"]</th>
                            <th><span class="au-sr-only">@T["services.table.actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Orders)
                        {
                            var amount = o.FinalAmount ?? o.QuotedAmount;
                            <tr>
                                <td data-label="@T["contactDetail.orders.service"]" dir="auto">@(o.ServiceName ?? "—")</td>
                                <td data-label="@T["services.table.status"]"><span class="badge @StatusBadgeHelper.CssClass(o.Status)">@T.ValueLabel(o.Status)</span></td>
                                <td data-label="@T["contactDetail.orders.amount"]">
                                    <div>
                                        @if (amount is { } a)
                                        {
                                            <span dir="ltr">@a.Display("#,0.##") @o.CurrencyCode</span>
                                            <div class="cell-sub">@(o.FinalAmount is not null ? T["contactDetail.orders.final"] : T["contactDetail.orders.quoted"])@(o.DepositAmount is { } d ? T["contactDetail.orders.depositNote", d.Display("#,0.##")].Value : "")</div>
                                        }
                                        else
                                        {
                                            <span class="text-subtle">—</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="@T["contactDetail.orders.created"]" class="cell-sub">@LocalTimeHelper.Time(o.CreatedAt, "date")</td>
                                <td class="row-actions">
                                    <a href="/dashboard/contacts/@contact.Id?order=new" class="au-btn au-btn--outlined au-btn--sm" data-modal-open="order-overlay"
                                       data-order-id="@o.Id" data-order-service="@o.ServiceName" data-order-status="@o.Status"
                                       data-order-quoted="@o.QuotedAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-order-deposit="@o.DepositAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-order-final="@o.FinalAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-order-currency="@o.CurrencyCode">@T["common.edit"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* Add / edit an order (popup; modal.js opens it, contact-orders.js switches it to editing from the Edit button's data-order-*). *@
    <div class="bm-overlay" data-modal id="order-overlay" hidden="@(!Model.OrderFormOpen)">
        <div class="card form-modal" role="dialog" aria-modal="true" aria-labelledby="order-form-title">
            <div class="modal-head">
                <h3 id="order-form-title" class="card-title" data-title-add="@T["contactDetail.orders.addTitle"]" data-title-edit="@T["contactDetail.orders.editTitle"]">@(Model.OrderId is null ? T["contactDetail.orders.addTitle"] : T["contactDetail.orders.editTitle"])</h3>
                <button type="button" class="au-icon-btn" data-modal-close aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            @if (Model.OrderError is not null)
            {
                <partial name="_Messages" model="new PageMessagesModel(null, Model.OrderError)" />
            }
            @* #order-id, #order-service-field, #order-service-name, [data-order-edit-only] and #order-submit are read by contact-orders.js. *@
            <form method="post" asp-page-handler="Order" asp-route-id="@contact.Id" id="order-form">
                <input type="hidden" name="OrderId" id="order-id" value="@Model.OrderId" />
                <div class="au-form-grid">
                    <div class="au-form-field au-span-2" id="order-service-field" hidden="@(Model.OrderId is not null)">
                        <label class="au-form-label" for="order-service">@T["contactDetail.orders.service"]<span class="au-required">*</span></label>
                        @if (Model.ActiveServices.Count == 0)
                        {
                            <p class="au-help">@T["contactDetail.orders.noServices"] <a href="/Services">@T["nav.services"]</a></p>
                        }
                        else
                        {
                            <select name="OrderServiceId" id="order-service" class="au-select">
                                @foreach (var s in Model.ActiveServices)
                                {
                                    <option value="@s.Id" selected="@(s.Id == Model.OrderServiceId)">@s.Name</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="au-form-field au-span-2" data-order-edit-only hidden="@(Model.OrderId is null)">
                        <span class="au-form-label">@T["contactDetail.orders.service"]</span>
                        <strong id="order-service-name" dir="auto"></strong>
                    </div>
                    <div class="au-form-field au-span-2" data-order-edit-only hidden="@(Model.OrderId is null)">
                        <label class="au-form-label" for="order-status">@T["services.table.status"]</label>
                        <select name="OrderStatusValue" id="order-status" class="au-select">
                            @foreach (var s in Model.OrderStatuses)
                            {
                                <option value="@s" selected="@(s == Model.OrderStatusValue)">@T.ValueLabel(s)</option>
                            }
                        </select>
                    </div>
                    <div class="au-form-field">
                        <label class="au-form-label" for="order-quoted">@T["contactDetail.orders.quotedAmount"]</label>
                        <input type="number" name="OrderQuoted" id="order-quoted" value="@Model.OrderQuoted?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="au-input" min="0" step="0.01" dir="ltr" />
                    </div>
                    <div class="au-form-field">
                        <label class="au-form-label" for="order-currency">@T["contactDetail.orders.currency"]</label>
                        <input type="text" name="OrderCurrency" id="order-currency" value="@Model.OrderCurrency" class="au-input" maxlength="3" dir="ltr" autocomplete="off" placeholder="USD" />
                    </div>
                    <div class="au-form-field" data-order-edit-only hidden="@(Model.OrderId is null)">
                        <label class="au-form-label" for="order-deposit">@T["contactDetail.orders.depositAmount"]</label>
                        <input type="number" name="OrderDeposit" id="order-deposit" value="@Model.OrderDeposit?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="au-input" min="0" step="0.01" dir="ltr" />
                    </div>
                    <div class="au-form-field" data-order-edit-only hidden="@(Model.OrderId is null)">
                        <label class="au-form-label" for="order-final">@T["contactDetail.orders.finalAmount"]</label>
                        <input type="number" name="OrderFinal" id="order-final" value="@Model.OrderFinal?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="au-input" min="0" step="0.01" dir="ltr" />
                    </div>
                    <div class="au-form-field au-span-2">
                        <label class="au-form-label" for="order-notes">@T["contactDetail.details.notes"] <span class="opt">@T["common.optional"]</span></label>
                        <textarea name="OrderNotes" id="order-notes" rows="2" class="au-textarea" maxlength="1000" dir="auto">@Model.OrderNotes</textarea>
                    </div>
                </div>
                <div class="au-form-actions">
                    <button type="button" class="au-btn au-btn--text" data-modal-close>@T["common.cancel"]</button>
                    <button type="submit" class="au-btn au-btn--primary" id="order-submit" data-label-add="@T["contactDetail.orders.add"]" data-label-edit="@T["common.saveChanges"]">@(Model.OrderId is null ? T["contactDetail.orders.add"] : T["common.saveChanges"])</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.CanManageData)
    {
        <section class="au-panel au-panel--round au-panel--pad mt-3" aria-labelledby="contact-data-title" id="contact-data">
            <div class="au-panel__head"><h3 class="au-panel__title" id="contact-data-title">@T["contactDetail.data.title"]</h3></div>
            <p class="au-help">@T["contactDetail.data.help"]</p>
            <div class="au-form-actions">
                <a class="au-btn au-btn--outlined" href="/dashboard/contacts/@contact.Id?handler=Export"><span class="au-icon" aria-hidden="true">description</span>@T["contactDetail.data.export"]</a>
            </div>
            <details class="contact-delete">
                <summary class="au-btn au-btn--danger-outlined">@T["contactDetail.data.delete"]</summary>
                <form method="post" asp-page-handler="Delete" asp-route-id="@contact.Id" class="au-stack mt-2" autocomplete="off">
                    <p><strong>@T["contactDetail.data.deleteTitle"]</strong></p>
                    <p class="au-help">@T["contactDetail.data.deleteHelp"]</p>
                    <div class="au-form-field">
                        <label class="au-form-label" for="delete-confirmation">@T["contactDetail.data.confirmLabel"] <strong><bdi dir="auto">@Model.DeleteConfirmation</bdi></strong></label>
                        <input type="text" name="confirmation" id="delete-confirmation" class="au-input" dir="auto" required autocomplete="off" />
                    </div>
                    <div><button type="submit" class="au-btn au-btn--danger">@T["contactDetail.data.deleteSubmit"]</button></div>
                </form>
            </details>
        </section>
    }

    <partial name="_StatusHelp" model="Model.Stages" />
    <script src="~/js/status-help.js" asp-append-version="true"></script>
    <script src="~/js/contact-orders.js" asp-append-version="true"></script>
}
