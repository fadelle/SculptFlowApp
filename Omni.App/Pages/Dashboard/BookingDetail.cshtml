@page "/dashboard/bookings/{id:guid}"
@model Omni.App.Pages.Dashboard.BookingDetailModel
@{
    ViewData["Title"] = T["bookingDetail.title"].Value;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else if (!Model.BookingsIncluded)
{
    <partial name="_BookingsNotIncluded" />
}
else if (Model.Booking is null)
{
    var missing = new EmptyStateModel(Icon: "event_busy", Title: T["bookingDetail.missing"].Value,
        ActionLabel: T["bookingDetail.back"].Value, ActionHref: "/dashboard/bookings", ActionIcon: "arrow_back");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="missing" /></div>
}
else
{
    var appt = Model.Booking;

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/dashboard/bookings" aria-label="@T["bookingDetail.back"]" title="@T["bookingDetail.back"]">
            <span class="au-icon au-icon--dir" aria-hidden="true">arrow_back</span>
        </a>
        <span class="avatar-md" aria-hidden="true">@(string.IsNullOrWhiteSpace(appt.ContactFullName) ? "?" : appt.ContactFullName.Trim()[..1])</span>
        <div class="min-w-0">
            <h2 class="au-back-header__title" dir="auto">@(appt.ContactFullName ?? "—")</h2>
            <span class="au-back-header__sub">@(appt.ServiceName ?? T["contactDetail.noService"].Value) · @LocalTimeHelper.Time(appt.ScheduledStart, "datetime-year", clientTimeZone: Model.ClientTimezone)</span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @StatusBadgeHelper.CssClass(appt.Status)">@T.ValueLabel(appt.Status)</span>
        <a class="au-btn au-btn--outlined au-btn--sm" href="/dashboard/contacts/@appt.ContactId"><span class="au-icon" aria-hidden="true">person</span>@T["bookings.openContact"]</a>
        <partial name="_TimeViewSwitch" model="Model.ClientTimezone" />
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <section class="au-panel au-panel--round au-panel--pad mw-480" aria-labelledby="appt-update-title">
        <div class="au-panel__head"><h3 class="au-panel__title" id="appt-update-title">@T["bookingDetail.update.title"]</h3></div>
        <form method="post">
            <div class="au-form-field">
                <label class="au-form-label" for="appt-status">@T["bookings.status"]</label>
                <select name="Status" id="appt-status" class="au-select">
                    @foreach (var s in Model.StatusOptions)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@T.ValueLabel(s)</option>
                    }
                </select>
            </div>
            <div class="au-form-actions">
                <a href="/dashboard/bookings" class="au-btn au-btn--text">@T["bookingDetail.backToCalendar"]</a>
                <button type="submit" class="au-btn au-btn--primary">@T["common.saveChanges"]</button>
            </div>
        </form>
    </section>

    @if (Model.Reminders.Count > 0)
    {
        <section class="au-panel au-panel--round au-panel--pad mw-480 mt-3" aria-labelledby="booking-reminders-title">
            <div class="au-panel__head"><h3 class="au-panel__title" id="booking-reminders-title">@T["bookingDetail.reminders.title"]</h3></div>
            <dl class="au-detail-rows">
                @foreach (var r in Model.Reminders)
                {
                    <div class="au-detail-row">
                        <dt>@(r.Kind == ReminderKind.First ? T["bookingDetail.reminders.first"] : T["bookingDetail.reminders.second"])</dt>
                        <dd>
                            <span class="badge @(r.Status == ReminderStatus.Sent ? "badge-green" : r.Status == ReminderStatus.Failed ? "badge-red" : "badge-gray")">@T[ReminderText.StatusKey(r.Status)]</span>
                            @if (!string.IsNullOrEmpty(r.Reason))
                            {
                                <div class="cell-sub">@T[ReminderText.ReasonKey(r.Reason)]</div>
                            }
                            <div class="cell-sub">@LocalTimeHelper.Time(r.UpdatedAt, "datetime")</div>
                        </dd>
                    </div>
                }
            </dl>
        </section>
    }
}
