@page "/dashboard/bookings"
@model Omni.App.Pages.Dashboard.BookingsModel
@{
    ViewData["Title"] = T["bookings.title"].Value;
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    @* Everything below is driven by wwwroot/js/bookings-calendar.js through the cal-* ids; only the static controls
       use kit classes. *@
    <div id="cal-message"></div>
    <div id="cal-outcome"></div>
    <div class="today-line" id="cal-today-line" hidden></div>

    <div class="cal-header">
        <div class="cal-nav">
            <button type="button" class="au-icon-btn au-icon-btn--bordered" id="cal-prev" title="@T["bookings.calendar.previousMonth"]" aria-label="@T["bookings.calendar.previousMonth"]"><span class="au-icon" aria-hidden="true">chevron_left</span></button>
            <div class="cal-title" id="cal-title" aria-live="polite">&nbsp;</div>
            <button type="button" class="au-icon-btn au-icon-btn--bordered" id="cal-next" title="@T["bookings.calendar.nextMonth"]" aria-label="@T["bookings.calendar.nextMonth"]"><span class="au-icon" aria-hidden="true">chevron_right</span></button>
            <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="cal-today">@T["bookings.calendar.today"]</button>
        </div>
        <div class="cal-header__actions">
            <partial name="_TimeViewSwitch" model="Model.ClientTimezone" />
            <button type="button" class="au-btn au-btn--primary" id="cal-new"><span class="au-icon" aria-hidden="true">add</span>@T["bookings.new.title"]</button>
        </div>
    </div>

    <div class="cal-weekdays">
        <div class="cal-weekday">@T["days.short.sunday"]</div><div class="cal-weekday">@T["days.short.monday"]</div><div class="cal-weekday">@T["days.short.tuesday"]</div>
        <div class="cal-weekday">@T["days.short.wednesday"]</div><div class="cal-weekday">@T["days.short.thursday"]</div><div class="cal-weekday">@T["days.short.friday"]</div>
        <div class="cal-weekday">@T["days.short.saturday"]</div>
    </div>
    <div class="cal-grid" id="cal-grid"></div>
    <div class="cal-agenda" id="cal-agenda"></div>

    <div class="cal-legend" aria-label="@T["bookings.calendar.legend"]">
        <span class="legend-item"><i class="legend-swatch status-booked"></i>@T["values.booked"]</span>
        <span class="legend-item"><i class="legend-swatch status-confirmed"></i>@T["values.confirmed"]</span>
        <span class="legend-item"><i class="legend-swatch status-attended"></i>@T["values.attended"]</span>
        <span class="legend-item"><i class="legend-swatch status-no_show"></i>@T["values.noShow"]</span>
        <span class="legend-item"><i class="legend-swatch status-canceled"></i>@T["values.canceled"]</span>
        <span class="legend-item"><i class="legend-swatch status-rescheduled"></i>@T["values.rescheduled"]</span>
    </div>

    @* ---------- Day drawer: every booking for the clicked day ---------- *@
    <div class="cal-drawer-overlay" id="cal-drawer-overlay" hidden></div>
    <div class="cal-drawer" id="cal-drawer" role="dialog" aria-modal="true" aria-labelledby="cal-drawer-title" hidden>
        <div class="cal-drawer-header">
            <h3 class="cal-drawer-title" id="cal-drawer-title">&nbsp;</h3>
            <div class="flex items-center gap-2">
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="cal-drawer-add"><span class="au-icon" aria-hidden="true">add</span>@T["bookings.drawer.new"]</button>
                <button type="button" class="au-icon-btn" id="cal-drawer-close" aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
        </div>
        <div class="cal-drawer-body" id="cal-drawer-body"></div>
    </div>

    @* ---------- New booking ---------- *@
    <div class="bm-overlay" id="cal-new-overlay" hidden>
        <div class="card cal-modal" role="dialog" aria-modal="true" aria-labelledby="cal-new-title">
            <div class="modal-head">
                <h3 id="cal-new-title" class="card-title">@T["bookings.new.title"]</h3>
                <button type="button" class="au-icon-btn" id="cal-new-close" aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            <div id="cal-new-error" class="connect-error modal-error" role="alert"></div>
            <div class="au-stack">
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-contact-search">@T["bookings.new.contact"]<span class="au-required">*</span></label>
                    <div class="picker" id="cal-new-contact-picker">
                        <input type="text" id="cal-new-contact-search" class="au-input search-input" placeholder="@T["contacts.search.placeholder"]" autocomplete="off" />
                        <div class="picker-chip" id="cal-new-contact-chip" hidden>
                            <span class="avatar-sm" id="cal-new-contact-chip-avatar"></span>
                            <span class="picker-chip-label" id="cal-new-contact-chip-label"></span>
                            <button type="button" class="picker-chip-x" id="cal-new-contact-clear" aria-label="@T["bookings.new.changeContact"]">&times;</button>
                        </div>
                        <div class="picker-results" id="cal-new-contact-results" role="listbox" hidden></div>
                    </div>
                    <input type="hidden" id="cal-new-contact-id" />
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-service">@T["contacts.table.service"] <span class="opt">@T["common.optional"]</span></label>
                    <select id="cal-new-service" class="au-select"><option value="">@T["common.loading"]</option></select>
                </div>
                <div class="au-form-grid cal-when">
                    <div class="au-form-field">
                        <label class="au-form-label" for="cal-new-date">@T["bookings.new.date"]<span class="au-required">*</span></label>
                        <input type="date" id="cal-new-date" class="au-input" required />
                    </div>
                    <div class="au-form-field">
                        <label class="au-form-label" for="cal-new-time">@T["bookings.new.time"]<span class="au-required">*</span></label>
                        <input type="time" id="cal-new-time" class="au-input" value="09:00" required />
                        <span class="au-help" id="cal-new-tz-hint"></span>
                    </div>
                    <div class="au-form-field au-span-2">
                        <label class="au-form-label" for="cal-new-duration">@T["bookings.new.duration"]</label>
                        <input type="number" id="cal-new-duration" class="au-input" value="30" min="5" max="1440" step="5" list="cal-duration-options" />
                        <datalist id="cal-duration-options">
                            <option value="15"></option><option value="30"></option><option value="45"></option><option value="60"></option>
                            <option value="90"></option><option value="120"></option><option value="180"></option><option value="240"></option>
                        </datalist>
                        <span class="au-help" id="cal-new-range"></span>
                    </div>
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-location">@T["bookings.where"] <span class="opt">@T["common.optional"]</span></label>
                    <select id="cal-new-location" class="au-select">
                        <option value="">@T["bookings.location.notSet"]</option>
                        <option value="in_person">@T["bookings.location.inPerson"]</option>
                        <option value="video">@T["bookings.location.video"]</option>
                        <option value="phone">@T["bookings.location.phone"]</option>
                    </select>
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-notes">@T["bookings.notes"] <span class="opt">@T["common.optional"]</span></label>
                    <textarea id="cal-new-notes" class="au-textarea" rows="2"></textarea>
                </div>
                <div class="au-form-actions">
                    <button type="button" class="au-btn au-btn--text" id="cal-new-cancel">@T["common.cancel"]</button>
                    <button type="button" class="au-btn au-btn--primary" id="cal-new-save">@T["bookings.new.create"]</button>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Booking details (opens from a calendar chip or a day-panel row) ---------- *@
    <div class="bm-overlay" id="cal-appt-overlay" hidden>
        <div class="card cal-modal" role="dialog" aria-modal="true" aria-labelledby="cal-appt-name">
            <div class="modal-head">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="avatar-md" id="cal-appt-avatar"></span>
                    <div class="min-w-0">
                        <h3 id="cal-appt-name" class="card-title"></h3>
                        <div class="text-muted text-sm" id="cal-appt-when"></div>
                    </div>
                </div>
                <button type="button" class="au-icon-btn" id="cal-appt-close" aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            <div id="cal-appt-error" class="connect-error modal-error" role="alert"></div>
            <div class="mb-2">
                <div class="inbox-contact-info-row"><span>@T["contacts.table.service"]</span><strong id="cal-appt-service">—</strong></div>
                <div class="inbox-contact-info-row"><span>@T["bookings.where"]</span><strong id="cal-appt-location">—</strong></div>
                <div class="inbox-contact-info-row" id="cal-appt-notes-row"><span>@T["bookings.notes"]</span><strong id="cal-appt-notes">—</strong></div>
            </div>
            <div class="au-form-field">
                <label class="au-form-label" for="cal-appt-status">@T["bookings.status"]</label>
                <select id="cal-appt-status" class="au-select">
                    <option value="booked">@T["values.booked"]</option>
                    <option value="confirmed">@T["values.confirmed"]</option>
                    <option value="attended">@T["values.attended"]</option>
                    <option value="no_show">@T["values.noShow"]</option>
                    <option value="canceled">@T["values.canceled"]</option>
                    <option value="rescheduled">@T["values.rescheduled"]</option>
                </select>
            </div>
            <div class="cal-appt-links">
                <a class="au-link" id="cal-appt-contact" href="#">@T["bookings.openContact"]</a>
                <a class="au-link" id="cal-appt-full" href="#">@T["bookings.openFullPage"]</a>
            </div>
            <div class="au-form-actions">
                <button type="button" class="au-btn au-btn--text" id="cal-appt-cancel">@T["common.cancel"]</button>
                <button type="button" class="au-btn au-btn--primary" id="cal-appt-save">@T["common.save"]</button>
            </div>
        </div>
    </div>

    <script src="~/js/bookings-calendar.js" asp-append-version="true"></script>
}
