@page "/Account/Register"
@model Omni.App.Pages.Account.RegisterModel
@{
    ViewData["Title"] = T["register.title"].Value;
    Layout = "_AuthLayout";
    var loginUrl = "/Account/Login" + (string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl));
    // The email already has an account: offer to sign in instead.
    var emailTaken = Model.EmailTaken;
}
@* auth.js reads [data-auth-form], [data-busy-label], [data-pw*] and [data-caps]; it rewrites the class of [data-pw-rule] and
   [data-pw-match], so those keep plain classes. *@
<div class="au-auth__card auth-card-wide">
    <div class="au-auth__brand">
        <span class="au-brand__mark"><img class="auth-logo" src="~/logo.svg" alt="" width="56" height="56" /></span>
        <div>
            <h1 class="au-auth__title">@T["register.title"]</h1>
            <p class="au-auth__sub">@T["register.subtitle"]</p>
        </div>
    </div>

    @if (!Model.SignupOpen)
    {
        <div class="au-alert au-alert--warning" role="status">
            <span class="au-icon au-alert__icon" aria-hidden="true">info</span>
            <div class="au-alert__body">@T["register.closed"]</div>
        </div>
        <p class="au-auth__foot">@T["register.haveAccount"] <a class="au-link" href="@loginUrl">@T["login.submit"]</a></p>
    }
    else
    {
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="au-alert au-alert--error" role="alert">
            <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
            <div class="au-alert__body">
                @if (emailTaken)
                {
                    <text>@T["register.emailTaken"] <a class="au-link" href="@loginUrl">@T["register.signInInstead"]</a></text>
                }
                else
                {
                    @Model.ErrorMessage
                }
            </div>
        </div>
    }

    <partial name="_GoogleButton" model="Model.ReturnUrl" />

    <form method="post" class="au-auth__form" data-auth-form data-au-no-busy>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-name">@T["register.fullName"]</label>
            <input type="text" name="FullName" id="reg-name" value="@Model.FullName" class="au-input" autocomplete="name" maxlength="200" required autofocus placeholder="@T["register.fullNamePlaceholder"]" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-email">@T["auth.email"]</label>
            <input type="email" name="Email" id="reg-email" value="@Model.Email" class="au-input" autocomplete="username" required placeholder="@T["auth.emailPlaceholder"]" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-client">@T["signup.clientName"]</label>
            <input type="text" name="ClientName" id="reg-client" value="@Model.ClientName" class="au-input" autocomplete="organization" maxlength="200" required
                   placeholder="@T["signup.clientNamePlaceholder"]" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-business-type">@T["signup.businessType.label"]</label>
            <select name="BusinessTypeCode" id="reg-business-type" class="au-select" required aria-describedby="reg-business-type-help">
                <option value="" selected="@string.IsNullOrEmpty(Model.BusinessTypeCode)" disabled>@T["signup.businessType.placeholder"]</option>
                @foreach (var type in Model.BusinessTypes)
                {
                    <option value="@type.Code" selected="@(type.Code == Model.BusinessTypeCode)">@type.Name</option>
                }
            </select>
            <small class="au-help" id="reg-business-type-help">@T["signup.businessType.help"]</small>
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-password">@T["auth.password"]</label>
            <span class="pw-wrap">
                <input type="password" name="Password" id="reg-password" class="au-input" autocomplete="new-password" required minlength="6" data-pw data-pw-new />
                <button type="button" class="pw-eye" data-pw-toggle aria-label="@T["auth.password.show"]" title="@T["auth.password.show"]">👁</button>
            </span>
            <small class="text-subtle" data-pw-rule>@T["register.passwordRule"]</small>
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-confirm">@T["register.confirmPassword"]</label>
            <span class="pw-wrap">
                <input type="password" name="ConfirmPassword" id="reg-confirm" class="au-input" autocomplete="new-password" required minlength="6" data-pw data-pw-confirm />
                <button type="button" class="pw-eye" data-pw-toggle aria-label="@T["auth.password.show"]" title="@T["auth.password.show"]">👁</button>
            </span>
            <small data-pw-match hidden></small>
        </div>
        <div class="caps-warn" data-caps hidden>⇪ @T["auth.password.capsLock"]</div>

        <button type="submit" class="au-btn au-btn--primary au-btn--lg au-btn--block" data-busy-label="@T["register.submitBusy"]">@T["register.submit"]</button>
    </form>

    <p class="au-auth__foot">@T["register.haveAccount"] <a class="au-link" href="@loginUrl">@T["login.submit"]</a></p>
    }
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
