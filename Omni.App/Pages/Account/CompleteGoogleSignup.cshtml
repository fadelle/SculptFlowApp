@page "/Account/CompleteGoogleSignup"
@model Omni.App.Pages.Account.CompleteGoogleSignupModel
@{
    ViewData["Title"] = T["signup.google.title"].Value;
    Layout = "_AuthLayout";
}
<div class="au-auth__card">
    <div class="au-auth__brand">
        <span class="au-brand__mark"><img class="auth-logo" src="~/logo.svg" alt="" width="56" height="56" /></span>
        <div>
            <h1 class="au-auth__title">@T["signup.google.heading"]</h1>
            <p class="au-auth__sub">@T["signup.google.subtitle"]</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="au-alert au-alert--error" role="alert">
            <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
            <div class="au-alert__body">@Model.ErrorMessage</div>
        </div>
    }

    <div class="auth-identity">
        @T["signup.google.identity"]
        <strong>@(string.IsNullOrWhiteSpace(Model.FullName) ? Model.Email : Model.FullName)</strong>
        @if (!string.IsNullOrWhiteSpace(Model.FullName)) { <span class="text-subtle"> · @Model.Email</span> }
    </div>

    @* auth.js reads [data-auth-form] and [data-busy-label]. *@
    <form method="post" class="au-auth__form" data-auth-form data-au-no-busy>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="au-form-field">
            <label class="au-form-label" for="google-client">@T["signup.clientName"]</label>
            <input type="text" name="ClientName" id="google-client" value="@Model.ClientName" class="au-input" autocomplete="organization" maxlength="200" required autofocus
                   placeholder="@T["signup.clientNamePlaceholder"]" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="google-business-type">@T["signup.businessType.label"]</label>
            <select name="BusinessTypeCode" id="google-business-type" class="au-select" required aria-describedby="google-business-type-help">
                <option value="" selected="@string.IsNullOrEmpty(Model.BusinessTypeCode)" disabled>@T["signup.businessType.placeholder"]</option>
                @foreach (var type in Model.BusinessTypes)
                {
                    <option value="@type.Code" selected="@(type.Code == Model.BusinessTypeCode)">@type.Name</option>
                }
            </select>
            <small class="au-help" id="google-business-type-help">@T["signup.businessType.help"]</small>
        </div>
        <button type="submit" class="au-btn au-btn--primary au-btn--lg au-btn--block" data-busy-label="@T["signup.google.submitBusy"]">@T["signup.google.submit"]</button>
    </form>

    <p class="au-auth__foot"><a class="au-link" href="/Account/Login">@T["signup.google.otherAccount"]</a></p>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
