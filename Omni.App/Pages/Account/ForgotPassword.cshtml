@page "/Account/ForgotPassword"
@model Omni.App.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = T["forgotPassword.title"].Value;
    Layout = "_AuthLayout";
}
@* auth.js reads [data-auth-form] and [data-busy-label]. *@
<div class="au-auth__card">
    <div class="au-auth__brand">
        <span class="au-brand__mark"><img class="auth-logo" src="~/logo.svg" alt="" width="56" height="56" /></span>
        <div>
            <h1 class="au-auth__title">@T["forgotPassword.heading"]</h1>
            <p class="au-auth__sub">@T["forgotPassword.subtitle"]</p>
        </div>
    </div>

    @if (Model.Sent)
    {
        <div class="au-alert au-alert--success" role="status">
            <span class="au-icon au-alert__icon" aria-hidden="true">check_circle</span>
            <div class="au-alert__body">@T["forgotPassword.sent"]</div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="au-alert au-alert--error" role="alert">
                <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
                <div class="au-alert__body">@Model.ErrorMessage</div>
            </div>
        }

        <form method="post" class="au-auth__form" data-auth-form data-au-no-busy>
            <div class="au-form-field">
                <label class="au-form-label" for="forgot-email">@T["auth.email"]</label>
                <input type="email" name="Email" id="forgot-email" value="@Model.Email" class="au-input" dir="ltr" autocomplete="username" placeholder="@T["auth.emailPlaceholder"]" required autofocus />
            </div>
            <button type="submit" class="au-btn au-btn--primary au-btn--lg au-btn--block" data-busy-label="@T["forgotPassword.submitBusy"]">@T["forgotPassword.submit"]</button>
        </form>
    }

    <p class="au-auth__foot">
        <a class="au-link" href="/Account/Login">@T["forgotPassword.backToSignIn"]</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
