@page "/inbox"
@model Omni.App.Pages.Inbox.IndexModel
@{
    ViewData["Title"] = T["inbox.title"].Value;
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts

    // Presentation only — mirrors initials()/modeLabel() in wwwroot/js/inbox.js, which re-renders this list on load.
    static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1 ? parts[0][..1] : string.Concat(parts[0][..1], parts[^1][..1]);
    }
    string ModeLabel(string mode) => mode switch { "ai" => T["inbox.mode.ai"], "human" => T["inbox.mode.human"], "approval" => T["inbox.mode.approval"], _ => mode };
    var unknownName = T["inbox.unknownName"].Value;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    @* Every id, data-* attribute and inbox-* class below is read by wwwroot/js/inbox.js (it re-renders the list and the
       thread); only the static controls use kit classes. *@
    <div class="inbox-shell" id="inbox-shell">
        <div class="inbox-sidebar">
            <div class="inbox-list-head">
                <input type="search" class="text-input search-input" id="inbox-search" placeholder="@T["inbox.search.placeholder"]" aria-label="@T["inbox.search.label"]" autocomplete="off" />
                <div class="inbox-filters" role="tablist" aria-label="@T["inbox.filter.label"]">
                    <button type="button" class="inbox-filter active" data-filter="all">@T["inbox.filter.all"] <span class="inbox-filter-count" data-count="all"></span></button>
                    <button type="button" class="inbox-filter" data-filter="needs">@T["inbox.filter.needs"] <span class="inbox-filter-count" data-count="needs"></span></button>
                    <button type="button" class="inbox-filter" data-filter="ai">@T["inbox.mode.ai"] <span class="inbox-filter-count" data-count="ai"></span></button>
                    <button type="button" class="inbox-filter" data-filter="closed">@T["inbox.filter.closed"] <span class="inbox-filter-count" data-count="closed"></span></button>
                </div>
            </div>
            <div class="inbox-list" id="inbox-list">
                @foreach (var c in Model.Conversations)
                {
                    <div class="inbox-conv-item" data-conversation-id="@c.Id" data-contact-name="@(c.ContactFullName ?? unknownName)" data-service-name="@(c.ServiceName ?? "")" data-channel="@c.Channel">
                        <span class="inbox-avatar">
                            @Initials(c.ContactFullName)
                            <span class="inbox-channel-icon" style="background:@Omni.App.Common.Helpers.ChannelIconHelper.Hex(c.Channel)" title="@c.Channel">
                                @{ var svg = Omni.App.Common.Helpers.ChannelIconHelper.Svg(c.Channel); }
                                @if (svg is not null)
                                {
                                    @Html.Raw(svg)
                                }
                                else
                                {
                                    @Omni.App.Common.Helpers.ChannelIconHelper.Initials(c.Channel)
                                }
                            </span>
                        </span>
                        <div class="inbox-conv-main">
                            <div class="inbox-conv-top">
                                <span class="inbox-conv-name">@(c.ContactFullName ?? unknownName)</span>
                                <span class="inbox-conv-time" data-timestamp="@((c.LastMessageAt ?? c.CreatedAt).ToString("O"))"></span>
                            </div>
                            @if (!string.IsNullOrEmpty(c.ServiceName))
                            {
                                <div class="inbox-conv-service">@c.ServiceName</div>
                            }
                            <div class="inbox-conv-bottom">
                                <span class="inbox-conv-preview">@(c.LastMessagePreview ?? T["inbox.list.noMessages"].Value)</span>
                                <span class="inbox-mode inbox-mode-@c.Mode">@ModeLabel(c.Mode)</span>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Conversations.Count == 0)
                {
                    <div class="inbox-list-message">@T["inbox.list.empty"]</div>
                }
            </div>
        </div>

        <div class="inbox-thread" id="inbox-thread">
            <div class="inbox-empty" id="inbox-empty">
                <span class="au-empty__icon"><span class="au-icon" aria-hidden="true">forum</span></span>
                <p class="empty-title">@T["inbox.thread.emptyTitle"]</p>
                <p class="empty-text">@T["inbox.thread.emptyText"]</p>
            </div>

            <div class="inbox-thread-inner" id="inbox-thread-inner" hidden>
                <div class="inbox-thread-header">
                    <button type="button" class="au-icon-btn inbox-back" id="inbox-btn-back" aria-label="@T["inbox.thread.back"]" title="@T["inbox.thread.back"]">
                        <span class="au-icon" aria-hidden="true">arrow_back</span>
                    </button>
                    <span class="inbox-avatar" id="inbox-thread-avatar"></span>
                    <div class="inbox-thread-who">
                        <div class="inbox-thread-name" id="inbox-thread-name"></div>
                        <div class="inbox-thread-service text-subtle" id="inbox-thread-service"></div>
                    </div>
                    <div class="inbox-thread-actions">
                        <span class="inbox-mode" id="inbox-thread-mode"></span>
                        <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="inbox-btn-takeover">@T["inbox.thread.takeOver"]</button>
                        <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="inbox-btn-return-ai">@T["inbox.thread.returnToAi"]</button>
                        <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="inbox-btn-reopen" title="@T["inbox.thread.reopenHelp"]" hidden>@T["inbox.thread.reopen"]</button>
                        <button type="button" class="au-btn au-btn--text au-btn--sm" id="inbox-btn-info" title="@T["inbox.contact.show"]" aria-label="@T["inbox.contact.show"]">
                            <span class="au-icon" aria-hidden="true">info</span>@T["inbox.thread.info"]
                        </button>
                        <div class="inbox-more">
                            <button type="button" class="au-icon-btn au-icon-btn--sm" id="inbox-btn-more" title="@T["inbox.thread.more"]" aria-label="@T["inbox.thread.more"]" aria-haspopup="menu" aria-expanded="false">
                                <span class="au-icon" aria-hidden="true">more_horiz</span>
                            </button>
                            <div class="inbox-more-menu" id="inbox-more-menu" role="menu" hidden>
                                <button type="button" class="user-menu-item user-menu-danger" id="inbox-btn-close" role="menuitem">
                                    <span class="au-icon" aria-hidden="true">block</span>@T["inbox.thread.close"]
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="inbox-messages" id="inbox-messages"></div>

                <div class="inbox-window-closed-notice" id="inbox-window-closed-notice" hidden>
                    @T["inbox.thread.windowClosed"]
                </div>

                <form class="inbox-composer" id="inbox-composer">
                    <textarea class="inbox-composer-input" id="inbox-composer-input" placeholder="@T["inbox.composer.placeholder"]" rows="2" aria-label="@T["inbox.composer.label"]"></textarea>
                    <div class="inbox-composer-bar">
                        <button type="button" class="au-btn au-btn--text-primary au-btn--sm" id="inbox-btn-send-template">
                            <span class="au-icon" aria-hidden="true">description</span>@T["inbox.composer.sendTemplate"]
                        </button>
                        <span class="inbox-composer-hint">@T["inbox.composer.hint"]</span>
                        <button type="submit" class="au-btn au-btn--primary au-btn--sm" id="inbox-composer-send">
                            <span class="au-icon" aria-hidden="true">send</span>@T["inbox.composer.send"]
                        </button>
                    </div>
                </form>

                <form class="inbox-template-picker" id="inbox-template-picker" hidden>
                    <span class="eyebrow">@T["inbox.template.title"]</span>
                    <select class="select" id="inbox-template-select" aria-label="@T["inbox.template.label"]"></select>
                    <div id="inbox-template-variables"></div>
                    <div id="inbox-template-preview" class="inbox-template-preview"></div>
                    <div class="flex items-center gap-2">
                        <button type="submit" class="au-btn au-btn--primary au-btn--sm" id="inbox-template-send">
                            <span class="au-icon" aria-hidden="true">send</span>@T["inbox.composer.send"]
                        </button>
                        <button type="button" class="au-btn au-btn--text au-btn--sm" id="inbox-template-cancel">@T["common.cancel"]</button>
                    </div>
                </form>
            </div>
        </div>

        <aside class="inbox-contact-info" id="inbox-contact-info" hidden>
            <div class="inbox-contact-head">
                <button type="button" class="au-icon-btn au-icon-btn--sm inbox-contact-close" id="inbox-contact-close" aria-label="@T["inbox.contact.hide"]" title="@T["inbox.contact.hide"]">
                    <span class="au-icon" aria-hidden="true">close</span>
                </button>
                <span class="inbox-avatar inbox-avatar-lg" id="inbox-contact-avatar"></span>
                <strong id="inbox-contact-name">—</strong>
                <span class="badge badge-gray" id="inbox-contact-stage">—</span>
            </div>

            <div class="inbox-contact-section" id="inbox-contact-journey-wrap">
                <span class="eyebrow">@T["inbox.contact.journey"]</span>
                <div class="journey" id="inbox-contact-journey">@foreach (var _ in IndexModel.JourneyCategories){<i></i>}</div>
                <div class="journey-labels">@foreach (var category in IndexModel.JourneyCategories){<span>@Model.JourneyLabel(category)</span>}</div>
            </div>

            <div class="inbox-contact-section">
                <span class="eyebrow">@T["inbox.contact.details"]</span>
                <div class="inbox-contact-info-row"><span>@T["inbox.contact.phone"]</span><strong id="inbox-contact-phone">—</strong></div>
                <div class="inbox-contact-info-row"><span>@T["inbox.contact.email"]</span><strong id="inbox-contact-email">—</strong></div>
                <div class="inbox-contact-info-row"><span>@T["inbox.contact.service"]</span><strong id="inbox-contact-service">—</strong></div>
                <div class="inbox-contact-info-row"><span>@T["inbox.contact.source"]</span><strong id="inbox-contact-source">—</strong></div>
                <div class="inbox-contact-info-row"><span>@T["inbox.contact.timeline"]</span><strong id="inbox-contact-timeline">—</strong></div>
                <div class="inbox-contact-info-row"><span>@T["inbox.contact.nextFollowUp"]</span><strong id="inbox-contact-followup">—</strong></div>
                <div class="inbox-contact-info-row"><span>@T["inbox.contact.since"]</span><strong id="inbox-contact-created">—</strong></div>
            </div>

            <div class="inbox-contact-actions">
                <a class="au-btn au-btn--outlined" id="inbox-contact-profile" href="#"><span class="au-icon" aria-hidden="true">person</span>@T["inbox.contact.profile"]</a>
                <a class="au-btn au-btn--outlined" href="/dashboard/bookings"><span class="au-icon" aria-hidden="true">calendar_month</span>@T["inbox.contact.bookings"]</a>
            </div>
        </aside>
    </div>
}

<script>
    window.PS_INBOX_CONFIG = {
        clientId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClientId.ToString())),
        aiAssistantAvailable: @(Model.AiAssistantAvailable ? "true" : "false"),
        stages: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Pipeline.Stages, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))),
        journeyCategories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(IndexModel.JourneyCategories)),
        hubUrl: '/hubs/inbox'
    };
</script>
<script src="~/js/inbox-voice.js" asp-append-version="true"></script>
<script src="~/js/inbox.js" asp-append-version="true"></script>
