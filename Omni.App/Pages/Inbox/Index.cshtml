@page "/inbox"
@model Omni.App.Pages.Inbox.IndexModel
@{
    ViewData["Title"] = "Inbox";
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts

    // Presentation only — mirrors initials()/modeLabel() in wwwroot/js/inbox.js, which re-renders this list on load.
    static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1 ? parts[0][..1] : string.Concat(parts[0][..1], parts[^1][..1]);
    }
    static string ModeLabel(string mode) => mode switch { "ai" => "AI", "human" => "Staff", "approval" => "Approval", _ => mode };
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    @* Every id, data-* attribute and inbox-* class below is read by wwwroot/js/inbox.js (it re-renders the list and the
       thread); only the static controls use kit classes. *@
    <div class="inbox-shell" id="inbox-shell">
        <div class="inbox-sidebar">
            <div class="inbox-list-head">
                <input type="search" class="text-input search-input" id="inbox-search" placeholder="Search name or phone" aria-label="Search conversations" autocomplete="off" />
                <div class="inbox-filters" role="tablist" aria-label="Filter conversations">
                    <button type="button" class="inbox-filter active" data-filter="all">All <span class="inbox-filter-count" data-count="all"></span></button>
                    <button type="button" class="inbox-filter" data-filter="needs">Needs you <span class="inbox-filter-count" data-count="needs"></span></button>
                    <button type="button" class="inbox-filter" data-filter="ai">AI <span class="inbox-filter-count" data-count="ai"></span></button>
                    <button type="button" class="inbox-filter" data-filter="closed">Closed <span class="inbox-filter-count" data-count="closed"></span></button>
                </div>
            </div>
            <div class="inbox-list" id="inbox-list">
                @foreach (var c in Model.Conversations)
                {
                    <div class="inbox-conv-item" data-conversation-id="@c.Id" data-contact-name="@(c.ContactFullName ?? "Unknown")" data-service-name="@(c.ServiceName ?? "")" data-channel="@c.Channel">
                        <span class="inbox-avatar">
                            @Initials(c.ContactFullName)
                            <span class="inbox-channel-icon" style="background:@Omni.App.Common.Helpers.ChannelIconHelper.Hex(c.Channel)" title="@c.Channel">
                                @{ var svg = Omni.App.Common.Helpers.ChannelIconHelper.Svg(c.Channel); }
                                @if (svg is not null)
                                {
                                    @Html.Raw(svg)
                                }
                                else
                                {
                                    @Omni.App.Common.Helpers.ChannelIconHelper.Initials(c.Channel)
                                }
                            </span>
                        </span>
                        <div class="inbox-conv-main">
                            <div class="inbox-conv-top">
                                <span class="inbox-conv-name">@(c.ContactFullName ?? "Unknown")</span>
                                <span class="inbox-conv-time" data-timestamp="@((c.LastMessageAt ?? c.CreatedAt).ToString("O"))"></span>
                            </div>
                            @if (!string.IsNullOrEmpty(c.ServiceName))
                            {
                                <div class="inbox-conv-service">@c.ServiceName</div>
                            }
                            <div class="inbox-conv-bottom">
                                <span class="inbox-conv-preview">@(c.LastMessagePreview ?? "No messages yet")</span>
                                <span class="inbox-mode inbox-mode-@c.Mode">@ModeLabel(c.Mode)</span>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Conversations.Count == 0)
                {
                    <div class="inbox-list-message">No conversations yet.</div>
                }
            </div>
        </div>

        <div class="inbox-thread" id="inbox-thread">
            <div class="inbox-empty" id="inbox-empty">
                <span class="au-empty__icon"><span class="au-icon" aria-hidden="true">forum</span></span>
                <p class="empty-title">Pick a conversation</p>
                <p class="empty-text">When a contact writes to your client, the conversation shows up on the left.</p>
            </div>

            <div class="inbox-thread-inner" id="inbox-thread-inner" hidden>
                <div class="inbox-thread-header">
                    <button type="button" class="au-icon-btn inbox-back" id="inbox-btn-back" aria-label="Back to conversations" title="Back to conversations">
                        <span class="au-icon" aria-hidden="true">arrow_back</span>
                    </button>
                    <span class="inbox-avatar" id="inbox-thread-avatar"></span>
                    <div class="inbox-thread-who">
                        <div class="inbox-thread-name" id="inbox-thread-name"></div>
                        <div class="inbox-thread-service text-subtle" id="inbox-thread-service"></div>
                    </div>
                    <div class="inbox-thread-actions">
                        <span class="inbox-mode" id="inbox-thread-mode"></span>
                        <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="inbox-btn-takeover">Take over</button>
                        <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="inbox-btn-return-ai">Return to AI</button>
                        <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="inbox-btn-reopen" title="Move this conversation back to the working list" hidden>Reopen</button>
                        <button type="button" class="au-btn au-btn--text au-btn--sm" id="inbox-btn-info" title="Customer info" aria-label="Customer info">
                            <span class="au-icon" aria-hidden="true">info</span>Info
                        </button>
                        <div class="inbox-more">
                            <button type="button" class="au-icon-btn au-icon-btn--sm" id="inbox-btn-more" title="More actions" aria-label="More actions" aria-haspopup="menu" aria-expanded="false">
                                <span class="au-icon" aria-hidden="true">more_horiz</span>
                            </button>
                            <div class="inbox-more-menu" id="inbox-more-menu" role="menu" hidden>
                                <button type="button" class="user-menu-item user-menu-danger" id="inbox-btn-close" role="menuitem">
                                    <span class="au-icon" aria-hidden="true">block</span>Close conversation
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="inbox-messages" id="inbox-messages"></div>

                <div class="inbox-window-closed-notice" id="inbox-window-closed-notice" hidden>
                    The 24-hour WhatsApp window is closed. To reach this person, send an approved template.
                </div>

                <form class="inbox-composer" id="inbox-composer">
                    <textarea class="inbox-composer-input" id="inbox-composer-input" placeholder="Write a reply…" rows="2" aria-label="Your reply"></textarea>
                    <div class="inbox-composer-bar">
                        <button type="button" class="au-btn au-btn--text-primary au-btn--sm" id="inbox-btn-send-template">
                            <span class="au-icon" aria-hidden="true">description</span>Send template
                        </button>
                        <span class="inbox-composer-hint">Enter to send · Shift+Enter for a new line</span>
                        <button type="submit" class="au-btn au-btn--primary au-btn--sm" id="inbox-composer-send">
                            <span class="au-icon" aria-hidden="true">send</span>Send
                        </button>
                    </div>
                </form>

                <form class="inbox-template-picker" id="inbox-template-picker" hidden>
                    <span class="eyebrow">Send an approved template</span>
                    <select class="select" id="inbox-template-select" aria-label="Template"></select>
                    <div id="inbox-template-variables"></div>
                    <div id="inbox-template-preview" class="inbox-template-preview"></div>
                    <div class="flex items-center gap-2">
                        <button type="submit" class="au-btn au-btn--primary au-btn--sm" id="inbox-template-send">
                            <span class="au-icon" aria-hidden="true">send</span>Send
                        </button>
                        <button type="button" class="au-btn au-btn--text au-btn--sm" id="inbox-template-cancel">Cancel</button>
                    </div>
                </form>
            </div>
        </div>

        <aside class="inbox-contact-info" id="inbox-contact-info" hidden>
            <div class="inbox-contact-head">
                <button type="button" class="au-icon-btn au-icon-btn--sm inbox-contact-close" id="inbox-contact-close" aria-label="Hide customer info" title="Hide customer info">
                    <span class="au-icon" aria-hidden="true">close</span>
                </button>
                <span class="inbox-avatar inbox-avatar-lg" id="inbox-contact-avatar"></span>
                <strong id="inbox-contact-name">—</strong>
                <span class="badge badge-gray" id="inbox-contact-stage">—</span>
            </div>

            <div class="inbox-contact-section" id="inbox-contact-journey-wrap">
                <span class="eyebrow">Journey</span>
                <div class="journey" id="inbox-contact-journey">@foreach (var _ in IndexModel.JourneyCategories){<i></i>}</div>
                <div class="journey-labels">@foreach (var category in IndexModel.JourneyCategories){<span>@Model.JourneyLabel(category)</span>}</div>
            </div>

            <div class="inbox-contact-section">
                <span class="eyebrow">Details</span>
                <div class="inbox-contact-info-row"><span>Phone</span><strong id="inbox-contact-phone">—</strong></div>
                <div class="inbox-contact-info-row"><span>Email</span><strong id="inbox-contact-email">—</strong></div>
                <div class="inbox-contact-info-row"><span>Service</span><strong id="inbox-contact-service">—</strong></div>
                <div class="inbox-contact-info-row"><span>Source</span><strong id="inbox-contact-source">—</strong></div>
                <div class="inbox-contact-info-row"><span>Timeline</span><strong id="inbox-contact-timeline">—</strong></div>
                <div class="inbox-contact-info-row"><span>Next follow-up</span><strong id="inbox-contact-followup">—</strong></div>
                <div class="inbox-contact-info-row"><span>Contact since</span><strong id="inbox-contact-created">—</strong></div>
            </div>

            <div class="inbox-contact-actions">
                <a class="au-btn au-btn--outlined" id="inbox-contact-profile" href="#"><span class="au-icon" aria-hidden="true">person</span>Open full profile</a>
                <a class="au-btn au-btn--outlined" href="/dashboard/bookings"><span class="au-icon" aria-hidden="true">calendar_month</span>Go to Bookings</a>
            </div>
        </aside>
    </div>
}

<script>
    window.PS_INBOX_CONFIG = {
        clientId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClientId.ToString())),
        aiAgentAvailable: @(Model.AiAgentAvailable ? "true" : "false"),
        stages: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Pipeline.Stages, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))),
        journeyCategories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(IndexModel.JourneyCategories)),
        hubUrl: '/hubs/inbox'
    };
</script>
<script src="~/js/inbox-voice.js" asp-append-version="true"></script>
<script src="~/js/inbox.js" asp-append-version="true"></script>
