@page "/Campaigns/Create"
@model Omni.App.Pages.Campaigns.CreateModel
@{
    ViewData["Title"] = T["campaigns.new"].Value;
    var hasTemplate = Model.SelectedTemplate is not null;
    var hasBlanks = Model.PlaceholderNumbers.Count > 0;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/Campaigns" aria-label="@T["campaigns.back"]" title="@T["campaigns.back"]">
            <span class="au-icon au-icon--dir" aria-hidden="true">arrow_back</span>
        </a>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@T["campaigns.new"]</h2>
            <span class="au-back-header__sub">@T["campaigns.create.sub"]</span>
        </div>
    </div>

    <partial name="_Messages" model="new PageMessagesModel(null, Model.ErrorMessage)" />

    @if (Model.ApprovedTemplates.Count == 0)
    {
        var empty = new EmptyStateModel(Icon: "description", Title: T["campaigns.create.noTemplateTitle"].Value,
            Text: T["campaigns.create.noTemplateText"].Value,
            ActionLabel: T["campaigns.create.noTemplateAction"].Value, ActionHref: "/WhatsApp/Templates", ActionIcon: "arrow_forward");
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="empty" /></div>
    }
    else
    {
        <form method="post" id="campaign-form" class="create-wrap">
            <input type="hidden" name="WhatsAppTemplateId" value="@Model.WhatsAppTemplateId" />

            @* ---------------- 1. Message ---------------- *@
            <section class="step au-panel au-panel--round">
                <div class="step-head"><span class="step-num">1</span><h3>@T["campaigns.create.step.message"]</h3></div>
                <div class="msg-grid">
                    <div>
                        <label class="field">
                            <span>@T["campaigns.create.name"]</span>
                            <input type="text" name="Name" id="campaign-name" value="@Model.Name" class="text-input" placeholder="@T["campaigns.create.namePlaceholder"]" required />
                        </label>
                        <label class="field mt-2">
                            <span>@T["campaigns.create.template"]</span>
                            @* Picking a template reloads the page with it (keeping the name typed so far) — see campaign-create.js. *@
                            <select id="template-select" class="select">
                                <option value="">@T["campaigns.create.templatePlaceholder"]</option>
                                @foreach (var t in Model.ApprovedTemplates)
                                {
                                    <option value="@t.Id" selected="@(t.Id == Model.WhatsAppTemplateId)">@t.Name (@t.Language)</option>
                                }
                            </select>
                        </label>

                        @if (hasTemplate && hasBlanks)
                        {
                            <div class="alert alert-warning mt-2 text-sm" id="blanks-warning" hidden>
                                @T.Html("campaigns.create.blanksWarning", string.Join(", ", Model.PlaceholderNumbers.Select(n => "{{" + n + "}}")), new Microsoft.AspNetCore.Html.HtmlString($"<strong>{System.Net.WebUtility.HtmlEncode(T["campaigns.create.blanksWarningManual"].Value)}</strong>"))
                            </div>
                            <div class="field mt-2" id="blanks-fields">
                                <span>@T["campaigns.create.fillBlanks"]</span>
                                @foreach (var n in Model.PlaceholderNumbers)
                                {
                                    var current = Model.Variables.GetValueOrDefault(n) ?? "{ContactFirstName}";
                                    var isToken = current is "{ContactFirstName}" or "{ContactFullName}" or "{ContactPhone}";
                                    <div class="var-row" data-var="@n">
                                        <span class="var-tag">{{@n}}</span>
                                        <select class="select var-mode" aria-label="@T["campaigns.create.valueFor", "{{" + n + "}}"]">
                                            <option value="{ContactFirstName}" selected="@(current == "{ContactFirstName}")">@T["campaigns.create.var.firstName"]</option>
                                            <option value="{ContactFullName}" selected="@(current == "{ContactFullName}")">@T["campaigns.create.var.fullName"]</option>
                                            <option value="{ContactPhone}" selected="@(current == "{ContactPhone}")">@T["campaigns.create.var.phone"]</option>
                                            <option value="__text" selected="@(!isToken)">@T["campaigns.create.var.sameText"]</option>
                                        </select>
                                        <input type="text" class="text-input var-text" placeholder="@T["campaigns.create.textFor", "{{" + n + "}}"]" value="@(isToken ? "" : current)" hidden="@isToken" />
                                        <input type="hidden" name="Variables[@n]" class="var-value" value="@current" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div>
                        <span class="eyebrow">@T["campaigns.create.preview"]</span>
                        @if (hasTemplate)
                        {
                            <div class="wa-preview"><div class="wa-bubble" id="wa-bubble" dir="auto" data-body="@Model.SelectedTemplate!.Body">@Model.SelectedTemplate.Body<span class="wa-time">09:00</span></div></div>
                        }
                        else
                        {
                            <div class="wa-preview wa-empty">@T["campaigns.create.previewEmpty"]</div>
                        }
                    </div>
                </div>
            </section>

            @if (!hasTemplate)
            {
                <section class="step au-panel au-panel--round"><div class="step-head"><span class="step-num">2</span><h3>@T["campaigns.create.step.audience"]</h3></div><div class="text-subtle text-sm">@T["campaigns.create.templateFirst"]</div></section>
                <section class="step au-panel au-panel--round"><div class="step-head"><span class="step-num">3</span><h3>@T["campaigns.create.step.when"]</h3></div><div class="text-subtle text-sm">@T["campaigns.create.templateFirst"]</div></section>
            }
            else
            {
                @* ---------------- 2. Audience ---------------- *@
                <section class="step au-panel au-panel--round">
                    <div class="step-head">
                        <span class="step-num">2</span><h3>@T["campaigns.create.step.audience"]</h3>
                        <button type="button" class="status-help-trigger" data-status-help-trigger title="@T["statusHelp.trigger.label"]" aria-label="@T["statusHelp.trigger.label"]">?</button>
                    </div>

                    @* These four radios are UI-only (not bound) — campaign-audience.js maps them onto the two hidden
                       fields actually posted (AudienceType, ManualSelection). *@
                    <div class="aud-grid">
                        <label class="aud-card">
                            <input type="radio" name="AudienceChoice" value="reactivation_no_booking" data-audience-choice checked="@(Model.AudienceChoice == "reactivation_no_booking")" />
                            <span class="aud-title">@T["campaigns.audience.reactivation"] <span class="badge badge-green">@T["campaigns.create.recommended"]</span></span>
                            <span class="aud-desc">@T["campaigns.create.reactivationDesc"]</span>
                        </label>
                        <label class="aud-card">
                            <input type="radio" name="AudienceChoice" value="all_eligible" data-audience-choice checked="@(Model.AudienceChoice == "all_eligible")" />
                            <span class="aud-title">@T["campaigns.audience.allEligible"]</span>
                            <span class="aud-desc">@T["campaigns.create.allEligibleDesc"]</span>
                        </label>
                        <label class="aud-card">
                            <input type="radio" name="AudienceChoice" value="custom" data-audience-choice checked="@(Model.AudienceChoice == "custom")" />
                            <span class="aud-title">@T["campaigns.audience.custom"]</span>
                            <span class="aud-desc">@T["campaigns.create.customDesc"]</span>
                        </label>
                        <label class="aud-card">
                            <input type="radio" name="AudienceChoice" value="manual" data-audience-choice checked="@(Model.AudienceChoice == "manual")" />
                            <span class="aud-title">@T["campaigns.create.manualTitle"]</span>
                            <span class="aud-desc">@T["campaigns.create.manualDesc"]</span>
                        </label>
                    </div>

                    <input type="hidden" name="AudienceType" id="audience-type-field" value="@Model.AudienceType" />
                    <input type="hidden" name="ManualSelection" id="manual-selection-field" value="@(Model.ManualSelection ? "true" : "false")" />

                    @* Old contacts who never booked *@
                    <div id="reactivation-panel" class="aud-panel" hidden>
                        <div class="filter-row">
                            <label class="field">
                                <span>@T["campaigns.create.inactiveFor"]</span>
                                <select name="InactiveDays" id="inactive-days" class="select">
                                    <option value="30" selected="@(Model.InactiveDays == 30)">@T["campaigns.create.days", 30]</option>
                                    <option value="60" selected="@(Model.InactiveDays == 60)">@T["campaigns.create.days", 60]</option>
                                    <option value="90" selected="@(Model.InactiveDays == 90)">@T["campaigns.create.days", 90]</option>
                                </select>
                            </label>
                            <label class="field">
                                <span>@T["contacts.table.service"]</span>
                                <select name="ReactivationServiceId" id="reactivation-service" class="select">
                                    <option value="">@T["campaigns.create.allServices"]</option>
                                    @foreach (var p in Model.Services)
                                    {
                                        <option value="@p.Id" selected="@(p.Id == Model.ReactivationServiceId)">@p.Name</option>
                                    }
                                </select>
                            </label>
                            @if (Model.ContactSources.Count > 0)
                            {
                                <label class="field">
                                    <span>@T["campaigns.create.contactSource"]</span>
                                    <select name="ReactivationSource" id="reactivation-source" class="select">
                                        <option value="">@T["campaigns.create.anySource"]</option>
                                        @foreach (var s in Model.ContactSources)
                                        {
                                            <option value="@s" selected="@(s == Model.ReactivationSource)">@T.ValueLabel(s)</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                        <div class="count-box">
                            <div><span class="count-num" id="reactivation-match-count">—</span> <span class="text-muted">@T["campaigns.create.count.reactivation"]</span></div>
                            <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-preview-btn data-preview-audience="reactivation_no_booking" data-preview-target="reactivation-preview-list">@T["campaigns.create.previewContacts"]</button>
                        </div>
                        <div id="reactivation-preview-list" class="preview-contacts-list" style="display:none"></div>
                    </div>

                    @* All reachable contacts *@
                    <div id="all-eligible-panel" class="aud-panel" hidden>
                        <div class="text-subtle text-sm mt-2">@T["campaigns.create.allEligibleHelp"]</div>
                        <div class="count-box">
                            <div><span class="count-num" id="all-eligible-match-count">—</span> <span class="text-muted">@T["campaigns.create.count.reachable"]</span></div>
                            <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-preview-btn data-preview-audience="all_eligible" data-preview-target="all-eligible-preview-list">@T["campaigns.create.previewContacts"]</button>
                        </div>
                        <div id="all-eligible-preview-list" class="preview-contacts-list" style="display:none"></div>
                    </div>

                    @* Custom audience — every filter in one grid *@
                    <div id="custom-panel" class="aud-panel" hidden>
                        <div class="filter-grid" id="advanced-filters">
                            <label class="field">
                                <span>@T["contacts.table.service"]</span>
                                <select name="CustomServiceId" id="custom-service" class="select">
                                    <option value="">@T["campaigns.create.allServices"]</option>
                                    @foreach (var p in Model.Services)
                                    {
                                        <option value="@p.Id" selected="@(p.Id == Model.CustomServiceId)">@p.Name</option>
                                    }
                                </select>
                            </label>
                            <label class="field">
                                <span>@T["campaigns.create.inactiveFor"]</span>
                                <select name="CustomInactiveDays" id="custom-inactive-days" class="select">
                                    <option value="" selected="@(Model.CustomInactiveDays is null)">@T["campaigns.create.anyTime"]</option>
                                    <option value="30" selected="@(Model.CustomInactiveDays == 30)">@T["campaigns.create.daysPlus", 30]</option>
                                    <option value="60" selected="@(Model.CustomInactiveDays == 60)">@T["campaigns.create.daysPlus", 60]</option>
                                    <option value="90" selected="@(Model.CustomInactiveDays == 90)">@T["campaigns.create.daysPlus", 90]</option>
                                </select>
                            </label>
                            <div class="field"><span>@T["contacts.table.stage"]</span>@{ await RenderMultiSelect("CustomStageKeys", T["campaigns.create.anyStage"].Value, Model.Stages.Select(s => s.Key).ToList(), Model.CustomStageKeys, key => StageDisplay.Label(Model.Stages, key)); }</div>
                            <div class="field"><span>@T["contacts.table.qualification"]</span>@{ await RenderMultiSelect("CustomQualifications", T["campaigns.create.any"].Value, Model.QualificationOptions, Model.CustomQualifications); }</div>
                            @if (Model.ContactSources.Count > 0)
                            {
                                <div class="field"><span>@T["campaigns.create.contactSource"]</span>@{ await RenderMultiSelect("CustomSources", T["campaigns.create.anySource"].Value, Model.ContactSources, Model.CustomSources); }</div>
                            }
                            <div class="field"><span>@T["campaigns.create.bookingStatus"]</span>@{ await RenderMultiSelect("CustomBookingStatuses", T["campaigns.create.any"].Value, Model.BookingStatusOptions, Model.CustomBookingStatuses); }</div>
                            <div class="field date-pair">
                                <span>@T["campaigns.create.created"]</span>
                                <div class="flex gap-1">
                                    <input type="date" name="CustomCreatedAfter" id="custom-created-after" class="text-input" value="@(Model.CustomCreatedAfter?.ToString("yyyy-MM-dd"))" aria-label="@T["campaigns.create.createdAfter"]" />
                                    <input type="date" name="CustomCreatedBefore" id="custom-created-before" class="text-input" value="@(Model.CustomCreatedBefore?.ToString("yyyy-MM-dd"))" aria-label="@T["campaigns.create.createdBefore"]" />
                                </div>
                            </div>
                            <div class="field date-pair">
                                <span>@T["campaigns.create.lastContacted"]</span>
                                <div class="flex gap-1">
                                    <input type="date" name="CustomLastContactedAfter" id="custom-last-contacted-after" class="text-input" value="@(Model.CustomLastContactedAfter?.ToString("yyyy-MM-dd"))" aria-label="@T["campaigns.create.lastContactedAfter"]" />
                                    <input type="date" name="CustomLastContactedBefore" id="custom-last-contacted-before" class="text-input" value="@(Model.CustomLastContactedBefore?.ToString("yyyy-MM-dd"))" aria-label="@T["campaigns.create.lastContactedBefore"]" />
                                </div>
                            </div>
                            <label class="field">
                                <span>@T["campaigns.create.country"]</span>
                                <input type="text" name="CustomCountry" id="custom-country" class="text-input" value="@Model.CustomCountry" placeholder="@T["campaigns.create.countryPlaceholder"]" />
                            </label>
                            <label class="field">
                                <span>@T["contactDetail.details.city"]</span>
                                <input type="text" name="CustomCity" id="custom-city" class="text-input" value="@Model.CustomCity" placeholder="@T["campaigns.create.cityPlaceholder"]" />
                            </label>
                        </div>
                        <div class="active-filters" id="custom-active-filters" hidden></div>
                        <div class="count-box">
                            <div><span class="count-num" id="custom-match-count">—</span> <span class="text-muted">@T["campaigns.create.count.matching"]</span></div>
                            <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-preview-btn data-preview-audience="custom" data-preview-target="custom-preview-list">@T["campaigns.create.previewContacts"]</button>
                        </div>
                        <div id="custom-preview-list" class="preview-contacts-list" style="display:none"></div>
                    </div>

                    @* Pick people manually *@
                    <div id="manual-recipients" class="aud-panel" hidden>
                        <div class="flex items-center gap-2 mt-2 flex-wrap">
                            <input type="search" id="contact-search-input" value="@Model.Search" class="text-input search-input manual-search" placeholder="@T["contacts.search.placeholder"]" autocomplete="off" />
                            <span class="text-subtle text-sm" id="manual-search-hint">
                                @(Model.Contacts.Count >= 200 ? T["campaigns.create.manual.first200", 200] : T["campaigns.create.manual.filtersAsYouType"])
                            </span>
                            <span class="sel-count" id="manual-selected-count">@T["campaigns.create.manual.selected", 0]</span>
                        </div>
                        <div class="au-table-card mt-2 manual-table">
                            <div class="au-table-scroll" style="--au-table-max-h: 360px">
                            <table class="au-table">
                                <thead><tr><th class="au-shrink"><input type="checkbox" id="manual-select-all" title="@T["campaigns.create.manual.selectAll"]" aria-label="@T["campaigns.create.manual.selectAll"]" /></th><th>@T["contacts.table.name"]</th><th>@T["contacts.table.phone"]</th><th>@T["contacts.table.stage"]</th></tr></thead>
                                <tbody>
                                    @foreach (var contact in Model.Contacts)
                                    {
                                        <tr data-search="@(((contact.FullName ?? "") + " " + (contact.Phone ?? "")).ToLowerInvariant())">
                                            <td><input type="checkbox" name="ContactIds" value="@contact.Id" checked="@Model.ContactIds.Contains(contact.Id)" /></td>
                                            <td><div class="cell-person"><span class="avatar-sm">@(string.IsNullOrWhiteSpace(contact.FullName) ? "?" : contact.FullName.Trim()[..1])</span><span dir="auto">@(contact.FullName ?? "—")</span></div></td>
                                            <td><span dir="ltr">@(contact.Phone ?? "—")</span></td>
                                            <td><span class="badge @StageDisplay.CssClass(Model.Stages, contact.StageKey)">@StageDisplay.Label(Model.Stages, contact.StageKey)</span></td>
                                        </tr>
                                    }
                                    <tr class="empty-row" id="manual-empty" hidden="@(Model.Contacts.Count > 0)"><td colspan="4">@T["campaigns.create.manual.noMatch"]</td></tr>
                                </tbody>
                            </table>
                            </div>
                        </div>
                    </div>
                </section>

                @* ---------------- 3. When ---------------- *@
                <section class="step au-panel au-panel--round">
                    <div class="step-head"><span class="step-num">3</span><h3>@T["campaigns.create.step.when"]</h3></div>
                    <div class="seg" role="radiogroup" aria-label="@T["campaigns.create.whenLabel"]">
                        <label class="seg-opt"><input type="radio" name="SendOption" value="now" checked="@(Model.SendOption != "later")" /><span>@T["campaigns.create.sendNow"]</span></label>
                        <label class="seg-opt"><input type="radio" name="SendOption" value="later" checked="@(Model.SendOption == "later")" /><span>@T["campaigns.create.schedule"]</span></label>
                    </div>
                    <div class="text-subtle text-sm mt-2" id="send-now-hint">@T["campaigns.create.sendNowHint"]</div>
                    <div class="flex items-center gap-2 mt-2 flex-wrap" id="schedule-fields" hidden>
                        <input type="date" name="ScheduleDate" class="text-input w-auto" value="@Model.ScheduleDate?.ToString("yyyy-MM-dd")" aria-label="@T["bookings.new.date"]" />
                        <input type="time" name="ScheduleTime" class="text-input w-auto" value="@(Model.ScheduleTime?.ToString("HH:mm") ?? "09:00")" aria-label="@T["bookings.new.time"]" />
                        <span class="text-subtle text-sm">@T.Html("campaigns.create.yourTime", new Microsoft.AspNetCore.Html.HtmlString($"<span data-viewer-tz>{System.Net.WebUtility.HtmlEncode(Model.ViewerTimezone)}</span>"))</span>
                    </div>
                </section>

                <div class="summary-bar">
                    <div id="summary-text"><strong>@T["campaigns.create.summary.ready"]</strong> <bdi>@Model.SelectedTemplate!.Name</bdi></div>
                    <div class="flex gap-2">
                        <a href="/Campaigns" class="au-btn au-btn--text">@T["common.cancel"]</a>
                        <button type="submit" class="au-btn au-btn--primary" id="create-btn"><span class="au-icon au-icon--dir" aria-hidden="true">send</span>@T["campaigns.create.submit"]</button>
                    </div>
                </div>
            }
        </form>

        <partial name="_StatusHelp" model="Model.Stages" />
        <script src="~/js/multi-select.js" asp-append-version="true"></script>
        <script src="~/js/campaign-audience.js" asp-append-version="true"></script>
        <script src="~/js/campaign-create.js" asp-append-version="true"></script>
        <script src="~/js/status-help.js" asp-append-version="true"></script>
    }
}

@functions {
    /// <summary>Renders one filter dropdown — checkboxes with client-friendly labels
    /// (<paramref name="labelOf"/>, else FilterLabelHelper) wrapped in the .ms markup wwwroot/js/multi-select.js turns into a
    /// searchable chips dropdown. The checkboxes are the real, only form data; the JS is purely
    /// presentational on top.</summary>
    private async Task RenderMultiSelect(string name, string label, IReadOnlyList<string> options, List<string> selected,
        Func<string, string>? labelOf = null)
    {
        <div class="ms" data-ms data-ms-label="@label">
            <button type="button" class="ms-trigger">
                <span class="ms-trigger-text">@label</span>
                <span class="ms-caret">▾</span>
            </button>
            <div class="ms-chips"></div>
            <div class="ms-panel" hidden>
                <input type="text" class="ms-search text-input" placeholder="@T["common.searchPlaceholder"]" />
                <div class="ms-options">
                    @foreach (var value in options)
                    {
                        <label class="ms-option">
                            <input type="checkbox" name="@name" value="@value" checked="@selected.Contains(value)" />
                            <span>@(labelOf?.Invoke(value) ?? T.ValueLabel(value))</span>
                        </label>
                    }
                </div>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm ms-clear-btn">@T["common.clear"]</button>
            </div>
        </div>
        await Task.CompletedTask;
    }
}
