@page "/Campaigns/{id:guid}"
@model Omni.App.Pages.Campaigns.DetailsModel
@{
    ViewData["Title"] = Model.Details?.Campaign.Name ?? T["campaigns.details.title"].Value;

    string Pct(int part, int whole) => whole > 0 ? T["campaigns.funnel.ofPrevious", Math.Round(part * 100.0 / whole)].Value : "";
    static string Width(int part, int whole) => whole > 0 ? (part * 100.0 / whole).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "0";
    // Which recipient tab a row belongs to (client-side filter below).
    static string Group(string status) => status switch
    {
        CampaignRecipientStatus.Read or CampaignRecipientStatus.Replied or CampaignRecipientStatus.Booked => "read",
        CampaignRecipientStatus.Failed or CampaignRecipientStatus.Skipped => "problem",
        CampaignRecipientStatus.Pending or CampaignRecipientStatus.Queued => "waiting",
        _ => "sent"
    };
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else if (Model.Details is not null)
{
    var d = Model.Details;
    var c = d.Campaign;
    var st = d.Stats;
    var isManual = c.AudienceType == CampaignAudienceType.Custom && string.IsNullOrWhiteSpace(c.AudienceFilters);
    var audience = isManual ? T["campaigns.audience.manual"].Value : c.AudienceType switch
    {
        CampaignAudienceType.ReactivationNoBooking => T["campaigns.audience.reactivation"].Value,
        CampaignAudienceType.AllEligible => T["campaigns.audience.allEligible"].Value,
        _ => T["campaigns.audience.custom"].Value
    };
    var (whenKey, whenAt) = c.Status == CampaignStatus.Scheduled && c.ScheduledAt is not null ? ("scheduled", c.ScheduledAt)
        : c.CompletedAt is not null ? ("finished", c.CompletedAt)
        : c.StartedAt is not null ? ("started", c.StartedAt)
        : ("created", (DateTimeOffset?)c.CreatedAt);
    var whenText = whenKey switch
    {
        "scheduled" => T.Html("campaigns.when.scheduledFor", LocalTimeHelper.Time(whenAt)),
        "finished" => T.Html("campaigns.when.finishedAt", LocalTimeHelper.Time(whenAt)),
        "started" => T.Html("campaigns.when.startedAt", LocalTimeHelper.Time(whenAt)),
        _ => T.Html("campaigns.when.createdAt", LocalTimeHelper.Time(whenAt))
    };
    // Draft: Send now. Scheduled: Stop (hold it) or Send now. Running: Stop (the background sender keeps sending
    // otherwise). Paused ("Stopped"): Resume. Cancel ends any of them for good.
    var canCancel = c.Status is CampaignStatus.Draft or CampaignStatus.Scheduled or CampaignStatus.Running or CampaignStatus.Paused;
    var canStop = c.Status is CampaignStatus.Scheduled or CampaignStatus.Running;
    var canSend = c.Status is CampaignStatus.Draft or CampaignStatus.Scheduled or CampaignStatus.Paused;
    var sendCount = st.TotalRecipients - st.Skipped;
    var waitingCount = st.Pending + st.Queued;
    var sendLabel = c.Status == CampaignStatus.Paused ? T["campaigns.send.resume"].Value
        : sendCount == 1 ? T["campaigns.send.nowOne"].Value : T["campaigns.send.nowOther", sendCount].Value;
    // Sending can't be undone, so the button asks first (the kit's styled confirm).
    var sendConfirm = c.Status == CampaignStatus.Paused
        ? (waitingCount == 1 ? T["campaigns.send.resumeConfirmOne"].Value : T["campaigns.send.resumeConfirmOther", waitingCount].Value)
        : (sendCount == 1 ? T["campaigns.send.confirmOne"].Value : T["campaigns.send.confirmOther", sendCount].Value);
    var stopConfirm = c.Status == CampaignStatus.Scheduled ? T["campaigns.stop.confirmScheduled"].Value : T["campaigns.stop.confirmRunning"].Value;
    var groups = d.Recipients.GroupBy(r => Group(r.Status)).ToDictionary(g => g.Key, g => g.Count());

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/Campaigns" aria-label="@T["campaigns.back"]" title="@T["campaigns.back"]">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@c.Name</h2>
            <span class="au-back-header__sub">@T["campaigns.details.template", c.TemplateName ?? "—"] · @audience · @whenText</span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @StatusBadgeHelper.CssClass(c.Status)">@T.CampaignStatusLabel(c.Status)</span>
        @if (canCancel)
        {
            <span class="au-spacer"></span>
            <form method="post" asp-page-handler="Cancel"
                  data-au-confirm="@T["campaigns.cancel.confirm"]"
                  data-au-confirm-title="@T["campaigns.cancel.button"]" data-au-confirm-label="@T["campaigns.cancel.button"]" data-au-confirm-tone="danger">
                <button type="submit" class="au-btn au-btn--danger-outlined au-btn--sm">@T["campaigns.cancel.button"]</button>
            </form>
        }
        @if (canStop)
        {
            <form method="post" asp-page-handler="Stop"
                  data-au-confirm="@stopConfirm" data-au-confirm-title="@T["campaigns.stop.button"]" data-au-confirm-label="@T["campaigns.stop.button"]">
                <button type="submit" class="au-btn au-btn--outlined au-btn--sm"><span class="au-icon" aria-hidden="true">pause</span>@T["campaigns.stop.button"]</button>
            </form>
        }
        @if (canSend)
        {
            <form method="post" asp-page-handler="Send"
                  data-au-confirm="@sendConfirm" data-au-confirm-title="@(c.Status == CampaignStatus.Paused ? T["campaigns.send.resumeTitle"] : T["campaigns.send.title"])" data-au-confirm-label="@sendLabel">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm"><span class="au-icon" aria-hidden="true">@(c.Status == CampaignStatus.Paused ? "play_arrow" : "send")</span>@sendLabel</button>
            </form>
        }
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    @if (st.TotalRecipients > 0)
    {
        <div class="prog prog-lg" title="@T["campaigns.progress.summary", st.TotalRecipients, st.Sent, st.Delivered, st.Read, st.Failed]">
            <div class="prog-bar">
                <i class="p-read" style="width:@Width(st.Read, st.TotalRecipients)%"></i><i class="p-deliv" style="width:@Width(Math.Max(st.Delivered - st.Read, 0), st.TotalRecipients)%"></i><i class="p-sent" style="width:@Width(Math.Max(st.Sent - st.Delivered, 0), st.TotalRecipients)%"></i><i class="p-fail" style="width:@Width(st.Failed, st.TotalRecipients)%"></i>
            </div>
        </div>
    }

    <div class="funnel">
        @{
            var steps = new (string Label, int Value, string Hint)[]
            {
                (T["campaigns.funnel.recipients"].Value, st.TotalRecipients, ""),
                (T["values.sent"].Value, st.Sent, Pct(st.Sent, st.TotalRecipients)),
                (T["values.delivered"].Value, st.Delivered, Pct(st.Delivered, st.Sent)),
                (T["values.read"].Value, st.Read, Pct(st.Read, st.Delivered)),
                (T["values.replied"].Value, st.Replied, Pct(st.Replied, st.Delivered)),
                (T["values.booked"].Value, st.Booked, Pct(st.Booked, st.Replied)),
            };
        }
        @for (var i = 0; i < steps.Length; i++)
        {
            <div class="funnel-step">
                @if (i > 0) { <span class="funnel-arrow" aria-hidden="true">&rsaquo;</span> }
                <div class="eyebrow">@steps[i].Label</div>
                <div class="funnel-num">@steps[i].Value</div>
                <div class="cell-sub">@(string.IsNullOrEmpty(steps[i].Hint) ? " " : steps[i].Hint)</div>
            </div>
        }
    </div>
    <div class="side-stats">
        @T["campaigns.stats.also"]
        <span class="badge badge-gray">@T["campaigns.stats.pending", st.Pending]</span>
        <span class="badge badge-amber">@T["campaigns.stats.queued", st.Queued]</span>
        <span class="badge badge-red">@T["campaigns.stats.failed", st.Failed]</span>
        <span class="badge badge-gray" title="@T["campaigns.stats.skippedHelp"]">@T["campaigns.stats.skipped", st.Skipped]</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(d.TemplateBody))
    {
        <details class="au-panel au-panel--round tpl-card mt-3">
            <summary>@T["campaigns.details.messageSent"]</summary>
            <div class="wa-preview"><div class="wa-bubble">@d.TemplateBody<span class="wa-time">&nbsp;</span></div></div>
            <div class="text-subtle text-xs mt-1">@T["campaigns.details.blanksFilled", "{{1}}"]</div>
        </details>
    }

    <h2 class="section-title">@T["campaigns.funnel.recipients"]</h2>
    @if (d.Recipients.Count == 0)
    {
        var empty = new EmptyStateModel(Icon: "group_off", Title: T["campaigns.details.emptyTitle"].Value,
            Text: T["campaigns.details.emptyText"].Value,
            ActionLabel: T["campaigns.new"].Value, ActionHref: "/Campaigns/Create");
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="empty" /></div>
    }
    else
    {
        @* #recipient-tabs, tr[data-group] and #recipient-tab-empty are read by the script at the bottom. *@
        <div class="inbox-filters mb-2" id="recipient-tabs" role="tablist" aria-label="@T["campaigns.recipients.tabsLabel"]">
            <button type="button" class="inbox-filter active" data-tab="all">@T["campaigns.tabs.all"] <span class="inbox-filter-count">@d.Recipients.Count</span></button>
            <button type="button" class="inbox-filter" data-tab="read">@T["values.read"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("read"))</span></button>
            <button type="button" class="inbox-filter" data-tab="problem">@T["campaigns.recipients.notDelivered"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("problem"))</span></button>
            <button type="button" class="inbox-filter" data-tab="waiting">@T["campaigns.recipients.waiting"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("waiting"))</span></button>
        </div>

        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead>
                        <tr><th>@T["campaigns.recipients.contact"]</th><th>@T["contacts.table.phone"]</th><th>@T["campaigns.table.status"]</th><th>@T["campaigns.recipients.lastUpdate"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in d.Recipients)
                        {
                            var (lastLabel, lastAt) = r.ReadAt is not null ? (T["values.read"].Value, r.ReadAt)
                                : r.DeliveredAt is not null ? (T["values.delivered"].Value, r.DeliveredAt)
                                : r.SentAt is not null ? (T["values.sent"].Value, r.SentAt)
                                : r.FailedAt is not null ? (T["values.failed"].Value, r.FailedAt)
                                : r.QueuedAt is not null ? (T["values.queued"].Value, r.QueuedAt)
                                : ("", (DateTimeOffset?)null);
                            var problem = r.SkipReason ?? r.FailureReason;
                            <tr class="row-link" data-href="/dashboard/contacts/@r.ContactId" data-group="@Group(r.Status)">
                                <td data-label="@T["campaigns.recipients.contact"]"><a class="cell-person" href="/dashboard/contacts/@r.ContactId"><span class="avatar-sm">@(string.IsNullOrWhiteSpace(r.ContactFullName) ? "?" : r.ContactFullName.Trim()[..1])</span>@(r.ContactFullName ?? "—")</a></td>
                                <td data-label="@T["contacts.table.phone"]">@r.PhoneNumber</td>
                                <td data-label="@T["campaigns.table.status"]" class="au-wrap">
                                    <div>
                                        <span class="badge @StatusBadgeHelper.CssClass(r.Status)">@T.ValueLabel(r.Status)</span>
                                        @if (!string.IsNullOrWhiteSpace(problem))
                                        {
                                            <div class="cell-err">@problem</div>
                                        }
                                    </div>
                                </td>
                                <td data-label="@T["campaigns.recipients.lastUpdate"]" class="cell-sub">@lastLabel @LocalTimeHelper.Time(lastAt)</td>
                            </tr>
                        }
                        <tr class="empty-row" id="recipient-tab-empty" hidden><td colspan="4">@T["campaigns.recipients.tabEmpty"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <script>
        (function () {
            var tabs = document.querySelectorAll('#recipient-tabs [data-tab]');
            var rows = document.querySelectorAll('tr[data-group]');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var group = tab.getAttribute('data-tab');
                    var shown = 0;
                    tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
                    rows.forEach(function (r) {
                        var show = group === 'all' || r.getAttribute('data-group') === group;
                        r.hidden = !show;
                        if (show) shown++;
                    });
                    document.getElementById('recipient-tab-empty').hidden = shown > 0;
                });
            });
            rows.forEach(function (r) {
                r.addEventListener('click', function (e) {
                    if (e.target.closest('a, button')) return;
                    window.location.href = r.getAttribute('data-href');
                });
            });
        })();
    </script>
}
