@page "/Campaigns"
@model Omni.App.Pages.Campaigns.IndexModel
@{
    ViewData["Title"] = T["campaigns.title"].Value;

    // Which list tab a campaign belongs to (client-side filter, see the script at the bottom).
    static string Group(string status) => status switch
    {
        CampaignStatus.Draft => "draft",
        CampaignStatus.Scheduled or CampaignStatus.Running or CampaignStatus.Paused => "active",
        _ => "finished"
    };
    string AudienceLabel(string? type, bool manual) => manual ? T["campaigns.audience.manual"].Value : type switch
    {
        CampaignAudienceType.ReactivationNoBooking => T["campaigns.audience.reactivation"].Value,
        CampaignAudienceType.AllEligible => T["campaigns.audience.allEligible"].Value,
        CampaignAudienceType.Custom => T["campaigns.audience.custom"].Value,
        _ => "—"
    };
    string Pct(int part, int whole) => whole > 0 ? T["common.percent", Math.Round(part * 100.0 / whole)].Value : "";
    static string Width(int part, int whole) => whole > 0 ? (part * 100.0 / whole).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "0";
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <div class="au-page-head">
        <p class="au-page-head__sub">@T["campaigns.intro"]</p>
        <div class="au-page-head__actions">
            <a href="/Campaigns/Create" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">add</span>@T["campaigns.new"]</a>
        </div>
    </div>

    @if (Model.Campaigns.Count == 0)
    {
        var empty = new EmptyStateModel(Icon: "campaign", Title: T["campaigns.empty.title"].Value,
            Text: T["campaigns.empty.text"].Value,
            ActionLabel: T["campaigns.new"].Value, ActionHref: "/Campaigns/Create");
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="empty" /></div>
    }
    else
    {
        var groups = Model.Campaigns.GroupBy(c => Group(c.Status)).ToDictionary(g => g.Key, g => g.Count());
        @* #campaign-tabs, tr[data-group] and #campaign-tab-empty are read by the script at the bottom. *@
        <div class="inbox-filters mb-2" id="campaign-tabs" role="tablist" aria-label="@T["campaigns.tabs.label"]">
            <button type="button" class="inbox-filter active" data-tab="all">@T["campaigns.tabs.all"] <span class="inbox-filter-count">@Model.Campaigns.Count</span></button>
            <button type="button" class="inbox-filter" data-tab="active">@T["campaigns.tabs.active"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("active"))</span></button>
            <button type="button" class="inbox-filter" data-tab="draft">@T["campaigns.tabs.drafts"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("draft"))</span></button>
            <button type="button" class="inbox-filter" data-tab="finished">@T["campaigns.tabs.finished"] <span class="inbox-filter-count">@(groups.GetValueOrDefault("finished"))</span></button>
        </div>

        <div class="au-table-card tip-safe">
            <table class="au-table au-table--stack">
                <thead>
                    <tr>
                        <th>@T["campaigns.table.campaign"]</th>
                        <th>@T["campaigns.table.status"]</th>
                        <th>@T["campaigns.table.audience"]</th>
                        <th>
                            <span class="th-with-tip">
                                @T["campaigns.table.progress"]
                                <span class="info-tip" tabindex="0" role="button" aria-label="@T["campaigns.progressTip.label"]" aria-describedby="progress-tip">
                                    <span class="au-icon au-icon--sm" aria-hidden="true">info</span>
                                    <span class="info-tip-box" role="tooltip" id="progress-tip">
                                        <strong>@T["campaigns.progressTip.title"]</strong>
                                        <span class="tip-row"><i class="p-read"></i> @T["campaigns.progressTip.read"]</span>
                                        <span class="tip-row"><i class="p-deliv"></i> @T["campaigns.progressTip.delivered"]</span>
                                        <span class="tip-row"><i class="p-sent"></i> @T["campaigns.progressTip.sent"]</span>
                                        <span class="tip-row"><i class="p-fail"></i> @T["campaigns.progressTip.failed"]</span>
                                        <span class="tip-row"><i class="p-rest"></i> @T["campaigns.progressTip.rest"]</span>
                                        <span class="tip-note">@T["campaigns.progressTip.note"]</span>
                                    </span>
                                </span>
                            </span>
                        </th>
                        <th>@T["campaigns.table.replies"]</th>
                        <th>@T["campaigns.table.when"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Campaigns)
                    {
                        var readW = Width(c.Read, c.TotalRecipients);
                        var delivW = Width(Math.Max(c.Delivered - c.Read, 0), c.TotalRecipients);
                        var sentW = Width(Math.Max(c.Sent - c.Delivered, 0), c.TotalRecipients);
                        var failW = Width(c.Failed, c.TotalRecipients);
                        var progressText = c.Sent > 0 ? T["campaigns.progress.deliveredRead", c.Delivered, c.Read]
                            : c.Status == CampaignStatus.Scheduled ? T["campaigns.progress.waiting"]
                            : c.Status == CampaignStatus.Paused ? T["campaigns.progress.stoppedBefore"]
                            : c.Status == CampaignStatus.Draft ? T["campaigns.progress.notSent"]
                            : c.Failed > 0 ? T["campaigns.progress.failed", c.Failed] : T["campaigns.progress.nothingSent"];
                        <tr class="row-link" data-href="/Campaigns/@c.Id" data-group="@Group(c.Status)">
                            <td data-label="@T["campaigns.table.campaign"]"><div><a href="/Campaigns/@c.Id"><strong dir="auto">@c.Name</strong></a><div class="cell-sub">@(c.TemplateName ?? "—")</div></div></td>
                            <td data-label="@T["campaigns.table.status"]"><span class="badge @StatusBadgeHelper.CssClass(c.Status)">@T.CampaignStatusLabel(c.Status)</span></td>
                            <td data-label="@T["campaigns.table.audience"]"><div>@c.TotalRecipients <span class="cell-sub">@T.Plural("campaigns.people", c.TotalRecipients)</span><div class="cell-sub">@AudienceLabel(c.AudienceType, c.ManuallySelected)</div></div></td>
                            <td data-label="@T["campaigns.table.progress"]" class="prog-cell">
                                <div class="prog" title="@T["campaigns.progress.summary", c.TotalRecipients, c.Sent, c.Delivered, c.Read, c.Failed]">
                                    <div class="prog-bar"><i class="p-read" style="width:@readW%"></i><i class="p-deliv" style="width:@delivW%"></i><i class="p-sent" style="width:@sentW%"></i><i class="p-fail" style="width:@failW%"></i></div>
                                    <div class="prog-text">@progressText</div>
                                </div>
                            </td>
                            <td data-label="@T["campaigns.table.replies"]">
                                @if (c.Replied > 0)
                                {
                                    <span><strong>@c.Replied</strong> <span class="cell-sub">(@Pct(c.Replied, c.Sent))</span></span>
                                }
                                else
                                {
                                    @:—
                                }
                            </td>
                            <td data-label="@T["campaigns.table.when"]">
                                @if (c.ScheduledAt is not null && c.Status == CampaignStatus.Scheduled)
                                {
                                    <div><span class="text-md">@T["values.scheduled"]</span><div class="cell-sub">@LocalTimeHelper.Time(c.ScheduledAt)</div></div>
                                }
                                else
                                {
                                    <div><span class="text-md">@T["campaigns.when.created"]</span><div class="cell-sub">@LocalTimeHelper.Time(c.CreatedAt)</div></div>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="empty-row" id="campaign-tab-empty" hidden><td colspan="6">@T["campaigns.tabs.empty"]</td></tr>
                </tbody>
            </table>
        </div>

        <script>
            (function () {
                var tabs = document.querySelectorAll('#campaign-tabs [data-tab]');
                var rows = document.querySelectorAll('tr[data-group]');
                tabs.forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        var group = tab.getAttribute('data-tab');
                        var shown = 0;
                        tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
                        rows.forEach(function (r) {
                            var show = group === 'all' || r.getAttribute('data-group') === group;
                            r.hidden = !show;
                            if (show) shown++;
                        });
                        document.getElementById('campaign-tab-empty').hidden = shown > 0;
                    });
                });
                // Whole row opens the campaign (links inside keep working as links).
                rows.forEach(function (r) {
                    r.addEventListener('click', function (e) {
                        if (e.target.closest('a, button, .info-tip')) return;
                        window.location.href = r.getAttribute('data-href');
                    });
                });
            })();
        </script>
    }
}
