@page "/KnowledgeBase/Settings"
@model Omni.App.Pages.KnowledgeBase.SettingsModel
@inject Omni.App.Business.Contracts.Managers.IConfigManager Settings
@{
    ViewData["Title"] = T["knowledgeSettings.title"].Value;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/KnowledgeBase" aria-label="@T["knowledge.edit.back", T["knowledge.edit.backKnowledge"].Value]" title="@T["knowledge.edit.back", T["knowledge.edit.backKnowledge"].Value]">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@T["knowledgeSettings.heading"]</h2>
            <span class="au-back-header__sub">@T["knowledgeSettings.sub"]</span>
        </div>
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <section class="au-panel au-panel--round au-panel--pad mw-640">
        <form method="post">
            <p class="au-help m-0">@T["knowledgeSettings.note"]</p>

            <label class="set-row">
                <div>
                    <strong>@T["knowledgeSettings.chunkSize.title"]</strong>
                    <div class="cell-sub">@T["knowledgeSettings.chunkSize.range", Settings.KnowledgeMinChunkSizeTokens, Settings.KnowledgeMaxChunkSizeTokens]</div>
                    <div class="cell-sub">@T["knowledgeSettings.chunkSize.help"]</div>
                </div>
                <input type="number" name="ChunkSizeTokens" value="@Model.ChunkSizeTokens" class="au-input set-input" min="@Settings.KnowledgeMinChunkSizeTokens" max="@Settings.KnowledgeMaxChunkSizeTokens" required />
            </label>

            <label class="set-row">
                <div>
                    <strong>@T["knowledgeSettings.overlap.title"]</strong>
                    <div class="cell-sub">@T["knowledgeSettings.overlap.range"]</div>
                    <div class="cell-sub">@T["knowledgeSettings.overlap.help"]</div>
                </div>
                <input type="number" name="ChunkOverlapTokens" value="@Model.ChunkOverlapTokens" class="au-input set-input" min="0" max="500" required />
            </label>

            <label class="set-row">
                <div>
                    <strong>@T["knowledgeSettings.topK.title"]</strong>
                    <div class="cell-sub">@T["knowledgeSettings.topK.range", Settings.KnowledgeMinTopK, Settings.KnowledgeMaxTopK]</div>
                    <div class="cell-sub">@T["knowledgeSettings.topK.help"]</div>
                </div>
                <input type="number" name="TopK" value="@Model.TopK" class="au-input set-input" min="@Settings.KnowledgeMinTopK" max="@Settings.KnowledgeMaxTopK" required />
            </label>

            <label class="set-row">
                <div>
                    <strong>@T["knowledgeSettings.similarity.title"]</strong>
                    <div class="cell-sub">@T["knowledgeSettings.similarity.range"]</div>
                    <div class="cell-sub">@T["knowledgeSettings.similarity.help"]</div>
                </div>
                <input type="text" inputmode="decimal" name="MinimumSimilarity" value="@Model.MinimumSimilarity" class="au-input set-input" required />
            </label>

            <div class="au-form-actions">
                <a href="/KnowledgeBase" class="au-btn au-btn--text">@T["common.cancel"]</a>
                <button type="submit" class="au-btn au-btn--primary">@T["knowledgeSettings.save"]</button>
            </div>
        </form>
    </section>

    <details class="au-panel au-panel--round tech mw-640 mt-3">
        <summary>@T["knowledgeSettings.tech.title"]</summary>
        <div class="inbox-contact-info-row"><span>@T["knowledgeSettings.tech.model"]</span><strong>@Model.Current.EmbeddingModel</strong></div>
        <div class="inbox-contact-info-row"><span>@T["knowledgeSettings.tech.dimension"]</span><strong>@Model.Current.VectorDimension</strong></div>
        <div class="inbox-contact-info-row"><span>@T["knowledgeSettings.tech.method"]</span><strong>@KnowledgeSimilarityMethod.Label(Model.Current.SimilarityMethod)</strong></div>
        <div class="inbox-contact-info-row"><span>@T["knowledgeSettings.tech.index"]</span><strong>@KnowledgeVectorIndexType.Label(Model.Current.VectorIndexType)</strong></div>
        <div class="cell-sub mt-1">
            @T["knowledgeSettings.tech.help"]
            @T.Html("knowledgeSettings.tech.lastUpdated", LocalTimeHelper.Time(Model.Current.UpdatedAt, "datetime-year"))
        </div>
    </details>
}
