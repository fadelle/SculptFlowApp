@model Omni.App.Pages.KnowledgeBase.IndexModel
@* The Knowledge Base add / edit popup (Pages/KnowledgeBase/Index). modal.js opens and closes it; knowledge-page.js reads
   [data-kb-tab], .kb-choice, #kb-panel-*, #kb-body, #kb-body-count, #kb-add-qa, the drop zone ids (#kb-dropzone, #kb-file,
   #kb-drop-*), .seg-cards .cat-card and the opener's data-kb-mode. An edit is opened by its address (?edit=), so closing it
   goes back to BackUrl. *@
@{
    var isNew = Model.Edit is null;
    var maxMb = Model.MaxUploadBytes / 1024.0 / 1024.0;
    var activeMode = isNew ? Model.FormMode : "manual";
    var closeHref = isNew && Model.ReturnUrl is null ? null : Model.BackUrl;
}

@functions {
    // Active on/off switch: a real checkbox (name=IsActive, value=true) styled as a switch.
    private Microsoft.AspNetCore.Html.IHtmlContent ActiveSwitch(bool isChecked, string help) => new Microsoft.AspNetCore.Html.HtmlString(
        $"<label class=\"switch-row\"><input type=\"checkbox\" name=\"IsActive\" value=\"true\" class=\"switch-input\"{(isChecked ? " checked" : "")} /><span class=\"switch\" aria-hidden=\"true\"></span> {System.Net.WebUtility.HtmlEncode(T["services.active"].Value)} <span class=\"text-subtle\">{System.Net.WebUtility.HtmlEncode(help)}</span></label>");

    private Microsoft.AspNetCore.Html.IHtmlContent CategorySelect(string selected)
    {
        var sb = new System.Text.StringBuilder("<select name=\"Category\" class=\"au-select\">");
        foreach (var value in Model.CategoryOptions)
        {
            var label = T.CategoryLabel(value);
            sb.Append("<option value=\"").Append(System.Net.WebUtility.HtmlEncode(value)).Append('"')
              .Append(value == selected ? " selected" : "").Append('>').Append(System.Net.WebUtility.HtmlEncode(label)).Append("</option>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(sb.Append("</select>").ToString());
    }
}

<div class="bm-overlay" data-modal id="kb-overlay" hidden="@(!Model.FormOpen)" data-modal-close-href="@closeHref">
    <div class="card form-modal form-modal--wide" role="dialog" aria-modal="true" aria-labelledby="kb-form-title">
        <div class="modal-head">
            <div class="min-w-0">
                <h3 id="kb-form-title" class="card-title" dir="auto">@(isNew ? T["knowledge.add"].Value : Model.Title)</h3>
                <span class="cell-sub">@(isNew ? T["knowledge.edit.newSub"] : T["knowledge.edit.editSub"])</span>
            </div>
            <button type="button" class="au-icon-btn" data-modal-close aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
        </div>

        @if (Model.FormError is not null)
        {
            <partial name="_Messages" model="new PageMessagesModel(null, Model.FormError)" />
        }

        @if (isNew)
        {
            <div class="kb-choices kb-choices--compact" role="radiogroup" aria-label="@T["knowledge.edit.howToAdd"]">
                <label class="kb-choice @(activeMode == "manual" ? "on" : "")"><input type="radio" name="kb-mode" value="manual" data-kb-tab="manual" checked="@(activeMode == "manual")" /><span class="kb-choice-icon au-icon" aria-hidden="true">edit_note</span><strong>@T["knowledge.choice.write"]</strong><small>@T["knowledge.edit.writeHelp"]</small></label>
                <label class="kb-choice @(activeMode == "upload" ? "on" : "")"><input type="radio" name="kb-mode" value="upload" data-kb-tab="upload" checked="@(activeMode == "upload")" /><span class="kb-choice-icon au-icon" aria-hidden="true">upload_file</span><strong>@T["knowledge.choice.upload"]</strong><small>@T["knowledge.choice.uploadHelp"]</small></label>
                <label class="kb-choice @(activeMode == "website" ? "on" : "")"><input type="radio" name="kb-mode" value="website" data-kb-tab="website" checked="@(activeMode == "website")" /><span class="kb-choice-icon au-icon" aria-hidden="true">language</span><strong>@T["knowledge.edit.importWebsite"]</strong><small>@T["knowledge.edit.importWebsiteHelp"]</small></label>
            </div>
        }

        @* ---------- Written entry / edit ---------- *@
        <div id="kb-panel-manual" hidden="@(activeMode != "manual")">
            <form method="post" asp-page-handler="Save" class="au-stack">
                <input type="hidden" name="Edit" value="@Model.Edit" />
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                @if (Model.IsWebsite || Model.IsUpload)
                {
                    <div class="src-banner">
                        <span class="src-icon @(Model.IsWebsite ? "src-web" : "src-up")"><span class="au-icon au-icon--sm" aria-hidden="true">@(Model.IsWebsite ? "language" : "description")</span></span>
                        <div class="flex-1 min-w-0">
                            @if (Model.IsWebsite)
                            {
                                @T.Html("knowledge.edit.fromPage", new Microsoft.AspNetCore.Html.HtmlString($"<a href=\"{System.Net.WebUtility.HtmlEncode(Model.SourceUrl)}\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"au-link break-all\">{System.Net.WebUtility.HtmlEncode(Omni.App.Common.Helpers.UrlDisplayHelper.Readable(Model.SourceUrl ?? ""))}</a>"))
                                <div class="cell-sub">@T["knowledge.edit.fromPageHelp"]</div>
                            }
                            else
                            {
                                @T.Html("knowledge.edit.fromFile", new Microsoft.AspNetCore.Html.HtmlString($"<strong>{System.Net.WebUtility.HtmlEncode(Model.OriginalFileName)}</strong>"))
                                @if (Model.FileSizeBytes.HasValue) { <text> @T["knowledge.edit.fileSize", (Model.FileSizeBytes.Value / 1024.0).Display("0")]</text> }
                                <div class="cell-sub">@T["knowledge.edit.fromFileHelp"]</div>
                            }
                        </div>
                    </div>
                }

                <div class="au-form-grid">
                    <div class="au-form-field">
                        <label class="au-form-label" for="kb-title">@T["knowledge.edit.titleLabel"]<span class="au-required">*</span></label>
                        <input type="text" name="Title" id="kb-title" value="@Model.Title" class="au-input" maxlength="200" required dir="auto" placeholder="@T["knowledge.edit.titlePlaceholder"]" />
                    </div>
                    <label class="au-form-field">
                        <span class="au-form-label">@T["knowledge.table.category"]</span>
                        @CategorySelect(Model.Category)
                    </label>
                </div>

                @if (Model.IsWebsite || Model.IsUpload)
                {
                    <div class="au-form-field">
                        <span class="au-form-label">@T["knowledge.edit.textAiReads"]</span>
                        <div class="readonly-text" dir="auto">@Model.Body</div>
                    </div>
                }
                else
                {
                    <div class="au-form-field">
                        <div class="flex items-center justify-between">
                            <label class="au-form-label" for="kb-body">@T["knowledge.edit.content"]<span class="au-required">*</span></label>
                            <button type="button" class="au-btn au-btn--text au-btn--sm" id="kb-add-qa"><span class="au-icon" aria-hidden="true">add</span>@T["knowledge.edit.addQa"]</button>
                        </div>
                        <textarea name="Body" id="kb-body" rows="10" class="au-textarea" required dir="auto"
                                  placeholder="@T["knowledge.edit.contentPlaceholder"]">@Model.Body</textarea>
                        <span class="au-help counter" id="kb-body-count"></span>
                    </div>
                }

                @ActiveSwitch(Model.IsActive, T["knowledge.edit.activeEntry"].Value)

                <div class="au-form-actions">
                    <span class="au-help form-actions-note">@T["knowledge.edit.prepareNote"]</span>
                    <button type="button" class="au-btn au-btn--text" data-modal-close>@T["common.cancel"]</button>
                    <button type="submit" class="au-btn au-btn--primary">@(isNew ? T["knowledge.edit.addSubmit"] : T["common.saveChanges"])</button>
                </div>
            </form>
        </div>

        @if (isNew)
        {
            @* ---------- Upload a document ---------- *@
            <div id="kb-panel-upload" hidden="@(activeMode != "upload")">
                <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="au-stack">
                    <label class="dropzone" id="kb-dropzone" data-max-bytes="@Model.MaxUploadBytes">
                        <input type="file" name="UploadFile" id="kb-file" accept=".pdf,.docx,.txt" required class="dropzone-input" />
                        <span class="kb-choice-icon" id="kb-drop-icon">⇪</span>
                        <div class="flex-1 min-w-0">
                            <strong id="kb-drop-title">@T["knowledge.upload.dropTitle"]</strong>
                            <div class="cell-sub" id="kb-drop-sub">@T["knowledge.upload.dropSub", maxMb.Display("0.#")]</div>
                        </div>
                    </label>

                    <div class="au-form-grid">
                        <div class="au-form-field">
                            <label class="au-form-label" for="kb-upload-title">@T["knowledge.edit.titleLabel"] <span class="opt">@T["common.optional"]</span></label>
                            <input type="text" name="Title" id="kb-upload-title" value="@Model.Title" class="au-input" maxlength="200" dir="auto" placeholder="@T["knowledge.upload.titlePlaceholder"]" />
                        </div>
                        <label class="au-form-field">
                            <span class="au-form-label">@T["knowledge.table.category"]</span>
                            @CategorySelect(Model.Category)
                        </label>
                    </div>

                    @ActiveSwitch(Model.FormError is null || Model.IsActive, T["knowledge.edit.activeDocument"].Value)

                    <div class="au-form-actions">
                        <span class="au-help form-actions-note">@T["knowledge.upload.note"]</span>
                        <button type="button" class="au-btn au-btn--text" data-modal-close>@T["common.cancel"]</button>
                        <button type="submit" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">upload</span>@T["knowledge.upload.submit"]</button>
                    </div>
                </form>
            </div>

            @* ---------- Import a website ---------- *@
            <div id="kb-panel-website" hidden="@(activeMode != "website")">
                <form method="post" asp-page-handler="Website" class="au-stack">
                    <div class="au-form-field">
                        <label class="au-form-label" for="kb-website-url">@T["knowledge.website.address"]<span class="au-required">*</span></label>
                        <input type="text" name="WebsiteUrl" id="kb-website-url" value="@Model.WebsiteUrl" class="au-input" maxlength="2000" required dir="ltr"
                               placeholder="https://www.yourbusiness.com" inputmode="url" autocomplete="off" />
                    </div>

                    <div class="au-form-field">
                        <span class="au-form-label">@T["knowledge.website.whatToImport"]</span>
                        <div class="seg-cards">
                            <label class="cat-card @(Model.WebsiteMode != "single_page" ? "on" : "")">
                                <input type="radio" name="WebsiteMode" value="crawl_site" checked="@(Model.WebsiteMode != "single_page")" />
                                <strong>@T["knowledge.crawl.whole"]</strong><small>@T["knowledge.website.wholeHelp"]</small>
                            </label>
                            <label class="cat-card @(Model.WebsiteMode == "single_page" ? "on" : "")">
                                <input type="radio" name="WebsiteMode" value="single_page" checked="@(Model.WebsiteMode == "single_page")" />
                                <strong>@T["knowledge.website.justThisPage"]</strong><small>@T["knowledge.website.justThisPageHelp"]</small>
                            </label>
                        </div>
                    </div>

                    <label class="au-form-field">
                        <span class="au-form-label">@T["knowledge.table.category"]</span>
                        @CategorySelect(Model.Category)
                    </label>

                    @ActiveSwitch(Model.FormError is null || Model.IsActive, T["knowledge.edit.activePages"].Value)

                    <details class="kb-more">
                        <summary>@T["knowledge.website.whatGetsImported"]</summary>
                        <p class="au-help mt-1">
                            @T.Html("knowledge.website.whatGetsImportedText", new Microsoft.AspNetCore.Html.HtmlString("<code>robots.txt</code>"))
                        </p>
                    </details>

                    <div class="au-form-actions">
                        <button type="button" class="au-btn au-btn--text" data-modal-close>@T["common.cancel"]</button>
                        <button type="submit" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">language</span>@T["knowledge.website.import"]</button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>
