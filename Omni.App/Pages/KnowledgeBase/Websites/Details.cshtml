@page "/KnowledgeBase/Websites/{id:guid}"
@model Omni.App.Pages.KnowledgeBase.Websites.DetailsModel
@{
    ViewData["Title"] = T["knowledge.source.website"].Value;
    string RunBadge(string s) => s switch
    {
        WebsiteScrapeStatus.Completed => "badge-green",
        WebsiteScrapeStatus.CompletedWithErrors => "badge-amber",
        WebsiteScrapeStatus.Failed => "badge-red",
        WebsiteScrapeStatus.Crawling => "badge-teal",
        _ => "badge-gray"
    };
    string RunLabel(WebsiteRunResponse r) => r.Status switch
    {
        WebsiteScrapeStatus.Completed => T["values.completed"].Value,
        WebsiteScrapeStatus.CompletedWithErrors => T.Plural("website.problems", r.PagesFailed).Value,
        WebsiteScrapeStatus.Failed => T["values.failed"].Value,
        WebsiteScrapeStatus.Crawling => T["website.run.importing"].Value,
        WebsiteScrapeStatus.Pending => T["campaigns.recipients.waiting"].Value,
        _ => r.Status
    };
    string PageBadge(string s) => s switch
    {
        WebsitePageStatus.Indexed or WebsitePageStatus.Unchanged => "badge-green",
        WebsitePageStatus.Failed or WebsitePageStatus.Removed => "badge-red",
        WebsitePageStatus.Skipped or WebsitePageStatus.Duplicate => "badge-gray",
        _ => "badge-teal"
    };
    string PageLabel(string s) => s switch
    {
        WebsitePageStatus.Indexed or WebsitePageStatus.Unchanged => T["website.page.inKnowledge"].Value,
        WebsitePageStatus.Failed => T["values.failed"].Value,
        WebsitePageStatus.Removed => T["values.removed"].Value,
        WebsitePageStatus.Skipped => T["values.skipped"].Value,
        WebsitePageStatus.Duplicate => T["values.duplicate"].Value,
        _ => T["website.page.checking"].Value
    };
    Microsoft.AspNetCore.Html.IHtmlContent Ago(DateTimeOffset when) =>
        LocalTimeHelper.Ago(T, when, dayCutoff: 2, fallbackFormat: "date");
    var d = Model.Detail;
    // "View text" remembers this exact page (including the filter) so Cancel/Save on the entry return here.
    var backToThisPage = "/KnowledgeBase/Websites/" + Model.Id + (string.IsNullOrEmpty(Model.Status) ? "" : "?status=" + Uri.EscapeDataString(Model.Status));
}

@if (!Model.ClientConfigured || d is null)
{
    <partial name="_NoClient" />
}
else
{
    var s = d.Source;
    var run = s.LatestRun;
    int Count(params string[] statuses) => statuses.Sum(x => d.PageStatusCounts.GetValueOrDefault(x));
    var inKb = Count(WebsitePageStatus.Indexed, WebsitePageStatus.Unchanged);

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/KnowledgeBase" aria-label="@T["knowledge.edit.back", T["knowledge.edit.backKnowledge"].Value]" title="@T["knowledge.edit.back", T["knowledge.edit.backKnowledge"].Value]">
            <span class="au-icon au-icon--dir" aria-hidden="true">arrow_back</span>
        </a>
        <span class="src-icon src-web big" aria-hidden="true"><span class="au-icon">language</span></span>
        <div class="min-w-0">
            <h2 class="au-back-header__title"><a href="@s.StartUrl" target="_blank" rel="noopener noreferrer" title="@T["website.open"]">@UrlDisplayHelper.Readable(s.StartUrl)</a></h2>
            <span class="au-back-header__sub">
                @(s.CrawlMode == WebsiteCrawlMode.SinglePage ? T["knowledge.crawl.single"] : T["knowledge.crawl.whole"])
                · @T.CategoryLabel(s.Category)
                · @if (s.LastScrapedAt is { } last) { @T.Html("website.importedAgo", Ago(last)) } else { @T["website.notImported"] }
            </span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @(s.IsActive ? "badge-green" : "badge-gray")">@(s.IsActive ? T["services.active"] : T["services.inactive"])</span>
        <span class="au-spacer"></span>
        <form method="post" asp-page-handler="Delete" class="inline-form"
              data-au-confirm="@T["knowledge.website.deleteConfirm"]"
              data-au-confirm-title="@T["knowledge.website.delete"]" data-au-confirm-label="@T["knowledge.website.delete"]" data-au-confirm-tone="danger">
            <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text" disabled="@s.InProgress">@T["common.delete"]</button>
        </form>
        <form method="post" asp-page-handler="Toggle" class="inline-form">
            <input type="hidden" name="active" value="@((!s.IsActive).ToString().ToLowerInvariant())" />
            <button type="submit" class="au-btn au-btn--outlined au-btn--sm">@(s.IsActive ? T["services.deactivate"] : T["services.activate"])</button>
        </form>
        @if (s.IsActive)
        {
            <form method="post" asp-page-handler="Rescrape" class="inline-form">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm" disabled="@s.InProgress"><span class="au-icon" aria-hidden="true">sync</span>@T["website.importAgain"]</button>
            </form>
        }
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    @if (s.InProgress)
    {
        var pct = run is { PagesDiscovered: > 0 } ? Math.Min(100, run.PagesProcessed * 100 / run.PagesDiscovered) : 0;
        <div class="au-panel au-panel--round au-panel--pad mb-3">
            <div class="progress"><div style="width:@(pct)%"></div></div>
            <div class="cell-sub mt-1">
                <span class="spin"></span>
                @(run is { PagesDiscovered: > 0 } ? T["website.progress.checked", run.PagesProcessed, run.PagesDiscovered] : T["website.progress.starting"])
                @T["website.progress.canLeave"]
            </div>
        </div>
    }
    else if (run is not null && run.Status == WebsiteScrapeStatus.Failed)
    {
        <div class="au-alert au-alert--error" role="alert">
            <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
            <div class="au-alert__body">
                <div class="au-alert__title">@T["website.failed.title"]</div>
                @(string.IsNullOrWhiteSpace(run.ErrorSummary) ? T["website.failed.unreadable"].Value : run.ErrorSummary)
                @T["website.failed.tryAgain"]
            </div>
        </div>
    }
    else if (run is not null && run.Status == WebsiteScrapeStatus.CompletedWithErrors)
    {
        <div class="au-alert au-alert--warning" role="status">
            <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
            <div class="au-alert__body">
                <div class="au-alert__title">@T.Plural("website.withProblems", run.PagesFailed)</div>
                @T.Html("website.withProblems.text", new Microsoft.AspNetCore.Html.HtmlString($"<a class=\"au-link\" href=\"/KnowledgeBase/Websites/{s.Id}?status={WebsitePageStatus.Failed}\">{System.Net.WebUtility.HtmlEncode(T["values.failed"].Value)}</a>"))
                @if (!string.IsNullOrWhiteSpace(run.ErrorSummary))
                {
                    <details class="alert-details"><summary>@T["messages.error.details"]</summary><div>@run.ErrorSummary</div></details>
                }
            </div>
        </div>
    }

    @if (run is not null)
    {
        <div class="facts mb-3">
            <div class="fact au-panel au-panel--round"><div class="eyebrow">@T["website.facts.found"]</div><div class="fact-main">@run.PagesDiscovered</div></div>
            <div class="fact au-panel au-panel--round"><div class="eyebrow">@T["website.page.inKnowledge"]</div><div class="fact-main">@s.IndexedPages</div></div>
            <div class="fact au-panel au-panel--round"><div class="eyebrow">@T["values.skipped"]</div><div class="fact-main">@(run.PagesSkipped + run.PagesDuplicate)</div></div>
            <div class="fact au-panel au-panel--round"><div class="eyebrow">@T["values.failed"]</div><div class="fact-main">@run.PagesFailed</div></div>
        </div>
        <details class="au-panel au-panel--round tech mb-3">
            <summary>@T["website.numbers.title"]</summary>
            <div class="kb-nums mt-2">
                @foreach (var (label, value, hint) in new[]
                {
                    (T["website.numbers.discovered"].Value, run.PagesDiscovered, T["website.numbers.discoveredHelp"].Value),
                    (T["website.numbers.processed"].Value, run.PagesProcessed, T["website.numbers.processedHelp"].Value),
                    (T["website.numbers.indexed"].Value, run.PagesIndexed, T["website.numbers.indexedHelp"].Value),
                    (T["website.numbers.new"].Value, run.PagesNew, T["website.numbers.newHelp"].Value),
                    (T["website.numbers.changed"].Value, run.PagesChanged, T["website.numbers.changedHelp"].Value),
                    (T["website.numbers.unchanged"].Value, run.PagesUnchanged, T["website.numbers.unchangedHelp"].Value),
                    (T["values.skipped"].Value, run.PagesSkipped, T["website.numbers.skippedHelp"].Value),
                    (T["values.duplicate"].Value, run.PagesDuplicate, T["website.numbers.duplicateHelp"].Value),
                    (T["values.failed"].Value, run.PagesFailed, T["website.numbers.failedHelp"].Value),
                    (T["values.removed"].Value, run.PagesRemoved, T["website.numbers.removedHelp"].Value)
                })
                {
                    <span title="@hint">@label <strong>@value</strong></span>
                }
            </div>
            <div class="cell-sub mt-1">
                @if (run.StartedAt is null)
                {
                    @T["knowledge.import.waiting"]
                }
                else
                {
                    @T.Html("campaigns.when.startedAt", LocalTimeHelper.Time(run.StartedAt))
                }
                @if (run.CompletedAt is not null)
                {
                    <text>· </text>@T.Html("website.finishedAt", LocalTimeHelper.Time(run.CompletedAt, "time"))
                }
            </div>
        </details>
    }

    <div class="section-head">
        <h2 class="section-title">@T["website.pages.title"]</h2>
        <div class="inbox-filters" aria-label="@T["website.pages.show"]">
            @foreach (var (value, label, count) in new[]
            {
                ("", T["campaigns.tabs.all"].Value, d.PageStatusCounts.Values.Sum()),
                ("in_kb", T["website.page.inKnowledge"].Value, inKb),
                (WebsitePageStatus.Failed, T["values.failed"].Value, Count(WebsitePageStatus.Failed)),
                (WebsitePageStatus.Skipped, T["values.skipped"].Value, Count(WebsitePageStatus.Skipped)),
                (WebsitePageStatus.Duplicate, T["values.duplicate"].Value, Count(WebsitePageStatus.Duplicate)),
                (WebsitePageStatus.Removed, T["values.removed"].Value, Count(WebsitePageStatus.Removed))
            })
            {
                <a href="/KnowledgeBase/Websites/@s.Id@(value == "" ? "" : "?status=" + value)"
                   class="inbox-filter @((Model.Status ?? "") == value ? "active" : "")">@label <span class="inbox-filter-count">@count</span></a>
            }
        </div>
    </div>

    @if (Model.Pages.Count == 0)
    {
        var noPages = new EmptyStateModel(Icon: s.InProgress ? "hourglass_top" : "web_asset_off",
            Title: s.InProgress ? T["website.pages.readingTitle"].Value : T["website.pages.emptyTitle"].Value,
            Text: s.InProgress ? T["website.pages.readingText"].Value : string.IsNullOrEmpty(Model.Status) ? T["website.pages.emptyText"].Value : T["website.pages.emptyFiltered"].Value,
            ActionLabel: string.IsNullOrEmpty(Model.Status) ? null : T["website.pages.showAll"].Value, ActionHref: $"/KnowledgeBase/Websites/{s.Id}", ActionIcon: "list");
        @* icon:hourglass_top *@ @* icon:web_asset_off *@
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="noPages" /></div>
    }
    else
    {
        <div class="au-table-card">
            <div class="au-table-scroll">
            <table class="au-table au-table--stack">
                <thead>
                    <tr>
                        <th>@T["website.pages.page"]</th>
                        <th>@T["services.table.status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Pages)
                    {
                        var readable = UrlDisplayHelper.Readable(p.Url);
                        <tr>
                            <td data-label="@T["website.pages.page"]">
                                <div class="min-w-0">
                                    <a href="@p.Url" target="_blank" rel="noopener noreferrer" class="row-title clip-1" dir="auto" title="@readable">@(string.IsNullOrEmpty(p.Title) ? readable : p.Title)</a>
                                    @if (!string.IsNullOrEmpty(p.Title))
                                    {
                                        <div class="cell-sub clip-1" title="@readable">@readable</div>
                                    }
                                </div>
                            </td>
                            <td data-label="@T["services.table.status"]" class="au-wrap">
                                <div>
                                    <span class="badge @PageBadge(p.Status)">@PageLabel(p.Status)</span>
                                    @if (!string.IsNullOrEmpty(p.FailureReason) || p.HttpStatus >= 400)
                                    {
                                        <div class="cell-sub break-word">@p.FailureReason@(p.HttpStatus >= 400 ? " " + T["website.pages.httpError", p.HttpStatus].Value : "")</div>
                                    }
                                </div>
                            </td>
                            <td class="row-actions">
                                @if (p.KnowledgeDocumentId is { } docId)
                                {
                                    <a href="/KnowledgeBase?edit=@docId&returnUrl=@Uri.EscapeDataString(backToThisPage)" class="au-btn au-btn--outlined au-btn--sm">@T["website.pages.viewText"]</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }

    @if (d.RecentRuns.Count > 1)
    {
        <details class="au-panel au-panel--round tech mt-3">
            <summary>@T["website.history.title", d.RecentRuns.Count]</summary>
            <div class="timeline">
                @foreach (var r in d.RecentRuns)
                {
                    <div class="tl-row">
                        <span class="badge @RunBadge(r.Status)">@RunLabel(r)</span>
                        <div class="flex-1 cell-sub">
                            @LocalTimeHelper.Time(r.StartedAt ?? r.CreatedAt, "datetime-year")
                            · @T["website.history.counts", r.PagesDiscovered, r.PagesNew, r.PagesChanged, r.PagesUnchanged]
                            @if (r.PagesFailed > 0) { <text>· @T["campaigns.progress.failed", r.PagesFailed]</text> }
                            @if (r.PagesRemoved > 0) { <text>· @T["website.history.removed", r.PagesRemoved]</text> }
                        </div>
                    </div>
                }
            </div>
        </details>
    }

    @if (s.InProgress)
    {
        <script>setTimeout(function () { location.reload(); }, 3000);</script>
    }
}
