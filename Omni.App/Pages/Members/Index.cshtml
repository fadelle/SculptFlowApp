@page "/Members"
@model Omni.App.Pages.Members.IndexModel
@{
    ViewData["Title"] = T["members.title"].Value;
    string DisplayName(MemberResponse m) =>
        !string.IsNullOrWhiteSpace(m.FullName) ? m.FullName! : !string.IsNullOrWhiteSpace(m.Email) ? m.Email!.Split('@')[0] : "—";
    string Initials(string name) =>
        string.Concat(name.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    var members = Model.Members
        .OrderByDescending(m => m.UserId == Model.CurrentUserId)
        .ThenByDescending(m => m.IsActive)
        .ThenBy(m => DisplayName(m))
        .ToList();
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="au-page-head">
        <p class="au-page-head__sub mw-640">@T["members.intro", Model.ClientName]</p>
    </div>

    @if (Model.CanManage)
    {
        <form method="post" asp-page-handler="Add" class="au-panel au-panel--round integration-form mb-3" id="member-add-form" autocomplete="off">
            <div class="set-section">
                <div class="set-section-head"><strong>@T["members.add.title"]</strong><div class="cell-sub">@T["members.add.help"]</div></div>
                <div class="set-section-body">
                    <div class="form-row-contact">
                        <label class="field">
                            <span>@T["members.add.fullName"]</span>
                            <input type="text" name="FullName" value="@Model.FullName" class="text-input" maxlength="200" required autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>@T["members.add.email"]</span>
                            <input type="email" name="Email" value="@Model.Email" class="text-input" maxlength="256" required autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>@T["members.add.password"]</span>
                            <input type="password" name="Password" class="text-input" required autocomplete="new-password" />
                        </label>
                    </div>
                    <p class="au-help">@T["members.add.passwordHelp"]</p>
                    <div><button type="submit" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">person_add</span>@T["members.add.submit"]</button></div>
                </div>
            </div>
        </form>
    }

    if (members.Count == 0)
    {
        var empty = new EmptyStateModel(Icon: "badge", Title: T["members.empty.title"].Value, Text: T["members.empty.text"].Value);
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="empty" /></div>
    }
    else
    {
        <div class="section-head">
            <h2 class="section-title">@T.Plural("members.list.count", members.Count)</h2>
            <span class="au-toolbar__meta">@(Model.SeatLimit is { } limit ? T["members.seats.limited", Model.SeatsInUse, limit] : T["members.seats.unlimited", Model.SeatsInUse])</span>
        </div>
        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead>
                        <tr>
                            <th>@T["members.table.name"]</th>
                            <th>@T["members.table.email"]</th>
                            <th>@T["members.table.role"]</th>
                            <th>@T["members.table.status"]</th>
                            <th>@T["members.table.lastSignIn"]</th>
                            @if (Model.CanManage)
                            {
                                <th><span class="au-sr-only">@T["members.table.actions"]</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in members)
                        {
                            var name = DisplayName(m);
                            var isMe = m.UserId == Model.CurrentUserId;
                            <tr class="@(m.IsActive ? "" : "row-dim")">
                                <td data-label="@T["members.table.name"]">
                                    <div class="kb-title">
                                        <span class="avatar @(m.IsActive ? "" : "avatar-off")">@Initials(name)</span>
                                        <span class="row-title" dir="auto">@name</span>
                                        @if (isMe)
                                        {
                                            <span class="badge badge-teal">@T["members.you"]</span>
                                        }
                                    </div>
                                    <div class="cell-sub" @LocalTimeHelper.Title(m.JoinedAt, "date")>@T["members.joined"] @LocalTimeHelper.Time(m.JoinedAt, "month-year")</div>
                                </td>
                                <td data-label="@T["members.table.email"]"><span dir="ltr">@(m.Email ?? "—")</span></td>
                                <td data-label="@T["members.table.role"]">@(m.Role == UserRole.Client ? T["members.role.client"] : T["members.role.member"])</td>
                                <td data-label="@T["members.table.status"]"><span class="badge @(m.IsActive ? "badge-green" : "badge-gray")">@(m.IsActive ? T["members.status.active"] : T["members.status.inactive"])</span></td>
                                <td data-label="@T["members.table.lastSignIn"]" class="cell-sub">@LocalTimeHelper.Time(m.LastLoginAt, "datetime", T["members.lastSignIn.never"].Value)</td>
                                @if (Model.CanManage)
                                {
                                    <td data-label="@T["members.table.actions"]">
                                        @if (!isMe && m.Role == UserRole.Member)
                                        {
                                            <form method="post" asp-page-handler="@(m.IsActive ? "Deactivate" : "Reactivate")"
                                                  data-au-confirm="@(m.IsActive ? T["members.actions.deactivateConfirm", name].Value : null)"
                                                  data-au-confirm-title="@(m.IsActive ? T["members.actions.deactivate"].Value : null)"
                                                  data-au-confirm-label="@(m.IsActive ? T["members.actions.deactivate"].Value : null)" data-au-confirm-tone="danger">
                                                <input type="hidden" name="userId" value="@m.UserId" />
                                                <input type="hidden" name="name" value="@name" />
                                                <button type="submit" class="au-btn au-btn--outlined au-btn--sm">@(m.IsActive ? T["members.actions.deactivate"] : T["members.actions.reactivate"])</button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (!Model.CanManage)
        {
            <p class="au-help mt-2">@T["members.readOnly"]</p>
        }
    }
}
