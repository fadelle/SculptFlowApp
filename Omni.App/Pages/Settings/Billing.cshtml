@page "/settings/billing"
@model Omni.App.Pages.Settings.BillingModel
@{
    ViewData["Title"] = T["billing.title"].Value;
    var s = Model.Summary;
    string Money(decimal value) => (s?.Currency == "USD" ? "$" : "") + value.Display("#,0.00") + (s?.Currency == "USD" ? "" : " " + s?.Currency);
    string UnitMoney(decimal value) => value.Display("#,0.00##");
    (string Css, string Text) StatusBadge(string? status) => status switch
    {
        "active" => ("badge-green", T["billing.status.active"]),
        "past_due" => ("badge-amber", T["billing.status.pastDue"]),
        "expired" => ("badge-red", T["billing.status.expired"]),
        "cancelled" => ("badge-gray", T["billing.status.cancelled"]),
        _ => ("badge-gray", T["billing.status.none"])
    };
}

@if (!Model.ClientConfigured || s is null)
{
    <partial name="_NoClient" />
}
else
{
    var badge = StatusBadge(s.SubscriptionStatus);
    // A trial ends instead of renewing: show the days left (whole days, rounded up).
    var onTrial = s.TrialDays is not null && s.SubscriptionStatus == "active" && s.CurrentPeriodEnd is not null;
    var trialDaysLeft = onTrial ? Math.Max(0, (int)Math.Ceiling((s.CurrentPeriodEnd!.Value - DateTimeOffset.UtcNow).TotalDays)) : 0;
    <div class="au-page-head">
        <p class="au-page-head__sub">@T["billing.intro"]</p>
    </div>

    @if (s.SubscriptionStatus == "past_due")
    {
        <div class="au-alert au-alert--warning" role="status">
            <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
            <div class="au-alert__body">
                <div class="au-alert__title">@T["billing.pastDue.title"]</div>
                @if (s.GraceEndsAt is not null)
                {
                    @T.Html("billing.pastDue.text", LocalTimeHelper.Time(s.GraceEndsAt.Value, "date"))
                }
            </div>
        </div>
    }
    else if (!s.HasAccess)
    {
        <div class="au-alert au-alert--warning" role="status">
            <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
            <div class="au-alert__body">
                <div class="au-alert__title">@T["billing.noPlan.title"]</div>
                @T["billing.noPlan.text"]
            </div>
        </div>
    }

    <h2 class="section-title">@T["billing.plan.title"]</h2>
    <div class="au-grid au-grid--4">
        <div class="au-stat stat-accent">
            <span class="au-eyebrow">@T["billing.plan.current"]</span>
            <div class="au-stat__value">@(s.PlanName ?? T["billing.plan.none"].Value)</div>
            <span class="au-stat__hint"><span class="badge @badge.Css">@badge.Text</span>
                @if (onTrial) { <text>· @T["billing.trial.badge"]</text> }
                else if (s.PlanPrice is not null) { <text>· @T["billing.plan.price", Money(s.PlanPrice.Value), s.BillingPeriod == BillingPeriod.Year ? T["billing.plan.perYear"] : T["billing.plan.perMonth"]]</text> }</span>
        </div>
        <div class="au-stat">
            <span class="au-eyebrow">@(onTrial ? T["billing.trial.endsOn"] : s.CancelAtPeriodEnd ? T["billing.plan.endsOn"] : T["billing.plan.renewsOn"])</span>
            <div class="au-stat__value">@LocalTimeHelper.Time(s.CurrentPeriodEnd, "date")</div>
            @if (onTrial)
            {
                <span class="au-stat__hint">@T.Plural("billing.trial.daysLeft", trialDaysLeft)</span>
            }
            else if (s.CurrentPeriodStart is not null)
            {
                <span class="au-stat__hint">@T.Html("billing.plan.periodStarted", LocalTimeHelper.Time(s.CurrentPeriodStart.Value, "date"))</span>
            }
        </div>
        <div class="au-stat">
            <span class="au-eyebrow">@T["billing.credit.left"]</span>
            <div class="au-stat__value">@Money(s.IncludedCreditRemaining)</div>
            <span class="au-stat__hint">@T["billing.credit.ofTotal", Money(s.PlanIncludedCredit)]</span>
        </div>
        <div class="au-stat">
            <span class="au-eyebrow">@T["billing.balance.title"]</span>
            <div class="au-stat__value">@Money(s.WalletBalance)</div>
            <span class="au-stat__hint">@T["billing.balance.hint", Money(s.ReservedAmount), Money(s.Spendable)]</span>
        </div>
    </div>

    @* Usage against the plan: each limit as "used of limit" with a bar, then this period's messages and AI replies. *@
    if (Model.PlanUsage is { } usage)
    {
        <h2 class="section-title">@T["billing.quota.title"] <span class="section-title__sub">@T.Html("billing.usage.since", LocalTimeHelper.Time(s.UsageSince, "date"))</span></h2>
        <div class="au-grid au-grid--4 quota-grid">
            @foreach (var q in usage.Quotas)
            {
                var full = q.Limit is { } max && q.Used >= max;
                <div class="au-stat">
                    <span class="au-eyebrow">@T.EntitlementLabel(q.Key, Omni.App.Common.Statics.EntitlementCatalog.Find(q.Key)?.Label ?? q.Key)</span>
                    <div class="au-stat__value">
                        @if (q.Limit is 0 && q.Used == 0)
                        {
                            <span class="quota-off">@T["billing.entitlement.notIncluded"]</span>
                        }
                        else if (q.Limit is { } limit)
                        {
                            @T["billing.quota.of", q.Used.Display("N0"), limit.Display("N0")]
                        }
                        else
                        {
                            @q.Used.Display("N0")
                        }
                    </div>
                    @if (q.Limit is { } l && l > 0)
                    {
                        <div class="progress quota-bar @(full ? "is-full" : "")" role="presentation"><div style="width:@(Math.Min(100, q.Used * 100 / l))%"></div></div>
                    }
                    else if (q.Limit is null)
                    {
                        <span class="au-stat__hint">@T["billing.entitlement.unlimited"]</span>
                    }
                </div>
            }
            <div class="au-stat">
                <span class="au-eyebrow">@T["billing.quota.messages"]</span>
                <div class="au-stat__value">@usage.Messages.Display("N0")</div>
                <span class="au-stat__hint">@T["billing.quota.charged", Money(usage.MessagesCharged)]</span>
            </div>
            @if (usage.AiIncluded || usage.AiReplies > 0)
            {
                <div class="au-stat">
                    <span class="au-eyebrow">@T["billing.quota.aiReplies"]</span>
                    <div class="au-stat__value">@usage.AiReplies.Display("N0")</div>
                    <span class="au-stat__hint">@T["billing.quota.charged", Money(usage.AiRepliesCharged)]</span>
                </div>
            }
        </div>
    }

    <h2 class="section-title">@T["billing.includes.title"]</h2>
    <div class="feature-chips">
        @foreach (var e in s.Entitlements.Where(e => e.Kind == "feature"))
        {
            var on = e.Value == "true";
            <span class="badge @(on ? "badge-green" : "badge-gray")" title="@(on ? T["billing.entitlement.included"] : T["billing.entitlement.notIncluded"])">
                <span class="au-icon au-icon--sm" aria-hidden="true">@(on ? "check_circle" : "block")</span>@T.EntitlementLabel(e.Key, e.Label)
                <span class="au-sr-only">@(on ? T["billing.entitlement.included"] : T["billing.entitlement.notIncluded"])</span>
            </span>
        }
    </div>

    <h2 class="section-title">@T["billing.addons.title"]</h2>
    @if (s.Addons is { Count: > 0 } addons)
    {
        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead><tr><th>@T["billing.addons.limit"]</th><th class="au-right">@T["billing.addons.units"]</th><th class="au-right">@T["billing.addons.cost"]</th></tr></thead>
                    <tbody>
                        @foreach (var a in addons)
                        {
                            <tr><td data-label="@T["billing.addons.limit"]">@T.EntitlementLabel(a.EntitlementKey, a.Name)</td><td data-label="@T["billing.addons.units"]" class="au-right"><span dir="ltr">+@a.Quantity.Display("N0")</span></td><td data-label="@T["billing.addons.cost"]" class="au-right">@Money(a.PeriodPrice)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <p class="text-subtle mt-2">@T["billing.addons.ask"]</p>

    @if (s.ChannelAccounts.Count > 0)
    {
        <h2 class="section-title">@T["billing.accounts.title"]</h2>
        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead><tr><th>@T["billing.accounts.channel"]</th><th>@T["billing.accounts.account"]</th><th>@T["billing.accounts.costs"]</th></tr></thead>
                    <tbody>
                        @foreach (var a in s.ChannelAccounts)
                        {
                            <tr><td data-label="@T["billing.accounts.channel"]">@a.ChannelLabel</td><td data-label="@T["billing.accounts.account"]"><span dir="auto">@(a.DisplayName ?? "—")</span></td><td data-label="@T["billing.accounts.costs"]">@T.PaidByLabel(a.ProviderBilling, a.Channel, a.ChargedByPlatform)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <h2 class="section-title">@T["billing.usage.title"] <span class="section-title__sub">@T.Html("billing.usage.since", LocalTimeHelper.Time(s.UsageSince, "date"))</span></h2>
    @if (s.Usage.Count == 0)
    {
        var none = new EmptyStateModel(Icon: "receipt_long", Title: T["billing.usage.empty"].Value);
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="none" /></div>
    }
    else
    {
        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead><tr><th>@T["billing.usage.type"]</th><th class="au-right">@T["billing.usage.count"]</th><th class="au-right">@T["billing.usage.charged"]</th></tr></thead>
                    <tbody>
                        @foreach (var u in s.Usage)
                        {
                            <tr><td data-label="@T["billing.usage.type"]">@T.EventTypeLabel(u.EventType)</td><td data-label="@T["billing.usage.count"]" class="au-right">@u.Count</td><td data-label="@T["billing.usage.charged"]" class="au-right">@Money(u.Amount)</td></tr>
                        }
                        <tr class="total-row"><td data-label="@T["billing.usage.type"]"><strong>@T["billing.usage.total"]</strong></td><td class="au-right"></td><td data-label="@T["billing.usage.charged"]" class="au-right"><strong>@Money(s.UsageTotal)</strong></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (s.ProviderDirectUsage.Count > 0)
    {
        <h2 class="section-title">@T["billing.direct.title"] <span class="section-title__sub">@T["billing.direct.sub"]</span></h2>
        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead><tr><th>@T["billing.usage.type"]</th><th class="au-right">@T["billing.usage.count"]</th><th>@T["billing.direct.whoPays"]</th></tr></thead>
                    <tbody>
                        @foreach (var u in s.ProviderDirectUsage)
                        {
                            <tr><td data-label="@T["billing.usage.type"]">@T.EventTypeLabel(u.EventType)</td><td data-label="@T["billing.usage.count"]" class="au-right">@u.Count</td><td data-label="@T["billing.direct.whoPays"]">@T.PaidByLabel(u.ProviderBilling, u.Channel, false)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <h2 class="section-title">@T["billing.transactions.title"]</h2>
    @if (s.RecentTransactions.Count == 0)
    {
        var none = new EmptyStateModel(Icon: "account_balance_wallet", Title: T["billing.transactions.emptyTitle"].Value,
            Text: T["billing.transactions.emptyText"].Value);
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="none" /></div>
    }
    else
    {
        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead><tr><th>@T["billing.transactions.date"]</th><th>@T["billing.transactions.description"]</th><th>@T["billing.transactions.from"]</th><th class="au-right">@T["billing.transactions.amount"]</th><th class="au-right">@T["billing.transactions.balanceAfter"]</th></tr></thead>
                    <tbody>
                        @foreach (var t in s.RecentTransactions)
                        {
                            <tr>
                                <td data-label="@T["billing.transactions.date"]" class="cell-sub" @LocalTimeHelper.Title(t.CreatedAt)>@LocalTimeHelper.Time(t.CreatedAt, "datetime-year")</td>
                                <td data-label="@T["billing.transactions.description"]" class="au-wrap">@T.LedgerLabel(t.EntryType)@(string.IsNullOrWhiteSpace(t.Reason) ? "" : " — " + t.Reason)</td>
                                <td data-label="@T["billing.transactions.from"]">@(t.BalanceType == "wallet" ? T["billing.balance.title"] : T["billing.credit.included"])</td>
                                <td data-label="@T["billing.transactions.amount"]" class="au-right">@(t.Amount > 0 ? "+" : t.Amount < 0 ? "−" : "")@UnitMoney(Math.Abs(t.Amount))</td>
                                <td data-label="@T["billing.transactions.balanceAfter"]" class="au-right">@UnitMoney(t.BalanceAfter)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="au-help mt-2">@T["billing.transactions.help"]</p>
    }
}
