@page "/settings/auto-respond"
@model Omni.App.Pages.Settings.AutoRespondModel
@{
    ViewData["Title"] = T["nav.autoRespond"].Value;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="au-page-head">
        <p class="au-page-head__sub">@T["autoReply.intro"]</p>
    </div>

    @if (Model.DisabledByAdmin)
    {
        <div class="au-alert au-alert--warning" role="status"><div class="au-alert__body">@T["autoReply.disabledByAdmin"]</div></div>
    }

    @* One form for every channel: a tab each (channel logo, grey dot = not connected), one Save. auto-respond.js reads
       [data-channel-tab], [data-channel-panel], #auto-reply-tab, [data-reopened-mode] and [data-reopened-message]. *@
    <form method="post" class="au-panel au-panel--round au-panel--pad au-stack" id="auto-reply-form">
        <input type="hidden" name="Tab" id="auto-reply-tab" value="@Model.ActiveChannel" />
        <div class="au-tabs page-tabs" role="tablist" aria-label="@T["nav.autoRespond"]">
            @foreach (var c in Model.Channels)
            {
                var ch = c.Settings.Channel;
                var isActive = ch == Model.ActiveChannel;
                <a href="?tab=@ch" class="au-tab @(isActive ? "is-active" : "")" role="tab" id="tab-@ch" aria-controls="panel-@ch"
                   aria-selected="@(isActive ? "true" : "false")" data-channel-tab="@ch">
                    <span class="tab-channel-mark" style="background:@ChannelIconHelper.Hex(ch)" aria-hidden="true">@Html.Raw(ChannelIconHelper.BrandSvg(ch) ?? ChannelIconHelper.Initials(ch))</span>
                    @ChannelNames.Brand(ch)
                    @if (!c.Connected)
                    {
                        <span class="tab-dot" title="@T["autoReply.notConnected"]"></span><span class="au-sr-only">@T["autoReply.notConnected"]</span>
                    }
                </a>
            }
        </div>

        @for (var i = 0; i < Model.Channels.Count; i++)
        {
            var channel = Model.Channels[i];
            var values = Model.FormValues(channel);
            var ch = values.Channel;
            var aiAnswers = channel.AiBotAnswersNew || channel.AiBotAnswersReopened;
            var prefix = $"Replies[{i}].";
            <div class="au-stack" role="tabpanel" id="panel-@ch" aria-labelledby="tab-@ch" data-channel-panel="@ch" hidden="@(ch != Model.ActiveChannel)">
                <input type="hidden" name="@(prefix)Channel" value="@ch" />
                @if (!channel.Connected)
                {
                    <div class="au-alert" role="note"><span class="au-icon au-alert__icon" aria-hidden="true">info</span><div class="au-alert__body">@T["autoReply.channelHelp"]</div></div>
                }

                <label class="au-check">
                    <input type="checkbox" class="au-switch" role="switch" name="@(prefix)NewConversationEnabled" value="true" checked="@values.NewConversationEnabled" />
                    @T["autoReply.new.switch"]
                </label>
                <div class="au-form-field">
                    <label class="au-form-label" for="auto-reply-new-@ch">@T["autoReply.new.message"]</label>
                    <textarea name="@(prefix)NewConversationMessage" id="auto-reply-new-@ch" class="au-textarea" rows="3" maxlength="@Model.MaxLength" dir="auto">@values.NewConversationMessage</textarea>
                    @if (channel.AiBotAnswersNew)
                    {
                        <span class="au-help">@T["autoReply.new.aiBot"]</span>
                    }
                </div>

                <div class="au-form-field">
                    <span class="au-form-label">@T["autoReply.reopened.title"]</span>
                    <div class="seg" role="radiogroup" aria-label="@T["autoReply.reopened.title"]">
                        <label class="seg-opt"><input type="radio" name="@(prefix)ReopenedMode" value="@AutoReplyReopenedMode.Off" checked="@(values.ReopenedMode == AutoReplyReopenedMode.Off)" data-reopened-mode /><span>@T["autoReply.reopened.off"]</span></label>
                        <label class="seg-opt"><input type="radio" name="@(prefix)ReopenedMode" value="@AutoReplyReopenedMode.Same" checked="@(values.ReopenedMode == AutoReplyReopenedMode.Same)" data-reopened-mode /><span>@T["autoReply.reopened.same"]</span></label>
                        <label class="seg-opt"><input type="radio" name="@(prefix)ReopenedMode" value="@AutoReplyReopenedMode.Custom" checked="@(values.ReopenedMode == AutoReplyReopenedMode.Custom)" data-reopened-mode /><span>@T["autoReply.reopened.custom"]</span></label>
                    </div>
                    <span class="au-help">@T["autoReply.reopened.help"]</span>
                    @if (channel.AiBotAnswersReopened)
                    {
                        <span class="au-help">@T["autoReply.reopened.aiBot"]</span>
                    }
                </div>
                <div class="au-form-field" data-reopened-message hidden="@(values.ReopenedMode != AutoReplyReopenedMode.Custom)">
                    <label class="au-form-label" for="auto-reply-reopened-@ch">@T["autoReply.reopened.message"]</label>
                    <textarea name="@(prefix)ReopenedMessage" id="auto-reply-reopened-@ch" class="au-textarea" rows="3" maxlength="@Model.MaxLength" dir="auto">@values.ReopenedMessage</textarea>
                </div>

                @* Only where the AI bot answers this channel; elsewhere the saved choice is kept as it is. *@
                @if (aiAnswers)
                {
                    <label class="au-check">
                        <input type="checkbox" class="au-switch" role="switch" name="@(prefix)SendWhenAiAnswers" value="true" checked="@values.SendWhenAiAnswers" />
                        @T["autoReply.sendWhenAi"]
                    </label>
                    <small class="text-subtle">@T["autoReply.sendWhenAiHelp"]</small>
                }
                else if (values.SendWhenAiAnswers)
                {
                    <input type="hidden" name="@(prefix)SendWhenAiAnswers" value="true" />
                }
            </div>
        }

        <div class="au-form-actions">
            <span class="au-help form-actions-note">@T["autoReply.billing"]</span>
            <button type="submit" class="au-btn au-btn--primary">@T["common.save"]</button>
        </div>
    </form>

    <script src="~/js/auto-respond.js" asp-append-version="true"></script>
}
