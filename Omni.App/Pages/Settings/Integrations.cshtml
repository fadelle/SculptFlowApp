@page "/settings/integrations"
@model Omni.App.Pages.Settings.IntegrationsModel
@{
    ViewData["Title"] = T["nav.integrations"].Value;
    // One entry per card on the page: the summary total, counts and rendering all come from this list.
    (bool Connected, bool Attention) MessagingState(string ch) =>
        Model.Channels.TryGetValue(ch, out var i)
            ? (i.Status == ChannelIntegrationStatus.Connected && !NeedsAttention(i), NeedsAttention(i))
            : (false, false);
    var cards = new List<(bool Connected, bool Attention, Func<Task> Render)>
    {
        (MessagingState(ChannelType.WhatsApp).Connected, MessagingState(ChannelType.WhatsApp).Attention,
            () => RenderChannelCard(ChannelType.WhatsApp, "WA", "#25D366", "WhatsApp Business", T["integrations.whatsApp.purpose"].Value, T["integrations.whatsApp.whenConnected"].Value, oauth: true)),
        (MessagingState(ChannelType.Instagram).Connected, MessagingState(ChannelType.Instagram).Attention,
            () => RenderChannelCard(ChannelType.Instagram, "IG", "#C13584", "Instagram", T["integrations.instagram.purpose"].Value, T["integrations.instagram.whenConnected"].Value, oauth: false)),
        (MessagingState(ChannelType.Facebook).Connected, MessagingState(ChannelType.Facebook).Attention,
            () => RenderChannelCard(ChannelType.Facebook, "FB", "#1877F2", "Facebook Messenger", T["integrations.facebook.purpose"].Value, T["integrations.facebook.whenConnected"].Value, oauth: true)),
        (MessagingState(ChannelType.Telegram).Connected, MessagingState(ChannelType.Telegram).Attention,
            () => RenderTelegramCard()),
        (Model.TikTok?.Status == TikTokIntegrationStatus.Connected, Model.TikTok?.Status == TikTokIntegrationStatus.Error,
            () => RenderTikTokCard()),
    };
    var connectedCount = cards.Count(c => c.Connected);
    var attentionCount = cards.Count(c => c.Attention);
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="au-page-head">
        <p class="au-page-head__sub">@T["integrations.intro"]</p>
    </div>
    <div class="int-summary">
        <strong>@T["integrations.summary", connectedCount, cards.Count]</strong>
        @if (attentionCount > 0)
        {
            <span class="text-danger-soft"> · @T.Plural("integrations.summaryAttention", attentionCount)</span>
        }
    </div>

    <div class="int-grid int-grid-even">
        @foreach (var card in cards)
        {
            await card.Render();
        }
    </div>
}

<script>
    window.PS_META_CONFIG = {
        appId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaAppId)),
        version: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaGraphApiVersion)),
        clientId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClientId.ToString())),
        whatsappConfigId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaWhatsAppLoginConfigId)),
        facebookConfigId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaFacebookLoginConfigId))
    };
</script>
<script src="~/js/meta-connect.js" asp-append-version="true"></script>
<script>
    // Two-step PIN: hidden until "Show" is pressed.
    document.querySelectorAll('[data-pin-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var pin = btn.parentElement.querySelector('[data-pin]');
            var shown = pin.textContent !== '••••••';
            pin.textContent = shown ? '••••••' : pin.getAttribute('data-pin');
            btn.textContent = shown ? btn.getAttribute('data-show-label') : btn.getAttribute('data-hide-label');
        });
    });

    // Card popups: open from [data-open], close with ×/Cancel, a click outside, or Esc.
    document.querySelectorAll('[data-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var m = document.getElementById(btn.getAttribute('data-open'));
            m.hidden = false;
            var first = m.querySelector('input:not([type=hidden]), select, textarea');
            if (first) first.focus();
        });
    });
    document.querySelectorAll('.int-modal').forEach(function (card) {
        var overlay = card.parentElement;
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay || e.target.closest('[data-close]')) overlay.hidden = true;
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') document.querySelectorAll('.int-modal').forEach(function (c) { c.parentElement.hidden = true; });
    });
</script>

@functions {
    // A channel needs attention when it's in error, or (Telegram) its webhook reports a problem.
    private static bool NeedsAttention(ChannelIntegrationResponse i) =>
        i.Status == ChannelIntegrationStatus.Error
        || (i.Channel == ChannelType.Telegram && i.Status == ChannelIntegrationStatus.Connected && i.WebhookStatus == WebhookStatus.Error);

    private async Task RenderStatusPill(ChannelIntegrationResponse? info)
    {
        var (label, dot) = info is not null && NeedsAttention(info) ? (T["integrations.state.attention"].Value, "dot-red")
            : info?.Status == ChannelIntegrationStatus.Connected ? (T["integrations.state.connected"].Value, "dot-green")
            : (T["integrations.state.notConnected"].Value, "dot-gray");
        <span class="status-pill"><span class="dot @dot"></span>@label</span>
        await Task.CompletedTask;
    }

    // Popup that holds a card's form (manual setup, account details, a different bot) so the cards never grow.
    private async Task RenderModalStart(string id, string channel, string accentHex, string title, string subtitle)
    {
        @:<div class="bm-overlay" id="@id" hidden>
        @:<div class="card cal-modal int-modal" role="dialog" aria-modal="true" aria-labelledby="@(id)-title">
            <div class="modal-head">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="channel-mark ch-@channel" style="background:@accentHex">@Html.Raw(Omni.App.Common.Helpers.ChannelIconHelper.BrandSvg(channel) ?? "")</span>
                    <div class="min-w-0">
                        <h3 class="card-title m-0" id="@(id)-title">@title</h3>
                        <div class="cell-sub">@subtitle</div>
                    </div>
                </div>
                <button type="button" class="au-icon-btn" data-close aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
        await Task.CompletedTask;
    }

    private async Task RenderModalEnd()
    {
        @:</div>
        @:</div>
        await Task.CompletedTask;
    }

    // One Meta channel's card. Connecting uses the OAuth button (when oauth: true and a Login Configuration ID
    // is set) or the manual form in a popup; Instagram is manual only (its Login Configuration isn't set up yet).
    private async Task RenderChannelCard(string channel, string initials, string accentHex, string title, string purpose, string whenConnected, bool oauth)
    {
        var info = Model.Channels.TryGetValue(channel, out var c) ? c : null;
        var connected = info?.Status == ChannelIntegrationStatus.Connected;
        var isError = info?.Status == ChannelIntegrationStatus.Error;
        var configId = channel switch
        {
            ChannelType.WhatsApp => Model.MetaWhatsAppLoginConfigId,
            ChannelType.Facebook => Model.MetaFacebookLoginConfigId,
            _ => ""
        };
        // Only WhatsApp uses a JS-driven button; Facebook Messenger uses Meta's fb:login-button plugin.
        var jsFunction = channel == ChannelType.WhatsApp ? "psConnectWhatsApp" : "";
        var modalId = "int-m-" + channel;

        <div class="card int-card int-framed @(isError ? "int-card-error" : "")" style="--ch:@accentHex">
            <div class="int-head">
                <span class="channel-mark int-notch ch-@channel" title="@title">@Html.Raw(Omni.App.Common.Helpers.ChannelIconHelper.BrandSvg(channel) ?? initials)</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">@title</div>
                    <div class="cell-sub">@((connected || isError) && !string.IsNullOrEmpty(info!.DisplayName) ? info.DisplayName : purpose)</div>
                </div>
                @{ await RenderStatusPill(info); }
            </div>

            @* Middle strip: same place on every card. *@
            @if (isError)
            {
                <div class="int-strip int-strip-problem">
                    <div>
                        <span class="cell-sub">@T["integrations.strip.problem"]</span>
                        <span class="int-val">@T["integrations.channel.stopped", title]</span>
                        @if (!string.IsNullOrEmpty(info!.LastError))
                        {
                            <details class="mt-1"><summary class="cell-sub">@T["messages.error.details"]</summary><div class="cell-sub break-word">@info.LastError</div></details>
                        }
                    </div>
                </div>
            }
            else if (connected && channel == ChannelType.WhatsApp)
            {
                <div class="int-strip">
                    @if (!string.IsNullOrEmpty(info!.Pin))
                    {
                        <div>
                            <span class="cell-sub">@T["integrations.whatsApp.pin"]</span>
                            <span class="int-val"><code data-pin="@info.Pin">••••••</code> <button type="button" class="link-btn" data-pin-toggle data-show-label="@T["integrations.whatsApp.pinShow"]" data-hide-label="@T["integrations.whatsApp.pinHide"]">@T["integrations.whatsApp.pinShow"]</button></span>
                        </div>
                    }
                    <div>
                        <span class="cell-sub">@T["integrations.whatsApp.health"]</span>
                        <span class="int-val"><a href="/WhatsApp/Health">@T["integrations.whatsApp.viewHealth"]</a></span>
                    </div>
                </div>
            }
            else if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">@(channel == ChannelType.Instagram ? T["integrations.instagram.account"] : T["integrations.facebook.page"])</span>
                        <span class="int-val">@(string.IsNullOrEmpty(info!.DisplayName) ? (channel == ChannelType.Instagram ? info.InstagramBusinessId : info.PageId) ?? "—" : info.DisplayName)</span>
                    </div>
                    <div>
                        <span class="cell-sub">@T["integrations.messages.label"]</span>
                        <span class="int-val">@T["integrations.messages.inbox"]</span>
                    </div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div>
                        <span class="cell-sub">@T["integrations.strip.whenConnected"]</span>
                        <span class="int-val">@whenConnected</span>
                    </div>
                </div>
            }

            @if (!connected && oauth)
            {
                @if (string.IsNullOrEmpty(configId))
                {
                    <div class="cell-sub" title="@T["integrations.meta.missingConfigHelp"]">@T["integrations.meta.missingConfig"]</div>
                }
                else
                {
                    <div class="text-subtle text-xs" data-status-for="@channel"></div>
                }
            }

            <div class="int-foot">
                @if (!connected && oauth)
                {
                    @* Connect (or reconnect) with Facebook sign-in. *@
                    @if (channel == ChannelType.Facebook && !string.IsNullOrEmpty(configId))
                    {
                        <fb:login-button config_id="@configId" onlogin="psFacebookOnLogin();"></fb:login-button>
                    }
                    else
                    {
                        <button type="button" class="au-btn au-btn--primary au-btn--sm"
                                onclick="@(string.IsNullOrEmpty(jsFunction) ? null : jsFunction + "()")"
                                disabled="@string.IsNullOrEmpty(configId)">
                            @(isError ? T["integrations.meta.reconnect"] : T["integrations.meta.continue"])
                        </button>
                    }
                }
                <button type="button" class="au-btn au-btn--sm @(connected || isError || oauth ? "au-btn--text" : "au-btn--primary")" data-open="@modalId">
                    @(connected || isError ? T["integrations.manual.details"] : oauth ? T["integrations.manual.setUpManually"] : T["integrations.manual.setUp"])
                </button>
                @if (connected || isError)
                {
                    <form method="post" asp-page-handler="Disconnect" class="inline-form int-foot-end"
                          data-au-confirm="@T["integrations.channel.disconnectConfirm", title]" data-au-confirm-title="@T["integrations.disconnectTitle", title]" data-au-confirm-label="@T["integrations.action.disconnect"]" data-au-confirm-tone="danger">
                        <input type="hidden" name="Channel" value="@channel" />
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">@T["integrations.action.disconnect"]</button>
                    </form>
                }
            </div>
        </div>

        await RenderModalStart(modalId, channel, accentHex,
            connected || isError ? T["integrations.manual.detailsTitle", title] : oauth ? T["integrations.manual.setUpManuallyTitle", title] : T["integrations.manual.setUpTitle", title],
            connected || isError ? (info?.DisplayName ?? T["integrations.manual.detailsSub"].Value)
                : oauth ? T["integrations.manual.setUpManuallySub"] : T["integrations.manual.setUpSub"]);
        await RenderManualForm(channel, info, connected);
        await RenderModalEnd();
    }

    // Telegram: the client pastes a BotFather token and Omni does the rest (getMe, then setWebhook with a
    // generated secret). The token is write-only — nothing here can render a saved one.
    private async Task RenderTelegramCard()
    {
        var info = Model.Channels.TryGetValue(ChannelType.Telegram, out var c) ? c : null;
        var connected = info?.Status == ChannelIntegrationStatus.Connected;
        var problem = info is not null && NeedsAttention(info);
        const string modalId = "int-m-telegram";

        <div class="card int-card int-framed @(problem ? "int-card-error" : "")" style="--ch:#229ED9">
            <div class="int-head">
                <span class="channel-mark int-notch ch-telegram" title="Telegram">@Html.Raw(Omni.App.Common.Helpers.ChannelIconHelper.BrandSvg(ChannelType.Telegram))</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">Telegram</div>
                    <div class="cell-sub">
                        @if (!string.IsNullOrEmpty(info?.TelegramBotUsername))
                        {
                            <text>@(connected ? "@" + info!.TelegramBotUsername : T["integrations.telegram.lastBot", "@" + info!.TelegramBotUsername].Value)</text>
                        }
                        else
                        {
                            <text>@T["integrations.telegram.purpose"]</text>
                        }
                    </div>
                </div>
                @{ await RenderStatusPill(info); }
            </div>

            @if (!string.IsNullOrEmpty(info?.LastError))
            {
                <div class="int-strip int-strip-problem">
                    <div>
                        <span class="cell-sub">@T["integrations.strip.problem"]</span>
                        <span class="int-val">@T["integrations.telegram.problem"]</span>
                        <details class="mt-1"><summary class="cell-sub">@T["messages.error.details"]</summary><div class="cell-sub break-word">@info!.LastError</div></details>
                    </div>
                </div>
            }
            else if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">@T["integrations.telegram.receiving"]</span>
                        <span class="int-val">@(info!.WebhookStatus switch { WebhookStatus.Active => T["integrations.telegram.receivingYes"], WebhookStatus.Pending => T["integrations.telegram.receivingPending"], _ => T["integrations.telegram.receivingNo"] })</span>
                    </div>
                    <div>
                        <span class="cell-sub">@T["integrations.telegram.lastMessage"]</span>
                        <span class="int-val" title="@(info.LastWebhookAt is { } lastWebhook ? TextCulture.Date(lastWebhook.UtcDateTime, DateStyle.MonthDayTime) + " UTC" : null)">
                            @if (info.LastWebhookAt is { } last) { @LocalTimeHelper.Ago(T, last) } else { <text>@T["integrations.telegram.noMessage"]</text> }
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div>
                        <span class="cell-sub">@T["integrations.strip.whenConnected"]</span>
                        <span class="int-val">@T["integrations.telegram.whenConnected"]</span>
                    </div>
                </div>
            }

            <div class="int-foot">
                @if (connected)
                {
                    <form method="post" asp-page-handler="RefreshTelegram" class="inline-form">
                        <button type="submit" class="au-btn au-btn--outlined au-btn--sm">@T["integrations.telegram.check"]</button>
                    </form>
                    <button type="button" class="au-btn au-btn--text au-btn--sm" data-open="@modalId">@T["integrations.telegram.otherBot"]</button>
                    <form method="post" asp-page-handler="Disconnect" class="inline-form int-foot-end"
                          data-au-confirm="@T["integrations.telegram.disconnectConfirm"]" data-au-confirm-title="@T["integrations.disconnectTitle", "Telegram"]" data-au-confirm-label="@T["integrations.action.disconnect"]" data-au-confirm-tone="danger">
                        <input type="hidden" name="Channel" value="@ChannelType.Telegram" />
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">@T["integrations.action.disconnect"]</button>
                    </form>
                }
                else
                {
                    <button type="button" class="au-btn au-btn--primary au-btn--sm" data-open="@modalId">@T["integrations.action.connect"]</button>
                }
            </div>
        </div>

        await RenderModalStart(modalId, ChannelType.Telegram, "#229ED9",
            connected ? T["integrations.telegram.otherBot"] : T["integrations.telegram.connectTitle"],
            connected && !string.IsNullOrEmpty(info?.TelegramBotUsername) ? T["integrations.telegram.replaces", "@" + info!.TelegramBotUsername] : T["integrations.telegram.connectSub"]);
        await RenderTelegramConnectForm(connected ? T["integrations.action.reconnect"] : T["integrations.action.connect"]);
        await RenderModalEnd();
    }

    private async Task RenderTelegramConnectForm(string buttonLabel)
    {
        <form method="post" asp-page-handler="ConnectTelegram" class="integration-form">
            <ol class="steps">
                <li>@T.Html("integrations.telegram.step1", new Microsoft.AspNetCore.Html.HtmlString("<strong>@BotFather</strong>"))</li>
                <li>@T.Html("integrations.telegram.step2", new Microsoft.AspNetCore.Html.HtmlString("<code>/newbot</code>"))</li>
                <li>@T["integrations.telegram.step3"]</li>
            </ol>
            <label class="field">
                <span>@T["integrations.telegram.token"]</span>
                <input type="password" name="BotToken" class="text-input" autocomplete="off" spellcheck="false"
                       placeholder="123456789:AA…" required />
                <small class="text-subtle">@T["integrations.telegram.tokenHelp"]</small>
            </label>
            <div class="flex items-center gap-2">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm">@buttonLabel</button>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-close>@T["common.cancel"]</button>
            </div>
        </form>
        await Task.CompletedTask;
    }

    // TikTok Login Kit: account connection only (not a messaging channel yet — see
    // Business/Contracts/Services/TikTok/ITikTokIntegrationService.cs), so Connect/Reconnect is a plain link to TikTokOAuthController
    // (a real browser redirect to TikTok's consent screen), same pattern as Calendar Integrations' cards.
    private async Task RenderTikTokCard()
    {
        var info = Model.TikTok;
        var connected = info?.Status == TikTokIntegrationStatus.Connected;
        var pending = info?.Status == TikTokIntegrationStatus.Pending;
        var failed = info?.Status == TikTokIntegrationStatus.Error;
        var unhealthy = connected && info is not null && !info.IsHealthy;
        var (label, dot) = failed || unhealthy ? (T["integrations.state.attention"].Value, "dot-red")
            : connected ? (T["integrations.state.connected"].Value, "dot-green")
            : pending ? (T["integrations.state.connecting"].Value, "dot-gray")
            : (T["integrations.state.notConnected"].Value, "dot-gray");

        <div class="card int-card int-framed @(failed || unhealthy ? "int-card-error" : "")" style="--ch:#000000">
            <div class="int-head">
                <span class="channel-mark int-notch ch-tiktok" title="TikTok">@Html.Raw(Omni.App.Common.Helpers.ChannelIconHelper.BrandSvg("tiktok"))</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">TikTok</div>
                    <div class="cell-sub">@(connected && !string.IsNullOrEmpty(info!.DisplayName) ? info.DisplayName : T["integrations.tiktok.purpose"].Value)</div>
                </div>
                <span class="status-pill"><span class="dot @dot"></span>@label</span>
            </div>

            @if (failed || unhealthy)
            {
                <div class="int-strip int-strip-problem">
                    <div>
                        <span class="cell-sub">@T["integrations.strip.problem"]</span>
                        <span class="int-val">@T["integrations.tiktok.stopped"]</span>
                        @if (!string.IsNullOrEmpty(info?.LastProblemMessage))
                        {
                            <details class="mt-1"><summary class="cell-sub">@T["messages.error.details"]</summary><div class="cell-sub break-word">@info.LastProblemMessage</div></details>
                        }
                    </div>
                </div>
            }
            else if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">@T["integrations.tiktok.account"]</span>
                        <span class="int-val">@(info!.DisplayName ?? T["integrations.state.connected"].Value)</span>
                    </div>
                </div>
            }
            else if (pending)
            {
                <div class="int-strip int-strip-note">
                    <div><span class="cell-sub">@T["integrations.strip.notFinished"]</span><span class="int-val">@T["calendars.notFinished", "TikTok"]</span></div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div><span class="cell-sub">@T["integrations.strip.whenConnected"]</span><span class="int-val">@T["integrations.tiktok.whenConnected"]</span></div>
                </div>
            }

            <div class="int-foot">
                @if (pending || failed)
                {
                    <a href="/tiktok-oauth/connect" class="au-btn au-btn--primary au-btn--sm">@(pending ? T["integrations.action.startAgain"] : T["integrations.action.tryAgain"])</a>
                    <form method="post" asp-page-handler="DisconnectTikTok" class="inline-form">
                        <button type="submit" class="au-btn au-btn--text au-btn--sm">@T["integrations.action.reset"]</button>
                    </form>
                }
                else if (!connected)
                {
                    <a href="/tiktok-oauth/connect" class="au-btn au-btn--primary au-btn--sm">@T["integrations.action.connect"]</a>
                }
                else
                {
                    @if (unhealthy)
                    {
                        <a href="/tiktok-oauth/connect" class="au-btn au-btn--primary au-btn--sm">@T["integrations.action.reconnect"]</a>
                    }
                    <form method="post" asp-page-handler="DisconnectTikTok" class="inline-form int-foot-end"
                          data-au-confirm="@T["integrations.tiktok.disconnectConfirm"]" data-au-confirm-title="@T["integrations.disconnectTitle", "TikTok"]" data-au-confirm-label="@T["integrations.action.disconnect"]" data-au-confirm-tone="danger">
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">@T["integrations.action.disconnect"]</button>
                    </form>
                }
            </div>
        </div>
        await Task.CompletedTask;
    }

    private async Task RenderManualForm(string channel, ChannelIntegrationResponse? info, bool connected)
    {
        var tokenOnFile = info is not null && info.HasAccessToken;
        <form method="post" asp-page-handler="Save" class="integration-form">
            <input type="hidden" name="Channel" value="@channel" />

            <div class="form-row-even">
                <label class="field">
                    <span>@T["integrations.manual.displayName"]</span>
                    <input type="text" name="DisplayName" value="@(info?.DisplayName)" placeholder="@T["integrations.manual.displayNamePlaceholder"]" class="text-input" />
                </label>

                @if (channel == ChannelType.WhatsApp)
                {
                    <label class="field">
                        <span>@T["integrations.manual.phoneNumberId"]</span>
                        <input type="text" name="PhoneNumberId" value="@(info?.PhoneNumberId)" class="text-input" />
                        <small class="text-subtle">@T["integrations.manual.phoneNumberIdHelp"]</small>
                    </label>
                    <label class="field">
                        <span>@T["integrations.manual.wabaId"]</span>
                        <input type="text" name="WhatsAppBusinessId" value="@(info?.WhatsAppBusinessId)" class="text-input" />
                        <small class="text-subtle">@T["integrations.manual.wabaIdHelp"]</small>
                    </label>
                    <label class="field">
                        <span>@T["integrations.manual.verifyToken"]</span>
                        <input type="text" name="WebhookVerifyToken"
                               placeholder="@(info?.HasWebhookVerifyToken == true ? T["integrations.manual.keepSecret"] : T["integrations.manual.verifyTokenPlaceholder"])"
                               class="text-input" />
                        <small class="text-subtle">@T["integrations.manual.verifyTokenHelp"]</small>
                    </label>
                }
                else if (channel == ChannelType.Instagram)
                {
                    <label class="field">
                        <span>@T["integrations.manual.instagramId"]</span>
                        <input type="text" name="InstagramBusinessId" value="@(info?.InstagramBusinessId)" class="text-input" />
                        <small class="text-subtle">@T["integrations.manual.instagramIdHelp"]</small>
                    </label>
                    <label class="field">
                        <span>@T["integrations.manual.linkedPageId"]</span>
                        <input type="text" name="PageId" value="@(info?.PageId)" class="text-input" />
                        <small class="text-subtle">@T["integrations.manual.pageIdHelp"]</small>
                    </label>
                }
                else if (channel == ChannelType.Facebook)
                {
                    <label class="field">
                        <span>@T["integrations.manual.pageId"]</span>
                        <input type="text" name="PageId" value="@(info?.PageId)" class="text-input" />
                        <small class="text-subtle">@T["integrations.manual.pageIdHelp"]</small>
                    </label>
                }
            </div>

            <label class="field">
                <span>@T["integrations.manual.accessToken"]</span>
                <input type="password" name="AccessToken"
                       placeholder="@(tokenOnFile ? T["integrations.manual.keepSecret"] : T["integrations.manual.accessTokenPlaceholder"])"
                       class="text-input" autocomplete="off" />
                <small class="text-subtle">@(tokenOnFile ? T["integrations.manual.tokenSaved"] : T["integrations.manual.tokenNew"])</small>
            </label>

            <div class="flex items-center gap-2">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm">@(connected ? T["common.saveChanges"] : T["integrations.action.connect"])</button>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-close>@T["common.cancel"]</button>
            </div>
        </form>
        await Task.CompletedTask;
    }
}
