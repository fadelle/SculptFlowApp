@page "/settings/calendar-integrations"
@model Omni.App.Pages.Settings.CalendarIntegrationsModel
@{
    ViewData["Title"] = T["nav.calendarIntegrations"].Value;
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="au-page-head">
        <p class="au-page-head__sub">@T["calendars.intro"] <span class="one-way">@T["calendars.oneWay"]</span></p>
    </div>
    <p class="cell-sub mb-3">@T["calendars.oneWayHelp"]</p>

    <div class="int-grid int-grid-even">
        @{ await RenderProviderCard(CalendarProvider.Google, "G", "#4285F4", "Google Calendar", "Google"); }
        @{ await RenderProviderCard(CalendarProvider.Outlook, "O", "#0078D4", "Outlook Calendar", "Outlook"); }
    </div>
}

<script>
    // Calendar popups: open from [data-open], close with ×/Cancel, a click outside, or Esc.
    document.querySelectorAll('[data-open]').forEach(function (btn) {
        btn.addEventListener('click', function () { document.getElementById(btn.getAttribute('data-open')).hidden = false; });
    });
    document.querySelectorAll('.int-modal').forEach(function (card) {
        var overlay = card.parentElement;
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay || e.target.closest('[data-close]')) overlay.hidden = true;
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') document.querySelectorAll('.int-modal').forEach(function (c) { c.parentElement.hidden = true; });
    });
</script>

@functions {
    private async Task RenderProviderCard(string provider, string initials, string accentHex, string title, string shortName)
    {
        var info = Model.Integrations.FirstOrDefault(i => i.Provider == provider);
        var connected = info?.Status == CalendarIntegrationStatus.Connected;
        var unhealthy = connected && !info!.IsHealthy;
        var failed = info?.Status == CalendarIntegrationStatus.Error;
        var pending = info?.Status == CalendarIntegrationStatus.Pending;
        var (label, dot) = unhealthy || failed ? (T["integrations.state.attention"].Value, "dot-red")
            : connected ? (T["integrations.state.connected"].Value, "dot-green")
            : pending ? (T["integrations.state.connecting"].Value, "dot-gray")
            : (T["integrations.state.notConnected"].Value, "dot-gray");
        var hasCalendar = connected && !string.IsNullOrEmpty(info!.SelectedCalendarId);
        var modalId = "cal-m-" + provider;
        var calendarName = !hasCalendar ? null
            : info!.AvailableCalendars.FirstOrDefault(c => c.ExternalCalendarId == info.SelectedCalendarId)?.Name ?? info.SelectedCalendarName ?? T["calendars.chosen"].Value;

        <div class="card int-card int-framed @(unhealthy || failed ? "int-card-error" : "")" style="--ch:@accentHex">
            <div class="int-head">
                <span class="channel-mark int-notch ch-@provider" title="@title">@Html.Raw(Omni.App.Common.Helpers.ChannelIconHelper.BrandSvg(provider) ?? initials)</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">@title</div>
                    <div class="cell-sub">@(connected && !string.IsNullOrEmpty(info!.AccountDisplayName) ? info.AccountDisplayName : T["calendars.cardSub", shortName].Value)</div>
                </div>
                <span class="status-pill"><span class="dot @dot"></span>@label</span>
            </div>

            @* Middle strip: same place on every card. *@
            @if ((unhealthy || failed) && !string.IsNullOrEmpty(info?.LastProblemMessage))
            {
                <div class="int-strip int-strip-problem">
                    <div><span class="cell-sub">@T["integrations.strip.problem"]</span><span class="int-val">@info.LastProblemMessage</span></div>
                </div>
            }
            else if (pending)
            {
                <div class="int-strip int-strip-note">
                    <div><span class="cell-sub">@T["integrations.strip.notFinished"]</span><span class="int-val">@T["calendars.notFinished", shortName]</span></div>
                </div>
            }
            else if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">@T["calendars.calendar"]</span>
                        <span class="int-val">@(calendarName ?? T["calendars.notChosen"].Value)</span>
                    </div>
                    <div>
                        <span class="cell-sub">@T["calendars.sync"]</span>
                        <span class="int-val">
                            @if (!hasCalendar)
                            {
                                <text>@T["calendars.chooseFirst"]</text>
                            }
                            else
                            {
                                <span class="dot @(info!.SyncEnabled ? "dot-green" : "dot-gray")"></span>
                                @(info.SyncEnabled ? T["calendars.syncOn"] : T["calendars.syncOff"])
                                @if (info.LastSyncedAt is { } s)
                                {
                                    <span class="cell-sub"> · @LocalTimeHelper.Ago(s)</span>
                                }
                            }
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div><span class="cell-sub">@T["integrations.strip.whenConnected"]</span><span class="int-val">@T["calendars.whenConnected", shortName]</span></div>
                </div>
            }

            <div class="int-foot">
                @if (pending || failed)
                {
                    <a href="/calendar-oauth/@provider/connect" class="au-btn au-btn--primary au-btn--sm">@(pending ? T["integrations.action.startAgain"] : T["integrations.action.tryAgain"])</a>
                    <form method="post" asp-page-handler="Disconnect" class="inline-form">
                        <input type="hidden" name="provider" value="@provider" />
                        <button type="submit" class="au-btn au-btn--text au-btn--sm">@T["integrations.action.reset"]</button>
                    </form>
                }
                else if (!connected)
                {
                    <a href="/calendar-oauth/@provider/connect" class="au-btn au-btn--primary au-btn--sm">@T["integrations.action.connect"]</a>
                }
                else
                {
                    @if (unhealthy)
                    {
                        <a href="/calendar-oauth/@provider/connect" class="au-btn au-btn--primary au-btn--sm">@T["integrations.action.reconnect"]</a>
                    }
                    <button type="button" class="au-btn au-btn--sm @(hasCalendar || unhealthy ? "au-btn--text" : "au-btn--primary")" data-open="@modalId">@(hasCalendar ? T["calendars.change"] : T["calendars.choose"])</button>
                    @if (hasCalendar)
                    {
                        <form method="post" asp-page-handler="SetSyncEnabled" class="inline-form">
                            <input type="hidden" name="provider" value="@provider" />
                            <input type="hidden" name="enabled" value="@((!info!.SyncEnabled).ToString().ToLowerInvariant())" />
                            <button type="submit" class="au-btn au-btn--text au-btn--sm">@(info.SyncEnabled ? T["calendars.turnSyncOff"] : T["calendars.turnSyncOn"])</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Disconnect" class="inline-form int-foot-end"
                          data-au-confirm="@T["calendars.disconnectConfirm", title]" data-au-confirm-title="@T["integrations.disconnectTitle", title]" data-au-confirm-label="@T["integrations.action.disconnect"]" data-au-confirm-tone="danger">
                        <input type="hidden" name="provider" value="@provider" />
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">@T["integrations.action.disconnect"]</button>
                    </form>
                }
            </div>
        </div>

        @if (connected)
        {
            @* Choosing the calendar happens in a popup so the card never changes size. *@
            <div class="bm-overlay" id="@modalId" hidden>
                <div class="card cal-modal int-modal" role="dialog" aria-modal="true" aria-labelledby="@(modalId)-title">
                    <div class="modal-head">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="channel-mark ch-@provider" style="background:@accentHex">@Html.Raw(Omni.App.Common.Helpers.ChannelIconHelper.BrandSvg(provider) ?? initials)</span>
                            <div class="min-w-0">
                                <h3 class="card-title m-0" id="@(modalId)-title">@(hasCalendar ? T["calendars.change"] : T["calendars.chooseOne"])</h3>
                                <div class="cell-sub">@T["calendars.modalSub", shortName]</div>
                            </div>
                        </div>
                        <button type="button" class="au-icon-btn" data-close aria-label="@T["common.close"]" title="@T["common.close"]"><span class="au-icon" aria-hidden="true">close</span></button>
                    </div>
                    <div class="integration-form">
                        <label class="field">
                            <span>@T["calendars.calendar"]</span>
                            <span class="flex gap-2">
                                <select name="externalCalendarId" form="@(modalId)-form" class="select flex-1 min-w-0" required>
                                    <option value="">@T["calendars.placeholder"]</option>
                                    @if (hasCalendar && !info!.AvailableCalendars.Any(c => c.ExternalCalendarId == info.SelectedCalendarId))
                                    {
                                        @* The chosen calendar isn't in the (possibly not yet loaded) list: still show it as chosen. *@
                                        <option value="@info.SelectedCalendarId" selected>@calendarName</option>
                                    }
                                    @foreach (var cal in info!.AvailableCalendars)
                                    {
                                        <option value="@cal.ExternalCalendarId" selected="@(cal.ExternalCalendarId == info.SelectedCalendarId)">@(cal.IsPrimary ? T["calendars.primary", cal.Name ?? ""] : cal.Name)</option>
                                    }
                                </select>
                                <form method="post" asp-page-handler="RefreshCalendars" class="inline-form">
                                    <input type="hidden" name="provider" value="@provider" />
                                    <button type="submit" class="au-icon-btn au-icon-btn--bordered" title="@T["calendars.refresh"]" aria-label="@T["calendars.refresh"]"><span class="au-icon" aria-hidden="true">refresh</span></button>
                                </form>
                            </span>
                            @if (info.AvailableCalendars.Count == 0)
                            {
                                <small class="text-subtle">@T["calendars.noneFound"]</small>
                            }
                        </label>
                        <form method="post" asp-page-handler="SelectCalendar" id="@(modalId)-form" class="flex items-center gap-2">
                            <input type="hidden" name="provider" value="@provider" />
                            <button type="submit" class="au-btn au-btn--primary au-btn--sm">@T["common.save"]</button>
                            <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-close>@T["common.cancel"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        await Task.CompletedTask;
    }
}
