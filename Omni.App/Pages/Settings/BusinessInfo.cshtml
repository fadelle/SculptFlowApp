@page "/settings/business-info"
@model Omni.App.Pages.Settings.BusinessInfoModel
@inject ITextContext TextContext
@{
    ViewData["Title"] = T["nav.businessInfo"].Value;
    // English day names are the rows' data-day values (business-info.js finds Monday by it); people see DayLabel.
    var dayNames = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
    string DayLabel(int day) => day switch
    {
        0 => T["days.sunday"], 1 => T["days.monday"], 2 => T["days.tuesday"], 3 => T["days.wednesday"],
        4 => T["days.thursday"], 5 => T["days.friday"], _ => T["days.saturday"],
    };
    static (string Month, string Day, string Long) DateParts(string value) =>
        DateOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var d)
            ? (TextCulture.Date(d, DateStyle.MonthShort), d.Day.Display("0"), TextCulture.Date(d, DateStyle.WeekdayDate))
            : ("", "", value);
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <nav class="au-tabs page-tabs" aria-label="@T["businessInfo.tabs.label"]">
        <a asp-page="/Settings/BusinessInfo" class="au-tab @(Model.ActiveTab == "general" ? "is-active" : "")" aria-current="@(Model.ActiveTab == "general" ? "page" : null)"><span class="au-icon" aria-hidden="true">apartment</span>@T["businessInfo.tabs.details"]</a>
        <a asp-page="/Settings/BusinessInfo" asp-route-tab="availability" class="au-tab @(Model.ActiveTab == "availability" ? "is-active" : "")" aria-current="@(Model.ActiveTab == "availability" ? "page" : null)"><span class="au-icon" aria-hidden="true">schedule</span>@T["businessInfo.tabs.hours"]</a>
        @if (Model.InboxSettings?.PlanIncludesAiBot == true)
        {
            <a asp-page="/Settings/BusinessInfo" asp-route-tab="ai" class="au-tab @(Model.ActiveTab == "ai" ? "is-active" : "")" aria-current="@(Model.ActiveTab == "ai" ? "page" : null)"><span class="au-icon" aria-hidden="true">smart_toy</span>@T["businessInfo.tabs.ai"]</a>
        }
    </nav>

    @* business-info.js reads [data-dirty-form], [data-save-bar], [data-save-text], [data-discard], #client-website(-open), the
       week rows ([data-day*]), [data-rule], #avail-*, #exc-form, #exc-mode button[data-closed], #exc-closed/start/end. *@

    if (Model.ActiveTab == "general")
    {
        <p class="au-page-head__sub mb-3">@T["businessInfo.details.intro"]</p>

        <form method="post" class="au-panel au-panel--round integration-form client-form" id="client-form" data-dirty-form>
            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.details.client"]</strong><div class="cell-sub">@T["businessInfo.details.clientHelp"]</div></div>
                <div class="set-section-body">
                    <label class="field">
                        <span>@T["signup.clientName"]</span>
                        <input type="text" name="Name" value="@Model.Name" class="text-input" maxlength="200" required />
                    </label>
                </div>
            </div>

            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.details.reach"]</strong><div class="cell-sub">@T["businessInfo.details.reachHelp"]</div></div>
                <div class="set-section-body">
                    <div class="form-row-contact">
                        <label class="field">
                            <span>@T["businessInfo.details.phone"]</span>
                            <input type="tel" name="Phone" value="@Model.Phone" class="text-input" placeholder="+961 1 555 123" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>@T["auth.email"]</span>
                            <input type="text" inputmode="email" name="Email" value="@Model.Email" class="text-input" placeholder="@T["businessInfo.details.emailPlaceholder"]" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>@T["businessInfo.details.website"]</span>
                            <span class="input-with-link">
                                <input type="text" inputmode="url" name="Website" id="client-website" value="@Model.Website" class="text-input" placeholder="@T["businessInfo.details.websitePlaceholder"]" autocomplete="off" />
                                <a href="@Model.Website" id="client-website-open" class="au-icon-btn au-icon-btn--bordered" target="_blank" rel="noopener noreferrer" title="@T["businessInfo.details.openWebsite"]" aria-label="@T["businessInfo.details.openWebsite"]" hidden="@string.IsNullOrWhiteSpace(Model.Website)"><span class="au-icon" aria-hidden="true">open_in_new</span></a>
                            </span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.details.location"]</strong><div class="cell-sub">@T["businessInfo.details.locationHelp"]</div></div>
                <div class="set-section-body">
                    <label class="field">
                        <span>@T["businessInfo.details.address"]</span>
                        <textarea name="Address" rows="2" class="text-input" placeholder="@T["businessInfo.details.addressPlaceholder"]" dir="auto">@Model.Address</textarea>
                    </label>
                </div>
            </div>

            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.details.forContacts"]</strong><div class="cell-sub">@T["businessInfo.details.forContactsHelp"]</div></div>
                <div class="set-section-body">
                    <label class="field">
                        <span>@T["businessInfo.details.hoursText"]</span>
                        <textarea name="OperatingHours" rows="2" class="text-input" placeholder="@T["businessInfo.details.hoursTextPlaceholder"]" dir="auto">@Model.OperatingHours</textarea>
                        <small class="text-subtle">@T["businessInfo.details.hoursTextHelp"] <a asp-page="/Settings/BusinessInfo" asp-route-tab="availability">@T["businessInfo.details.hoursTextLink"]</a></small>
                    </label>
                    <label class="field">
                        <span>@T["businessInfo.details.bookingInfo"]</span>
                        <textarea name="BookingInfo" rows="3" class="text-input" placeholder="@T["businessInfo.details.bookingInfoPlaceholder"]" dir="auto">@Model.BookingInfo</textarea>
                    </label>
                </div>
            </div>

            <div class="save-bar is-idle" data-save-bar>
                <span class="text-subtle text-sm" data-save-text>@T["businessInfo.save.allSaved"]</span>
                <div class="flex gap-2">
                    <button type="reset" class="au-btn au-btn--text" data-discard hidden>@T["businessInfo.save.discard"]</button>
                    <button type="submit" class="au-btn au-btn--primary">@T["common.saveChanges"]</button>
                </div>
            </div>
        </form>

        @if (TextContext.Offered.Count > 1 || Model.DefaultLanguage != AppLanguage.English)
        {
            <form method="post" asp-page-handler="SaveLanguage" class="au-panel au-panel--round integration-form client-form mt-3" id="language-form">
                <div class="set-section">
                    <div class="set-section-head"><strong>@T["businessInfo.language.title"]</strong><div class="cell-sub">@T["businessInfo.language.help"]</div></div>
                    <div class="set-section-body">
                        <label class="field">
                            <span>@T["businessInfo.language.label"]</span>
                            <select name="Language" class="text-input" disabled="@(!Model.CanChangeLanguage)">
                                @foreach (var language in TextContext.Offered.Contains(Model.DefaultLanguage) ? TextContext.Offered : TextContext.Offered.Append(Model.DefaultLanguage))
                                {
                                    <option value="@language" lang="@language" selected="@(language == Model.DefaultLanguage)">@AppLanguage.NativeName(language)</option>
                                }
                            </select>
                            @if (!Model.CanChangeLanguage)
                            {
                                <small class="text-subtle">@T["businessInfo.language.ownerOnly"]</small>
                            }
                        </label>
                    </div>
                </div>
                @if (Model.CanChangeLanguage)
                {
                    <div class="save-row">
                        <button type="submit" class="au-btn au-btn--primary">@T["businessInfo.language.save"]</button>
                    </div>
                }
            </form>
        }
    }
    else if (Model.ActiveTab == "ai" && Model.InboxSettings is { } bot)
    {
        <p class="au-page-head__sub mb-3">@T["businessInfo.ai.intro"]</p>

        <form method="post" asp-page-handler="SaveAiBot" class="au-panel au-panel--round integration-form client-form" id="inbox-settings-form">
            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.ai.new"]</strong><div class="cell-sub">@T["businessInfo.ai.newHelp"]</div></div>
                <div class="set-section-body">
                    <label class="au-check">
                        <input type="checkbox" class="au-switch" role="switch" name="AiBotNewConversations" value="true" checked="@bot.AiBotNewConversations" />
                        @T["businessInfo.ai.newSwitch"]
                    </label>
                    <small class="text-subtle">@T["businessInfo.ai.newOff"]</small>
                </div>
            </div>

            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.ai.reopened"]</strong><div class="cell-sub">@T["businessInfo.ai.reopenedHelp"]</div></div>
                <div class="set-section-body">
                    <label class="au-check">
                        <input type="checkbox" class="au-switch" role="switch" name="AiBotReopenedConversations" value="true" checked="@bot.AiBotReopenedConversations" />
                        @T["businessInfo.ai.reopenedSwitch"]
                    </label>
                    <small class="text-subtle">@T["businessInfo.ai.reopenedOff"]</small>
                </div>
            </div>

            <div class="save-row">
                <button type="submit" class="au-btn au-btn--primary">@T["businessInfo.ai.save"]</button>
            </div>
        </form>
    }
    else if (Model.Availability is { } av)
    {
        if (!av.Configured)
        {
            <div class="au-alert au-alert--warning" role="status">
                <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
                <div class="au-alert__body">
                    <div class="au-alert__title">@T["businessInfo.hours.notConfiguredTitle"]</div>
                    @T["businessInfo.hours.notConfiguredText"]
                </div>
            </div>
        }
        <p class="au-page-head__sub mb-3">
            @T["businessInfo.hours.intro"]
        </p>

        <form method="post" asp-page-handler="SaveAvailability" class="au-panel au-panel--round integration-form client-form" id="avail-form">
            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.hours.timezone"]</strong><div class="cell-sub">@T["businessInfo.hours.timezoneHelp"]</div></div>
                <div class="set-section-body">
                    <div class="flex items-center gap-3 flex-wrap">
                        <select name="TimezoneId" id="avail-tz" class="au-select w-auto" aria-label="@T["businessInfo.hours.timezone"]">
                            @foreach (var tz in Model.TimezoneOptions(av.Timezone))
                            {
                                <option value="@tz" selected="@(tz == av.Timezone)">@tz</option>
                            }
                        </select>
                        <span class="cell-sub" id="avail-tz-now"></span>
                    </div>
                </div>
            </div>

            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.hours.weekly"]</strong><div class="cell-sub" id="avail-open-count"></div></div>
                <div class="set-section-body">
                    <div class="week" id="avail-week">
                        @{ var i = 0; }
                        @foreach (var d in Model.OrderedDays())
                        {
                            <div class="week-row @(d.IsOpen ? "" : "is-closed")" data-day="@dayNames[d.DayOfWeek]">
                                <input type="hidden" name="Days[@i].DayOfWeek" value="@d.DayOfWeek" />
                                <label class="switch-row">
                                    <input type="checkbox" name="Days[@i].IsOpen" value="true" class="switch-input" data-day-open checked="@d.IsOpen" />
                                    <span class="switch" aria-hidden="true"></span>
                                    <span class="week-day">@DayLabel(d.DayOfWeek)</span>
                                </label>
                                <span class="week-times">
                                    <input type="time" name="Days[@i].Start" value="@d.Start" class="text-input avail-time" data-day-start aria-label="@T["businessInfo.hours.opens", DayLabel(d.DayOfWeek)]" />
                                    <span class="text-subtle">@T["businessInfo.hours.to"]</span>
                                    <input type="time" name="Days[@i].End" value="@d.End" class="text-input avail-time" data-day-end aria-label="@T["businessInfo.hours.closes", DayLabel(d.DayOfWeek)]" />
                                    <span class="field-err" data-day-err hidden>@T["businessInfo.hours.endAfterStart"]</span>
                                </span>
                                <span class="text-subtle week-closed">@T["businessInfo.hours.closed"]</span>
                            </div>
                            i++;
                        }
                        <div><button type="button" class="au-btn au-btn--text au-btn--sm mt-1" id="avail-copy"><span class="au-icon" aria-hidden="true">content_copy</span>@T["businessInfo.hours.copyMonday"]</button></div>
                    </div>
                </div>
            </div>

            <div class="set-section">
                <div class="set-section-head"><strong>@T["businessInfo.rules.title"]</strong><div class="cell-sub">@T["businessInfo.rules.help"]</div></div>
                <div class="set-section-body">
                    <div class="rules">
                        <label class="set-row">
                            <div><strong>@T["businessInfo.rules.length"]</strong><div class="cell-sub">@T["businessInfo.rules.lengthHelp"]</div></div>
                            <span class="unit-input"><input type="number" name="DefaultDurationMinutes" value="@av.Booking.DefaultDurationMinutes" min="5" max="480" class="text-input set-input" data-rule="duration" /><span>@T["businessInfo.rules.minutes"]</span></span>
                        </label>
                        <label class="set-row">
                            <div><strong>@T["businessInfo.rules.gap"]</strong></div>
                            <span class="unit-input"><input type="number" name="BufferMinutes" value="@av.Booking.BufferMinutes" min="0" max="240" class="text-input set-input" data-rule="buffer" /><span>@T["businessInfo.rules.minutes"]</span></span>
                        </label>
                        <label class="set-row">
                            <div><strong>@T["businessInfo.rules.notice"]</strong></div>
                            <span class="unit-input"><input type="number" name="NoticeHours" value="@(av.Booking.MinimumNoticeMinutes / 60)" min="0" max="720" class="text-input set-input" data-rule="notice" /><span>@T["businessInfo.rules.hoursAhead"]</span></span>
                        </label>
                        <label class="set-row">
                            <div><strong>@T["businessInfo.rules.advance"]</strong></div>
                            <span class="unit-input"><input type="number" name="MaxAdvanceDays" value="@av.Booking.MaxAdvanceDays" min="1" max="365" class="text-input set-input" data-rule="advance" /><span>@T["businessInfo.rules.daysAhead"]</span></span>
                        </label>
                    </div>
                    <div class="kb-hint" id="avail-summary"></div>
                </div>
            </div>

            <div class="save-row">
                <button type="submit" class="au-btn au-btn--primary">@T["businessInfo.hours.save"]</button>
            </div>
        </form>

        <h2 class="section-title">@T["businessInfo.dates.title"]</h2>
        <p class="text-muted mb-2">@T["businessInfo.dates.intro"]</p>

        <div class="au-panel au-panel--round">
            @if (av.Exceptions.Count == 0)
            {
                var none = new EmptyStateModel(Icon: "event_busy", Title: T["businessInfo.dates.emptyTitle"].Value,
                    Text: T["businessInfo.dates.emptyText"].Value);
                <partial name="_EmptyState" model="none" />
            }
            else
            {
                <div class="timeline">
                    @foreach (var ex in av.Exceptions)
                    {
                        var parts = DateParts(ex.Date);
                        <div class="tl-row">
                            <div class="date-chip"><span>@parts.Month</span><strong>@parts.Day</strong></div>
                            <div class="flex-1 min-w-0">
                                <div class="tl-title">@parts.Long</div>
                                <div class="cell-sub">@(string.IsNullOrWhiteSpace(ex.Reason) ? T["businessInfo.dates.noReason"].Value : ex.Reason)</div>
                            </div>
                            @if (ex.IsClosed)
                            {
                                <span class="badge badge-gray">@T["businessInfo.hours.closed"]</span>
                            }
                            else
                            {
                                <span class="badge badge-blue">@ex.Start–@ex.End</span>
                            }
                            <form method="post" asp-page-handler="DeleteException" asp-route-id="@ex.Id" class="inline-form">
                                <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">@T["businessInfo.dates.remove"]</button>
                            </form>
                        </div>
                    }
                </div>
            }

            <form method="post" asp-page-handler="AddException" class="integration-form add-date" id="exc-form">
                <input type="hidden" name="ExceptionClosed" id="exc-closed" value="true" />
                <div class="add-date-row">
                    <label class="field">
                        <span>@T["businessInfo.dates.date"]</span>
                        <input type="date" name="ExceptionDate" class="text-input" required />
                    </label>
                    <div class="field">
                        <span>@T["businessInfo.dates.thatDay"]</span>
                        <div class="seg" id="exc-mode">
                            <button type="button" class="on" data-closed="true">@T["businessInfo.hours.closed"]</button>
                            <button type="button" data-closed="false">@T["businessInfo.dates.differentHours"]</button>
                        </div>
                    </div>
                    <label class="field" data-exc-time hidden>
                        <span>@T["dashboard.period.from"]</span>
                        <input type="time" name="ExceptionStart" id="exc-start" class="text-input" />
                    </label>
                    <label class="field" data-exc-time hidden>
                        <span>@T["dashboard.period.to"]</span>
                        <input type="time" name="ExceptionEnd" id="exc-end" class="text-input" />
                    </label>
                </div>
                <label class="field">
                    <span>@T["businessInfo.dates.reason"] <em class="opt">@T["businessInfo.dates.reasonHelp"]</em></span>
                    <input type="text" name="ExceptionReason" class="text-input" maxlength="200" placeholder="@T["businessInfo.dates.reasonPlaceholder"]" />
                </label>
                <div><button type="submit" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">add</span>@T["businessInfo.dates.add"]</button></div>
            </form>
        </div>
    }

    <script src="~/js/business-info.js" asp-append-version="true"></script>
}
