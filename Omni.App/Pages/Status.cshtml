@page
@model Omni.App.Pages.StatusModel
@{
    var (title, text) = Model.Code switch
    {
        404 => (T["status.notFound.title"].Value, T["status.notFound.text"].Value),
        400 => (T["status.badRequest.title"].Value, T["status.badRequest.text"].Value),
        403 => (T["status.forbidden.title"].Value, T["status.forbidden.text"].Value),
        _ => (T["status.other.title"].Value, T["status.other.text"].Value)
    };
    ViewData["Title"] = title;
    // Inside the shell when signed in; the plain auth card otherwise (docs/UI_GUIDE.md §6.6, §0.4).
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<div class="au-fullpage-msg">
    <div class="au-fullpage-msg__inner">
        <div class="au-fullpage-msg__code" dir="ltr">@Model.Code</div>
        <h2 class="au-h3 m-0">@title</h2>
        <p class="au-muted m-0">@text</p>
        <div class="au-row au-row--wrap fullpage-actions">
            <button type="button" class="au-btn au-btn--outlined" onclick="history.back()"><span class="au-icon au-icon--dir" aria-hidden="true">arrow_back</span>@T["status.goBack"]</button>
            @if (signedIn)
            {
                <a class="au-btn au-btn--primary" href="/dashboard"><span class="au-icon" aria-hidden="true">space_dashboard</span>@T["status.backToDashboard"]</a>
            }
            else
            {
                <a class="au-btn au-btn--primary" href="/Account/Login"><span class="au-icon au-icon--dir" aria-hidden="true">login</span>@T["status.signIn"]</a>
            }
        </div>
    </div>
</div>
