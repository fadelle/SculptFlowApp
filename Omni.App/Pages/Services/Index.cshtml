@page "/Services"
@model Omni.App.Pages.Services.IndexModel
@{
    ViewData["Title"] = "Services";
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="au-page-head">
        <div class="mw-640">
            <p class="au-page-head__sub">
                Treatments your client offers. Contacts, bookings, campaigns and the AI assistant use this list.
                <button type="button" class="link-btn" id="svc-how-btn" aria-expanded="false" aria-controls="svc-how">How it works</button>
            </p>
            <p class="au-help mt-1 mb-0" id="svc-how" hidden>
                Services can't be deleted. Deactivate one to stop using it for new bookings while keeping past contacts
                and bookings intact. Put detailed information (pricing, recovery, preparation) in the
                <a href="/KnowledgeBase">Knowledge Base</a>.
            </p>
        </div>
        <div class="au-page-head__actions">
            <a href="/Services/Edit" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">add</span>Add service</a>
        </div>
    </div>

    @if (Model.Services.Count == 0)
    {
        var empty = new EmptyStateModel(Icon: "medical_services", Title: "Add your first service",
            Text: "Contacts, bookings and the AI assistant need to know what your client offers.",
            ActionLabel: "Add service", ActionHref: "/Services/Edit");
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="empty" /></div>
    }
    else
    {
        @* #svc-search, #svc-table tbody tr[data-search], tr[data-href] and #svc-no-match are read by services-page.js. *@
        <div class="au-toolbar">
            <div class="au-toolbar__filters">
                <input type="search" id="svc-search" class="au-input search-input" placeholder="Search services" aria-label="Search services" />
            </div>
            <span class="au-toolbar__meta">@Model.Services.Count @(Model.Services.Count == 1 ? "service" : "services")</span>
        </div>
        <div class="au-table-card">
            <div class="au-table-scroll">
                <table class="au-table au-table--stack" id="svc-table">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Code</th>
                            <th>Booking</th>
                            <th>Status</th>
                            <th><span class="au-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Services)
                        {
                            <tr class="row-link @(p.IsActive ? "" : "row-dim")" data-href="/Services/Edit/@p.Id" data-search="@($"{p.Name} {p.Code} {p.Description}".ToLowerInvariant())">
                                <td data-label="Service">
                                    <div class="min-w-0">
                                        <a href="/Services/Edit/@p.Id" class="row-title">@p.Name</a>
                                        @if (!string.IsNullOrWhiteSpace(p.Description))
                                        {
                                            <div class="cell-sub clip-1" title="@p.Description">@p.Description</div>
                                        }
                                    </div>
                                </td>
                                <td data-label="Code">
                                    @if (!string.IsNullOrEmpty(p.Code))
                                    {
                                        <span class="code-chip">@p.Code</span>
                                    }
                                    else
                                    {
                                        <span class="text-subtle">—</span>
                                    }
                                </td>
                                <td data-label="Booking">
                                    @if (p.BookingDuration is { } d)
                                    {
                                        @($"{d} min")
                                    }
                                    else
                                    {
                                        <span class="text-warn-soft">Not set</span>
                                    }
                                </td>
                                <td data-label="Status"><span class="badge @(p.IsActive ? "badge-green" : "badge-gray")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="row-actions">
                                    <a href="/Services/Edit/@p.Id" class="au-btn au-btn--outlined au-btn--sm">Edit</a>
                                    <form method="post" asp-page-handler="Toggle" class="inline-form">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="active" value="@((!p.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="au-btn au-btn--text au-btn--sm">@(p.IsActive ? "Deactivate" : "Activate")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        <tr class="empty-row" id="svc-no-match" hidden><td colspan="5">No services match your search.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <script src="~/js/services-page.js" asp-append-version="true"></script>
}
