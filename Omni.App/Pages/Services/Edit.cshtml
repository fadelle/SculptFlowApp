@page "/Services/Edit/{id:guid?}"
@model Omni.App.Pages.Services.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Service" : "Edit Service";
}

@if (!Model.ClientConfigured)
{
    <partial name="_NoClient" />
}
else
{
    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/Services" aria-label="Back to Services" title="Back to Services">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@(Model.IsNew ? "Add a service" : Model.Name)</h2>
            <span class="au-back-header__sub">@(Model.IsNew ? "A treatment your client offers." : "Edit this service.")</span>
        </div>
    </div>

    <partial name="_Messages" model="new PageMessagesModel(null, Model.ErrorMessage)" />

    @* #svc-name, #svc-code, #svc-desc and #svc-desc-count are read by services-page.js (code suggestion, counter). *@
    <section class="au-panel au-panel--round au-panel--pad mw-720">
        <form method="post">
            <div class="au-form-grid">
                <div class="au-form-field">
                    <label class="au-form-label" for="svc-name">Name<span class="au-required">*</span></label>
                    <input type="text" name="Name" id="svc-name" value="@Model.Name" class="au-input" maxlength="200" required placeholder="e.g. Rhinoplasty" />
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="svc-code">Short code <span class="opt">optional</span></label>
                    <input type="text" name="Code" id="svc-code" value="@Model.Code" class="au-input" maxlength="100" placeholder="e.g. RHINO" />
                    <span class="au-help">Suggested from the name. Used in reports.</span>
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="svc-duration">Consultation length (minutes)</label>
                    <input type="number" name="DurationMinutes" id="svc-duration" value="@Model.DurationMinutes" class="au-input" min="1" max="480" placeholder="e.g. 30" />
                </div>
                <div class="au-form-field au-span-2">
                    <label class="au-form-label" for="svc-desc">Short description <span class="opt">optional</span></label>
                    <textarea name="Description" id="svc-desc" rows="3" class="au-textarea" maxlength="500" placeholder="One or two sentences patients would understand.">@Model.Description</textarea>
                    <span class="au-help counter" id="svc-desc-count">0 / 500</span>
                </div>
            </div>

            <div class="au-alert" role="note">
                <span class="au-icon au-alert__icon" aria-hidden="true">lightbulb</span>
                <div class="au-alert__body">Prices, preparation and recovery go in the <a class="au-link" href="/KnowledgeBase">Knowledge Base</a>, so the AI assistant can answer patients with them.</div>
            </div>

            <div class="au-form-actions">
                <a href="/Services" class="au-btn au-btn--text">Cancel</a>
                <button type="submit" class="au-btn au-btn--primary">@(Model.IsNew ? "Add service" : "Save changes")</button>
            </div>
        </form>
    </section>

    <script src="~/js/services-page.js" asp-append-version="true"></script>
}
