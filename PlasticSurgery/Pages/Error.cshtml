@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    // Always the plain layout: the shell reads the clinic from the database, which may be what just failed.
    Layout = "_AuthLayout";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<div class="au-fullpage-msg">
    <div class="au-fullpage-msg__inner">
        <div class="au-fullpage-msg__code">Oops</div>
        <h2 class="au-h3 m-0">Something went wrong on our side</h2>
        <p class="au-muted m-0">Please try again in a moment. If it keeps happening, contact SculptFlow support and quote the reference below.</p>
        @if (Model.ShowRequestId)
        {
            <span class="au-copy" title="Reference for support">Reference <span class="au-mono">@Model.Reference</span></span>
        }
        <div class="au-row au-row--wrap fullpage-actions">
            <button type="button" class="au-btn au-btn--outlined" onclick="history.back()"><span class="au-icon" aria-hidden="true">arrow_back</span>Go back</button>
            <a class="au-btn au-btn--primary" href="@(signedIn ? "/dashboard" : "/Account/Login")"><span class="au-icon" aria-hidden="true">space_dashboard</span>Back to the dashboard</a>
        </div>
    </div>
</div>
