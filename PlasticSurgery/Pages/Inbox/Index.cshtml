@page "/inbox"
@model PlasticSurgery.Pages.Inbox.IndexModel
@{
    ViewData["Title"] = "Inbox";

    // Presentation only — mirrors initials()/modeLabel() in wwwroot/js/inbox.js, which re-renders this list on load.
    static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1 ? parts[0][..1] : string.Concat(parts[0][..1], parts[^1][..1]);
    }
    static string ModeLabel(string mode) => mode switch { "ai" => "AI", "human" => "Staff", "approval" => "Approval", _ => mode };
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else
{
    <div class="inbox-shell" id="inbox-shell">
        <div class="inbox-sidebar">
            <div class="inbox-list-head">
                <input type="search" class="text-input search-input" id="inbox-search" placeholder="Search name or phone" aria-label="Search conversations" autocomplete="off" />
                <div class="inbox-filters" role="tablist" aria-label="Filter conversations">
                    <button type="button" class="inbox-filter active" data-filter="all">All <span class="inbox-filter-count" data-count="all"></span></button>
                    <button type="button" class="inbox-filter" data-filter="needs">Needs you <span class="inbox-filter-count" data-count="needs"></span></button>
                    <button type="button" class="inbox-filter" data-filter="ai">AI <span class="inbox-filter-count" data-count="ai"></span></button>
                    <button type="button" class="inbox-filter" data-filter="closed">Closed <span class="inbox-filter-count" data-count="closed"></span></button>
                </div>
            </div>
            <div class="inbox-list" id="inbox-list">
                @foreach (var c in Model.Conversations)
                {
                    <div class="inbox-conv-item" data-conversation-id="@c.Id" data-lead-name="@(c.LeadFullName ?? "Unknown")" data-procedure-name="@(c.ProcedureName ?? "")" data-channel="@c.Channel">
                        <span class="inbox-avatar">
                            @Initials(c.LeadFullName)
                            <span class="inbox-channel-icon" style="background:@PlasticSurgery.Common.Helpers.ChannelIconHelper.Hex(c.Channel)" title="@c.Channel">
                                @{ var svg = PlasticSurgery.Common.Helpers.ChannelIconHelper.Svg(c.Channel); }
                                @if (svg is not null)
                                {
                                    @Html.Raw(svg)
                                }
                                else
                                {
                                    @PlasticSurgery.Common.Helpers.ChannelIconHelper.Initials(c.Channel)
                                }
                            </span>
                        </span>
                        <div class="inbox-conv-main">
                            <div class="inbox-conv-top">
                                <span class="inbox-conv-name">@(c.LeadFullName ?? "Unknown")</span>
                                <span class="inbox-conv-time" data-timestamp="@((c.LastMessageAt ?? c.CreatedAt).ToString("O"))"></span>
                            </div>
                            @if (!string.IsNullOrEmpty(c.ProcedureName))
                            {
                                <div class="inbox-conv-procedure">@c.ProcedureName</div>
                            }
                            <div class="inbox-conv-bottom">
                                <span class="inbox-conv-preview">@(c.LastMessagePreview ?? "No messages yet")</span>
                                <span class="inbox-mode inbox-mode-@c.Mode">@ModeLabel(c.Mode)</span>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Conversations.Count == 0)
                {
                    <div class="inbox-list-message">No conversations yet.</div>
                }
            </div>
        </div>

        <div class="inbox-thread" id="inbox-thread">
            <div class="inbox-empty" id="inbox-empty">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <p>Select a conversation to view it here.</p>
            </div>

            <div class="inbox-thread-inner" id="inbox-thread-inner" hidden>
                <div class="inbox-thread-header">
                    <button type="button" class="btn btn-ghost btn-sm inbox-back" id="inbox-btn-back" aria-label="Back to conversations">&larr;</button>
                    <span class="inbox-avatar" id="inbox-thread-avatar"></span>
                    <div class="inbox-thread-who">
                        <div class="inbox-thread-name" id="inbox-thread-name"></div>
                        <div class="inbox-thread-procedure text-subtle" id="inbox-thread-procedure"></div>
                    </div>
                    <div class="inbox-thread-actions">
                        <span class="inbox-mode" id="inbox-thread-mode"></span>
                        <button type="button" class="btn btn-sm" id="inbox-btn-takeover">Take Over</button>
                        <button type="button" class="btn btn-sm" id="inbox-btn-return-ai">Return to AI</button>
                        <button type="button" class="btn btn-ghost btn-sm" id="inbox-btn-info" title="Customer info" aria-label="Customer info">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                            Info
                        </button>
                        <div class="inbox-more">
                            <button type="button" class="btn btn-ghost btn-sm" id="inbox-btn-more" title="More actions" aria-label="More actions" aria-haspopup="menu" aria-expanded="false">&hellip;</button>
                            <div class="inbox-more-menu" id="inbox-more-menu" role="menu" hidden>
                                <button type="button" class="user-menu-item user-menu-danger" id="inbox-btn-close" role="menuitem">Close conversation</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="inbox-messages" id="inbox-messages"></div>

                <div class="inbox-window-closed-notice" id="inbox-window-closed-notice" hidden>
                    The 24-hour WhatsApp customer service window is closed — send an approved template to reach this lead.
                </div>

                <form class="inbox-composer" id="inbox-composer">
                    <textarea class="inbox-composer-input" id="inbox-composer-input" placeholder="Write a reply…" rows="2"></textarea>
                    <div class="inbox-composer-bar">
                        <button type="button" class="btn btn-ghost btn-sm" id="inbox-btn-send-template">Send Template</button>
                        <span class="inbox-composer-hint">Enter to send · Shift+Enter for a new line</span>
                        <button type="submit" class="btn btn-primary btn-sm" id="inbox-composer-send">Send</button>
                    </div>
                </form>

                <form class="inbox-template-picker" id="inbox-template-picker" hidden>
                    <span class="eyebrow">Send an approved template</span>
                    <select class="select" id="inbox-template-select"></select>
                    <div id="inbox-template-variables"></div>
                    <div id="inbox-template-preview" class="inbox-template-preview"></div>
                    <div class="flex items-center gap-2">
                        <button type="submit" class="btn btn-primary btn-sm" id="inbox-template-send">Send</button>
                        <button type="button" class="btn btn-ghost btn-sm" id="inbox-template-cancel">Cancel</button>
                    </div>
                </form>
            </div>
        </div>

        <aside class="inbox-lead-info" id="inbox-lead-info" hidden>
            <div class="inbox-lead-head">
                <button type="button" class="btn btn-ghost btn-sm inbox-lead-close" id="inbox-lead-close" aria-label="Hide customer info">&times;</button>
                <span class="inbox-avatar inbox-avatar-lg" id="inbox-lead-avatar"></span>
                <strong id="inbox-lead-name">—</strong>
                <span class="badge badge-gray" id="inbox-lead-status">—</span>
            </div>

            <div class="inbox-lead-section" id="inbox-lead-journey-wrap">
                <span class="eyebrow">Journey</span>
                <div class="journey" id="inbox-lead-journey"><i></i><i></i><i></i><i></i></div>
                <div class="journey-labels"><span>New</span><span>Qualified</span><span>Consult</span><span>Surgery</span></div>
            </div>

            <div class="inbox-lead-section">
                <span class="eyebrow">Details</span>
                <div class="inbox-lead-info-row"><span>Phone</span><strong id="inbox-lead-phone">—</strong></div>
                <div class="inbox-lead-info-row"><span>Email</span><strong id="inbox-lead-email">—</strong></div>
                <div class="inbox-lead-info-row"><span>Procedure</span><strong id="inbox-lead-procedure">—</strong></div>
                <div class="inbox-lead-info-row"><span>Source</span><strong id="inbox-lead-source">—</strong></div>
                <div class="inbox-lead-info-row"><span>Timeline</span><strong id="inbox-lead-timeline">—</strong></div>
                <div class="inbox-lead-info-row"><span>Next follow-up</span><strong id="inbox-lead-followup">—</strong></div>
                <div class="inbox-lead-info-row"><span>Lead since</span><strong id="inbox-lead-created">—</strong></div>
            </div>

            <div class="inbox-lead-actions">
                <a class="btn" id="inbox-lead-profile" href="#">Open full profile</a>
                <a class="btn" href="/dashboard/appointments">Go to Appointments</a>
            </div>
        </aside>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    window.PS_INBOX_CONFIG = {
        clinicId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClinicId.ToString())),
        hubUrl: '/hubs/inbox'
    };
</script>
<script src="~/js/inbox.js" asp-append-version="true"></script>
