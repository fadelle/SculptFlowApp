@page "/Campaigns/Create"
@model PlasticSurgery.Pages.Campaigns.CreateModel
@{
    ViewData["Title"] = "New Campaign";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Main Numbers page for setup steps.</div>
}
else
{
    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
    }

    @if (Model.ApprovedTemplates.Count == 0)
    {
        <div class="alert alert-info">
            No approved templates yet — create one on the <a href="/WhatsApp/Templates">Templates</a> page and wait for Meta to approve it before starting a campaign.
        </div>
    }
    else
    {
        <form method="get" class="mb-3 flex items-center gap-2">
            <select name="WhatsAppTemplateId" class="select" onchange="this.form.submit()">
                <option value="">Choose a template…</option>
                @foreach (var t in Model.ApprovedTemplates)
                {
                    <option value="@t.Id" selected="@(t.Id == Model.WhatsAppTemplateId)">@t.Name (@t.Language)</option>
                }
            </select>
        </form>

        @if (Model.SelectedTemplate is not null)
        {
            <div class="card mb-3" style="padding:1rem">
                <div class="text-subtle" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em">Template preview</div>
                <p style="white-space:pre-wrap;margin:.4rem 0 0">@Model.SelectedTemplate.Body</p>
            </div>

            <form method="post" class="integration-form">
                <input type="hidden" name="WhatsAppTemplateId" value="@Model.SelectedTemplate.Id" />

                <label class="field">
                    <span>Campaign name</span>
                    <input type="text" name="Name" value="@Model.Name" class="text-input" required />
                </label>

                @if (Model.PlaceholderNumbers.Count > 0)
                {
                    <div class="field">
                        <span>Body variables</span>
                        <div class="text-subtle mb-2" style="font-size:.78rem" id="variables-hint">
                            Type literal text (sent to every recipient), or one of
                            <code>{LeadFullName}</code>, <code>{LeadFirstName}</code>, <code>{LeadPhone}</code>
                            to substitute each recipient's own value. Only available when recipients are
                            chosen manually below.
                        </div>
                        @foreach (var n in Model.PlaceholderNumbers)
                        {
                            <input type="text" name="Variables[@n]" placeholder="{{@n}} value" class="text-input mb-2" />
                        }
                    </div>
                }

                <div class="field">
                    <span>Send</span>
                    <label class="flex items-center gap-1" style="font-weight:400">
                        <input type="radio" name="SendOption" value="now" checked="@(Model.SendOption != "later")" /> Now
                    </label>
                    <label class="flex items-center gap-1" style="font-weight:400">
                        <input type="radio" name="SendOption" value="later" checked="@(Model.SendOption == "later")" /> Later
                        <input type="datetime-local" name="ScheduledAt" class="text-input" style="display:inline-block;width:auto" />
                    </label>
                </div>

                <div class="field">
                    <span class="flex items-center gap-2">
                        Who do you want to reach?
                        <button type="button" class="status-help-trigger" data-status-help-trigger title="What do these statuses mean?">?</button>
                    </span>

                    <!-- These four radios are UI-only (not bound) — they drive the two hidden fields
                         actually posted (AudienceType, ManualSelection) via campaign-audience.js. That
                         keeps four clinic-facing choices mapped onto the three real backend audience
                         types without adding a fourth one. -->
                    <label class="audience-option audience-option-featured">
                        <input type="radio" name="AudienceChoice" value="reactivation_no_consultation" data-audience-choice checked="@(Model.AudienceChoice == "reactivation_no_consultation")" />
                        <span class="audience-option-body">
                            <span class="audience-option-title">Old leads who never booked <span class="badge badge-green">Recommended</span></span>
                            <span class="audience-option-desc">Re-engage people who previously showed interest but never booked a consultation.</span>
                        </span>
                    </label>

                    <label class="audience-option">
                        <input type="radio" name="AudienceChoice" value="all_eligible" data-audience-choice checked="@(Model.AudienceChoice == "all_eligible")" />
                        <span class="audience-option-body">
                            <span class="audience-option-title">All contactable leads</span>
                            <span class="audience-option-desc">Reach all leads who are currently eligible to be contacted.</span>
                        </span>
                    </label>

                    <label class="audience-option">
                        <input type="radio" name="AudienceChoice" value="custom" data-audience-choice checked="@(Model.AudienceChoice == "custom")" />
                        <span class="audience-option-body">
                            <span class="audience-option-title">Build a custom audience</span>
                            <span class="audience-option-desc">Choose your own filters.</span>
                        </span>
                    </label>

                    <label class="audience-option">
                        <input type="radio" name="AudienceChoice" value="manual" data-audience-choice checked="@(Model.AudienceChoice == "manual")" />
                        <span class="audience-option-body">
                            <span class="audience-option-title">Select leads manually</span>
                            <span class="audience-option-desc">Choose specific people from your lead list.</span>
                        </span>
                    </label>
                </div>

                <input type="hidden" name="AudienceType" id="audience-type-field" value="@Model.AudienceType" />
                <input type="hidden" name="ManualSelection" id="manual-selection-field" value="@(Model.ManualSelection ? "true" : "false")" />

                <!-- "Old leads who never booked" -->
                <div id="reactivation-panel" class="card mb-3" style="padding:1.25rem;display:none;border-color:var(--accent)">
                    <div class="flex items-center gap-2 mb-2" style="flex-wrap:wrap">
                        <label class="flex items-center gap-1" style="font-weight:400">
                            Inactive for
                            <select name="InactiveDays" id="inactive-days" class="select" style="width:auto">
                                <option value="30" selected="@(Model.InactiveDays == 30)">30 days</option>
                                <option value="60" selected="@(Model.InactiveDays == 60)">60 days</option>
                                <option value="90" selected="@(Model.InactiveDays == 90)">90 days</option>
                            </select>
                        </label>
                        <label class="flex items-center gap-1" style="font-weight:400">
                            Procedure
                            <select name="ReactivationProcedureId" id="reactivation-procedure" class="select" style="width:auto">
                                <option value="">All procedures</option>
                                @foreach (var p in Model.Procedures)
                                {
                                    <option value="@p.Id" selected="@(p.Id == Model.ReactivationProcedureId)">@p.Name</option>
                                }
                            </select>
                        </label>
                        @if (Model.LeadSources.Count > 0)
                        {
                            <label class="flex items-center gap-1" style="font-weight:400">
                                Lead source
                                <select name="ReactivationSource" id="reactivation-source" class="select" style="width:auto">
                                    <option value="">Any source</option>
                                    @foreach (var s in Model.LeadSources)
                                    {
                                        <option value="@s" selected="@(s == Model.ReactivationSource)">@s</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    <div class="audience-count-hero">
                        <span class="value" id="reactivation-match-count">—</span>
                        <span class="label">leads ready for reactivation</span>
                    </div>
                    <button type="button" class="btn btn-sm mt-2" data-preview-btn data-preview-audience="reactivation_no_consultation" data-preview-target="reactivation-preview-list">Preview leads</button>
                    <div id="reactivation-preview-list" class="preview-leads-list" style="display:none"></div>
                </div>

                <!-- "All contactable leads" -->
                <div id="all-eligible-panel" class="card mb-3" style="padding:1.25rem;display:none">
                    <div class="text-subtle mb-2" style="font-size:.78rem">
                        Automatically excludes anyone who can't be contacted — no phone on file, opted out,
                        or otherwise not eligible.
                    </div>
                    <div class="audience-count-hero">
                        <span class="value" id="all-eligible-match-count">—</span>
                        <span class="label">contactable leads</span>
                    </div>
                    <button type="button" class="btn btn-sm mt-2" data-preview-btn data-preview-audience="all_eligible" data-preview-target="all-eligible-preview-list">Preview leads</button>
                    <div id="all-eligible-preview-list" class="preview-leads-list" style="display:none"></div>
                </div>

                <!-- "Build a custom audience" -->
                <div id="custom-panel" class="card mb-3" style="padding:1.25rem;display:none">
                    <div class="flex items-center gap-2 mb-2" style="flex-wrap:wrap">
                        <label class="flex items-center gap-1" style="font-weight:400">
                            Procedure
                            <select name="CustomProcedureId" id="custom-procedure" class="select" style="width:auto">
                                <option value="">All procedures</option>
                                @foreach (var p in Model.Procedures)
                                {
                                    <option value="@p.Id" selected="@(p.Id == Model.CustomProcedureId)">@p.Name</option>
                                }
                            </select>
                        </label>
                        <label class="flex items-center gap-1" style="font-weight:400">
                            Inactive for
                            <select name="CustomInactiveDays" id="custom-inactive-days" class="select" style="width:auto">
                                <option value="" selected="@(Model.CustomInactiveDays is null)">Any time</option>
                                <option value="30" selected="@(Model.CustomInactiveDays == 30)">30+ days</option>
                                <option value="60" selected="@(Model.CustomInactiveDays == 60)">60+ days</option>
                                <option value="90" selected="@(Model.CustomInactiveDays == 90)">90+ days</option>
                            </select>
                        </label>
                    </div>

                    <button type="button" id="advanced-filters-toggle" class="btn btn-sm mb-2">Advanced filters ▾</button>

                    <div id="advanced-filters" style="display:none">
                        <div class="flex items-center gap-2 mb-2" style="flex-wrap:wrap">
                            @{ await RenderMultiSelect("CustomLeadStatuses", "Lead status", Model.LeadStatusOptions, Model.CustomLeadStatuses); }
                            @{ await RenderMultiSelect("CustomQualificationStatuses", "Qualification status", Model.QualificationStatusOptions, Model.CustomQualificationStatuses); }
                            @if (Model.LeadSources.Count > 0)
                            {
                                await RenderMultiSelect("CustomSources", "Lead source", Model.LeadSources, Model.CustomSources);
                            }
                            @{ await RenderMultiSelect("CustomAppointmentStatuses", "Appointment status", Model.AppointmentStatusOptions, Model.CustomAppointmentStatuses); }
                        </div>
                        <div class="flex items-center gap-2 mb-2" style="flex-wrap:wrap">
                            <label class="flex items-center gap-1" style="font-weight:400">
                                Created after
                                <input type="date" name="CustomCreatedAfter" id="custom-created-after" class="text-input" style="width:auto" value="@(Model.CustomCreatedAfter?.ToString("yyyy-MM-dd"))" />
                            </label>
                            <label class="flex items-center gap-1" style="font-weight:400">
                                Created before
                                <input type="date" name="CustomCreatedBefore" id="custom-created-before" class="text-input" style="width:auto" value="@(Model.CustomCreatedBefore?.ToString("yyyy-MM-dd"))" />
                            </label>
                        </div>
                        <div class="flex items-center gap-2 mb-2" style="flex-wrap:wrap">
                            <label class="flex items-center gap-1" style="font-weight:400">
                                Last contacted after
                                <input type="date" name="CustomLastContactedAfter" id="custom-last-contacted-after" class="text-input" style="width:auto" value="@(Model.CustomLastContactedAfter?.ToString("yyyy-MM-dd"))" />
                            </label>
                            <label class="flex items-center gap-1" style="font-weight:400">
                                Last contacted before
                                <input type="date" name="CustomLastContactedBefore" id="custom-last-contacted-before" class="text-input" style="width:auto" value="@(Model.CustomLastContactedBefore?.ToString("yyyy-MM-dd"))" />
                            </label>
                        </div>
                        <div class="flex items-center gap-2 mb-2" style="flex-wrap:wrap">
                            <label class="flex items-center gap-1" style="font-weight:400">
                                Country
                                <input type="text" name="CustomCountry" id="custom-country" class="text-input" style="width:auto" value="@Model.CustomCountry" placeholder="e.g. LB" />
                            </label>
                            <label class="flex items-center gap-1" style="font-weight:400">
                                City
                                <input type="text" name="CustomCity" id="custom-city" class="text-input" style="width:auto" value="@Model.CustomCity" placeholder="e.g. Beirut" />
                            </label>
                        </div>
                    </div>

                    <div class="audience-count-hero">
                        <span class="value" id="custom-match-count">—</span>
                        <span class="label">matching leads</span>
                    </div>
                    <button type="button" class="btn btn-sm mt-2" data-preview-btn data-preview-audience="custom" data-preview-target="custom-preview-list">Preview leads</button>
                    <div id="custom-preview-list" class="preview-leads-list" style="display:none"></div>
                </div>

                <!-- "Select leads manually" -->
                <div class="field" id="manual-recipients" style="display:none">
                    <span>Recipients (@Model.Leads.Count shown)</span>
                    @* Not a nested <form> — this page's real submit is the outer method="post" form below,
                       and a <form> inside a <form> is invalid HTML that browsers silently mangle (it broke
                       the Create campaign button's form association). This just navigates via GET instead. *@
                    <div class="flex items-center gap-2 mb-2">
                        <input type="text" id="lead-search-input" value="@Model.Search" placeholder="Search leads by name/phone…" class="text-input"
                               onkeydown="if(event.key==='Enter'){event.preventDefault();document.getElementById('lead-search-btn').click();}" />
                        <button type="button" id="lead-search-btn" class="btn btn-sm"
                                onclick="location.href='/Campaigns/Create?WhatsAppTemplateId=@Model.WhatsAppTemplateId&Search=' + encodeURIComponent(document.getElementById('lead-search-input').value);">Search</button>
                    </div>

                    <div class="table-card table-scroll" style="max-height:360px;overflow-y:auto">
                        <table class="data-table">
                            <thead><tr><th></th><th>Name</th><th>Phone</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var lead in Model.Leads)
                                {
                                    <tr>
                                        <td><input type="checkbox" name="LeadIds" value="@lead.Id" /></td>
                                        <td>@(lead.FullName ?? "—")</td>
                                        <td>@(lead.Phone ?? "—")</td>
                                        <td>@PlasticSurgery.Pages.Shared.FilterLabelHelper.Label(lead.Status)</td>
                                    </tr>
                                }
                                @if (Model.Leads.Count == 0)
                                {
                                    <tr class="empty-row"><td colspan="4">No leads match this search.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="flex items-center gap-2 mt-2">
                    <button type="submit" class="btn btn-primary btn-sm">Create campaign</button>
                    <a href="/Campaigns" class="btn btn-sm">Cancel</a>
                </div>
            </form>

            <partial name="_StatusHelp" />
            <script src="~/js/multi-select.js" asp-append-version="true"></script>
            <script src="~/js/campaign-audience.js" asp-append-version="true"></script>
            <script src="~/js/status-help.js" asp-append-version="true"></script>
        }
    }
}

@functions {
    /// <summary>Renders one advanced-filter dropdown — checkboxes with clinic-friendly labels
    /// (FilterLabelHelper) wrapped in the .ms markup wwwroot/js/multi-select.js turns into a
    /// searchable chips dropdown. The checkboxes are the real, only form data; the JS is purely
    /// presentational on top.</summary>
    private async Task RenderMultiSelect(string name, string label, IReadOnlyList<string> options, List<string> selected)
    {
        <div class="ms" data-ms data-ms-label="@label">
            <button type="button" class="ms-trigger">
                <span class="ms-trigger-text">@label</span>
                <span class="ms-caret">▾</span>
            </button>
            <div class="ms-chips"></div>
            <div class="ms-panel" hidden>
                <input type="text" class="ms-search text-input" placeholder="Search…" />
                <div class="ms-options">
                    @foreach (var value in options)
                    {
                        <label class="ms-option">
                            <input type="checkbox" name="@name" value="@value" checked="@selected.Contains(value)" />
                            <span>@PlasticSurgery.Pages.Shared.FilterLabelHelper.Label(value)</span>
                        </label>
                    }
                </div>
                <button type="button" class="btn btn-sm ms-clear-btn">Clear</button>
            </div>
        </div>
        await Task.CompletedTask;
    }
}
