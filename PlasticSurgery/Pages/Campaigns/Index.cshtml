@page "/Campaigns"
@model PlasticSurgery.Pages.Campaigns.IndexModel
@using PlasticSurgery.Data.Entities
@using PlasticSurgery.Pages.Shared
@{
    ViewData["Title"] = "Campaigns";

    // Which list tab a campaign belongs to (client-side filter, see the script at the bottom).
    static string Group(string status) => status switch
    {
        CampaignStatus.Draft => "draft",
        CampaignStatus.Scheduled or CampaignStatus.Running or CampaignStatus.Paused => "active",
        _ => "finished"
    };
    static string AudienceLabel(string? type, bool manual) => manual ? "Picked manually" : type switch
    {
        CampaignAudienceType.ReactivationNoConsultation => "Old leads who never booked",
        CampaignAudienceType.AllEligible => "All contactable leads",
        CampaignAudienceType.Custom => "Custom audience",
        _ => "—"
    };
    static string Pct(int part, int whole) => whole > 0 ? $"{Math.Round(part * 100.0 / whole)}%" : "";
    static string Width(int part, int whole) => whole > 0 ? (part * 100.0 / whole).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "0";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else
{
    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <p class="text-muted m-0">Send one approved WhatsApp template to many leads. Replies land in each lead's Inbox conversation.</p>
        <a href="/Campaigns/Create" class="btn btn-primary btn-sm">+ New campaign</a>
    </div>

    @if (Model.Campaigns.Count == 0)
    {
        <div class="card empty-card">
            <div class="empty-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg></div>
            <h3>No campaigns yet</h3>
            <p class="text-muted">Bring old leads back or announce an offer with one approved WhatsApp template.</p>
            <a href="/Campaigns/Create" class="btn btn-primary btn-sm">+ New campaign</a>
        </div>
    }
    else
    {
        var groups = Model.Campaigns.GroupBy(c => Group(c.Status)).ToDictionary(g => g.Key, g => g.Count());
        <div class="inbox-filters mb-2" id="campaign-tabs">
            <button type="button" class="inbox-filter active" data-tab="all">All <span class="inbox-filter-count">@Model.Campaigns.Count</span></button>
            <button type="button" class="inbox-filter" data-tab="active">Active <span class="inbox-filter-count">@(groups.GetValueOrDefault("active"))</span></button>
            <button type="button" class="inbox-filter" data-tab="draft">Drafts <span class="inbox-filter-count">@(groups.GetValueOrDefault("draft"))</span></button>
            <button type="button" class="inbox-filter" data-tab="finished">Finished <span class="inbox-filter-count">@(groups.GetValueOrDefault("finished"))</span></button>
        </div>

        <div class="table-card tip-safe">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Campaign</th>
                        <th>Status</th>
                        <th>Audience</th>
                        <th>
                            <span class="th-with-tip">
                                Progress
                                <span class="info-tip" tabindex="0" role="button" aria-label="What the progress bar shows" aria-describedby="progress-tip">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                                    <span class="info-tip-box" role="tooltip" id="progress-tip">
                                        <strong>How far each campaign has got</strong>
                                        <span class="tip-row"><i class="p-read"></i> Read: opened by the lead</span>
                                        <span class="tip-row"><i class="p-deliv"></i> Delivered: reached their phone</span>
                                        <span class="tip-row"><i class="p-sent"></i> Sent: on its way</span>
                                        <span class="tip-row"><i class="p-fail"></i> Failed: couldn't be delivered</span>
                                        <span class="tip-row"><i class="p-rest"></i> Grey: not sent yet</span>
                                        <span class="tip-note">Hover a bar to see the exact numbers.</span>
                                    </span>
                                </span>
                            </span>
                        </th>
                        <th>Replies</th>
                        <th>When</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Campaigns)
                    {
                        var readW = Width(c.Read, c.TotalRecipients);
                        var delivW = Width(Math.Max(c.Delivered - c.Read, 0), c.TotalRecipients);
                        var sentW = Width(Math.Max(c.Sent - c.Delivered, 0), c.TotalRecipients);
                        var failW = Width(c.Failed, c.TotalRecipients);
                        var progressText = c.Sent > 0 ? $"{c.Delivered} delivered · {c.Read} read"
                            : c.Status == CampaignStatus.Scheduled ? "Waiting to send"
                            : c.Status == CampaignStatus.Draft ? "Not sent yet"
                            : c.Failed > 0 ? $"{c.Failed} failed" : "Nothing sent";
                        <tr class="row-link" data-href="/Campaigns/@c.Id" data-group="@Group(c.Status)">
                            <td><a href="/Campaigns/@c.Id"><strong>@c.Name</strong></a><div class="cell-sub">@(c.TemplateName ?? "—")</div></td>
                            <td><span class="badge @StatusBadgeHelper.CssClass(c.Status)">@FilterLabelHelper.Label(c.Status)</span></td>
                            <td>@c.TotalRecipients<div class="cell-sub">@AudienceLabel(c.AudienceType, c.ManuallySelected)</div></td>
                            <td class="prog-cell">
                                <div class="prog" title="@($"{c.TotalRecipients} recipients · {c.Sent} sent · {c.Delivered} delivered · {c.Read} read · {c.Failed} failed")">
                                    <div class="prog-bar"><i class="p-read" style="width:@readW%"></i><i class="p-deliv" style="width:@delivW%"></i><i class="p-sent" style="width:@sentW%"></i><i class="p-fail" style="width:@failW%"></i></div>
                                    <div class="prog-text">@progressText</div>
                                </div>
                            </td>
                            <td>
                                @if (c.Replied > 0)
                                {
                                    <strong>@c.Replied</strong> <span class="cell-sub">(@Pct(c.Replied, c.Sent))</span>
                                }
                                else
                                {
                                    @:—
                                }
                            </td>
                            <td>
                                @if (c.ScheduledAt is not null && c.Status == CampaignStatus.Scheduled)
                                {
                                    <span class="text-md">Scheduled</span><div class="cell-sub">@LocalTimeHelper.Time(c.ScheduledAt)</div>
                                }
                                else
                                {
                                    <span class="text-md">Created</span><div class="cell-sub">@LocalTimeHelper.Time(c.CreatedAt)</div>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="empty-row" id="campaign-tab-empty" hidden><td colspan="6">No campaigns in this tab.</td></tr>
                </tbody>
            </table>
        </div>

        <script>
            (function () {
                var tabs = document.querySelectorAll('#campaign-tabs [data-tab]');
                var rows = document.querySelectorAll('tr[data-group]');
                tabs.forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        var group = tab.getAttribute('data-tab');
                        var shown = 0;
                        tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
                        rows.forEach(function (r) {
                            var show = group === 'all' || r.getAttribute('data-group') === group;
                            r.hidden = !show;
                            if (show) shown++;
                        });
                        document.getElementById('campaign-tab-empty').hidden = shown > 0;
                    });
                });
                // Whole row opens the campaign (links inside keep working as links).
                rows.forEach(function (r) {
                    r.addEventListener('click', function (e) {
                        if (e.target.closest('a, button, .info-tip')) return;
                        window.location.href = r.getAttribute('data-href');
                    });
                });
            })();
        </script>
    }
}
