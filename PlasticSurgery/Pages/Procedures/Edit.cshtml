@page "/Procedures/Edit/{id:guid?}"
@model PlasticSurgery.Pages.Procedures.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Procedure" : "Edit Procedure";
}

@if (!Model.ClinicConfigured)
{
    <partial name="_NoClinic" />
}
else
{
    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/Procedures" aria-label="Back to Procedures" title="Back to Procedures">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@(Model.IsNew ? "Add a procedure" : Model.Name)</h2>
            <span class="au-back-header__sub">@(Model.IsNew ? "A treatment your clinic offers." : "Edit this procedure.")</span>
        </div>
    </div>

    <partial name="_Messages" model="new PageMessagesModel(null, Model.ErrorMessage)" />

    @* #proc-name, #proc-code, #proc-desc and #proc-desc-count are read by procedures-page.js (code suggestion, counter). *@
    <section class="au-panel au-panel--round au-panel--pad mw-720">
        <form method="post">
            <div class="au-form-grid">
                <div class="au-form-field">
                    <label class="au-form-label" for="proc-name">Name<span class="au-required">*</span></label>
                    <input type="text" name="Name" id="proc-name" value="@Model.Name" class="au-input" maxlength="200" required placeholder="e.g. Rhinoplasty" />
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="proc-code">Short code <span class="opt">optional</span></label>
                    <input type="text" name="Code" id="proc-code" value="@Model.Code" class="au-input" maxlength="100" placeholder="e.g. RHINO" />
                    <span class="au-help">Suggested from the name. Used in reports.</span>
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="proc-duration">Consultation length (minutes)</label>
                    <input type="number" name="DurationMinutes" id="proc-duration" value="@Model.DurationMinutes" class="au-input" min="1" max="480" placeholder="e.g. 30" />
                </div>
                <div class="au-form-field au-span-2">
                    <label class="au-form-label" for="proc-desc">Short description <span class="opt">optional</span></label>
                    <textarea name="Description" id="proc-desc" rows="3" class="au-textarea" maxlength="500" placeholder="One or two sentences patients would understand.">@Model.Description</textarea>
                    <span class="au-help counter" id="proc-desc-count">0 / 500</span>
                </div>
            </div>

            <div class="au-alert" role="note">
                <span class="au-icon au-alert__icon" aria-hidden="true">lightbulb</span>
                <div class="au-alert__body">Prices, preparation and recovery go in the <a class="au-link" href="/KnowledgeBase">Knowledge Base</a>, so the AI assistant can answer patients with them.</div>
            </div>

            <div class="au-form-actions">
                <a href="/Procedures" class="au-btn au-btn--text">Cancel</a>
                <button type="submit" class="au-btn au-btn--primary">@(Model.IsNew ? "Add procedure" : "Save changes")</button>
            </div>
        </form>
    </section>

    <script src="~/js/procedures-page.js" asp-append-version="true"></script>
}
