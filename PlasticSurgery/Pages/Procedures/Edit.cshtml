@page "/Procedures/Edit/{id:guid?}"
@model PlasticSurgery.Pages.Procedures.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Procedure" : "Edit Procedure";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else
{
    <a href="/Procedures" class="back-link">← Procedures</a>

    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3 mt-2">@Model.ErrorMessage</div>
    }

    <div class="card p-5 mw-640 mt-2">
        <form method="post" class="integration-form">
            <div class="form-row-2">
                <label class="field">
                    <span>Name</span>
                    <input type="text" name="Name" id="proc-name" value="@Model.Name" class="text-input" maxlength="200" required placeholder="e.g. Rhinoplasty" />
                </label>
                <label class="field">
                    <span>Short code <em class="opt">optional</em></span>
                    <input type="text" name="Code" id="proc-code" value="@Model.Code" class="text-input" maxlength="100" placeholder="e.g. RHINO" />
                    <small class="text-subtle">Suggested from the name. Used in reports.</small>
                </label>
            </div>

            <label class="field">
                <span>Consultation length (minutes)</span>
                <input type="number" name="DurationMinutes" value="@Model.DurationMinutes" class="text-input" min="1" max="480" placeholder="e.g. 30" style="max-width:160px" />
            </label>

            <label class="field">
                <span>Short description <em class="opt">optional</em></span>
                <textarea name="Description" id="proc-desc" rows="3" class="text-input" maxlength="500" placeholder="One or two sentences patients would understand.">@Model.Description</textarea>
                <small class="text-subtle counter" id="proc-desc-count">0 / 500</small>
            </label>

            <div class="kb-hint">
                💡 Prices, preparation and recovery go in the <a href="/KnowledgeBase">Knowledge Base</a>, so the AI assistant can answer patients with them.
            </div>

            <div class="flex items-center gap-2 mt-2">
                <button type="submit" class="btn btn-primary btn-sm">@(Model.IsNew ? "Add procedure" : "Save changes")</button>
                <a href="/Procedures" class="btn btn-sm">Cancel</a>
            </div>
        </form>
    </div>

    <script src="~/js/procedures-page.js" asp-append-version="true"></script>
}
