@page "/Procedures"
@model PlasticSurgery.Pages.Procedures.IndexModel
@{
    ViewData["Title"] = "Procedures";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else
{
    if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info mb-3">@Model.StatusMessage</div>
    }
    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
    }

    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <div class="mw-640">
            <p class="text-muted m-0">
                Treatments your clinic offers. Leads, bookings, campaigns and the AI assistant use this list.
                <button type="button" class="link-btn" id="proc-how-btn" aria-expanded="false">How it works</button>
            </p>
            <p class="text-subtle text-sm mt-1 mb-0" id="proc-how" hidden>
                Procedures can't be deleted. Deactivate one to stop using it for new bookings while keeping past leads
                and appointments intact. Put detailed information (pricing, recovery, preparation) in the
                <a href="/KnowledgeBase">Knowledge Base</a>.
            </p>
        </div>
        <a href="/Procedures/Edit" class="btn btn-primary btn-sm">+ Add procedure</a>
    </div>

    @if (Model.Procedures.Count == 0)
    {
        <div class="card empty-card">
            <div class="empty-icon">✚</div>
            <h3>Add your first procedure</h3>
            <p class="text-muted">Leads, bookings and the AI assistant need to know what your clinic offers.</p>
            <a href="/Procedures/Edit" class="btn btn-primary btn-sm">+ Add procedure</a>
        </div>
    }
    else
    {
        <div class="flex justify-end mb-2">
            <input type="search" id="proc-search" class="text-input search-sm" placeholder="Search procedures" aria-label="Search procedures" />
        </div>
        <div class="table-card table-scroll">
            <table class="data-table" id="proc-table">
                <thead>
                    <tr>
                        <th>Procedure</th>
                        <th>Code</th>
                        <th>Consultation</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Procedures)
                    {
                        <tr class="row-link @(p.IsActive ? "" : "row-dim")" data-href="/Procedures/Edit/@p.Id" data-search="@($"{p.Name} {p.Code} {p.Description}".ToLowerInvariant())">
                            <td>
                                <a href="/Procedures/Edit/@p.Id" class="row-title">@p.Name</a>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="cell-sub clip-1" title="@p.Description">@p.Description</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.Code))
                                {
                                    <span class="code-chip">@p.Code</span>
                                }
                                else
                                {
                                    <span class="text-subtle">—</span>
                                }
                            </td>
                            <td>
                                @if (p.ConsultationDuration is { } d)
                                {
                                    @($"{d} min")
                                }
                                else
                                {
                                    <span class="text-warn-soft">Not set</span>
                                }
                            </td>
                            <td><span class="badge @(p.IsActive ? "badge-green" : "badge-gray")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="row-actions">
                                <a href="/Procedures/Edit/@p.Id" class="btn btn-sm">Edit</a>
                                <form method="post" asp-page-handler="Toggle" class="inline-form">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="active" value="@((!p.IsActive).ToString().ToLowerInvariant())" />
                                    <button type="submit" class="btn btn-ghost btn-sm">@(p.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    <tr class="empty-row" id="proc-no-match" hidden><td colspan="5">No procedures match your search.</td></tr>
                </tbody>
            </table>
        </div>
    }

    <script src="~/js/procedures-page.js" asp-append-version="true"></script>
}
