@page "/KnowledgeBase/Settings"
@model PlasticSurgery.Pages.KnowledgeBase.SettingsModel
@inject PlasticSurgery.Business.Contracts.Managers.IConfigManager Settings
@{
    ViewData["Title"] = "Knowledge Base Settings";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else
{
    if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info mb-3">@Model.StatusMessage</div>
    }
    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
    }

    <a href="/KnowledgeBase" class="back-link">← Knowledge Base</a>

    <div class="card p-5 mw-640 mt-2">
        <form method="post" class="integration-form">
            <div>
                <h3 class="m-0">Search tuning</h3>
                <div class="cell-sub">Changes apply to entries saved from now on. Re-save an entry to use the new values.</div>
            </div>

            <label class="set-row">
                <div>
                    <strong>How much text per piece</strong>
                    <div class="cell-sub">Chunk size · tokens, @Settings.KnowledgeMinChunkSizeTokens–@Settings.KnowledgeMaxChunkSizeTokens</div>
                    <div class="cell-sub">About 4 characters per token.</div>
                </div>
                <input type="number" name="ChunkSizeTokens" value="@Model.ChunkSizeTokens" class="text-input set-input" min="@Settings.KnowledgeMinChunkSizeTokens" max="@Settings.KnowledgeMaxChunkSizeTokens" required />
            </label>

            <label class="set-row">
                <div>
                    <strong>Overlap between pieces</strong>
                    <div class="cell-sub">Chunk overlap · tokens</div>
                    <div class="cell-sub">So nothing is cut in half. Up to half the piece size.</div>
                </div>
                <input type="number" name="ChunkOverlapTokens" value="@Model.ChunkOverlapTokens" class="text-input set-input" min="0" max="500" required />
            </label>

            <label class="set-row">
                <div>
                    <strong>Results per question</strong>
                    <div class="cell-sub">Top K · @Settings.KnowledgeMinTopK–@Settings.KnowledgeMaxTopK</div>
                    <div class="cell-sub">The most pieces the AI gets back for one question.</div>
                </div>
                <input type="number" name="TopK" value="@Model.TopK" class="text-input set-input" min="@Settings.KnowledgeMinTopK" max="@Settings.KnowledgeMaxTopK" required />
            </label>

            <label class="set-row">
                <div>
                    <strong>Minimum match</strong>
                    <div class="cell-sub">Minimum similarity · 0–1</div>
                    <div class="cell-sub">Higher is stricter. Unrelated questions return nothing.</div>
                </div>
                <input type="text" inputmode="decimal" name="MinimumSimilarity" value="@Model.MinimumSimilarity" class="text-input set-input" required />
            </label>

            <div class="flex items-center gap-2 mt-1">
                <button type="submit" class="btn btn-primary btn-sm">Save settings</button>
                <a href="/KnowledgeBase" class="btn btn-sm">Cancel</a>
            </div>
        </form>
    </div>

    <details class="card tech mw-640 mt-3">
        <summary>Technical setup (read-only)</summary>
        <div class="inbox-lead-info-row"><span>Embedding model</span><strong>@Model.Current.EmbeddingModel</strong></div>
        <div class="inbox-lead-info-row"><span>Vector dimension</span><strong>@Model.Current.VectorDimension</strong></div>
        <div class="inbox-lead-info-row"><span>Similarity method</span><strong>@KnowledgeSimilarityMethod.Label(Model.Current.SimilarityMethod)</strong></div>
        <div class="inbox-lead-info-row"><span>Vector index type</span><strong>@KnowledgeVectorIndexType.Label(Model.Current.VectorIndexType)</strong></div>
        <div class="cell-sub mt-1">
            Changing this means re-processing every entry. Contact support if you need a different setup.
            Last updated @LocalTimeHelper.Time(Model.Current.UpdatedAt, "datetime-year").
        </div>
    </details>
}
