@page "/KnowledgeBase/Websites/{id:guid}"
@model PlasticSurgery.Pages.KnowledgeBase.Websites.DetailsModel
@{
    ViewData["Title"] = "Website";
    string RunBadge(string s) => s switch
    {
        WebsiteScrapeStatus.Completed => "badge-green",
        WebsiteScrapeStatus.CompletedWithErrors => "badge-amber",
        WebsiteScrapeStatus.Failed => "badge-red",
        WebsiteScrapeStatus.Crawling => "badge-teal",
        _ => "badge-gray"
    };
    string RunLabel(WebsiteRunResponse r) => r.Status switch
    {
        WebsiteScrapeStatus.Completed => "Completed",
        WebsiteScrapeStatus.CompletedWithErrors => $"{r.PagesFailed} problem{(r.PagesFailed == 1 ? "" : "s")}",
        WebsiteScrapeStatus.Failed => "Failed",
        WebsiteScrapeStatus.Crawling => "Importing",
        WebsiteScrapeStatus.Pending => "Waiting",
        _ => r.Status
    };
    string PageBadge(string s) => s switch
    {
        WebsitePageStatus.Indexed or WebsitePageStatus.Unchanged => "badge-green",
        WebsitePageStatus.Failed or WebsitePageStatus.Removed => "badge-red",
        WebsitePageStatus.Skipped or WebsitePageStatus.Duplicate => "badge-gray",
        _ => "badge-teal"
    };
    string PageLabel(string s) => s switch
    {
        WebsitePageStatus.Indexed or WebsitePageStatus.Unchanged => "In Knowledge Base",
        WebsitePageStatus.Failed => "Failed",
        WebsitePageStatus.Removed => "Removed",
        WebsitePageStatus.Skipped => "Skipped",
        WebsitePageStatus.Duplicate => "Duplicate",
        _ => "Checking…"
    };
    static Microsoft.AspNetCore.Html.IHtmlContent Ago(DateTimeOffset when) =>
        LocalTimeHelper.Ago(when, dayCutoff: 2, fallbackFormat: "date");
    var d = Model.Detail;
    // "View text" remembers this exact page (including the filter) so Cancel/Save on the entry return here.
    var backToThisPage = "/KnowledgeBase/Websites/" + Model.Id + (string.IsNullOrEmpty(Model.Status) ? "" : "?status=" + Uri.EscapeDataString(Model.Status));
}

@if (!Model.ClinicConfigured || d is null)
{
    <partial name="_NoClinic" />
}
else
{
    var s = d.Source;
    var run = s.LatestRun;
    int Count(params string[] statuses) => statuses.Sum(x => d.PageStatusCounts.GetValueOrDefault(x));
    var inKb = Count(WebsitePageStatus.Indexed, WebsitePageStatus.Unchanged);

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/KnowledgeBase" aria-label="Back to Knowledge Base" title="Back to Knowledge Base">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <span class="src-icon src-web big" aria-hidden="true"><span class="au-icon">language</span></span>
        <div class="min-w-0">
            <h2 class="au-back-header__title"><a href="@s.StartUrl" target="_blank" rel="noopener noreferrer" title="Open the website">@UrlDisplayHelper.Readable(s.StartUrl)</a></h2>
            <span class="au-back-header__sub">
                @(s.CrawlMode == WebsiteCrawlMode.SinglePage ? "Single page" : "Whole website")
                · @KnowledgeCategory.Label(s.Category)
                · @if (s.LastScrapedAt is { } last) { <text>imported @Ago(last)</text> } else { <text>not imported yet</text> }
            </span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @(s.IsActive ? "badge-green" : "badge-gray")">@(s.IsActive ? "Active" : "Inactive")</span>
        <span class="au-spacer"></span>
        <form method="post" asp-page-handler="Delete" class="inline-form"
              data-au-confirm="Delete this website and all the Knowledge Base pages imported from it? Written entries and uploaded documents stay."
              data-au-confirm-title="Delete website" data-au-confirm-label="Delete website" data-au-confirm-tone="danger">
            <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text" disabled="@s.InProgress">Delete</button>
        </form>
        <form method="post" asp-page-handler="Toggle" class="inline-form">
            <input type="hidden" name="active" value="@((!s.IsActive).ToString().ToLowerInvariant())" />
            <button type="submit" class="au-btn au-btn--outlined au-btn--sm">@(s.IsActive ? "Deactivate" : "Activate")</button>
        </form>
        @if (s.IsActive)
        {
            <form method="post" asp-page-handler="Rescrape" class="inline-form">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm" disabled="@s.InProgress"><span class="au-icon" aria-hidden="true">sync</span>Import again</button>
            </form>
        }
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    @if (s.InProgress)
    {
        var pct = run is { PagesDiscovered: > 0 } ? Math.Min(100, run.PagesProcessed * 100 / run.PagesDiscovered) : 0;
        <div class="au-panel au-panel--round au-panel--pad mb-3">
            <div class="progress"><div style="width:@(pct)%"></div></div>
            <div class="cell-sub mt-1">
                <span class="spin"></span>
                @(run is { PagesDiscovered: > 0 } ? $"Importing… {run.PagesProcessed} of {run.PagesDiscovered} pages checked." : "Starting the import…")
                You can leave this page.
            </div>
        </div>
    }
    else if (run is not null && run.Status == WebsiteScrapeStatus.Failed)
    {
        <div class="au-alert au-alert--error" role="alert">
            <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
            <div class="au-alert__body">
                <div class="au-alert__title">The import failed</div>
                @(string.IsNullOrWhiteSpace(run.ErrorSummary) ? "The website couldn't be read." : run.ErrorSummary)
                Check the address and try "Import again".
            </div>
        </div>
    }
    else if (run is not null && run.Status == WebsiteScrapeStatus.CompletedWithErrors)
    {
        <div class="au-alert au-alert--warning" role="status">
            <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
            <div class="au-alert__body">
                <div class="au-alert__title">Imported with @run.PagesFailed problem@(run.PagesFailed == 1 ? "" : "s")</div>
                Most pages are fine; see <a class="au-link" href="/KnowledgeBase/Websites/@s.Id?status=@WebsitePageStatus.Failed">Failed</a> below.
                @if (!string.IsNullOrWhiteSpace(run.ErrorSummary))
                {
                    <details class="alert-details"><summary>Technical details</summary><div>@run.ErrorSummary</div></details>
                }
            </div>
        </div>
    }

    @if (run is not null)
    {
        <div class="facts mb-3">
            <div class="fact au-panel au-panel--round"><div class="eyebrow">Pages found</div><div class="fact-main">@run.PagesDiscovered</div></div>
            <div class="fact au-panel au-panel--round"><div class="eyebrow">In Knowledge Base</div><div class="fact-main">@s.IndexedPages</div></div>
            <div class="fact au-panel au-panel--round"><div class="eyebrow">Skipped</div><div class="fact-main">@(run.PagesSkipped + run.PagesDuplicate)</div></div>
            <div class="fact au-panel au-panel--round"><div class="eyebrow">Failed</div><div class="fact-main">@run.PagesFailed</div></div>
        </div>
        <details class="au-panel au-panel--round tech mb-3">
            <summary>All import numbers</summary>
            <div class="kb-nums mt-2">
                @foreach (var (label, value, hint) in new[]
                {
                    ("Discovered", run.PagesDiscovered, "URLs found on the site"),
                    ("Processed", run.PagesProcessed, "URLs fetched and examined"),
                    ("Indexed", run.PagesIndexed, "New + changed pages added to the Knowledge Base"),
                    ("New", run.PagesNew, "Pages added for the first time"),
                    ("Changed", run.PagesChanged, "Pages whose text changed and were re-indexed"),
                    ("Unchanged", run.PagesUnchanged, "Same content as last time — left alone"),
                    ("Skipped", run.PagesSkipped, "Not imported (robots.txt, not HTML, too little text, …)"),
                    ("Duplicate", run.PagesDuplicate, "Same page/content as another page"),
                    ("Failed", run.PagesFailed, "Could not be fetched or indexed"),
                    ("Removed", run.PagesRemoved, "No longer on the website — hidden from the AI")
                })
                {
                    <span title="@hint">@label <strong>@value</strong></span>
                }
            </div>
            <div class="cell-sub mt-1">
                @if (run.StartedAt is null)
                {
                    <text>Waiting to start</text>
                }
                else
                {
                    <text>Started @LocalTimeHelper.Time(run.StartedAt)</text>
                }
                @if (run.CompletedAt is not null)
                {
                    <text>· finished @LocalTimeHelper.Time(run.CompletedAt, "time")</text>
                }
            </div>
        </details>
    }

    <div class="section-head">
        <h2 class="section-title">Pages</h2>
        <div class="inbox-filters" aria-label="Show pages">
            @foreach (var (value, label, count) in new[]
            {
                ("", "All", d.PageStatusCounts.Values.Sum()),
                ("in_kb", "In Knowledge Base", inKb),
                (WebsitePageStatus.Failed, "Failed", Count(WebsitePageStatus.Failed)),
                (WebsitePageStatus.Skipped, "Skipped", Count(WebsitePageStatus.Skipped)),
                (WebsitePageStatus.Duplicate, "Duplicate", Count(WebsitePageStatus.Duplicate)),
                (WebsitePageStatus.Removed, "Removed", Count(WebsitePageStatus.Removed))
            })
            {
                <a href="/KnowledgeBase/Websites/@s.Id@(value == "" ? "" : "?status=" + value)"
                   class="inbox-filter @((Model.Status ?? "") == value ? "active" : "")">@label <span class="inbox-filter-count">@count</span></a>
            }
        </div>
    </div>

    @if (Model.Pages.Count == 0)
    {
        var noPages = new EmptyStateModel(Icon: s.InProgress ? "hourglass_top" : "web_asset_off",
            Title: s.InProgress ? "Reading the website…" : "No pages here",
            Text: s.InProgress ? "Pages appear here as they are checked." : string.IsNullOrEmpty(Model.Status) ? "Pages appear here once the website can be read." : "No pages with this status.",
            ActionLabel: string.IsNullOrEmpty(Model.Status) ? null : "Show all pages", ActionHref: $"/KnowledgeBase/Websites/{s.Id}", ActionIcon: "list");
        @* icon:hourglass_top *@ @* icon:web_asset_off *@
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="noPages" /></div>
    }
    else
    {
        <div class="au-table-card">
            <div class="au-table-scroll">
            <table class="au-table au-table--stack">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Pages)
                    {
                        var readable = UrlDisplayHelper.Readable(p.Url);
                        <tr>
                            <td data-label="Page">
                                <div class="min-w-0">
                                    <a href="@p.Url" target="_blank" rel="noopener noreferrer" class="row-title clip-1" title="@readable">@(string.IsNullOrEmpty(p.Title) ? readable : p.Title)</a>
                                    @if (!string.IsNullOrEmpty(p.Title))
                                    {
                                        <div class="cell-sub clip-1" title="@readable">@readable</div>
                                    }
                                </div>
                            </td>
                            <td data-label="Status" class="au-wrap">
                                <div>
                                    <span class="badge @PageBadge(p.Status)">@PageLabel(p.Status)</span>
                                    @if (!string.IsNullOrEmpty(p.FailureReason) || p.HttpStatus >= 400)
                                    {
                                        <div class="cell-sub break-word">@p.FailureReason@(p.HttpStatus >= 400 ? $" (error {p.HttpStatus})" : "")</div>
                                    }
                                </div>
                            </td>
                            <td class="row-actions">
                                @if (p.KnowledgeDocumentId is { } docId)
                                {
                                    <a href="/KnowledgeBase/Edit/@docId?returnUrl=@Uri.EscapeDataString(backToThisPage)" class="au-btn au-btn--outlined au-btn--sm">View text</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }

    @if (d.RecentRuns.Count > 1)
    {
        <details class="au-panel au-panel--round tech mt-3">
            <summary>Import history (@d.RecentRuns.Count)</summary>
            <div class="timeline">
                @foreach (var r in d.RecentRuns)
                {
                    <div class="tl-row">
                        <span class="badge @RunBadge(r.Status)">@RunLabel(r)</span>
                        <div class="flex-1 cell-sub">
                            @LocalTimeHelper.Time(r.StartedAt ?? r.CreatedAt, "datetime-year")
                            · @r.PagesDiscovered found · @r.PagesNew new · @r.PagesChanged changed · @r.PagesUnchanged unchanged
                            @if (r.PagesFailed > 0) { <text>· @r.PagesFailed failed</text> }
                            @if (r.PagesRemoved > 0) { <text>· @r.PagesRemoved removed</text> }
                        </div>
                    </div>
                }
            </div>
        </details>
    }

    @if (s.InProgress)
    {
        <script>setTimeout(function () { location.reload(); }, 3000);</script>
    }
}
