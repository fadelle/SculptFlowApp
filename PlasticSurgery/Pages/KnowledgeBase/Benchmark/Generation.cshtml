@page "/KnowledgeBase/Benchmark/Generations/{id:guid}"
@model PlasticSurgery.Pages.KnowledgeBase.Benchmark.GenerationModel
@{
    ViewData["Title"] = "Benchmark Generation";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Main Numbers page for setup steps.</div>
}
else
{
    <div class="mb-3"><a href="/KnowledgeBase/Benchmark" class="btn btn-sm">&larr; Back to Benchmark</a></div>

    <div id="bmg-message"></div>

    @* ---------- Generation summary ---------- *@
    <div class="card" id="bmg-summary" style="padding:1.1rem 1.25rem">Loading…</div>

    @* ---------- Latest scores of this generation's cases ---------- *@
    <div id="bmg-scores" class="mt-3"></div>

    @* ---------- Rejected questions (if any) ---------- *@
    <div id="bmg-rejected" class="mt-3" hidden>
        <h3 class="bm-section-title" id="bmg-rejected-title">Rejected questions</h3>
        <div class="table-card table-scroll">
            <table class="data-table">
                <thead><tr><th>Question</th><th>Reason</th></tr></thead>
                <tbody id="bmg-rejected-body"></tbody>
            </table>
        </div>
    </div>

    @* ---------- Chunks sent + raw n8n reply ---------- *@
    <div class="mt-3">
        <details>
            <summary style="cursor:pointer;font-size:.85rem;color:var(--text-muted)">Chunks sent (<span id="bmg-chunks-count">0</span>)</summary>
            <ul id="bmg-chunks-list" style="margin:.4rem 0 0 1.1rem;padding:0;font-size:.82rem"></ul>
        </details>
        <details class="mt-2" id="bmg-raw-wrap" hidden>
            <summary style="cursor:pointer;font-size:.85rem;color:var(--text-muted)">What n8n sent back (raw)</summary>
            <pre class="bm-block" style="max-height:260px;overflow:auto" id="bmg-raw"></pre>
        </details>
    </div>

    @* ---------- This generation's test cases ---------- *@
    <div class="mt-4">
        <div class="flex items-center gap-2 mb-1" style="justify-content:space-between;flex-wrap:wrap">
            <h3 class="bm-section-title">Test cases</h3>
            <select id="bmg-case-view" class="select" aria-label="Filter cases" style="width:auto">
                <option value="all">All cases</option>
                <option value="reviewed">Reviewed</option>
                <option value="unreviewed">Not reviewed</option>
                <option value="stale">Stale</option>
            </select>
        </div>
        <div class="table-card table-scroll mt-1">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Question</th>
                        <th>Expected document / chunk</th>
                        <th>Reviewed</th>
                        <th>Last result</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="bmg-cases-body"><tr class="empty-row"><td colspan="5">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="flex items-center gap-2 mt-1" id="bmg-cases-pager" hidden>
            <button type="button" class="btn btn-sm" id="bmg-cases-prev">&larr; Previous</button>
            <span class="text-subtle" style="font-size:.8rem" id="bmg-cases-range"></span>
            <button type="button" class="btn btn-sm" id="bmg-cases-next">Next &rarr;</button>
        </div>
    </div>

    @* ---------- Detail overlay (a case, or a failed-case analysis) ---------- *@
    <div class="bm-overlay" id="bmg-overlay" hidden>
        <div class="card bm-modal" role="dialog" aria-modal="true" aria-labelledby="bmg-modal-title">
            <div class="flex items-center gap-2" style="justify-content:space-between;margin-bottom:.75rem">
                <h3 id="bmg-modal-title" style="margin:0;font-size:1.05rem">Details</h3>
                <button type="button" class="btn btn-sm" id="bmg-modal-close">Close</button>
            </div>
            <div id="bmg-modal-body"></div>
        </div>
    </div>

    <div id="bmg-root" data-id="@Model.Id" hidden></div>
    <script src="~/js/knowledge-benchmark-generation.js" asp-append-version="true"></script>
}
