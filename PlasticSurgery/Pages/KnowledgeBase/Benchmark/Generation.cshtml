@page "/KnowledgeBase/Benchmark/Generations/{id:guid}"
@model PlasticSurgery.Pages.KnowledgeBase.Benchmark.GenerationModel
@{
    ViewData["Title"] = "Benchmark Generation";
}

@if (!Model.ClinicConfigured)
{
    <partial name="_NoClinic" />
}
else
{
    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/KnowledgeBase/Benchmark" aria-label="Back to Test search quality" title="Back to Test search quality">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <div class="min-w-0">
            <h2 class="au-back-header__title">Generated test cases</h2>
            <span class="au-back-header__sub">One request to the question generator, and how its cases score.</span>
        </div>
    </div>

    <div id="bmg-message"></div>

    @* ---------- Generation summary ---------- *@
    <div class="au-panel au-panel--round au-panel--pad" id="bmg-summary">Loading…</div>

    @* ---------- Latest scores of this generation's cases ---------- *@
    <div id="bmg-scores" class="mt-3"></div>

    @* ---------- Rejected questions (if any) ---------- *@
    <div id="bmg-rejected" class="mt-3" hidden>
        <h3 class="bm-section-title" id="bmg-rejected-title">Rejected questions</h3>
        <div class="table-card table-scroll">
            <table class="data-table">
                <thead><tr><th>Question</th><th>Reason</th></tr></thead>
                <tbody id="bmg-rejected-body"></tbody>
            </table>
        </div>
    </div>

    @* ---------- Chunks sent + raw n8n reply ---------- *@
    <div class="mt-3">
        <details>
            <summary class="bm-summary-toggle">Chunks sent (<span id="bmg-chunks-count">0</span>)</summary>
            <ul id="bmg-chunks-list" class="bm-chunks-list"></ul>
        </details>
        <details class="mt-2" id="bmg-raw-wrap" hidden>
            <summary class="bm-summary-toggle">What n8n sent back (raw)</summary>
            <pre class="bm-block bm-raw" id="bmg-raw"></pre>
        </details>
    </div>

    @* ---------- This generation's test cases ---------- *@
    <div class="mt-4">
        <div class="flex items-center gap-2 mb-1 justify-between flex-wrap">
            <h3 class="bm-section-title">Test cases</h3>
            <select id="bmg-case-view" class="au-select w-auto" aria-label="Filter cases">
                <option value="all">All cases</option>
                <option value="reviewed">Reviewed</option>
                <option value="unreviewed">Not reviewed</option>
                <option value="stale">Stale</option>
            </select>
        </div>
        <div class="table-card table-scroll mt-1">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Question</th>
                        <th>Expected document / chunk</th>
                        <th>Reviewed</th>
                        <th>Last result</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="bmg-cases-body"><tr class="empty-row"><td colspan="5">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="flex items-center gap-2 mt-1" id="bmg-cases-pager" hidden>
            <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="bmg-cases-prev"><span class="au-icon" aria-hidden="true">chevron_left</span>Previous</button>
            <span class="text-subtle text-sm" id="bmg-cases-range"></span>
            <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="bmg-cases-next">Next<span class="au-icon" aria-hidden="true">chevron_right</span></button>
        </div>
    </div>

    @* ---------- Detail overlay (a case, or a failed-case analysis) ---------- *@
    <div class="bm-overlay" id="bmg-overlay" hidden>
        <div class="card bm-modal" role="dialog" aria-modal="true" aria-labelledby="bmg-modal-title">
            <div class="flex items-center gap-2 justify-between mb-2">
                <h3 id="bmg-modal-title" class="card-title">Details</h3>
                <button type="button" class="au-icon-btn" id="bmg-modal-close" aria-label="Close" title="Close"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            <div id="bmg-modal-body"></div>
        </div>
    </div>

    <div id="bmg-root" data-id="@Model.Id" hidden></div>
    <script src="~/js/knowledge-benchmark-generation.js" asp-append-version="true"></script>
}
