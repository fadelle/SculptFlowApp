@page "/settings/integrations"
@model PlasticSurgery.Pages.Settings.IntegrationsModel
@{
    ViewData["Title"] = "Messaging Integrations";
    var allChannels = new[] { ChannelType.WhatsApp, ChannelType.Instagram, ChannelType.Facebook, ChannelType.Telegram };
    // A WhatsApp row connected through the provider not in use now doesn't count (see the two WhatsApp cards).
    var activeWhatsAppProvider = Model.UsesInfobipWhatsApp ? ChannelProvider.Infobip : ChannelProvider.Meta;
    var connectedCount = allChannels.Count(ch => Model.Channels.TryGetValue(ch, out var i) && i.Status == ChannelIntegrationStatus.Connected && !NeedsAttention(i)
        && (ch != ChannelType.WhatsApp || i.Provider == activeWhatsAppProvider));
    var attentionCount = allChannels.Count(ch => Model.Channels.TryGetValue(ch, out var i) && NeedsAttention(i));
}

@if (!Model.ClinicConfigured)
{
    <partial name="_NoClinic" />
}
else
{
    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="au-page-head">
        <p class="au-page-head__sub">Connect the apps patients message you on. Messages from all of them arrive in your Inbox.</p>
    </div>
    <div class="int-summary">
        <strong>@connectedCount of @allChannels.Length channels connected</strong>
        @if (attentionCount > 0)
        {
            <span class="text-danger-soft"> · @attentionCount need@(attentionCount == 1 ? "s" : "") attention</span>
        }
    </div>

    <div class="int-grid int-grid-even">
        @if (Model.UsesInfobipWhatsApp)
        {
            await RenderInfobipWhatsAppCard();
        }
        else
        {
            await RenderChannelCard(ChannelType.WhatsApp, "WA", "#25D366", "WhatsApp Business", "Chat with patients, send reminders and campaigns.", "Chat with patients on WhatsApp, and send reminders and campaigns.", oauth: true);
        }
        @{ await RenderChannelCard(ChannelType.Instagram, "IG", "#C13584", "Instagram", "Answer Instagram direct messages.", "Patients' Instagram DMs arrive in your Inbox, and the AI assistant can answer them.", oauth: false); }
        @{ await RenderChannelCard(ChannelType.Facebook, "FB", "#1877F2", "Facebook Messenger", "Answer messages sent to your Facebook page.", "Messages to your Facebook page arrive in your Inbox, and the AI assistant can answer them.", oauth: true); }
        @{ await RenderTelegramCard(); }
        @{ await RenderTikTokCard(); }
    </div>
}

<script>
    window.PS_META_CONFIG = {
        appId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaAppId)),
        version: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaGraphApiVersion)),
        clinicId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClinicId.ToString())),
        whatsappConfigId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaWhatsAppLoginConfigId)),
        facebookConfigId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaFacebookLoginConfigId))
    };
</script>
<script src="~/js/meta-connect.js" asp-append-version="true"></script>
<script>
    // Two-step PIN: hidden until "Show" is pressed.
    document.querySelectorAll('[data-pin-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var pin = btn.parentElement.querySelector('[data-pin]');
            var shown = pin.textContent !== '••••••';
            pin.textContent = shown ? '••••••' : pin.getAttribute('data-pin');
            btn.textContent = shown ? 'Show' : 'Hide';
        });
    });

    // Card popups: open from [data-open], close with ×/Cancel, a click outside, or Esc.
    document.querySelectorAll('[data-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var m = document.getElementById(btn.getAttribute('data-open'));
            m.hidden = false;
            var first = m.querySelector('input:not([type=hidden]), select, textarea');
            if (first) first.focus();
        });
    });
    document.querySelectorAll('.int-modal').forEach(function (card) {
        var overlay = card.parentElement;
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay || e.target.closest('[data-close]')) overlay.hidden = true;
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') document.querySelectorAll('.int-modal').forEach(function (c) { c.parentElement.hidden = true; });
    });
</script>

@functions {
    // A channel needs attention when it's in error, or (Telegram) its webhook reports a problem.
    private static bool NeedsAttention(ChannelIntegrationResponse i) =>
        i.Status == ChannelIntegrationStatus.Error
        || (i.Channel == ChannelType.Telegram && i.Status == ChannelIntegrationStatus.Connected && i.WebhookStatus == WebhookStatus.Error);

    private async Task RenderStatusPill(ChannelIntegrationResponse? info)
    {
        var (label, dot) = info is not null && NeedsAttention(info) ? ("Needs attention", "dot-red")
            : info?.Status == ChannelIntegrationStatus.Connected ? ("Connected", "dot-green")
            : ("Not connected", "dot-gray");
        <span class="status-pill"><span class="dot @dot"></span>@label</span>
        await Task.CompletedTask;
    }

    // Popup that holds a card's form (manual setup, account details, a different bot) so the cards never grow.
    private async Task RenderModalStart(string id, string channel, string accentHex, string title, string subtitle)
    {
        @:<div class="bm-overlay" id="@id" hidden>
        @:<div class="card cal-modal int-modal" role="dialog" aria-modal="true" aria-labelledby="@(id)-title">
            <div class="modal-head">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="channel-mark ch-@channel" style="background:@accentHex">@Html.Raw(PlasticSurgery.Common.Helpers.ChannelIconHelper.BrandSvg(channel) ?? "")</span>
                    <div class="min-w-0">
                        <h3 class="card-title m-0" id="@(id)-title">@title</h3>
                        <div class="cell-sub">@subtitle</div>
                    </div>
                </div>
                <button type="button" class="au-icon-btn" data-close aria-label="Close" title="Close"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
        await Task.CompletedTask;
    }

    private async Task RenderModalEnd()
    {
        @:</div>
        @:</div>
        await Task.CompletedTask;
    }

    // One Meta channel's card. Connecting uses the OAuth button (when oauth: true and a Login Configuration ID
    // is set) or the manual form in a popup; Instagram is manual only (its Login Configuration isn't set up yet).
    private async Task RenderChannelCard(string channel, string initials, string accentHex, string title, string purpose, string whenConnected, bool oauth)
    {
        var info = Model.Channels.TryGetValue(channel, out var c) ? c : null;
        // Back on Meta after the Infobip period: that number has to be connected again with Facebook sign-in,
        // so an Infobip-connected row shows as not connected here (mirror of RenderInfobipWhatsAppCard).
        if (channel == ChannelType.WhatsApp && info?.Provider == ChannelProvider.Infobip)
        {
            info = null;
        }
        var connected = info?.Status == ChannelIntegrationStatus.Connected;
        var isError = info?.Status == ChannelIntegrationStatus.Error;
        var configId = channel switch
        {
            ChannelType.WhatsApp => Model.MetaWhatsAppLoginConfigId,
            ChannelType.Facebook => Model.MetaFacebookLoginConfigId,
            _ => ""
        };
        // Only WhatsApp uses a JS-driven button; Facebook Messenger uses Meta's fb:login-button plugin.
        var jsFunction = channel == ChannelType.WhatsApp ? "psConnectWhatsApp" : "";
        var modalId = "int-m-" + channel;

        <div class="card int-card int-framed @(isError ? "int-card-error" : "")" style="--ch:@accentHex">
            <div class="int-head">
                <span class="channel-mark int-notch ch-@channel" title="@title">@Html.Raw(PlasticSurgery.Common.Helpers.ChannelIconHelper.BrandSvg(channel) ?? initials)</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">@title</div>
                    <div class="cell-sub">@((connected || isError) && !string.IsNullOrEmpty(info!.DisplayName) ? info.DisplayName : purpose)</div>
                </div>
                @{ await RenderStatusPill(info); }
            </div>

            @* Middle strip: same place on every card. *@
            @if (isError)
            {
                <div class="int-strip int-strip-problem">
                    <div>
                        <span class="cell-sub">Problem</span>
                        <span class="int-val">@title stopped working. Reconnect to keep sending and receiving messages.</span>
                        @if (!string.IsNullOrEmpty(info!.LastError))
                        {
                            <details class="mt-1"><summary class="cell-sub">Technical details</summary><div class="cell-sub break-word">@info.LastError</div></details>
                        }
                    </div>
                </div>
            }
            else if (connected && channel == ChannelType.WhatsApp)
            {
                <div class="int-strip">
                    @if (!string.IsNullOrEmpty(info!.Pin))
                    {
                        <div>
                            <span class="cell-sub">Two-step PIN</span>
                            <span class="int-val"><code data-pin="@info.Pin">••••••</code> <button type="button" class="link-btn" data-pin-toggle>Show</button></span>
                        </div>
                    }
                    <div>
                        <span class="cell-sub">Health</span>
                        <span class="int-val"><a href="/WhatsApp/Health">View WhatsApp Health →</a></span>
                    </div>
                </div>
            }
            else if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">@(channel == ChannelType.Instagram ? "Instagram account" : "Facebook page")</span>
                        <span class="int-val">@(string.IsNullOrEmpty(info!.DisplayName) ? (channel == ChannelType.Instagram ? info.InstagramBusinessId : info.PageId) ?? "—" : info.DisplayName)</span>
                    </div>
                    <div>
                        <span class="cell-sub">Messages</span>
                        <span class="int-val">Arrive in your Inbox</span>
                    </div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div>
                        <span class="cell-sub">When connected</span>
                        <span class="int-val">@whenConnected</span>
                    </div>
                </div>
            }

            @if (!connected && oauth)
            {
                @if (string.IsNullOrEmpty(configId))
                {
                    <div class="cell-sub" title="Meta Login Configuration ID missing in appsettings.json (Meta section)">Facebook sign-in isn't set up for this app yet, so use manual setup for now.</div>
                }
                else
                {
                    <div class="text-subtle text-xs" data-status-for="@channel"></div>
                }
            }

            <div class="int-foot">
                @if (!connected && oauth)
                {
                    @* Connect (or reconnect) with Facebook sign-in. *@
                    @if (channel == ChannelType.Facebook && !string.IsNullOrEmpty(configId))
                    {
                        <fb:login-button config_id="@configId" onlogin="psFacebookOnLogin();"></fb:login-button>
                    }
                    else
                    {
                        <button type="button" class="au-btn au-btn--primary au-btn--sm"
                                onclick="@(string.IsNullOrEmpty(jsFunction) ? null : jsFunction + "()")"
                                disabled="@string.IsNullOrEmpty(configId)">
                            @(isError ? "Reconnect with Facebook" : "Continue with Facebook")
                        </button>
                    }
                }
                <button type="button" class="au-btn au-btn--sm @(connected || isError || oauth ? "au-btn--text" : "au-btn--primary")" data-open="@modalId">
                    @(connected || isError ? "Account details" : oauth ? "Set up manually" : "Set up")
                </button>
                @if (connected || isError)
                {
                    <form method="post" asp-page-handler="Disconnect" class="inline-form int-foot-end"
                          data-au-confirm="Disconnect @title? Messages on this channel stop until you connect it again." data-au-confirm-title="Disconnect @title" data-au-confirm-label="Disconnect" data-au-confirm-tone="danger">
                        <input type="hidden" name="Channel" value="@channel" />
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">Disconnect</button>
                    </form>
                }
            </div>
        </div>

        await RenderModalStart(modalId, channel, accentHex,
            connected || isError ? $"{title} account details" : oauth ? $"Set up {title} manually" : $"Set up {title}",
            connected || isError ? (info?.DisplayName ?? "Change the IDs or the access token.")
                : oauth ? "Only if signing in with Facebook doesn't work for you." : "With the IDs and a token from your Meta app.");
        await RenderManualForm(channel, info, connected);
        await RenderModalEnd();
    }

    // WhatsApp while WhatsApp:Provider = infobip: no Facebook sign-in. The number is registered as a sender on
    // SculptFlow's Infobip account first; here it's only linked to this clinic (InfobipWhatsAppIntegrationService).
    // A Meta-connected row counts as not connected on this card, since it can't send while Infobip is active.
    private async Task RenderInfobipWhatsAppCard()
    {
        var row = Model.Channels.TryGetValue(ChannelType.WhatsApp, out var c) ? c : null;
        var info = row?.Provider == ChannelProvider.Infobip ? row : null;
        var connected = info?.Status == ChannelIntegrationStatus.Connected;
        var isError = info?.Status == ChannelIntegrationStatus.Error;
        const string modalId = "int-m-whatsapp-number";

        <div class="card int-card int-framed @(isError ? "int-card-error" : "")" style="--ch:#25D366">
            <div class="int-head">
                <span class="channel-mark int-notch ch-whatsapp" title="WhatsApp Business">@Html.Raw(PlasticSurgery.Common.Helpers.ChannelIconHelper.BrandSvg(ChannelType.WhatsApp) ?? "WA")</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">WhatsApp Business</div>
                    <div class="cell-sub">@(connected && !string.IsNullOrEmpty(info!.DisplayName) ? info.DisplayName : "Chat with patients, send reminders and campaigns.")</div>
                </div>
                @{ await RenderStatusPill(info); }
            </div>

            @if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">Number</span>
                        <span class="int-val">@info!.DisplayName</span>
                    </div>
                    <div>
                        <span class="cell-sub">Last message</span>
                        <span class="int-val" title="@(info.LastWebhookAt?.ToString("MMM d, HH:mm") + " UTC")">
                            @if (info.LastWebhookAt is { } last) { @LocalTimeHelper.Ago(last) } else { <text>None yet · send the number a WhatsApp message to test</text> }
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div>
                        <span class="cell-sub">When connected</span>
                        <span class="int-val">Chat with patients on WhatsApp, and send reminders and campaigns.</span>
                    </div>
                </div>
            }

            <div class="int-foot">
                <button type="button" class="au-btn au-btn--sm @(connected ? "au-btn--text" : "au-btn--primary")" data-open="@modalId">
                    @(connected ? "Account details" : "Connect")
                </button>
                @if (connected || isError)
                {
                    <form method="post" asp-page-handler="Disconnect" class="inline-form int-foot-end"
                          data-au-confirm="Disconnect WhatsApp? Messages on this number stop until you connect it again." data-au-confirm-title="Disconnect WhatsApp" data-au-confirm-label="Disconnect" data-au-confirm-tone="danger">
                        <input type="hidden" name="Channel" value="@ChannelType.WhatsApp" />
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">Disconnect</button>
                    </form>
                }
            </div>
        </div>

        await RenderModalStart(modalId, ChannelType.WhatsApp, "#25D366",
            connected ? "WhatsApp account details" : "Connect WhatsApp",
            connected ? (info!.DisplayName ?? "") : "Enter the WhatsApp number SculptFlow set up for your clinic.");
        <form method="post" asp-page-handler="ConnectWhatsAppNumber" class="integration-form">
            <label class="field">
                <span>WhatsApp number</span>
                <input type="tel" name="WhatsAppSenderNumber" class="text-input" autocomplete="off"
                       value="@(info?.ProviderSenderId is { } s ? "+" + s : "")" placeholder="+44 7860 099299" required />
                <small class="text-subtle">International format. We check it's ready for WhatsApp before connecting.</small>
            </label>
            @if (connected && !string.IsNullOrEmpty(Model.InfobipWebhookUrl))
            {
                <label class="field">
                    <span>Webhook URL</span>
                    <input type="text" class="text-input" readonly value="@Model.InfobipWebhookUrl" onclick="this.select()" />
                    <small class="text-subtle">For SculptFlow support: the number's inbound messages and delivery reports go here. Keep it private.</small>
                </label>
            }
            <div class="flex items-center gap-2">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm">@(connected ? "Save" : "Connect")</button>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-close>Cancel</button>
            </div>
        </form>
        await RenderModalEnd();
    }

    // Telegram: the clinic pastes a BotFather token and SculptFlow does the rest (getMe, then setWebhook with a
    // generated secret). The token is write-only — nothing here can render a saved one.
    private async Task RenderTelegramCard()
    {
        var info = Model.Channels.TryGetValue(ChannelType.Telegram, out var c) ? c : null;
        var connected = info?.Status == ChannelIntegrationStatus.Connected;
        var problem = info is not null && NeedsAttention(info);
        const string modalId = "int-m-telegram";

        <div class="card int-card int-framed @(problem ? "int-card-error" : "")" style="--ch:#229ED9">
            <div class="int-head">
                <span class="channel-mark int-notch ch-telegram" title="Telegram">@Html.Raw(PlasticSurgery.Common.Helpers.ChannelIconHelper.BrandSvg(ChannelType.Telegram))</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">Telegram</div>
                    <div class="cell-sub">
                        @if (!string.IsNullOrEmpty(info?.TelegramBotUsername))
                        {
                            <text>@(connected ? "" : "Last bot ")@("@" + info!.TelegramBotUsername)</text>
                        }
                        else
                        {
                            <text>Answer messages sent to your Telegram bot.</text>
                        }
                    </div>
                </div>
                @{ await RenderStatusPill(info); }
            </div>

            @if (!string.IsNullOrEmpty(info?.LastError))
            {
                <div class="int-strip int-strip-problem">
                    <div>
                        <span class="cell-sub">Problem</span>
                        <span class="int-val">Telegram can't deliver messages to us right now. Try "Check connection", or use a different bot.</span>
                        <details class="mt-1"><summary class="cell-sub">Technical details</summary><div class="cell-sub break-word">@info!.LastError</div></details>
                    </div>
                </div>
            }
            else if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">Receiving messages</span>
                        <span class="int-val">@(info!.WebhookStatus switch { WebhookStatus.Active => "Yes", WebhookStatus.Pending => "Setting up…", _ => "No" })</span>
                    </div>
                    <div>
                        <span class="cell-sub">Last message</span>
                        <span class="int-val" title="@(info.LastWebhookAt?.ToString("MMM d, HH:mm") + " UTC")">
                            @if (info.LastWebhookAt is { } last) { @LocalTimeHelper.Ago(last) } else { <text>None yet · send your bot a message to test</text> }
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div>
                        <span class="cell-sub">When connected</span>
                        <span class="int-val">Messages to your Telegram bot arrive in your Inbox, and the AI assistant can answer them.</span>
                    </div>
                </div>
            }

            <div class="int-foot">
                @if (connected)
                {
                    <form method="post" asp-page-handler="RefreshTelegram" class="inline-form">
                        <button type="submit" class="au-btn au-btn--outlined au-btn--sm">Check connection</button>
                    </form>
                    <button type="button" class="au-btn au-btn--text au-btn--sm" data-open="@modalId">Use a different bot</button>
                    <form method="post" asp-page-handler="Disconnect" class="inline-form int-foot-end"
                          data-au-confirm="Disconnect Telegram? The bot stops receiving and sending messages until you connect it again. Existing conversations are kept." data-au-confirm-title="Disconnect Telegram" data-au-confirm-label="Disconnect" data-au-confirm-tone="danger">
                        <input type="hidden" name="Channel" value="@ChannelType.Telegram" />
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">Disconnect</button>
                    </form>
                }
                else
                {
                    <button type="button" class="au-btn au-btn--primary au-btn--sm" data-open="@modalId">Connect</button>
                }
            </div>
        </div>

        await RenderModalStart(modalId, ChannelType.Telegram, "#229ED9",
            connected ? "Use a different bot" : "Connect Telegram",
            connected && !string.IsNullOrEmpty(info?.TelegramBotUsername) ? "Replaces @" + info!.TelegramBotUsername + "." : "Create a bot in Telegram, then paste its token.");
        await RenderTelegramConnectForm(connected ? "Reconnect" : "Connect");
        await RenderModalEnd();
    }

    private async Task RenderTelegramConnectForm(string buttonLabel)
    {
        <form method="post" asp-page-handler="ConnectTelegram" class="integration-form">
            <ol class="steps">
                <li>Open <strong>@@BotFather</strong> in Telegram.</li>
                <li>Send <code>/newbot</code> and follow the steps.</li>
                <li>Paste the token it gives you:</li>
            </ol>
            <label class="field">
                <span>Bot token</span>
                <input type="password" name="BotToken" class="text-input" autocomplete="off" spellcheck="false"
                       placeholder="123456789:AA…" required />
                <small class="text-subtle">We check the token and set everything up. It's never shown again.</small>
            </label>
            <div class="flex items-center gap-2">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm">@buttonLabel</button>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-close>Cancel</button>
            </div>
        </form>
        await Task.CompletedTask;
    }

    // TikTok Login Kit: account connection only (not a messaging channel yet — see
    // Business/Contracts/Services/TikTok/ITikTokIntegrationService.cs), so Connect/Reconnect is a plain link to TikTokOAuthController
    // (a real browser redirect to TikTok's consent screen), same pattern as Calendar Integrations' cards.
    private async Task RenderTikTokCard()
    {
        var info = Model.TikTok;
        var connected = info?.Status == TikTokIntegrationStatus.Connected;
        var pending = info?.Status == TikTokIntegrationStatus.Pending;
        var failed = info?.Status == TikTokIntegrationStatus.Error;
        var unhealthy = connected && info is not null && !info.IsHealthy;
        var (label, dot) = failed || unhealthy ? ("Needs attention", "dot-red")
            : connected ? ("Connected", "dot-green")
            : pending ? ("Connecting…", "dot-gray")
            : ("Not connected", "dot-gray");

        <div class="card int-card int-framed @(failed || unhealthy ? "int-card-error" : "")" style="--ch:#000000">
            <div class="int-head">
                <span class="channel-mark int-notch ch-tiktok" title="TikTok">@Html.Raw(PlasticSurgery.Common.Helpers.ChannelIconHelper.BrandSvg("tiktok"))</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">TikTok</div>
                    <div class="cell-sub">@(connected && !string.IsNullOrEmpty(info!.DisplayName) ? info.DisplayName : "Connect your clinic's TikTok account.")</div>
                </div>
                <span class="status-pill"><span class="dot @dot"></span>@label</span>
            </div>

            @if (failed || unhealthy)
            {
                <div class="int-strip int-strip-problem">
                    <div>
                        <span class="cell-sub">Problem</span>
                        <span class="int-val">TikTok stopped working. Reconnect to keep the connection active.</span>
                        @if (!string.IsNullOrEmpty(info?.LastProblemMessage))
                        {
                            <details class="mt-1"><summary class="cell-sub">Technical details</summary><div class="cell-sub break-word">@info.LastProblemMessage</div></details>
                        }
                    </div>
                </div>
            }
            else if (connected)
            {
                <div class="int-strip">
                    <div>
                        <span class="cell-sub">TikTok account</span>
                        <span class="int-val">@(info!.DisplayName ?? "Connected")</span>
                    </div>
                </div>
            }
            else if (pending)
            {
                <div class="int-strip int-strip-note">
                    <div><span class="cell-sub">Not finished</span><span class="int-val">The sign-in to TikTok wasn't finished. Start again, or reset it.</span></div>
                </div>
            }
            else
            {
                <div class="int-strip int-strip-note">
                    <div><span class="cell-sub">When connected</span><span class="int-val">See which TikTok account is linked to your clinic.</span></div>
                </div>
            }

            <div class="int-foot">
                @if (pending || failed)
                {
                    <a href="/tiktok-oauth/connect" class="au-btn au-btn--primary au-btn--sm">@(pending ? "Start again" : "Try again")</a>
                    <form method="post" asp-page-handler="DisconnectTikTok" class="inline-form">
                        <button type="submit" class="au-btn au-btn--text au-btn--sm">Cancel / reset</button>
                    </form>
                }
                else if (!connected)
                {
                    <a href="/tiktok-oauth/connect" class="au-btn au-btn--primary au-btn--sm">Connect</a>
                }
                else
                {
                    @if (unhealthy)
                    {
                        <a href="/tiktok-oauth/connect" class="au-btn au-btn--primary au-btn--sm">Reconnect</a>
                    }
                    <form method="post" asp-page-handler="DisconnectTikTok" class="inline-form int-foot-end"
                          data-au-confirm="Disconnect TikTok? Your clinic won't show a connected TikTok account until you connect it again." data-au-confirm-title="Disconnect TikTok" data-au-confirm-label="Disconnect" data-au-confirm-tone="danger">
                        <button type="submit" class="au-btn au-btn--text au-btn--sm btn-danger-text">Disconnect</button>
                    </form>
                }
            </div>
        </div>
        await Task.CompletedTask;
    }

    private async Task RenderManualForm(string channel, ChannelIntegrationResponse? info, bool connected)
    {
        var tokenOnFile = info is not null && info.HasAccessToken;
        <form method="post" asp-page-handler="Save" class="integration-form">
            <input type="hidden" name="Channel" value="@channel" />

            <div class="form-row-even">
                <label class="field">
                    <span>Display name</span>
                    <input type="text" name="DisplayName" value="@(info?.DisplayName)" placeholder="e.g. Clinic front desk" class="text-input" />
                </label>

                @if (channel == ChannelType.WhatsApp)
                {
                    <label class="field">
                        <span>Phone number ID</span>
                        <input type="text" name="PhoneNumberId" value="@(info?.PhoneNumberId)" class="text-input" />
                        <small class="text-subtle">Meta app → WhatsApp → API Setup</small>
                    </label>
                    <label class="field">
                        <span>WhatsApp Business Account ID</span>
                        <input type="text" name="WhatsAppBusinessId" value="@(info?.WhatsAppBusinessId)" class="text-input" />
                        <small class="text-subtle">Same page, under the phone number</small>
                    </label>
                    <label class="field">
                        <span>Webhook verify token</span>
                        <input type="text" name="WebhookVerifyToken"
                               placeholder="@(info?.HasWebhookVerifyToken == true ? "•••••••• (leave blank to keep)" : "Any word you choose")"
                               class="text-input" />
                        <small class="text-subtle">Type the same word in Meta's webhook settings</small>
                    </label>
                }
                else if (channel == ChannelType.Instagram)
                {
                    <label class="field">
                        <span>Instagram Business Account ID</span>
                        <input type="text" name="InstagramBusinessId" value="@(info?.InstagramBusinessId)" class="text-input" />
                        <small class="text-subtle">Meta Business Suite → Settings → Instagram accounts</small>
                    </label>
                    <label class="field">
                        <span>Linked Facebook Page ID</span>
                        <input type="text" name="PageId" value="@(info?.PageId)" class="text-input" />
                        <small class="text-subtle">Your Facebook page → About → Page transparency</small>
                    </label>
                }
                else if (channel == ChannelType.Facebook)
                {
                    <label class="field">
                        <span>Page ID</span>
                        <input type="text" name="PageId" value="@(info?.PageId)" class="text-input" />
                        <small class="text-subtle">Your Facebook page → About → Page transparency</small>
                    </label>
                }
            </div>

            <label class="field">
                <span>Access token</span>
                <input type="password" name="AccessToken"
                       placeholder="@(tokenOnFile ? "•••••••• (leave blank to keep)" : "Paste a permanent access token")"
                       class="text-input" autocomplete="off" />
                <small class="text-subtle">@(tokenOnFile ? "A token is saved. It's hidden for your security." : "Stored safely and never shown again.")</small>
            </label>

            <div class="flex items-center gap-2">
                <button type="submit" class="au-btn au-btn--primary au-btn--sm">@(connected ? "Save changes" : "Connect")</button>
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" data-close>Cancel</button>
            </div>
        </form>
        await Task.CompletedTask;
    }
}
