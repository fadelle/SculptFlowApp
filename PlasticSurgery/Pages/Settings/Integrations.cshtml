@page "/settings/integrations"
@model PlasticSurgery.Pages.Settings.IntegrationsModel
@using PlasticSurgery.Data.Entities
@{
    ViewData["Title"] = "Channels & Integrations";
    var allChannels = new[] { ChannelType.WhatsApp, ChannelType.Instagram, ChannelType.Facebook, ChannelType.Telegram };
    var connectedCount = allChannels.Count(ch => Model.Channels.TryGetValue(ch, out var i) && i.Status == ChannelIntegrationStatus.Connected && !NeedsAttention(i));
    var attentionCount = allChannels.Count(ch => Model.Channels.TryGetValue(ch, out var i) && NeedsAttention(i));
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else
{
    if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info mb-3">@Model.StatusMessage</div>
    }
    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
    }

    <p class="text-muted mb-2">Connect the apps patients message you on. Messages from all of them arrive in your Inbox.</p>
    <div class="int-summary">
        <strong>@connectedCount of @allChannels.Length channels connected</strong>
        @if (attentionCount > 0)
        {
            <span class="text-danger-soft"> · @attentionCount need@(attentionCount == 1 ? "s" : "") attention</span>
        }
    </div>

    <div class="int-grid">
        @{ await RenderChannelCard(ChannelType.WhatsApp, "WA", "#25D366", "WhatsApp Business", "Chat with patients, send reminders and campaigns.", oauth: true); }
        @{ await RenderChannelCard(ChannelType.Instagram, "IG", "#C13584", "Instagram", "Answer Instagram direct messages.", oauth: false); }
        @{ await RenderChannelCard(ChannelType.Facebook, "FB", "#1877F2", "Facebook Messenger", "Answer messages sent to your Facebook page.", oauth: true); }
        @{ await RenderTelegramCard(); }
    </div>
}

<script>
    window.PS_META_CONFIG = {
        appId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaAppId)),
        version: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaGraphApiVersion)),
        clinicId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClinicId.ToString())),
        whatsappConfigId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaWhatsAppLoginConfigId)),
        facebookConfigId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetaFacebookLoginConfigId))
    };
</script>
<script src="~/js/meta-connect.js" asp-append-version="true"></script>
<script>
    // Two-step PIN: hidden until "Show" is pressed.
    document.querySelectorAll('[data-pin-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var pin = btn.parentElement.querySelector('[data-pin]');
            var shown = pin.textContent !== '••••••';
            pin.textContent = shown ? '••••••' : pin.getAttribute('data-pin');
            btn.textContent = shown ? 'Show' : 'Hide';
        });
    });
</script>

@functions {
    // A channel needs attention when it's in error, or (Telegram) its webhook reports a problem.
    private static bool NeedsAttention(PlasticSurgery.Dtos.ChannelIntegrationResponse i) =>
        i.Status == ChannelIntegrationStatus.Error
        || (i.Channel == ChannelType.Telegram && i.Status == ChannelIntegrationStatus.Connected && i.WebhookStatus == WebhookStatus.Error);

    private static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} {((int)span.TotalHours == 1 ? "hour" : "hours")} ago";
        return $"{(int)span.TotalDays} {((int)span.TotalDays == 1 ? "day" : "days")} ago";
    }

    private async Task RenderStatusPill(PlasticSurgery.Dtos.ChannelIntegrationResponse? info)
    {
        var (label, dot) = info is not null && NeedsAttention(info) ? ("Needs attention", "dot-red")
            : info?.Status == ChannelIntegrationStatus.Connected ? ("Connected", "dot-green")
            : ("Not connected", "dot-gray");
        <span class="status-pill"><span class="dot @dot"></span>@label</span>
        await Task.CompletedTask;
    }

    // One Meta channel's card. Connecting uses the OAuth button (when oauth: true and a Login Configuration ID
    // is set) or the manual form; Instagram is manual only (its Login Configuration isn't set up yet).
    private async Task RenderChannelCard(string channel, string initials, string accentHex, string title, string purpose, bool oauth)
    {
        var info = Model.Channels.TryGetValue(channel, out var c) ? c : null;
        var connected = info?.Status == ChannelIntegrationStatus.Connected;
        var isError = info?.Status == ChannelIntegrationStatus.Error;
        var configId = channel switch
        {
            ChannelType.WhatsApp => Model.MetaWhatsAppLoginConfigId,
            ChannelType.Facebook => Model.MetaFacebookLoginConfigId,
            _ => ""
        };
        // Only WhatsApp uses a JS-driven button; Facebook Messenger uses Meta's fb:login-button plugin.
        var jsFunction = channel == ChannelType.WhatsApp ? "psConnectWhatsApp" : "";

        <div class="card int-card @(isError ? "int-card-error" : "")">
            <div class="int-head">
                <span class="channel-mark" style="background:@accentHex">@initials</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">@title</div>
                    <div class="cell-sub">@((connected || isError) && !string.IsNullOrEmpty(info!.DisplayName) ? info.DisplayName : purpose)</div>
                </div>
                @{ await RenderStatusPill(info); }
            </div>

            @if (isError)
            {
                <div class="int-problem">
                    <strong>Problem:</strong> @title stopped working. Reconnect to keep sending and receiving messages.
                    @if (!string.IsNullOrEmpty(info!.LastError))
                    {
                        <details class="mt-1"><summary class="cell-sub">Technical details</summary><div class="cell-sub break-word">@info.LastError</div></details>
                    }
                </div>
            }

            @if (connected && channel == ChannelType.WhatsApp)
            {
                <div class="int-facts">
                    @if (!string.IsNullOrEmpty(info!.Pin))
                    {
                        <div>
                            <span class="cell-sub">Two-step PIN</span>
                            <strong><code data-pin="@info.Pin">••••••</code> <button type="button" class="link-btn" data-pin-toggle>Show</button></strong>
                        </div>
                    }
                    <div>
                        <span class="cell-sub">Health</span>
                        <strong><a href="/WhatsApp/Health">View WhatsApp Health →</a></strong>
                    </div>
                </div>
            }

            @if (!connected && oauth)
            {
                @* Connect (or reconnect) with Facebook sign-in. *@
                <div class="int-actions">
                    @if (channel == ChannelType.Facebook && !string.IsNullOrEmpty(configId))
                    {
                        <fb:login-button config_id="@configId" onlogin="psFacebookOnLogin();"></fb:login-button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm"
                                onclick="@(string.IsNullOrEmpty(jsFunction) ? null : jsFunction + "()")"
                                disabled="@string.IsNullOrEmpty(configId)">
                            @(isError ? "Reconnect with Facebook" : "Continue with Facebook")
                        </button>
                    }
                </div>
                @if (string.IsNullOrEmpty(configId))
                {
                    <div class="cell-sub" title="Meta Login Configuration ID missing in appsettings.json (Meta section)">Facebook sign-in isn't set up for this app yet, so use manual setup for now.</div>
                }
                else
                {
                    <div class="text-subtle text-xs" data-status-for="@channel"></div>
                }
            }

            <details class="int-more">
                <summary class="btn btn-ghost btn-sm">@(connected || isError ? "Account details" : oauth ? "Set up manually" : "Set up")</summary>
                <div class="mt-2">
                    @{ await RenderManualForm(channel, info, connected); }
                </div>
            </details>

            @if (connected || isError)
            {
                <form method="post" asp-page-handler="Disconnect" class="inline-form"
                      onsubmit="return confirm('Disconnect @title? Leads on this channel will stop being sent/received until reconnected.');">
                    <input type="hidden" name="Channel" value="@channel" />
                    <button type="submit" class="btn btn-ghost btn-sm btn-danger-text">Disconnect</button>
                </form>
            }
        </div>
        await Task.CompletedTask;
    }

    // Telegram: the clinic pastes a BotFather token and SculptFlow does the rest (getMe, then setWebhook with a
    // generated secret). The token is write-only — nothing here can render a saved one.
    private async Task RenderTelegramCard()
    {
        var info = Model.Channels.TryGetValue(ChannelType.Telegram, out var c) ? c : null;
        var connected = info?.Status == ChannelIntegrationStatus.Connected;
        var problem = info is not null && NeedsAttention(info);

        <div class="card int-card @(problem ? "int-card-error" : "")">
            <div class="int-head">
                <span class="channel-mark" style="background:#229ED9">TG</span>
                <div class="flex-1 min-w-0">
                    <div class="integration-title">Telegram</div>
                    <div class="cell-sub">
                        @if (!string.IsNullOrEmpty(info?.TelegramBotUsername))
                        {
                            <text>@(connected ? "" : "Last bot ")@("@" + info!.TelegramBotUsername)</text>
                        }
                        else
                        {
                            <text>Answer messages sent to your Telegram bot.</text>
                        }
                    </div>
                </div>
                @{ await RenderStatusPill(info); }
            </div>

            @if (!string.IsNullOrEmpty(info?.LastError))
            {
                <div class="int-problem">
                    <strong>Problem:</strong> Telegram can't deliver messages to us right now. Try "Check connection", or reconnect the bot.
                    <details class="mt-1"><summary class="cell-sub">Technical details</summary><div class="cell-sub break-word">@info!.LastError</div></details>
                </div>
            }

            @if (connected)
            {
                <div class="int-facts">
                    <div>
                        <span class="cell-sub">Receiving messages</span>
                        <strong>@(info!.WebhookStatus switch { WebhookStatus.Active => "Yes", WebhookStatus.Pending => "Setting up…", _ => "No" })</strong>
                    </div>
                    <div>
                        <span class="cell-sub">Last message</span>
                        <strong title="@(info.LastWebhookAt?.ToString("MMM d, HH:mm") + " UTC")">@(info.LastWebhookAt is { } last ? Ago(last) : "None yet")</strong>
                    </div>
                </div>
                @if (!info.LastWebhookAt.HasValue)
                {
                    <div class="cell-sub">Send your bot a message from Telegram to test it.</div>
                }
                <div class="int-actions">
                    <form method="post" asp-page-handler="RefreshTelegram" class="inline-form">
                        <button type="submit" class="btn btn-sm">Check connection</button>
                    </form>
                    <form method="post" asp-page-handler="Disconnect" class="inline-form"
                          onsubmit="return confirm('Disconnect Telegram? The bot stops receiving and sending messages until reconnected. Existing conversations are kept.');">
                        <input type="hidden" name="Channel" value="@ChannelType.Telegram" />
                        <button type="submit" class="btn btn-ghost btn-sm btn-danger-text">Disconnect</button>
                    </form>
                </div>
                <details class="int-more">
                    <summary class="btn btn-ghost btn-sm">Use a different bot</summary>
                    <div class="mt-2">@{ await RenderTelegramConnectForm("Reconnect"); }</div>
                </details>
            }
            else
            {
                await RenderTelegramConnectForm("Connect");
            }
        </div>
        await Task.CompletedTask;
    }

    private async Task RenderTelegramConnectForm(string buttonLabel)
    {
        <form method="post" asp-page-handler="ConnectTelegram" class="integration-form">
            <ol class="steps">
                <li>Open <strong>@@BotFather</strong> in Telegram.</li>
                <li>Send <code>/newbot</code> and follow the steps.</li>
                <li>Paste the token it gives you:</li>
            </ol>
            <div class="flex gap-2">
                <input type="password" name="BotToken" class="text-input flex-1" autocomplete="off" spellcheck="false"
                       placeholder="123456789:AA…" required aria-label="Bot token" />
                <button type="submit" class="btn btn-primary btn-sm">@buttonLabel</button>
            </div>
            <div class="cell-sub">We check the token and set everything up. It's never shown again.</div>
        </form>
        await Task.CompletedTask;
    }

    private async Task RenderManualForm(string channel, PlasticSurgery.Dtos.ChannelIntegrationResponse? info, bool connected)
    {
        var tokenOnFile = info is not null && info.HasAccessToken;
        <form method="post" asp-page-handler="Save" class="integration-form">
            <input type="hidden" name="Channel" value="@channel" />

            <div class="form-row-even">
                <label class="field">
                    <span>Display name</span>
                    <input type="text" name="DisplayName" value="@(info?.DisplayName)" placeholder="e.g. Clinic front desk" class="text-input" />
                </label>

                @if (channel == ChannelType.WhatsApp)
                {
                    <label class="field">
                        <span>Phone number ID</span>
                        <input type="text" name="PhoneNumberId" value="@(info?.PhoneNumberId)" class="text-input" />
                        <small class="text-subtle">Meta app → WhatsApp → API Setup</small>
                    </label>
                    <label class="field">
                        <span>WhatsApp Business Account ID</span>
                        <input type="text" name="WhatsAppBusinessId" value="@(info?.WhatsAppBusinessId)" class="text-input" />
                        <small class="text-subtle">Same page, under the phone number</small>
                    </label>
                    <label class="field">
                        <span>Webhook verify token</span>
                        <input type="text" name="WebhookVerifyToken"
                               placeholder="@(info?.HasWebhookVerifyToken == true ? "•••••••• (leave blank to keep)" : "Any word you choose")"
                               class="text-input" />
                        <small class="text-subtle">Type the same word in Meta's webhook settings</small>
                    </label>
                }
                else if (channel == ChannelType.Instagram)
                {
                    <label class="field">
                        <span>Instagram Business Account ID</span>
                        <input type="text" name="InstagramBusinessId" value="@(info?.InstagramBusinessId)" class="text-input" />
                        <small class="text-subtle">Meta Business Suite → Settings → Instagram accounts</small>
                    </label>
                    <label class="field">
                        <span>Linked Facebook Page ID</span>
                        <input type="text" name="PageId" value="@(info?.PageId)" class="text-input" />
                        <small class="text-subtle">Your Facebook page → About → Page transparency</small>
                    </label>
                }
                else if (channel == ChannelType.Facebook)
                {
                    <label class="field">
                        <span>Page ID</span>
                        <input type="text" name="PageId" value="@(info?.PageId)" class="text-input" />
                        <small class="text-subtle">Your Facebook page → About → Page transparency</small>
                    </label>
                }
            </div>

            <label class="field">
                <span>Access token</span>
                <input type="password" name="AccessToken"
                       placeholder="@(tokenOnFile ? "•••••••• (leave blank to keep)" : "Paste a permanent access token")"
                       class="text-input" autocomplete="off" />
                <small class="text-subtle">@(tokenOnFile ? "A token is saved. It's hidden for your security." : "Stored safely and never shown again.")</small>
            </label>

            <div class="flex items-center gap-2">
                <button type="submit" class="btn btn-sm @(connected ? "" : "btn-primary")">@(connected ? "Save changes" : "Connect")</button>
            </div>
        </form>
        await Task.CompletedTask;
    }
}
