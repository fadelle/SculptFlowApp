@page "/dashboard/appointments/{id:guid}"
@model PlasticSurgery.Pages.Dashboard.AppointmentDetailModel
@{
    ViewData["Title"] = "Appointment";
}

@if (!Model.ClinicConfigured)
{
    <partial name="_NoClinic" />
}
else if (Model.Appointment is null)
{
    var missing = new EmptyStateModel(Icon: "event_busy", Title: "This appointment isn't in your calendar",
        ActionLabel: "Back to Appointments", ActionHref: "/dashboard/appointments", ActionIcon: "arrow_back");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="missing" /></div>
}
else
{
    var appt = Model.Appointment;

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/dashboard/appointments" aria-label="Back to Appointments" title="Back to Appointments">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <span class="avatar-md" aria-hidden="true">@(string.IsNullOrWhiteSpace(appt.LeadFullName) ? "?" : appt.LeadFullName.Trim()[..1])</span>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@(appt.LeadFullName ?? "—")</h2>
            <span class="au-back-header__sub">@(appt.ProcedureName ?? "No procedure on file") · @LocalTimeHelper.Time(appt.ScheduledStart, "datetime-year", clinicTimeZone: Model.ClinicTimezone)</span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @StatusBadgeHelper.CssClass(appt.Status)">@FilterLabelHelper.Label(appt.Status)</span>
        <a class="au-btn au-btn--outlined au-btn--sm" href="/dashboard/leads/@appt.LeadId"><span class="au-icon" aria-hidden="true">person</span>Open patient</a>
        <partial name="_TimeViewSwitch" model="Model.ClinicTimezone" />
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <section class="au-panel au-panel--round au-panel--pad mw-480" aria-labelledby="appt-update-title">
        <div class="au-panel__head"><h3 class="au-panel__title" id="appt-update-title">Update this appointment</h3></div>
        <form method="post">
            <div class="au-form-field">
                <label class="au-form-label" for="appt-status">Status</label>
                <select name="Status" id="appt-status" class="au-select">
                    @foreach (var s in Model.StatusOptions)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@FilterLabelHelper.Label(s)</option>
                    }
                </select>
            </div>
            <div class="au-form-actions">
                <a href="/dashboard/appointments" class="au-btn au-btn--text">Back to the calendar</a>
                <button type="submit" class="au-btn au-btn--primary">Save changes</button>
            </div>
        </form>
    </section>
}
