@page "/dashboard/appointments/{id:guid}"
@using PlasticSurgery.Pages.Shared
@model PlasticSurgery.Pages.Dashboard.AppointmentDetailModel
@{
    ViewData["Title"] = "Appointment";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else if (Model.Appointment is null)
{
    <div class="alert alert-warning">Appointment not found.</div>
}
else
{
    if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info mb-3">@Model.StatusMessage</div>
    }
    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
    }

    <div class="card profile-header mb-3">
        <span class="avatar-md">@(string.IsNullOrWhiteSpace(Model.Appointment.LeadFullName) ? "?" : Model.Appointment.LeadFullName.Trim()[..1])</span>
        <div class="profile-header-main">
            <div class="profile-header-name"><a href="/dashboard/leads/@Model.Appointment.LeadId">@(Model.Appointment.LeadFullName ?? "—")</a></div>
            <div class="text-muted text-md">
                @(Model.Appointment.ProcedureName ?? "No procedure on file") &middot; @LocalTimeHelper.Time(Model.Appointment.ScheduledStart, "datetime-year", clinicTimeZone: Model.ClinicTimezone)
            </div>
            <div class="mt-2"><partial name="_TimeViewSwitch" model="Model.ClinicTimezone" /></div>
        </div>
        <span class="badge @StatusBadgeHelper.CssClass(Model.Appointment.Status)">@FilterLabelHelper.Label(Model.Appointment.Status)</span>
    </div>

    <div class="card p-5 mw-480">
        <form method="post" class="integration-form">
            <label class="field">
                <span>Appointment status</span>
                <select name="Status" class="select">
                    @foreach (var s in Model.StatusOptions)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@FilterLabelHelper.Label(s)</option>
                    }
                </select>
            </label>

            <div class="flex items-center gap-2 mt-2">
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                <a href="/dashboard/appointments" class="btn btn-sm">Back to list</a>
            </div>
        </form>
    </div>
}
