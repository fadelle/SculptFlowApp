@page "/dashboard"
@model PlasticSurgery.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts

    // Presentation only: "36% of interested people" under a funnel card ("—" when there's nothing to compare to).
    static string Rate(int part, int whole) => whole > 0 ? $"{Math.Round(part * 100.0 / whole)}%" : "—";
}

@if (!Model.ClinicConfigured)
{
    <div class="au-alert au-alert--warning" role="status">
        <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
        <div class="au-alert__body">
            <div class="au-alert__title">Your account isn't linked to a clinic yet</div>
            New accounts get their own clinic when they register. If you signed up before that, ask SculptFlow support to
            link your account to your clinic.
        </div>
    </div>
}
else
{
    var s = Model.Summary!;
    var attention = Model.Attention!;
    var custom = Model.Period == "custom";

    var whatsAppLevel = Model.WhatsAppHealth?.HealthLevel ?? "unknown";
    var whatsAppDotClass = whatsAppLevel switch
    {
        "healthy" => "badge-green",
        "warning" => "badge-amber",
        "problem" => "badge-red",
        "disconnected" => "badge-gray",
        _ => "badge-gray"
    };
    var whatsAppLabel = Model.WhatsAppHealth is null ? "Not connected"
        : whatsAppLevel == "healthy" ? "Healthy" : "Attention Required";

    <div class="au-page-head">
        <p class="au-page-head__sub">@Model.ClinicName: what needs you, and how this period is going.</p>
        <div class="au-page-head__actions">
            <form method="get" class="period-form" id="period-form">
                <select name="Period" class="select" id="period-select" aria-label="Period">
                    @foreach (var (value, label) in PlasticSurgery.Pages.Dashboard.IndexModel.Periods)
                    {
                        <option value="@value" selected="@(value == Model.Period)">@label</option>
                    }
                </select>
                <span class="period-custom" id="period-custom" hidden="@(!custom)">
                    <input type="date" name="From" class="text-input" value="@Model.From?.ToString("yyyy-MM-dd")" aria-label="From" />
                    <span class="text-subtle">–</span>
                    <input type="date" name="To" class="text-input" value="@Model.To?.ToString("yyyy-MM-dd")" aria-label="To" />
                    <button type="submit" class="au-btn au-btn--outlined">Apply</button>
                </span>
            </form>
            <a href="/WhatsApp/Health" class="health-pill" title="WhatsApp connection health">
                <span id="dashboard-whatsapp-health-dot" class="health-dot @whatsAppDotClass"></span>
                <span class="text-muted">WhatsApp</span>
                <span id="dashboard-whatsapp-health-label">@whatsAppLabel</span>
            </a>
        </div>
    </div>

    <h2 class="section-title">Needs your attention</h2>
    @if (attention.ConversationsNeedingStaff + attention.OverdueFollowups + attention.AppointmentsNeedingOutcome == 0)
    {
        <div class="au-alert au-alert--success" role="status">
            <span class="au-icon au-alert__icon" aria-hidden="true">check_circle</span>
            <div class="au-alert__body">All clear: nothing is waiting on you.</div>
        </div>
    }
    else
    {
        <div class="au-grid au-grid--3">
            @if (attention.ConversationsNeedingStaff > 0)
            {
                <a class="au-action-card" href="/inbox?filter=needs">
                    <span class="au-icon-tile" style="--tile: var(--au-warning)"><span class="au-icon" aria-hidden="true">forum</span></span>
                    <span><span class="au-action-card__title">@attention.ConversationsNeedingStaff @(attention.ConversationsNeedingStaff == 1 ? "conversation is" : "conversations are") waiting for you</span>
                        <span class="au-action-card__text">Reply in the Inbox.</span></span>
                    <span class="au-icon au-action-card__arrow" aria-hidden="true">arrow_forward</span>
                </a>
            }
            @if (attention.OverdueFollowups > 0)
            {
                <a class="au-action-card" href="/dashboard/leads">
                    <span class="au-icon-tile" style="--tile: var(--au-warning)"><span class="au-icon" aria-hidden="true">schedule</span></span>
                    <span><span class="au-action-card__title">@attention.OverdueFollowups overdue @(attention.OverdueFollowups == 1 ? "follow-up" : "follow-ups")</span>
                        <span class="au-action-card__text">Get back to these people.</span></span>
                    <span class="au-icon au-action-card__arrow" aria-hidden="true">arrow_forward</span>
                </a>
            }
            @if (attention.AppointmentsNeedingOutcome > 0)
            {
                <a class="au-action-card" href="/dashboard/appointments">
                    <span class="au-icon-tile" style="--tile: var(--au-warning)"><span class="au-icon" aria-hidden="true">event_note</span></span>
                    <span><span class="au-action-card__title">@attention.AppointmentsNeedingOutcome past @(attention.AppointmentsNeedingOutcome == 1 ? "appointment needs" : "appointments need") an outcome</span>
                        <span class="au-action-card__text">Mark them attended, no-show or canceled.</span></span>
                    <span class="au-icon au-action-card__arrow" aria-hidden="true">arrow_forward</span>
                </a>
            }
        </div>
    }

    <h2 class="section-title">Patient funnel <span class="section-title__sub">@Model.RangeLabel</span></h2>
    <div class="au-grid au-grid--4">
        <div class="au-stat stat-accent">
            <span class="au-eyebrow">Interested people</span>
            <div class="au-stat__value">@s.NewInterestedPeople</div>
            <span class="au-stat__hint">New in this period</span>
        </div>
        <div class="au-stat">
            <span class="au-eyebrow">Consultations booked</span>
            <div class="au-stat__value">@s.ConsultationsBooked</div>
            <span class="au-stat__hint">@Rate(s.ConsultationsBooked, s.NewInterestedPeople) of interested people</span>
        </div>
        <div class="au-stat">
            <span class="au-eyebrow">Consultations attended</span>
            <div class="au-stat__value">@s.ConsultationsAttended</div>
            <span class="au-stat__hint">@Rate(s.ConsultationsAttended, s.ConsultationsBooked) of booked</span>
        </div>
        <div class="au-stat">
            <span class="au-eyebrow">Surgeries booked</span>
            <div class="au-stat__value">@s.SurgeriesBooked</div>
            <span class="au-stat__hint">@Rate(s.SurgeriesBooked, s.ConsultationsAttended) of attended</span>
        </div>
    </div>

    <h2 class="section-title">Results</h2>
    <div class="au-grid au-grid--4">
        <div class="au-stat">
            <span class="au-eyebrow">Revenue from completed surgeries</span>
            <div class="au-stat__value">@UiTextHelper.Amount(s.Revenue)</div>
            <span class="au-stat__hint">In this period</span>
        </div>
    </div>

    <h2 class="section-title">By procedure</h2>
    <div class="au-table-card">
        @if (Model.Procedures.Count == 0)
        {
            var empty = new EmptyStateModel(Icon: "medical_services", Title: "No procedures yet",
                Text: "Add the procedures your clinic offers to see interest and bookings for each one.",
                ActionLabel: "Add a procedure", ActionHref: "/Procedures/Edit");
            <partial name="_EmptyState" model="empty" />
        }
        else
        {
            <div class="au-table-scroll">
                <table class="au-table au-table--stack">
                    <thead>
                        <tr><th>Procedure</th><th class="au-right">Interested</th><th class="au-right">Bookings</th><th class="au-right">Completed</th><th class="au-right">Revenue</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Procedures)
                        {
                            <tr>
                                <td data-label="Procedure"><strong>@p.ProcedureName</strong></td>
                                <td data-label="Interested" class="au-right">@p.LeadCount</td>
                                <td data-label="Bookings" class="au-right">@p.BookingCount</td>
                                <td data-label="Completed" class="au-right">@p.CompletedCount</td>
                                <td data-label="Revenue" class="au-right">@UiTextHelper.Amount(p.CompletedRevenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <h2 class="section-title">Jump to</h2>
    <div class="au-grid au-grid--3">
        <a class="au-action-card" href="/inbox">
            <span class="au-icon-tile"><span class="au-icon" aria-hidden="true">chat</span></span>
            <span><span class="au-action-card__title">Inbox</span><span class="au-action-card__text">Reply to patients.</span></span>
            <span class="au-icon au-action-card__arrow" aria-hidden="true">arrow_forward</span>
        </a>
        <a class="au-action-card" href="/dashboard/leads">
            <span class="au-icon-tile"><span class="au-icon" aria-hidden="true">group</span></span>
            <span><span class="au-action-card__title">Interested People</span><span class="au-action-card__text">Every lead and their status.</span></span>
            <span class="au-icon au-action-card__arrow" aria-hidden="true">arrow_forward</span>
        </a>
        <a class="au-action-card" href="/dashboard/appointments">
            <span class="au-icon-tile"><span class="au-icon" aria-hidden="true">calendar_month</span></span>
            <span><span class="au-action-card__title">Appointments</span><span class="au-action-card__text">Consultations and surgeries.</span></span>
            <span class="au-icon au-action-card__arrow" aria-hidden="true">arrow_forward</span>
        </a>
    </div>

    <script>
        // Period dropdown: presets apply immediately; "Custom range…" reveals the two dates + Apply.
        (function () {
            var form = document.getElementById('period-form');
            var select = document.getElementById('period-select');
            var custom = document.getElementById('period-custom');
            select.addEventListener('change', function () {
                var isCustom = select.value === 'custom';
                custom.hidden = !isCustom;
                if (!isCustom) {
                    custom.querySelectorAll('input').forEach(function (i) { i.disabled = true; }); // keep the URL clean
                    form.submit();
                }
            });
        })();
    </script>

    <script>
        window.PS_DASHBOARD_CONFIG = {
            clinicId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClinicId.ToString())),
            hubUrl: '/hubs/inbox'
        };
    </script>
    <script src="~/js/whatsapp-health.js" asp-append-version="true"></script>
}
