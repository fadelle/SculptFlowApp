@page "/dashboard"
@model PlasticSurgery.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";

    // Presentation only: "36% of interested people" under a funnel card ("—" when there's nothing to compare to).
    static string Rate(int part, int whole) => whole > 0 ? $"{Math.Round(part * 100.0 / whole)}%" : "—";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">
        Your account isn't linked to a clinic yet. New accounts get their own clinic when they register;
        an account created before that change may need a <code>clinic_users</code> row pointing at its clinic.
    </div>
}
else
{
    var s = Model.Summary!;
    var attention = Model.Attention!;
    var custom = Model.Period == "custom";

    var whatsAppLevel = Model.WhatsAppHealth?.HealthLevel ?? "unknown";
    var whatsAppDotClass = whatsAppLevel switch
    {
        "healthy" => "badge-green",
        "warning" => "badge-amber",
        "problem" => "badge-red",
        "disconnected" => "badge-gray",
        _ => "badge-gray"
    };
    var whatsAppLabel = Model.WhatsAppHealth is null ? "Not connected"
        : whatsAppLevel == "healthy" ? "Healthy" : "Attention Required";

    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <p class="text-muted m-0">@Model.ClinicName</p>
        <div class="flex items-center gap-2 flex-wrap">
            <form method="get" class="period-form" id="period-form">
                <select name="Period" class="select" id="period-select" aria-label="Period">
                    @foreach (var (value, label) in PlasticSurgery.Pages.Dashboard.IndexModel.Periods)
                    {
                        <option value="@value" selected="@(value == Model.Period)">@label</option>
                    }
                </select>
                <span class="period-custom" id="period-custom" hidden="@(!custom)">
                    <input type="date" name="From" class="text-input" value="@Model.From?.ToString("yyyy-MM-dd")" aria-label="From" />
                    <span class="text-subtle">–</span>
                    <input type="date" name="To" class="text-input" value="@Model.To?.ToString("yyyy-MM-dd")" aria-label="To" />
                    <button type="submit" class="btn btn-sm">Apply</button>
                </span>
            </form>
            <a href="/WhatsApp/Health" class="health-pill">
                <span id="dashboard-whatsapp-health-dot" class="health-dot @whatsAppDotClass"></span>
                <span class="text-muted">WhatsApp</span>
                <span id="dashboard-whatsapp-health-label">@whatsAppLabel</span>
            </a>
        </div>
    </div>

    <div class="section-heading mt-0"><h2>Needs attention</h2></div>
    @if (attention.ConversationsNeedingStaff + attention.OverdueFollowups + attention.AppointmentsNeedingOutcome == 0)
    {
        <div class="attn-clear">All clear: nothing is waiting on you.</div>
    }
    else
    {
        <div class="attn-row">
            @if (attention.ConversationsNeedingStaff > 0)
            {
                <a class="attn" href="/inbox?filter=needs">
                    <span class="attn-num">@attention.ConversationsNeedingStaff</span>
                    <span>@(attention.ConversationsNeedingStaff == 1 ? "conversation waiting for you" : "conversations waiting for you")</span>
                    <span class="arrow">&rarr;</span>
                </a>
            }
            @if (attention.OverdueFollowups > 0)
            {
                <a class="attn" href="/dashboard/leads">
                    <span class="attn-num">@attention.OverdueFollowups</span>
                    <span>@(attention.OverdueFollowups == 1 ? "overdue follow-up" : "overdue follow-ups")</span>
                    <span class="arrow">&rarr;</span>
                </a>
            }
            @if (attention.AppointmentsNeedingOutcome > 0)
            {
                <a class="attn" href="/dashboard/appointments">
                    <span class="attn-num">@attention.AppointmentsNeedingOutcome</span>
                    <span>@(attention.AppointmentsNeedingOutcome == 1 ? "past appointment without an outcome" : "past appointments without an outcome")</span>
                    <span class="arrow">&rarr;</span>
                </a>
            }
        </div>
    }

    <div class="section-heading"><h2>Patient funnel <span class="text-subtle text-sm fw-normal">· @Model.RangeLabel</span></h2></div>
    <div class="stat-grid">
        <div class="stat-card stat-card-accent">
            <div class="label">Interested people</div>
            <div class="value">@s.NewInterestedPeople</div>
        </div>
        <div class="stat-card">
            <div class="label">Consultations booked</div>
            <div class="value">@s.ConsultationsBooked</div>
            <div class="conv">@Rate(s.ConsultationsBooked, s.NewInterestedPeople) of interested people</div>
        </div>
        <div class="stat-card">
            <div class="label">Consultations attended</div>
            <div class="value">@s.ConsultationsAttended</div>
            <div class="conv">@Rate(s.ConsultationsAttended, s.ConsultationsBooked) of booked</div>
        </div>
        <div class="stat-card">
            <div class="label">Surgeries booked</div>
            <div class="value">@s.SurgeriesBooked</div>
            <div class="conv">@Rate(s.SurgeriesBooked, s.ConsultationsAttended) of attended</div>
        </div>
    </div>

    <div class="section-heading"><h2>Results</h2></div>
    <div class="stat-grid">
        <div class="stat-card">
            <div class="label">Revenue (completed surgeries)</div>
            <div class="value">@s.Revenue.ToString("C0")</div>
        </div>
    </div>

    <div class="section-heading"><h2>By procedure</h2></div>
    <div class="table-card table-scroll">
        <table class="data-table">
            <thead>
                <tr><th>Procedure</th><th>Interested</th><th>Bookings</th><th>Completed</th><th>Revenue</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Procedures)
                {
                    <tr>
                        <td><strong>@p.ProcedureName</strong></td>
                        <td>@p.LeadCount</td>
                        <td>@p.BookingCount</td>
                        <td>@p.CompletedCount</td>
                        <td>@p.CompletedRevenue.ToString("C0")</td>
                    </tr>
                }
                @if (Model.Procedures.Count == 0)
                {
                    <tr class="empty-row"><td colspan="5">No procedures set up yet. <a class="link" href="/Procedures">Add one</a></td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="section-heading"><h2>Jump to</h2></div>
    <div class="quick-links">
        <a class="quick-link" href="/inbox">
            <span class="quick-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
            <div><strong>Inbox</strong><span>Reply to patients</span></div>
            <span class="arrow">&rarr;</span>
        </a>
        <a class="quick-link" href="/dashboard/leads">
            <span class="quick-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
            <div><strong>Interested People</strong><span>Every lead and their status</span></div>
            <span class="arrow">&rarr;</span>
        </a>
        <a class="quick-link" href="/dashboard/appointments">
            <span class="quick-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
            <div><strong>Appointments</strong><span>Consultations and surgeries</span></div>
            <span class="arrow">&rarr;</span>
        </a>
    </div>

    <script>
        // Period dropdown: presets apply immediately; "Custom range…" reveals the two dates + Apply.
        (function () {
            var form = document.getElementById('period-form');
            var select = document.getElementById('period-select');
            var custom = document.getElementById('period-custom');
            select.addEventListener('change', function () {
                var isCustom = select.value === 'custom';
                custom.hidden = !isCustom;
                if (!isCustom) {
                    custom.querySelectorAll('input').forEach(function (i) { i.disabled = true; }); // keep the URL clean
                    form.submit();
                }
            });
        })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        window.PS_DASHBOARD_CONFIG = {
            clinicId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClinicId.ToString())),
            hubUrl: '/hubs/inbox'
        };
    </script>
    <script src="~/js/whatsapp-health.js" asp-append-version="true"></script>
}
