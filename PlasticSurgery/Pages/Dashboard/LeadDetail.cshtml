@page "/dashboard/leads/{id:guid}"
@model PlasticSurgery.Pages.Dashboard.LeadDetailModel
@{
    ViewData["Title"] = "Lead";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else if (Model.Lead is null)
{
    <div class="alert alert-warning">Lead not found.</div>
}
else
{
    var lead = Model.Lead;
    var followupOverdue = lead.NextFollowupAt is not null && lead.NextFollowupAt < DateTimeOffset.UtcNow;
    // Inbox search matches name, phone or procedure — the phone is the most specific.
    var inboxSearch = !string.IsNullOrWhiteSpace(lead.Phone) ? lead.Phone : lead.FullName;

    <a href="/dashboard/leads" class="back-link mb-2">&larr; Interested People</a>

    if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info mb-3">@Model.StatusMessage</div>
    }
    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
    }

    <div class="card profile-header mb-3">
        <span class="avatar-md">@(string.IsNullOrWhiteSpace(Model.Lead.FullName) ? "?" : Model.Lead.FullName.Trim()[..1])</span>
        <div class="profile-header-main">
            <div class="profile-header-name">@(Model.Lead.FullName ?? "—")</div>
            <div class="text-muted text-md">
                @(Model.Lead.Phone ?? "—") &middot; @(Model.Lead.ProcedureName ?? "No procedure on file")
            </div>
        </div>
        <div class="flex items-center gap-1 flex-wrap">
            <span class="badge @StatusBadgeHelper.CssClass(Model.Lead.Status)">@FilterLabelHelper.Label(Model.Lead.Status)</span>
            <span class="badge @StatusBadgeHelper.CssClass(Model.Lead.QualificationStatus)">@FilterLabelHelper.Label(Model.Lead.QualificationStatus)</span>
            @if (!string.IsNullOrWhiteSpace(inboxSearch))
            {
                <a class="btn btn-sm" href="/inbox?search=@Uri.EscapeDataString(inboxSearch)">Open in Inbox</a>
            }
        </div>
    </div>

    <div class="lead-grid">
    <div class="card p-5">
        <div class="eyebrow mb-2">Details</div>
        <div class="inbox-lead-info-row"><span>Phone</span><strong>@(lead.Phone ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Email</span><strong>@(lead.Email ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Procedure</span><strong>@(lead.ProcedureName ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>City</span><strong>@(lead.City ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Timeline</span><strong>@(lead.DesiredTimeline ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Last contact</span><strong>@LocalTimeHelper.Time(lead.LastContactAt)</strong></div>
        <div class="inbox-lead-info-row"><span>Next follow-up</span><strong class="@(followupOverdue ? "overdue" : "")">@LocalTimeHelper.Time(lead.NextFollowupAt)@(followupOverdue ? " · overdue" : "")</strong></div>
        <div class="inbox-lead-info-row"><span>Lead since</span><strong>@LocalTimeHelper.Time(lead.CreatedAt, "date")</strong></div>
        @if (!string.IsNullOrWhiteSpace(lead.Notes))
        {
            <div class="lead-notes">
                <span class="eyebrow">Notes</span>
                <p>@lead.Notes</p>
            </div>
        }
    </div>

    <div class="card p-5">
        <div class="flex items-center gap-2 mb-2">
            <span class="eyebrow">Update lead</span>
            <button type="button" class="status-help-trigger" data-status-help-trigger title="What do these mean?">?</button>
        </div>
        <form method="post" class="integration-form">
            <label class="field">
                <span>Lead status</span>
                <select name="Status" class="select">
                    @foreach (var s in Model.StatusOptions)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@FilterLabelHelper.Label(s)</option>
                    }
                </select>
            </label>

            <label class="field">
                <span>Qualification status</span>
                <select name="QualificationStatus" class="select">
                    @foreach (var s in Model.QualificationOptions)
                    {
                        <option value="@s" selected="@(s == Model.QualificationStatus)">@FilterLabelHelper.Label(s)</option>
                    }
                </select>
            </label>

            <label class="field">
                <span>Lead source</span>
                <select name="SourceChoice" id="source-choice" class="select" onchange="document.getElementById('custom-source-field').style.display = this.value === 'other' ? '' : 'none';">
                    @foreach (var s in Model.SourceOptions)
                    {
                        <option value="@s" selected="@(s == Model.SourceChoice)">@s</option>
                    }
                    <option value="other" selected="@(Model.SourceChoice == "other")">Other…</option>
                </select>
            </label>

            <label class="field" id="custom-source-field" style="display:@(Model.SourceChoice == "other" ? "" : "none")">
                <span>Custom source</span>
                <input type="text" name="CustomSource" value="@Model.CustomSource" class="text-input" placeholder="e.g. trade show" />
            </label>

            <div class="flex items-center gap-2 mt-2">
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </div>
        </form>
    </div>
    </div>

    <partial name="_StatusHelp" />
    <script src="~/js/status-help.js" asp-append-version="true"></script>
}
