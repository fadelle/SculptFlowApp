@page "/dashboard/leads/{id:guid}"
@model PlasticSurgery.Pages.Dashboard.LeadDetailModel
@{
    ViewData["Title"] = "Lead";
}

@if (!Model.ClinicConfigured)
{
    <partial name="_NoClinic" />
}
else if (Model.Lead is null)
{
    var missing = new EmptyStateModel(Icon: "person_off", Title: "This person isn't in your list",
        ActionLabel: "Back to Interested People", ActionHref: "/dashboard/leads", ActionIcon: "arrow_back");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="missing" /></div>
}
else
{
    var lead = Model.Lead;
    var followupOverdue = lead.NextFollowupAt is not null && lead.NextFollowupAt < DateTimeOffset.UtcNow;
    // Inbox search matches name, phone or procedure — the phone is the most specific.
    var inboxSearch = !string.IsNullOrWhiteSpace(lead.Phone) ? lead.Phone : lead.FullName;

    <div class="au-back-header">
        <a class="au-icon-btn au-icon-btn--bordered" href="/dashboard/leads" aria-label="Back to Interested People" title="Back to Interested People">
            <span class="au-icon" aria-hidden="true">arrow_back</span>
        </a>
        <span class="avatar-md" aria-hidden="true">@(string.IsNullOrWhiteSpace(lead.FullName) ? "?" : lead.FullName.Trim()[..1])</span>
        <div class="min-w-0">
            <h2 class="au-back-header__title">@(lead.FullName ?? "—")</h2>
            <span class="au-back-header__sub">@(lead.Phone ?? "No phone") · @(lead.ProcedureName ?? "No procedure on file")</span>
        </div>
    </div>
    <div class="detail-chips">
        <span class="badge @StatusBadgeHelper.CssClass(lead.Status)">@FilterLabelHelper.Label(lead.Status)</span>
        <span class="badge @StatusBadgeHelper.CssClass(lead.QualificationStatus)">@FilterLabelHelper.Label(lead.QualificationStatus)</span>
        @if (!string.IsNullOrWhiteSpace(inboxSearch))
        {
            <a class="au-btn au-btn--outlined au-btn--sm" href="/inbox?search=@Uri.EscapeDataString(inboxSearch)"><span class="au-icon" aria-hidden="true">chat</span>Open in Inbox</a>
        }
    </div>

    <partial name="_Messages" model="new PageMessagesModel(Model.StatusMessage, Model.ErrorMessage)" />

    <div class="lead-grid">
        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="lead-details-title">
            <div class="au-panel__head"><h3 class="au-panel__title" id="lead-details-title">Details</h3></div>
            <dl class="au-detail-rows">
                <div class="au-detail-row"><dt>Phone</dt><dd>@(lead.Phone ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Email</dt><dd>@(lead.Email ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Procedure</dt><dd>@(lead.ProcedureName ?? "—")</dd></div>
                <div class="au-detail-row"><dt>City</dt><dd>@(lead.City ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Timeline</dt><dd>@(lead.DesiredTimeline ?? "—")</dd></div>
                <div class="au-detail-row"><dt>Last contact</dt><dd>@LocalTimeHelper.Time(lead.LastContactAt)</dd></div>
                <div class="au-detail-row"><dt>Next follow-up</dt><dd class="@(followupOverdue ? "overdue" : "")">@LocalTimeHelper.Time(lead.NextFollowupAt)@(followupOverdue ? " · overdue" : "")</dd></div>
                <div class="au-detail-row"><dt>Lead since</dt><dd>@LocalTimeHelper.Time(lead.CreatedAt, "date")</dd></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(lead.Notes))
            {
                <div class="lead-notes">
                    <span class="au-eyebrow">Notes</span>
                    <p>@lead.Notes</p>
                </div>
            }
        </section>

        <section class="au-panel au-panel--round au-panel--pad" aria-labelledby="lead-update-title">
            <div class="au-panel__head">
                <h3 class="au-panel__title" id="lead-update-title">Update this person</h3>
                <button type="button" class="status-help-trigger" data-status-help-trigger title="What do these mean?" aria-label="What do these statuses mean?">?</button>
            </div>
            <form method="post" class="au-stack">
                <div class="au-form-field">
                    <label class="au-form-label" for="lead-status">Lead status</label>
                    <select name="Status" id="lead-status" class="au-select">
                        @foreach (var s in Model.StatusOptions)
                        {
                            <option value="@s" selected="@(s == Model.Status)">@FilterLabelHelper.Label(s)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="lead-qualification">Qualification</label>
                    <select name="QualificationStatus" id="lead-qualification" class="au-select">
                        @foreach (var s in Model.QualificationOptions)
                        {
                            <option value="@s" selected="@(s == Model.QualificationStatus)">@FilterLabelHelper.Label(s)</option>
                        }
                    </select>
                </div>

                <div class="au-form-field">
                    <label class="au-form-label" for="source-choice">Where they came from</label>
                    <select name="SourceChoice" id="source-choice" class="au-select" onchange="document.getElementById('custom-source-field').style.display = this.value === 'other' ? '' : 'none';">
                        @foreach (var s in Model.SourceOptions)
                        {
                            <option value="@s" selected="@(s == Model.SourceChoice)">@s</option>
                        }
                        <option value="other" selected="@(Model.SourceChoice == "other")">Other…</option>
                    </select>
                </div>

                <div class="au-form-field" id="custom-source-field" style="display:@(Model.SourceChoice == "other" ? "" : "none")">
                    <label class="au-form-label" for="custom-source">Other source</label>
                    <input type="text" name="CustomSource" id="custom-source" value="@Model.CustomSource" class="au-input" placeholder="e.g. trade show" />
                </div>

                <div class="au-form-actions">
                    <button type="submit" class="au-btn au-btn--primary">Save changes</button>
                </div>
            </form>
        </section>
    </div>

    <partial name="_StatusHelp" />
    <script src="~/js/status-help.js" asp-append-version="true"></script>
}
