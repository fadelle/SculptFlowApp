@page "/dashboard/appointments"
@model PlasticSurgery.Pages.Dashboard.AppointmentsModel
@{
    ViewData["Title"] = "Appointments";
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts
}

@if (!Model.ClinicConfigured)
{
    <partial name="_NoClinic" />
}
else
{
    @* Everything below is driven by wwwroot/js/appointments-calendar.js through the cal-* ids; only the static controls
       use kit classes. *@
    <div id="cal-message"></div>
    <div id="cal-outcome"></div>
    <div class="today-line" id="cal-today-line" hidden></div>

    <div class="cal-header">
        <div class="cal-nav">
            <button type="button" class="au-icon-btn au-icon-btn--bordered" id="cal-prev" title="Previous month" aria-label="Previous month"><span class="au-icon" aria-hidden="true">chevron_left</span></button>
            <div class="cal-title" id="cal-title" aria-live="polite">&nbsp;</div>
            <button type="button" class="au-icon-btn au-icon-btn--bordered" id="cal-next" title="Next month" aria-label="Next month"><span class="au-icon" aria-hidden="true">chevron_right</span></button>
            <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="cal-today">Today</button>
        </div>
        <div class="cal-header__actions">
            <partial name="_TimeViewSwitch" model="Model.ClinicTimezone" />
            <button type="button" class="au-btn au-btn--primary" id="cal-new"><span class="au-icon" aria-hidden="true">add</span>New appointment</button>
        </div>
    </div>

    <div class="cal-weekdays">
        <div class="cal-weekday">Sun</div><div class="cal-weekday">Mon</div><div class="cal-weekday">Tue</div>
        <div class="cal-weekday">Wed</div><div class="cal-weekday">Thu</div><div class="cal-weekday">Fri</div>
        <div class="cal-weekday">Sat</div>
    </div>
    <div class="cal-grid" id="cal-grid"></div>
    <div class="cal-agenda" id="cal-agenda"></div>

    <div class="cal-legend" aria-label="Status colours">
        <span class="legend-item"><i class="legend-swatch status-booked"></i>Booked</span>
        <span class="legend-item"><i class="legend-swatch status-confirmed"></i>Confirmed</span>
        <span class="legend-item"><i class="legend-swatch status-attended"></i>Attended</span>
        <span class="legend-item"><i class="legend-swatch status-no_show"></i>No-show</span>
        <span class="legend-item"><i class="legend-swatch status-canceled"></i>Canceled</span>
        <span class="legend-item"><i class="legend-swatch status-rescheduled"></i>Rescheduled</span>
    </div>

    @* ---------- Day drawer: every appointment for the clicked day ---------- *@
    <div class="cal-drawer-overlay" id="cal-drawer-overlay" hidden></div>
    <div class="cal-drawer" id="cal-drawer" role="dialog" aria-modal="true" aria-labelledby="cal-drawer-title" hidden>
        <div class="cal-drawer-header">
            <h3 class="cal-drawer-title" id="cal-drawer-title">&nbsp;</h3>
            <div class="flex items-center gap-2">
                <button type="button" class="au-btn au-btn--outlined au-btn--sm" id="cal-drawer-add"><span class="au-icon" aria-hidden="true">add</span>New</button>
                <button type="button" class="au-icon-btn" id="cal-drawer-close" aria-label="Close" title="Close"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
        </div>
        <div class="cal-drawer-body" id="cal-drawer-body"></div>
    </div>

    @* ---------- New appointment ---------- *@
    <div class="bm-overlay" id="cal-new-overlay" hidden>
        <div class="card cal-modal" role="dialog" aria-modal="true" aria-labelledby="cal-new-title">
            <div class="modal-head">
                <h3 id="cal-new-title" class="card-title">New appointment</h3>
                <button type="button" class="au-icon-btn" id="cal-new-close" aria-label="Close" title="Close"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            <div id="cal-new-error" class="connect-error modal-error" role="alert"></div>
            <div class="au-stack">
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-lead-search">Patient<span class="au-required">*</span></label>
                    <div class="picker" id="cal-new-lead-picker">
                        <input type="text" id="cal-new-lead-search" class="au-input search-input" placeholder="Search by name or phone…" autocomplete="off" />
                        <div class="picker-chip" id="cal-new-lead-chip" hidden>
                            <span class="avatar-sm" id="cal-new-lead-chip-avatar"></span>
                            <span class="picker-chip-label" id="cal-new-lead-chip-label"></span>
                            <button type="button" class="picker-chip-x" id="cal-new-lead-clear" aria-label="Change patient">&times;</button>
                        </div>
                        <div class="picker-results" id="cal-new-lead-results" role="listbox" hidden></div>
                    </div>
                    <input type="hidden" id="cal-new-lead-id" />
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-procedure">Procedure <span class="opt">optional</span></label>
                    <select id="cal-new-procedure" class="au-select"><option value="">Loading…</option></select>
                </div>
                <div class="au-form-grid cal-when">
                    <div class="au-form-field">
                        <label class="au-form-label" for="cal-new-date">Date<span class="au-required">*</span></label>
                        <input type="date" id="cal-new-date" class="au-input" required />
                    </div>
                    <div class="au-form-field">
                        <label class="au-form-label" for="cal-new-time">Time<span class="au-required">*</span></label>
                        <input type="time" id="cal-new-time" class="au-input" value="09:00" required />
                        <span class="au-help" id="cal-new-tz-hint"></span>
                    </div>
                    <div class="au-form-field au-span-2">
                        <label class="au-form-label" for="cal-new-duration">Length (minutes)</label>
                        <input type="number" id="cal-new-duration" class="au-input" value="30" min="5" max="1440" step="5" list="cal-duration-options" />
                        <datalist id="cal-duration-options">
                            <option value="15"></option><option value="30"></option><option value="45"></option><option value="60"></option>
                            <option value="90"></option><option value="120"></option><option value="180"></option><option value="240"></option>
                        </datalist>
                        <span class="au-help" id="cal-new-range"></span>
                    </div>
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-location">Where <span class="opt">optional</span></label>
                    <select id="cal-new-location" class="au-select">
                        <option value="">Not set</option>
                        <option value="in_person">In person</option>
                        <option value="video">Video call</option>
                        <option value="phone">Phone</option>
                    </select>
                </div>
                <div class="au-form-field">
                    <label class="au-form-label" for="cal-new-notes">Notes <span class="opt">optional</span></label>
                    <textarea id="cal-new-notes" class="au-textarea" rows="2"></textarea>
                </div>
                <div class="au-form-actions">
                    <button type="button" class="au-btn au-btn--text" id="cal-new-cancel">Cancel</button>
                    <button type="button" class="au-btn au-btn--primary" id="cal-new-save">Create appointment</button>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Appointment details (opens from a calendar chip or a day-panel row) ---------- *@
    <div class="bm-overlay" id="cal-appt-overlay" hidden>
        <div class="card cal-modal" role="dialog" aria-modal="true" aria-labelledby="cal-appt-name">
            <div class="modal-head">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="avatar-md" id="cal-appt-avatar"></span>
                    <div class="min-w-0">
                        <h3 id="cal-appt-name" class="card-title"></h3>
                        <div class="text-muted text-sm" id="cal-appt-when"></div>
                    </div>
                </div>
                <button type="button" class="au-icon-btn" id="cal-appt-close" aria-label="Close" title="Close"><span class="au-icon" aria-hidden="true">close</span></button>
            </div>
            <div id="cal-appt-error" class="connect-error modal-error" role="alert"></div>
            <div class="mb-2">
                <div class="inbox-lead-info-row"><span>Procedure</span><strong id="cal-appt-procedure">—</strong></div>
                <div class="inbox-lead-info-row"><span>Where</span><strong id="cal-appt-location">—</strong></div>
                <div class="inbox-lead-info-row" id="cal-appt-notes-row"><span>Notes</span><strong id="cal-appt-notes">—</strong></div>
            </div>
            <div class="au-form-field">
                <label class="au-form-label" for="cal-appt-status">Status</label>
                <select id="cal-appt-status" class="au-select">
                    <option value="booked">Booked</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="attended">Attended</option>
                    <option value="no_show">No-show</option>
                    <option value="canceled">Canceled</option>
                    <option value="rescheduled">Rescheduled</option>
                </select>
            </div>
            <div class="cal-appt-links">
                <a class="au-link" id="cal-appt-lead" href="#">Open patient</a>
                <a class="au-link" id="cal-appt-full" href="#">Open full page</a>
            </div>
            <div class="au-form-actions">
                <button type="button" class="au-btn au-btn--text" id="cal-appt-cancel">Cancel</button>
                <button type="button" class="au-btn au-btn--primary" id="cal-appt-save">Save</button>
            </div>
        </div>
    </div>

    <script src="~/js/appointments-calendar.js" asp-append-version="true"></script>
}
