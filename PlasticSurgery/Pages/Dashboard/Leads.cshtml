@page "/dashboard/leads"
@using PlasticSurgery.Pages.Shared
@model PlasticSurgery.Pages.Dashboard.LeadsModel
@{
    ViewData["Title"] = "Interested People";
    var now = DateTimeOffset.UtcNow;
    var filtered = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status) || !string.IsNullOrWhiteSpace(Model.Source);

    // Presentation only: which channel icon a free-text leads.source value gets (null = show the text).
    static string? SourceChannel(string? source)
    {
        var s = (source ?? "").ToLowerInvariant();
        if (s.Contains("whatsapp")) return "whatsapp";
        if (s.Contains("instagram")) return "instagram";
        if (s.Contains("facebook") || s.Contains("meta")) return "facebook";
        if (s.Contains("telegram")) return "telegram";
        if (s.Contains("google")) return "google";
        if (s.Contains("website") || s == "web") return "website";
        if (s.Contains("email")) return "email";
        if (s.Contains("sms")) return "sms";
        return null;
    }

    string PageLink(int p) =>
        $"/dashboard/leads?PageNumber={p}&Status={Uri.EscapeDataString(Model.Status ?? "")}&Source={Uri.EscapeDataString(Model.Source ?? "")}&Search={Uri.EscapeDataString(Model.Search ?? "")}";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Dashboard page for setup steps.</div>
}
else
{
    <form method="get" class="filter-bar" id="leads-filters">
        <input type="search" name="Search" value="@Model.Search" placeholder="Search by name or phone…" class="text-input search-input" aria-label="Search leads" autocomplete="off" />
        <select name="Status" class="select" aria-label="Status">
            <option value="">All statuses</option>
            @foreach (var status in Model.AllStatuses)
            {
                <option value="@status" selected="@(status == Model.Status)">@FilterLabelHelper.Label(status)</option>
            }
        </select>
        <select name="Source" class="select" aria-label="Source">
            <option value="">All sources</option>
            @foreach (var source in Model.AllSources)
            {
                <option value="@source" selected="@(string.Equals(source, Model.Source, StringComparison.OrdinalIgnoreCase))">@FilterLabelHelper.Label(source)</option>
            }
        </select>
    </form>

    <div id="leads-results">
        <div class="table-card table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Procedure</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Qualification</th>
                        <th>Last contact</th>
                        <th>Next follow-up</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in Model.Leads)
                    {
                        var channel = SourceChannel(lead.Source);
                        var overdue = lead.NextFollowupAt is not null && lead.NextFollowupAt < now;
                        <tr class="row-link" data-href="/dashboard/leads/@lead.Id">
                            <td><a class="cell-person" href="/dashboard/leads/@lead.Id"><span class="avatar-sm">@(string.IsNullOrWhiteSpace(lead.FullName) ? "?" : lead.FullName.Trim()[..1])</span>@(lead.FullName ?? "—")</a></td>
                            <td>@(lead.Phone ?? "—")</td>
                            <td>@(lead.ProcedureName ?? "—")</td>
                            <td>
                                @if (channel is null)
                                {
                                    @(string.IsNullOrWhiteSpace(lead.Source) ? "—" : FilterLabelHelper.Label(lead.Source))
                                }
                                else
                                {
                                    var svg = ChannelIconHelper.Svg(channel);
                                    <span class="source-icon" style="background:@(channel == "google" ? "#4285F4" : ChannelIconHelper.Hex(channel))" title="@FilterLabelHelper.Label(lead.Source)" aria-label="@FilterLabelHelper.Label(lead.Source)">
                                        @if (svg is not null) { @Html.Raw(svg) } else { @(channel == "google" ? "G" : ChannelIconHelper.Initials(channel)) }
                                    </span>
                                }
                            </td>
                            <td><span class="badge @StatusBadgeHelper.CssClass(lead.Status)">@FilterLabelHelper.Label(lead.Status)</span></td>
                            <td><span class="badge @StatusBadgeHelper.CssClass(lead.QualificationStatus)">@FilterLabelHelper.Label(lead.QualificationStatus)</span></td>
                            <td>@LocalTimeHelper.Time(lead.LastContactAt)</td>
                            <td>
                                @if (overdue)
                                {
                                    <span class="overdue" title="This follow-up date has passed">@LocalTimeHelper.Time(lead.NextFollowupAt) · overdue</span>
                                }
                                else
                                {
                                    @LocalTimeHelper.Time(lead.NextFollowupAt)
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Leads.Count == 0)
                    {
                        <tr class="empty-row">
                            <td colspan="8">
                                @if (filtered)
                                {
                                    @:No one matches these filters. <a class="link" href="/dashboard/leads">Clear filters</a>
                                }
                                else
                                {
                                    @:No interested people yet.
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer mt-2">
            <span class="count">@Model.TotalCount total lead(s)</span>
            @if (Model.TotalPages > 1)
            {
                <ul class="pagination">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="@(p == Model.PageNumber ? "active" : "")">
                            <a href="@PageLink(p)">@p</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <script src="~/js/leads.js" asp-append-version="true"></script>
}
