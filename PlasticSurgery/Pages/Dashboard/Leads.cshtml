@page "/dashboard/leads"
@using PlasticSurgery.Pages.Shared
@model PlasticSurgery.Pages.Dashboard.LeadsModel
@{
    ViewData["Title"] = "Interested People";
}

@if (!Model.ClinicConfigured)
{
    <div class="alert alert-warning">No clinic configured yet — see the Main Numbers page for setup steps.</div>
}
else
{
    <form method="get" class="mb-3 flex items-center gap-2">
        <input type="text" name="Search" value="@Model.Search" placeholder="Search by name or phone…" class="text-input" style="width:auto" />
        <select name="Status" class="select" onchange="this.form.submit()">
            <option value="">All statuses</option>
            @foreach (var status in Model.AllStatuses)
            {
                <option value="@status" selected="@(status == Model.Status)">@status</option>
            }
        </select>
        <button type="submit" class="btn btn-sm">Search</button>
    </form>

    <div class="table-card table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Procedure</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Qualification</th>
                    <th>Last contact</th>
                    <th>Next follow-up</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lead in Model.Leads)
                {
                    <tr>
                        <td><a href="/dashboard/leads/@lead.Id">@(lead.FullName ?? "—")</a></td>
                        <td>@(lead.Phone ?? "—")</td>
                        <td>@(lead.ProcedureName ?? "—")</td>
                        <td>@(lead.Source ?? "—")</td>
                        <td><span class="badge @StatusBadgeHelper.CssClass(lead.Status)">@lead.Status</span></td>
                        <td><span class="badge @StatusBadgeHelper.CssClass(lead.QualificationStatus)">@lead.QualificationStatus</span></td>
                        <td>@(lead.LastContactAt?.ToString("MMM d, HH:mm") ?? "—")</td>
                        <td>@(lead.NextFollowupAt?.ToString("MMM d, HH:mm") ?? "—")</td>
                        <td>@lead.CreatedAt.ToString("MMM d, HH:mm")</td>
                    </tr>
                }
                @if (Model.Leads.Count == 0)
                {
                    <tr class="empty-row"><td colspan="9">No leads match this filter.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <ul class="pagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="@(p == Model.PageNumber ? "active" : "")">
                    <a href="/dashboard/leads?PageNumber=@p&Status=@Model.Status&Search=@Uri.EscapeDataString(Model.Search ?? "")">@p</a>
                </li>
            }
        </ul>
    }

    <p class="text-subtle mt-2">@Model.TotalCount total lead(s).</p>
}
