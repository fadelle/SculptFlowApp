@page "/Account/Register"
@model PlasticSurgery.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create your clinic account";
    Layout = "_AuthLayout";
    var loginUrl = "/Account/Login" + (string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl));
    // Identity reports a used email as "... is already taken." — offer to sign in instead.
    var emailTaken = Model.ErrorMessage?.Contains("already taken", StringComparison.OrdinalIgnoreCase) == true;
}
@* auth.js reads [data-auth-form], [data-busy-label], [data-pw*] and [data-caps]; it rewrites the class of [data-pw-rule] and
   [data-pw-match], so those keep plain classes. *@
<div class="au-auth__card auth-card-wide">
    <div class="au-auth__brand">
        <span class="au-brand__mark"><img class="auth-logo" src="~/logo.svg" alt="" width="56" height="56" /></span>
        <div>
            <h1 class="au-auth__title">Create your clinic account</h1>
            <p class="au-auth__sub">Takes a minute. You'll set up your own clinic workspace.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="au-alert au-alert--error" role="alert">
            <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
            <div class="au-alert__body">
                @if (emailTaken)
                {
                    <text>An account with this email already exists. <a class="au-link" href="@loginUrl">Sign in instead</a>?</text>
                }
                else
                {
                    @Model.ErrorMessage
                }
            </div>
        </div>
    }

    <partial name="_GoogleButton" model="Model.ReturnUrl" />

    <form method="post" class="au-auth__form" data-auth-form data-au-no-busy>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-name">Your full name</label>
            <input type="text" name="FullName" id="reg-name" value="@Model.FullName" class="au-input" autocomplete="name" maxlength="200" required autofocus placeholder="Rana Khoury" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-email">Email</label>
            <input type="email" name="Email" id="reg-email" value="@Model.Email" class="au-input" autocomplete="username" required placeholder="you@yourclinic.com" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-clinic">Clinic name</label>
            <input type="text" name="ClinicName" id="reg-clinic" value="@Model.ClinicName" class="au-input" autocomplete="organization" maxlength="200" required
                   placeholder="e.g. Glow Aesthetic Clinic" />
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-password">Password</label>
            <span class="pw-wrap">
                <input type="password" name="Password" id="reg-password" class="au-input" autocomplete="new-password" required minlength="6" data-pw data-pw-new />
                <button type="button" class="pw-eye" data-pw-toggle aria-label="Show password" title="Show password">👁</button>
            </span>
            <small class="text-subtle" data-pw-rule>At least 6 characters</small>
        </div>
        <div class="au-form-field">
            <label class="au-form-label" for="reg-confirm">Confirm password</label>
            <span class="pw-wrap">
                <input type="password" name="ConfirmPassword" id="reg-confirm" class="au-input" autocomplete="new-password" required minlength="6" data-pw data-pw-confirm />
                <button type="button" class="pw-eye" data-pw-toggle aria-label="Show password" title="Show password">👁</button>
            </span>
            <small data-pw-match hidden></small>
        </div>
        <div class="caps-warn" data-caps hidden>⇪ Caps Lock is on</div>

        <button type="submit" class="au-btn au-btn--primary au-btn--lg au-btn--block" data-busy-label="Creating your account…">Create account</button>
    </form>

    <p class="au-auth__foot">Already have an account? <a class="au-link" href="@loginUrl">Sign in</a></p>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
