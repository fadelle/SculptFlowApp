@page "/Account/Register"
@model PlasticSurgery.Pages.Account.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - MySculptFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>try { var t = localStorage.getItem('sf-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) { }</script>
</head>
<body>
    <div class="auth-shell">
        <div class="card auth-card">
            <div class="auth-brand">
                <span class="mark">SF</span>
                <h1>MySculptFlow</h1>
            </div>
            <p class="auth-tagline">Create your clinic account</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
            }

            <form method="post" class="integration-form">
                <label class="field">
                    <span>Full name</span>
                    <input type="text" name="FullName" value="@Model.FullName" class="text-input" autocomplete="name" maxlength="200" required autofocus />
                </label>
                <label class="field">
                    <span>Clinic name</span>
                    <input type="text" name="ClinicName" value="@Model.ClinicName" class="text-input" autocomplete="organization" maxlength="200" required
                           placeholder="e.g. Glow Aesthetic Clinic" />
                </label>
                <label class="field">
                    <span>Email</span>
                    <input type="email" name="Email" value="@Model.Email" class="text-input" autocomplete="username" required />
                </label>
                <label class="field">
                    <span>Password</span>
                    <input type="password" name="Password" class="text-input" autocomplete="new-password" required minlength="6" />
                </label>
                <label class="field">
                    <span>Confirm password</span>
                    <input type="password" name="ConfirmPassword" class="text-input" autocomplete="new-password" required minlength="6" />
                </label>

                <button type="submit" class="btn btn-primary auth-submit">Create account</button>
            </form>

            <p class="text-subtle auth-footer mb-1">
                Creating an account sets up your own new clinic workspace.
            </p>
            <p class="text-subtle auth-footer">
                Already have an account? <a href="/Account/Login@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))">Sign in</a>
            </p>
        </div>
    </div>
</body>
</html>
