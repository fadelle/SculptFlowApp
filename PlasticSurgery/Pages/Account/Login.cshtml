@page "/Account/Login"
@model PlasticSurgery.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - MySculptFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>try { var t = localStorage.getItem('sf-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) { }</script>
</head>
<body>
    <div class="auth-shell">
        <div class="card auth-card">
            <div class="auth-brand">
                <span class="mark">SF</span>
                <h1>MySculptFlow</h1>
            </div>
            <p class="auth-tagline">Sign in to your clinic dashboard</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-warning mb-3">@Model.ErrorMessage</div>
            }

            <form method="post" class="integration-form">
                <label class="field">
                    <span>Email</span>
                    <input type="email" name="Email" value="@Model.Email" class="text-input" autocomplete="username" required autofocus />
                </label>
                <label class="field">
                    <span>Password</span>
                    <input type="password" name="Password" class="text-input" autocomplete="current-password" required />
                </label>

                <button type="submit" class="btn btn-primary auth-submit">Sign in</button>
            </form>

            <p class="text-subtle auth-footer">
                No account yet? <a href="/Account/Register@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))">Register</a>
            </p>
        </div>
    </div>
</body>
</html>
