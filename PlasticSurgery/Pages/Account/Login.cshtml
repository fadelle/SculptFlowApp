@page "/Account/Login"
@model PlasticSurgery.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - MySculptFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>try { var t = localStorage.getItem('sf-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) { }</script>
</head>
<body class="auth-body">
    <div class="auth-split">
        <partial name="_AuthSide" />
        <main class="auth-main">
            <div class="auth-form">
                <h1 class="auth-h">Welcome back</h1>
                <p class="text-muted mb-3">Sign in to your clinic.</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-error" role="alert"><span aria-hidden="true">!</span><div>@Model.ErrorMessage</div></div>
                }

                <form method="post" class="integration-form" data-auth-form>
                    <label class="field">
                        <span>Email</span>
                        <input type="email" name="Email" value="@Model.Email" class="text-input" autocomplete="username" placeholder="you@yourclinic.com" required autofocus="@string.IsNullOrEmpty(Model.Email)" />
                    </label>
                    <label class="field">
                        <span>Password</span>
                        <span class="pw-wrap">
                            <input type="password" name="Password" class="text-input" autocomplete="current-password" required data-pw autofocus="@(!string.IsNullOrEmpty(Model.Email))" />
                            <button type="button" class="pw-eye" data-pw-toggle aria-label="Show password" title="Show password">👁</button>
                        </span>
                    </label>
                    <div class="caps-warn" data-caps hidden>⇪ Caps Lock is on</div>

                    <button type="submit" class="btn btn-primary auth-submit" data-busy-label="Signing in…">Sign in</button>
                </form>

                <p class="text-subtle auth-footer-left">
                    New to MySculptFlow? <a href="/Account/Register@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : "?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))">Create a clinic account</a>
                </p>
            </div>
        </main>
    </div>
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
