@page "/Account/CompleteGoogleSignup"
@model PlasticSurgery.Pages.Account.CompleteGoogleSignupModel
@{
    ViewData["Title"] = "Finish signing up";
    Layout = "_AuthLayout";
}
<div class="au-auth__card">
    <div class="au-auth__brand">
        <span class="au-brand__mark"><img class="auth-logo" src="~/logo.svg" alt="" width="56" height="56" /></span>
        <div>
            <h1 class="au-auth__title">One last step</h1>
            <p class="au-auth__sub">Name your clinic and you're in. This creates your own clinic workspace.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="au-alert au-alert--error" role="alert">
            <span class="au-icon au-alert__icon" aria-hidden="true">error</span>
            <div class="au-alert__body">@Model.ErrorMessage</div>
        </div>
    }

    <div class="auth-identity">
        Signing up with Google as
        <strong>@(string.IsNullOrWhiteSpace(Model.FullName) ? Model.Email : Model.FullName)</strong>
        @if (!string.IsNullOrWhiteSpace(Model.FullName)) { <span class="text-subtle"> · @Model.Email</span> }
    </div>

    @* auth.js reads [data-auth-form] and [data-busy-label]. *@
    <form method="post" class="au-auth__form" data-auth-form data-au-no-busy>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="au-form-field">
            <label class="au-form-label" for="google-clinic">Clinic name</label>
            <input type="text" name="ClinicName" id="google-clinic" value="@Model.ClinicName" class="au-input" autocomplete="organization" maxlength="200" required autofocus
                   placeholder="e.g. Glow Aesthetic Clinic" />
        </div>
        <button type="submit" class="au-btn au-btn--primary au-btn--lg au-btn--block" data-busy-label="Creating your clinic…">Create my clinic</button>
    </form>

    <p class="au-auth__foot"><a class="au-link" href="/Account/Login">Use a different account</a></p>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
