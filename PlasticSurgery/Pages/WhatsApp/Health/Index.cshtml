@page "/WhatsApp/Health"
@model PlasticSurgery.Pages.WhatsApp.Health.IndexModel
@{
    ViewData["Title"] = "WhatsApp Health";
    ViewData["SignalRFirst"] = true; // the layout loads the SignalR client before this page's scripts

    // ---- Presentation only: plain-language wording for Meta's raw values ----
    static (string Label, string Css, string Explain)? Quality(string? rating) => (rating ?? "").ToUpperInvariant() switch
    {
        "GREEN" or "HIGH" => ("High", "q-green", "People rarely block or report your messages."),
        "YELLOW" or "MEDIUM" => ("Medium", "q-yellow", "Some people blocked or reported recent messages."),
        "RED" or "LOW" => ("Low", "q-red", "Many blocks or reports. Meta may limit how much you can send."),
        _ => null
    };
    static string Nice(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : FilterLabelHelper.Label(value.ToLowerInvariant());
    // Material Symbols names (docs/tools/icon-font.js reads the icon:… notes).
    static (string Icon, string Label) EventKind(string type) => type switch
    {
        WhatsAppHealthEventType.PhoneNumberQualityUpdate => ("star", "Quality"), @* icon:star *@
        WhatsAppHealthEventType.PhoneNumberNameUpdate => ("edit", "Display name"), @* icon:edit *@
        WhatsAppHealthEventType.AccountUpdate => ("account_circle", "Account"), @* icon:account_circle *@
        WhatsAppHealthEventType.AccountReviewUpdate => ("verified", "Account review"), @* icon:verified *@
        WhatsAppHealthEventType.ConnectionUpdate => ("sync_alt", "Connection"), @* icon:sync_alt *@
        WhatsAppHealthEventType.TemplateProblem => ("description", "Template"), @* icon:description *@
        WhatsAppHealthEventType.WebhookProblem => ("warning", "Webhook"), @* icon:warning *@
        _ => ("circle", "Other") @* icon:circle *@
    };
}

@if (!Model.ClinicConfigured)
{
    <partial name="_NoClinic" />
}
else if (Model.Health is null)
{
    var notConnected = new EmptyStateModel(Icon: "phone_iphone", Title: "WhatsApp isn't connected yet",
        Text: "Connect your clinic's WhatsApp number to chat with patients, send reminders and run campaigns.",
        ActionLabel: "Connect WhatsApp", ActionHref: "/settings/integrations", ActionIcon: "link");
    <div class="au-panel au-panel--round"><partial name="_EmptyState" model="notConnected" /></div>
}
else
{
    var h = Model.Health;
    var quality = Quality(h.PhoneQualityRating);
    var accountBad = h.AccountStatus is not null && new[] { "disabled", "banned", "restricted" }.Contains(h.AccountStatus.ToLowerInvariant());
    var reviewRejected = string.Equals(h.AccountReviewStatus, "rejected", StringComparison.OrdinalIgnoreCase);

    // Banner: what the health level means for the clinic, and what to do about it (from the same fields the
    // server used to compute HealthLevel — see WhatsAppHealthService.RecomputeHealth).
    var (heroCss, heroIcon, heroTitle, heroText, heroTodo) = h.HealthLevel switch
    {
        WhatsAppHealthLevel.Healthy => ("ok", "check_circle", "All good", "Your WhatsApp number is connected and in good standing. Messages and campaigns can go out normally.", (string?)null),
        WhatsAppHealthLevel.Warning => ("warn", "warning", "Needs attention",
            quality?.Label == "Medium" ? "Meta lowered your number's quality to Medium. This usually happens when people block or report messages."
                : $"Meta reports your phone number as \"{Nice(h.PhoneStatus)}\".",
            quality?.Label == "Medium" ? "Send fewer marketing messages for a few days, and make sure people expect to hear from you."
                : "Check the number in WhatsApp Manager."),
        WhatsAppHealthLevel.Problem => ("bad", "error", "Sending may be limited",
            accountBad ? $"Meta {Nice(h.AccountStatus).ToLowerInvariant()} your WhatsApp account, so some messages may not be delivered."
                : reviewRejected ? "Meta rejected your business account review, so sending may be blocked."
                : "Meta lowered your number's quality to Low and may limit how much you can send.",
            "Open WhatsApp Manager to see Meta's reason, and pause campaigns until it's fixed."),
        WhatsAppHealthLevel.Disconnected => ("off", "link_off", "Not connected", "WhatsApp is disconnected, so no messages can be sent or received.", "Reconnect your number under Settings → Messaging Integrations."),
        _ => ("off", "help", "Status unknown", "We haven't heard from Meta about this number yet.", (string?)null)
    };
    var lastHeardLong = h.LastWebhookAt is null || DateTimeOffset.UtcNow - h.LastWebhookAt.Value > TimeSpan.FromHours(24);
    var problemEvents = Model.Events.Count(e => e.Severity is not null && e.Severity != WhatsAppHealthEventSeverity.Info);

    @* whatsapp-health.js writes "Updated just now: …" here after a live update. *@
    <div class="alert alert-info mb-2" id="health-live-note" hidden></div>
    @* Icons used by the banner above: *@ @* icon:link_off *@ @* icon:help *@

    <div id="whatsapp-health-card" data-level="@h.HealthLevel" data-quality="@h.PhoneQualityRating" data-account="@h.AccountStatus" data-review="@h.AccountReviewStatus">
        <div class="hero hero-@heroCss">
            <div class="hero-icon" aria-hidden="true"><span class="au-icon">@heroIcon</span></div>
            <div class="flex-1">
                <div class="hero-title" id="health-status-badge">@heroTitle</div>
                <div class="hero-text">@heroText</div>
                @if (heroTodo is not null)
                {
                    <div class="hero-todo"><strong>What to do:</strong> @heroTodo</div>
                }
            </div>
            @if (h.HealthLevel == WhatsAppHealthLevel.Disconnected)
            {
                <a href="/settings/integrations" class="au-btn au-btn--primary"><span class="au-icon" aria-hidden="true">link</span>Reconnect</a>
            }
        </div>

        <div class="facts">
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">Phone number</div>
                <div class="fact-main" id="health-phone">@(h.DisplayPhoneNumber ?? "—")</div>
                <div class="cell-sub">
                    @if (!string.IsNullOrWhiteSpace(h.VerifiedName))
                    {
                        @:Shown to patients as <strong id="health-verified-name">@h.VerifiedName</strong>
                        @if (!string.IsNullOrWhiteSpace(h.NameStatus))
                        {
                            <span class="badge @(string.Equals(h.NameStatus, "approved", StringComparison.OrdinalIgnoreCase) ? "badge-green" : "badge-amber")">Name @Nice(h.NameStatus).ToLowerInvariant()</span>
                        }
                    }
                    else
                    {
                        @:No display name yet
                    }
                </div>
            </div>
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">Message quality</div>
                <div class="fact-main" id="health-quality">
                    @if (quality is not null)
                    {
                        <span class="q-dot @quality.Value.Css"></span>@quality.Value.Label
                    }
                    else
                    {
                        @:—
                    }
                </div>
                <div class="cell-sub">@(quality?.Explain ?? "Meta hasn't reported a quality rating yet.")</div>
            </div>
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">Business account</div>
                <div class="fact-main" id="health-account">@Nice(h.AccountStatus)</div>
                <div class="cell-sub" id="health-review">@(h.AccountReviewStatus is null ? "" : "Meta review: " + Nice(h.AccountReviewStatus))</div>
            </div>
            <div class="fact au-panel au-panel--round">
                <div class="eyebrow">Last heard from Meta</div>
                <div class="fact-main" id="health-last-webhook" data-timestamp="@(h.LastWebhookAt?.ToString("O"))">
                    @if (h.LastWebhookAt is { } lastWebhook) { @LocalTimeHelper.Ago(lastWebhook) } else { <text>Never</text> }
                </div>
                <div class="cell-sub">
                    @LocalTimeHelper.Time(h.LastWebhookAt, empty: "")
                    @if (lastHeardLong)
                    {
                        <span class="text-warn">· longer than usual</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="section-head">
        <h2 class="section-title">Activity</h2>
        @if (Model.Events.Count > 0)
        {
            <div class="inbox-filters" id="health-tabs" role="tablist" aria-label="Show activity">
                <button type="button" class="inbox-filter active" data-tab="all">All <span class="inbox-filter-count">@Model.Events.Count</span></button>
                <button type="button" class="inbox-filter" data-tab="problem">Problems <span class="inbox-filter-count">@problemEvents</span></button>
            </div>
        }
    </div>

    @if (Model.Events.Count == 0)
    {
        var quiet = new EmptyStateModel(Icon: "notifications_none", Title: "Nothing to report",
            Text: "When Meta tells us about your number (quality, account, template problems), it shows up here.");
        <div class="au-panel au-panel--round"><partial name="_EmptyState" model="quiet" /></div>
    }
    else
    {
        <div class="au-panel au-panel--round timeline" id="whatsapp-health-events">
            @foreach (var e in Model.Events)
            {
                var kind = EventKind(e.EventType);
                var sev = e.Severity ?? WhatsAppHealthEventSeverity.Info;
                <div class="tl-row" data-problem="@(sev != WhatsAppHealthEventSeverity.Info ? "1" : "0")">
                    <span class="tl-icon sev-@sev" aria-hidden="true"><span class="au-icon au-icon--sm">@kind.Icon</span></span>
                    <div class="flex-1">
                        <div class="tl-title">@(e.Message ?? kind.Label + " update")</div>
                        <div class="cell-sub">@kind.Label@(e.Status is null ? "" : " · " + Nice(e.Status).ToLowerInvariant())</div>
                    </div>
                    <div class="cell-sub" @LocalTimeHelper.Title(e.OccurredAt)>@LocalTimeHelper.Time(e.OccurredAt)</div>
                </div>
            }
            <div class="tl-row tl-empty" id="health-tab-empty" hidden><span class="text-subtle">No problems reported.</span></div>
        </div>
    }

    <details class="au-panel au-panel--round tech mt-3">
        <summary>Technical details</summary>
        <div class="inbox-lead-info-row"><span>WhatsApp Business Account ID</span><strong id="health-waba">@(h.WabaId ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Phone status</span><strong>@(h.PhoneStatus ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Account status / review</span><strong>@(h.AccountStatus ?? "—") / @(h.AccountReviewStatus ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Quality rating</span><strong>@(h.PhoneQualityRating ?? "—")</strong></div>
        <div class="inbox-lead-info-row"><span>Last problem</span><strong id="health-last-problem">@(h.LastProblemCode is null && h.LastProblemMessage is null ? "None" : $"{h.LastProblemCode} {h.LastProblemMessage}".Trim())</strong></div>
    </details>

    <script>
        (function () {
            var tabs = document.querySelectorAll('#health-tabs [data-tab]');
            var rows = document.querySelectorAll('#whatsapp-health-events .tl-row[data-problem]');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var problemsOnly = tab.getAttribute('data-tab') === 'problem';
                    var shown = 0;
                    tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
                    rows.forEach(function (r) {
                        var show = !problemsOnly || r.getAttribute('data-problem') === '1';
                        r.hidden = !show;
                        if (show) shown++;
                    });
                    document.getElementById('health-tab-empty').hidden = shown > 0;
                });
            });
        })();
    </script>

    <script>
        window.PS_WHATSAPP_HEALTH_CONFIG = {
            clinicId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClinicId.ToString())),
            hubUrl: '/hubs/inbox'
        };
    </script>
    <script src="~/js/whatsapp-health.js" asp-append-version="true"></script>
}
