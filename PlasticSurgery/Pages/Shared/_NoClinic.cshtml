@* Shown instead of a page's content when the signed-in account isn't linked to a clinic (docs/UI_GUIDE.md §0.4). *@
<div class="au-alert au-alert--warning" role="status">
    <span class="au-icon au-alert__icon" aria-hidden="true">warning</span>
    <div class="au-alert__body">
        <div class="au-alert__title">Your account isn't linked to a clinic yet</div>
        See the <a class="au-link" href="/dashboard">Dashboard</a> for what to do next.
    </div>
</div>
